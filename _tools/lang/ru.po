#: season.py
msgid "invalid syntax"
msgstr "синтаксическая ошибка"

#: season.py
#, python-format
msgid "Python can't run this line (%s)"
msgstr "Python не может выполнить эту строку (%s)"

#: season.py
#, python-format
msgid "Python can't run seasons_config.py (%s)"
msgstr "Python не может выполнить seasons_config.py (%s)"

#: season.py
#, python-format
msgid "this stops the program (%s). Take it out."
msgstr "это останавливает программу (%s). Уберите эту строку."

#. the first is what Python said, like: name 'winter' is not defined
#: season.py
#, python-format
msgid "%(error)s. Names go in quotes: \"%(name)s\"."
msgstr "%(error)s. Имена пишутся в кавычках: \"%(name)s\"."

#: season.py
#, python-format
msgid "lines %(first)d to %(last)d: %(what)s"
msgstr "строки с %(first)d по %(last)d: %(what)s"

#: season.py
#, python-format
msgid "line %(line)d: %(what)s"
msgstr "строка %(line)d: %(what)s"

#: season.py
msgid "Save it as UTF-8: in Notepad, File > Save as, set Encoding to UTF-8, then Save."
msgstr "Сохраните его в UTF-8: в Блокноте выберите «Файл > Сохранить как», в поле «Кодировка» укажите UTF-8 и нажмите «Сохранить»."

#: season.py config_edit.py
#, python-format
msgid "seasons_config.py can't be read: %s"
msgstr "seasons_config.py не удаётся прочитать: %s"

#: season.py
msgid "The # coding line at the top of seasons_config.py names an encoding Python does not know. Delete that line and save the file as UTF-8: in Notepad, File > Save as, set Encoding to UTF-8, then Save."
msgstr "Строка # coding в начале seasons_config.py называет кодировку, которую Python не знает. Удалите эту строку и сохраните файл в UTF-8: в Блокноте выберите «Файл > Сохранить как», в поле «Кодировка» укажите UTF-8 и нажмите «Сохранить»."

#. English says "bytes in" for any number, 1 too
#: season.py
#, python-format
msgid "seasons_config.py is not saved as UTF-8 (byte 0x%(byte)02X, %(at)d bytes in). Save it as UTF-8: in Notepad, File > Save as, set Encoding to UTF-8, then Save."
msgid_plural "seasons_config.py is not saved as UTF-8 (byte 0x%(byte)02X, %(at)d bytes in). Save it as UTF-8: in Notepad, File > Save as, set Encoding to UTF-8, then Save."
msgstr[0] "seasons_config.py сохранён не в UTF-8 (байт 0x%(byte)02X на позиции %(at)d). Сохраните его в UTF-8: в Блокноте выберите «Файл > Сохранить как», в поле «Кодировка» укажите UTF-8 и нажмите «Сохранить»."
msgstr[1] "seasons_config.py сохранён не в UTF-8 (байт 0x%(byte)02X на позиции %(at)d). Сохраните его в UTF-8: в Блокноте выберите «Файл > Сохранить как», в поле «Кодировка» укажите UTF-8 и нажмите «Сохранить»."
msgstr[2] "seasons_config.py сохранён не в UTF-8 (байт 0x%(byte)02X на позиции %(at)d). Сохраните его в UTF-8: в Блокноте выберите «Файл > Сохранить как», в поле «Кодировка» укажите UTF-8 и нажмите «Сохранить»."

#: season.py
msgid "seasons_config.py is not saved as UTF-8. Save it as UTF-8: in Notepad, File > Save as, set Encoding to UTF-8, then Save."
msgstr "seasons_config.py сохранён не в UTF-8. Сохраните его в UTF-8: в Блокноте выберите «Файл > Сохранить как», в поле «Кодировка» укажите UTF-8 и нажмите «Сохранить»."

#: season.py config_edit.py
msgid "seasons_config.py is saved as UTF-16 (\"Unicode\" in Notepad). Save it as UTF-8: in Notepad, File > Save as, set Encoding to UTF-8, then Save."
msgstr "seasons_config.py сохранён в UTF-16 («Юникод» в Блокноте). Сохраните его в UTF-8: в Блокноте выберите «Файл > Сохранить как», в поле «Кодировка» укажите UTF-8 и нажмите «Сохранить»."

#: season.py
#, python-format
msgid "line %(line)d sets %(table)s again, which throws away the one on line %(first)d. Keep one."
msgstr "строка %(line)d снова задаёт %(table)s, и таблица из строки %(first)d теряется. Оставьте одну."

#: season.py
#, python-format
msgid "lists %(key)s twice, on lines %(first)d and %(second)d; only the second counts. Keep one."
msgstr "содержит %(key)s дважды, в строках %(first)d и %(second)d; учитывается только вторая запись. Оставьте одну."

#: season.py
#, python-format
msgid "%s needs fixing before play.bat can switch anything:"
msgstr "Исправьте %s, иначе play.bat ничего не переключит:"

#: season.py installer.py
msgid "Nothing has been changed."
msgstr "Ничего не изменено."

#: season.py
msgid "that is not a name in quotes. Put the mod's folder name in quotes."
msgstr "это не имя в кавычках. Укажите имя папки мода в кавычках."

#: season.py
msgid "the name is empty. Put the mod's folder name in the quotes."
msgstr "имя пустое. Впишите в кавычки имя папки мода."

#: season.py
msgid "the name has spaces at its start or end, which a folder name can't."
msgstr "в начале или в конце имени есть пробелы, а в имени папки их быть не может."

#: season.py
msgid "that can't be a folder name: folder names can't end with a dot or hold any of / \\ : * ? \" < > |."
msgstr "такого имени у папки быть не может: имя папки не может заканчиваться точкой или содержать / \\ : * ? \" < > |."

#. follows a table's name, like PERIODS, which stays English
#: season.py
msgid "must be a table, {name: (month, day)}, or {} for none."
msgstr "должен быть таблицей вида {имя: (месяц, день)} или {}, если их нет."

#. follows a table's name, like PERIODS, which stays English
#: season.py
msgid "must be a table, {name: ((month, day), (month, day))}, or {} for none."
msgstr "должен быть таблицей вида {имя: ((месяц, день), (месяц, день))} или {}, если их нет."

#: season.py
msgid "a name is letters, digits and underscores, like high_summer."
msgstr "имя может состоять только из латинских букв, цифр и подчёркиваний, например high_summer."

#: season.py
msgid "that is already a season. Rename it."
msgstr "так уже называется сезон. Переименуйте его."

#: season.py
msgid "that is already a kind of weather. Rename the event."
msgstr "так уже называется вид погоды. Переименуйте событие."

#: season.py
msgid "that is already a kind of weather. Rename the period."
msgstr "так уже называется вид погоды. Переименуйте период."

#: season.py
#, python-format
msgid "%s is both a period and an event. Rename one."
msgstr "%s — и период, и событие. Переименуйте что-то одно."

#: season.py
msgid "the start must be (month, day), like (7, 1)."
msgstr "начало должно быть в виде (месяц, день), например (7, 1)."

#. follows an entry, like PERIODS['x'], which stays English
#: season.py
msgid "can't start on February 29, which three years in four don't have. Use February 28 or March 1."
msgstr "не может начинаться 29 февраля: этого дня нет в трёх годах из четырёх. Выберите 28 февраля или 1 марта."

#. follows an entry, like PERIODS['x'], which stays English
#: season.py
#, python-format
msgid "starts on %(day)s, the same day as %(season)s, so one of them would never be on. Give it another day."
msgstr "начинается %(day)s, в тот же день, что и %(season)s, так что один из них никогда не наступит. Выберите другой день."

#. follows a table's name, like PERIODS, which stays English
#: season.py
msgid "must be a table, {mod folder: {...}}."
msgstr "должен быть таблицей вида {папка мода: {...}}."

#: season.py
msgid "that is the soundscape season.py makes, which it switches itself. Take the entry out."
msgstr "это мод фоновых звуков, который создаёт season.py и сам же переключает. Уберите запись."

#: season.py
msgid "that is this mod itself, which stays on all year. Take the entry out."
msgstr "это сам этот мод, он включён круглый год. Уберите запись."

#. follows an entry, like PERIODS['x'], which stays English
#: season.py
msgid "must be {\"when\": (...), \"above\": \"...\"}."
msgstr "должен быть {\"when\": (...), \"above\": \"...\"}."

#. follows an entry, like PERIODS['x'], which stays English
#: season.py
msgid "has both \"when\" and \"seasons\", which are the same thing. Keep one."
msgstr "содержит и \"when\", и \"seasons\", а это одно и то же. Оставьте что-то одно."

#. follows an entry, like PERIODS['x'], which stays English
#: season.py
#, python-format
msgid "has no \"when\" (it has %s). It names the seasons, events or weather the mod is on in, like \"when\": (\"winter\",)."
msgstr "не содержит \"when\" (а есть %s). В \"when\" указывают сезоны, события или погоду, когда мод включён, например \"when\": (\"winter\",)."

#. follows an entry, like PERIODS['x'], which stays English
#: season.py
msgid "has no \"when\". It names the seasons, events or weather the mod is on in, like \"when\": (\"winter\",)."
msgstr "не содержит \"when\". В \"when\" указывают сезоны, события или погоду, когда мод включён, например \"when\": (\"winter\",)."

#: season.py
#, python-format
msgid "\"when\" is the single name \"%(name)s\". Give each season its own quotes: (%(names)s)."
msgstr "\"when\" — это одно имя: \"%(name)s\". Возьмите каждый сезон в свои кавычки: (%(names)s)."

#: season.py
#, python-format
msgid "a single name in \"when\" needs a trailing comma: (\"%(name)s\",), not (\"%(name)s\")."
msgstr "единственному имени в \"when\" нужна запятая в конце: (\"%(name)s\",), а не (\"%(name)s\")."

#: season.py
msgid "\"when\" must list seasons, events or weather in brackets, like (\"winter\", \"winter_snow\")."
msgstr "в \"when\" нужно перечислить сезоны, события или погоду в скобках, например (\"winter\", \"winter_snow\")."

#: season.py
msgid "\"when\" is empty, so the mod would never be on."
msgstr "в \"when\" ничего нет, так что мод никогда не включится."

#: season.py
#, python-format
msgid "\"when\" names %(names)s, which is not a season, an event or weather. Valid: %(valid)s."
msgid_plural "\"when\" names %(names)s, which are not seasons, events or weather. Valid: %(valid)s."
msgstr[0] "в \"when\" указано %(names)s — это не сезон, не событие и не погода. Допустимые значения: %(valid)s."
msgstr[1] "в \"when\" указаны %(names)s — это не сезоны, не события и не погода. Допустимые значения: %(valid)s."
msgstr[2] "в \"when\" указаны %(names)s — это не сезоны, не события и не погода. Допустимые значения: %(valid)s."

#: season.py
#, python-format
msgid "\"above\" must name the mod this one wins over. Pick it in configure.bat, or find it with: %s."
msgstr "в \"above\" нужно указать мод, который этот мод перекрывает. Выберите его в configure.bat или найдите так: %s."

#: season.py
#, python-format
msgid "\"above\" is the mod itself. Name the mod it wins over (%s)."
msgstr "в \"above\" указан сам этот мод. Укажите мод, который он перекрывает (%s)."

#: season.py
#, python-format
msgid "%s each win over the next, in a circle, so play.bat would move them at every launch. Make one of them win over a different mod."
msgstr "%s — каждый перекрывает следующий, по кругу, поэтому play.bat будет переставлять их при каждом запуске. Пусть один из них перекрывает другой мод."

#. follows an entry, like PERIODS['x'], which stays English
#: season.py
msgid "must be {\"archive\": \"...\", \"options\": {...}}."
msgstr "должен быть {\"archive\": \"...\", \"options\": {...}}."

#: season.py
msgid "\"archive\" must be the name of a file in downloads."
msgstr "в \"archive\" должно быть имя файла из папки загрузок."

#: season.py
msgid "\"archive\" must be a .7z or .rar, which is what season.py can open."
msgstr "в \"archive\" должен быть архив .7z или .rar — только такие season.py умеет открывать."

#: season.py
msgid "\"options\" must map each season to a list of folder names in the archive."
msgstr "в \"options\" каждому сезону должен соответствовать список имён папок из архива."

#: season.py
#, python-format
msgid "%(name)s in \"options\" is not a season or a period. Valid: %(valid)s."
msgstr "%(name)s в \"options\" — не сезон и не период. Допустимые значения: %(valid)s."

#: season.py
#, python-format
msgid "\"options\" for %s must be a list of folder names, like [\"Spring\"]."
msgstr "в \"options\" для %s нужен список имён папок, например [\"Spring\"]."

#. follows a table's name, like PERIODS, which stays English
#: season.py
msgid "must be None or a mod's folder name in quotes."
msgstr "должен быть None или именем папки мода в кавычках."

#. follows a table's name, like PERIODS, which stays English
#: season.py
#, python-format
msgid "names %s, which season.py writes itself. Name the ambient sound mod to read from."
msgstr "указывает на %s, который season.py создаёт сам. Укажите мод с фоновыми звуками, из которого их брать."

#. follows a table's name, like PERIODS, which stays English
#: season.py
#, python-format
msgid "names %s, which is this mod itself. Name the ambient sound mod to read from."
msgstr "указывает на %s, а это сам этот мод. Укажите мод с фоновыми звуками, из которого их брать."

#: season.py
#, python-format
msgid "the value for %s isn't a number MCM can hold."
msgstr "значение для %s — число, которое MCM не может сохранить."

#: season.py
#, python-format
msgid "the value for %s can't be empty, start or end with a space, or hold ; [ ], a line break or a letter the game can't show."
msgstr "значение для %s не может быть пустым, начинаться или заканчиваться пробелом, содержать ; [ ], перенос строки или букву, которую игра не может показать."

#: season.py
#, python-format
msgid "the value for %s must be True, False, a number or text in quotes."
msgstr "значение для %s должно быть True, False, числом или текстом в кавычках."

#. follows a table's name, like PERIODS, which stays English
#: season.py
msgid "must be a table, {\"mod/option\": {\"winter\": True, \"else\": False}}, or {} for none."
msgstr "должен быть таблицей вида {\"мод/параметр\": {\"winter\": True, \"else\": False}} или {}, если их нет."

#: season.py
msgid "an option is named as MCM saves it: its page and the option, with / between, like \"cold_system/winter\"."
msgstr "параметр называется так, как его сохраняет MCM: страница и параметр через /, например \"cold_system/winter\"."

#: season.py
msgid "that is one of this mod's own options, which follow the season already. Take the entry out."
msgstr "это один из параметров самого этого мода, а они и так следуют за сезоном. Уберите запись."

#. follows an entry, like PERIODS['x'], which stays English
#: season.py
msgid "must be {\"winter\": True, \"else\": False}: a value for each season, event, spell or weather it names, and one for the rest of the year."
msgstr "должен быть {\"winter\": True, \"else\": False}: значение для каждого сезона, события, каприза или погоды, которые в нём указаны, и ещё одно — для остального времени года."

#: season.py
msgid "it needs \"else\", its value the rest of the year."
msgstr "нужен \"else\" — значение на остальное время года."

#: season.py
msgid "it names no season, event, spell or weather, so it would never change."
msgstr "в нём не указано ни одного сезона, события, каприза или погоды, так что значение никогда не изменится."

#: season.py
#, python-format
msgid "%(names)s is not a season, an event, a spell or weather. Valid: %(valid)s."
msgid_plural "%(names)s are not seasons, events, spells or weather. Valid: %(valid)s."
msgstr[0] "%(names)s — не сезон, не событие, не каприз и не погода. Допустимые значения: %(valid)s."
msgstr[1] "%(names)s — не сезоны, не события, не капризы и не погода. Допустимые значения: %(valid)s."
msgstr[2] "%(names)s — не сезоны, не события, не капризы и не погода. Допустимые значения: %(valid)s."

#: season.py
msgid "its values are of more than one kind; MCM keeps an option as a checkbox, a number or text. Give each the same kind."
msgstr "значения здесь разных типов, а MCM хранит параметр как флажок, число или текст. Сделайте их одного типа."

#: season.py
msgid "the rest of the year"
msgstr "остальное время года"

#: season.py
msgctxt "season"
msgid "spring"
msgstr "весна"

#: season.py
msgctxt "season"
msgid "summer"
msgstr "лето"

#: season.py
msgctxt "season"
msgid "autumn"
msgstr "осень"

#: season.py
msgctxt "season"
msgid "winter"
msgstr "зима"

#: season.py
msgctxt "season"
msgid "deep winter"
msgstr "разгар зимы"

#: season.py
msgctxt "season"
msgid "late winter"
msgstr "поздняя зима"

#. where the real weather comes from unless the player picks another place
#: season.py
msgid "Chornobyl"
msgstr "Чернобыль"

#. a place and where it is: N north, S south, E east, W west
#: season.py
#, python-format
msgid "%(name)s (%(lat).2f N, %(lon).2f E)"
msgstr "%(name)s (%(lat).2f° с. ш., %(lon).2f° в. д.)"

#: season.py
#, python-format
msgid "%(name)s (%(lat).2f N, %(lon).2f W)"
msgstr "%(name)s (%(lat).2f° с. ш., %(lon).2f° з. д.)"

#: season.py
#, python-format
msgid "%(name)s (%(lat).2f S, %(lon).2f E)"
msgstr "%(name)s (%(lat).2f° ю. ш., %(lon).2f° в. д.)"

#: season.py
#, python-format
msgid "%(name)s (%(lat).2f S, %(lon).2f W)"
msgstr "%(name)s (%(lat).2f° ю. ш., %(lon).2f° з. д.)"

#. follows a table's name, like PERIODS, which stays English
#: season.py
msgid "must be a table like {\"name\": \"Kyiv\", \"lat\": 50.45, \"lon\": 30.52}, or None for Chornobyl."
msgstr "должен быть таблицей вида {\"name\": \"Киев\", \"lat\": 50.45, \"lon\": 30.52} или None для Чернобыля."

#: season.py
#, python-format
msgid "%s is not one of its parts, which are name, lat and lon."
msgid_plural "%s are not one of its parts, which are name, lat and lon."
msgstr[0] "%s не входит в число его частей: name, lat и lon."
msgstr[1] "%s не входят в число его частей: name, lat и lon."
msgstr[2] "%s не входят в число его частей: name, lat и lon."

#: season.py
msgid "give the place a name in quotes, like \"Kyiv\"."
msgstr "дайте месту название в кавычках, например \"Киев\"."

#: season.py
#, python-format
msgid "the name \"%(name)s\" is %(n)d character; the PDA has room for %(most)d."
msgid_plural "the name \"%(name)s\" is %(n)d characters; the PDA has room for %(most)d."
msgstr[0] "в названии \"%(name)s\" %(n)d символ, а в КПК помещается не больше %(most)d."
msgstr[1] "в названии \"%(name)s\" %(n)d символа, а в КПК помещается не больше %(most)d."
msgstr[2] "в названии \"%(name)s\" %(n)d символов, а в КПК помещается не больше %(most)d."

#: season.py
msgid "the name can't contain ; [ ] = or a line break."
msgstr "в названии не может быть ; [ ] = или переноса строки."

#. %s is lat, as the config spells it
#: season.py
#, python-format
msgid "%s must be the latitude in degrees, -90 to 90, north and east positive, like 50.45."
msgstr "в %s нужна широта в градусах, от -90 до 90 (север и восток — положительные), например 50.45."

#. %s is lon, as the config spells it
#: season.py
#, python-format
msgid "%s must be the longitude in degrees, -180 to 180, north and east positive, like 30.52."
msgstr "в %s нужна долгота в градусах, от -180 до 180 (север и восток — положительные), например 30.52."

#. follows a table's name, like PERIODS, which stays English
#: season.py
msgid "must be a table, {season: \"its name\"}, or None for the usual names."
msgstr "должен быть таблицей вида {сезон: \"его название\"} или None для обычных названий."

#: season.py
#, python-format
msgid "not a season. The seasons are: %s."
msgstr "это не сезон. Сезоны: %s."

#: season.py
msgid "give the name in quotes, like \"The Long Cold\", or take the line out."
msgstr "укажите название в кавычках, например \"Долгий холод\", или уберите строку."

#: season.py
#, python-format
msgid "the name \"%(name)s\" is %(n)d character; the dial and the PDA have room for %(most)d."
msgid_plural "the name \"%(name)s\" is %(n)d characters; the dial and the PDA have room for %(most)d."
msgstr[0] "в названии \"%(name)s\" %(n)d символ, а на циферблате и в КПК помещается не больше %(most)d."
msgstr[1] "в названии \"%(name)s\" %(n)d символа, а на циферблате и в КПК помещается не больше %(most)d."
msgstr[2] "в названии \"%(name)s\" %(n)d символов, а на циферблате и в КПК помещается не больше %(most)d."

#: season.py
msgid "the name can't contain ; [ ] or a line break."
msgstr "в названии не может быть ; [ ] или переноса строки."

#: season.py
#, python-format
msgid "the name \"%s\" has letters the game can't show. Use English or Cyrillic letters."
msgstr "в названии \"%s\" есть буквы, которые игра не может показать. Используйте латиницу или кириллицу."

#: season.py
#, python-format
msgid "%(first)s and %(second)s would both be called \"%(name)s\". Give one of them another name."
msgstr "%(first)s и %(second)s будут называться одинаково: «%(name)s». Дайте одному из них другое название."

#: season.py configure.py
msgid "off"
msgstr "выкл."

#: season.py
msgid "every launch rolls another season"
msgstr "каждый запуск — другой сезон"

#: season.py
#, python-format
msgid "a %d%% chance at each launch of another season"
msgstr "шанс %d%% на другой сезон при каждом запуске"

#: season.py
msgid "on, but a pinned or forced season is never rolled over"
msgstr "включены, но закреплённый или заданный сезон кости не меняют"

#: season.py
#, python-format
msgid "drew %d, but the calendar has no other season on"
msgstr "выпало %d, но других включённых сезонов в календаре нет"

#: season.py
#, python-format
msgid "drew %(draw)d, over %(chance)d, so the calendar's season"
msgstr "выпало %(draw)d, больше %(chance)d, так что сезон по календарю"

#: season.py
msgid "added, enabled"
msgstr "добавлен, включён"

#: season.py
msgid "added, disabled"
msgstr "добавлен, выключен"

#: season.py
msgid "moved, enabled"
msgstr "перемещён, включён"

#: season.py
msgid "moved, disabled"
msgstr "перемещён, выключен"

#: season.py
msgid "disabled -> enabled"
msgstr "выключен -> включён"

#: season.py
msgid "enabled -> disabled"
msgstr "включён -> выключен"

#: season.py
#, python-format
msgid "MO2's mod list (%s) does not start with MO2's header line, so no seasonal mod was switched."
msgstr "Список модов MO2 (%s) не начинается со строки заголовка MO2, поэтому сезонные моды не переключены."

#: season.py
#, python-format
msgid "%(mod)s now wins over \"%(now)s\": the mod it is set to win over, \"%(was)s\", is not in MO2's mod list, and this looks like the same mod renamed by an update."
msgstr "%(mod)s теперь перекрывает «%(now)s»: «%(was)s», который он должен перекрывать, нет в списке модов MO2, и, похоже, это тот же мод, переименованный обновлением."

#: season.py
msgid "Pick it in its \"Wins over\" box in configure.bat to keep it."
msgstr "Выберите его в поле «Перекрывает» в configure.bat, чтобы так и осталось."

#: season.py
#, python-format
msgid "%(mod)s skipped: the mod it wins over, \"%(above)s\", is not in MO2's mod list."
msgstr "%(mod)s пропущен: мода \"%(above)s\", который он перекрывает, нет в списке модов MO2."

#: season.py
msgid "Pick another in its \"Wins over\" box in configure.bat."
msgstr "Выберите другой в его поле «Перекрывает» в configure.bat."

#. follows a table's name, like PERIODS, which stays English
#: season.py
msgid "must be a table, {season: (month, day)}, or None for Polesia's dates."
msgstr "должен быть таблицей вида {сезон: (месяц, день)} или None для дат Полесья."

#. follows a table's name, like PERIODS, which stays English
#: season.py
msgid "turns every season off. At least one has to stay on."
msgstr "выключает все сезоны. Хотя бы один должен остаться включённым."

#: season.py
msgid "the start must be (month, day), like (5, 20)."
msgstr "начало должно быть в виде (месяц, день), например (5, 20)."

#: season.py
#, python-format
msgid "%(first)s and %(second)s both start on %(day)s. Give each season its own day."
msgstr "%(first)s и %(second)s начинаются в один день, %(day)s. Дайте каждому сезону свой день."

#. English says "days" for 1 too
#: season.py
#, python-format
msgid "%(season)s would last %(days)d days. A season needs at least %(least)d."
msgid_plural "%(season)s would last %(days)d days. A season needs at least %(least)d."
msgstr[0] "%(season)s продлится всего %(days)d день. Сезону нужно не меньше %(least)d."
msgstr[1] "%(season)s продлится всего %(days)d дня. Сезону нужно не меньше %(least)d."
msgstr[2] "%(season)s продлится всего %(days)d дней. Сезону нужно не меньше %(least)d."

#: season.py
msgid "that is already the name of a season. Give it another name."
msgstr "так уже называется сезон. Дайте другое название."

#: season.py
msgid "that is already a season of your own. Give it another name."
msgstr "такой свой сезон уже есть. Дайте другое название."

#: season.py
msgid "that is already a period. Give it another name."
msgstr "такой период уже есть. Дайте другое название."

#: season.py
msgid "that is already an event. Give it another name."
msgstr "такое событие уже есть. Дайте другое название."

#: season.py
msgid "that is already a kind of weather. Give it another name."
msgstr "так уже называется вид погоды. Дайте другое название."

#: season.py
#, python-format
msgid "%(n)d season of your own, and the year has room for %(most)d, a week each. Take some out."
msgid_plural "%(n)d seasons of your own, and the year has room for %(most)d, a week each. Take some out."
msgstr[0] "%(n)d свой сезон, а в году есть место только для %(most)d, по неделе на каждый. Уберите лишние."
msgstr[1] "%(n)d своих сезона, а в году есть место только для %(most)d, по неделе на каждый. Уберите лишние."
msgstr[2] "%(n)d своих сезонов, а в году есть место только для %(most)d, по неделе на каждый. Уберите лишние."

#: season.py
msgid "give the season a name in quotes, like \"Wormhole season\"."
msgstr "дайте сезону название в кавычках, например \"Сезон червоточин\"."

#: season.py
msgid "the name has spaces at its start or end. Take them out."
msgstr "в начале или в конце названия есть пробелы. Уберите их."

#: season.py
#, python-format
msgid "the name is %(n)d character long; it can have %(most)d at most."
msgid_plural "the name is %(n)d characters long; it can have %(most)d at most."
msgstr[0] "в названии %(n)d символ, а можно не больше %(most)d."
msgstr[1] "в названии %(n)d символа, а можно не больше %(most)d."
msgstr[2] "в названии %(n)d символов, а можно не больше %(most)d."

#: season.py
msgid "the name can't contain , ; [ ] = or a line break."
msgstr "в названии не может быть , ; [ ] = или переноса строки."

#: season.py
msgid "the name has letters the game can't show. Use English or Cyrillic letters."
msgstr "в названии есть буквы, которые игра не может показать. Используйте латиницу или кириллицу."

#: season.py
#, python-format
msgid "%s is a season of yours already. Give this one another name."
msgstr "свой сезон %s уже есть. Назовите этот иначе."

#: season.py
msgid "give its first and last day, like ((8, 1), (8, 31))."
msgstr "укажите первый и последний день, например ((8, 1), (8, 31))."

#. follows an entry, like PERIODS['x'], which stays English
#: season.py
msgid "can't start or end on February 29, which three years in four don't have. Use February 28 or March 1."
msgstr "не может начинаться или заканчиваться 29 февраля: этого дня нет в трёх годах из четырёх. Выберите 28 февраля или 1 марта."

#: season.py
#, python-format
msgid "it runs %(n)d day, %(first)s to %(last)s. A season of your own runs at least a week."
msgid_plural "it runs %(n)d days, %(first)s to %(last)s. A season of your own runs at least a week."
msgstr[0] "он длится %(n)d день, с %(first)s по %(last)s. Свой сезон длится не меньше недели."
msgstr[1] "он длится %(n)d дня, с %(first)s по %(last)s. Свой сезон длится не меньше недели."
msgstr[2] "он длится %(n)d дней, с %(first)s по %(last)s. Свой сезон длится не меньше недели."

#. follows a table's name, like PERIODS, which stays English
#: season.py
msgid "must be a table, {name: {\"in\": (\"summer\",), \"chance\": 3, \"days\": (1, 2), \"as\": \"winter\"}}, or {} for none."
msgstr "должен быть таблицей вида {имя: {\"in\": (\"summer\",), \"chance\": 3, \"days\": (1, 2), \"as\": \"winter\"}} или {}, если их нет."

#: season.py
msgid "give the spell a name in quotes, like \"Summer frost\"."
msgstr "дайте капризу название в кавычках, например \"Летние заморозки\"."

#: season.py
#, python-format
msgid "%s is a spell already. Give this one another name."
msgstr "каприз %s уже есть. Назовите этот иначе."

#. follows an entry, like PERIODS['x'], which stays English
#: season.py
msgid "must be {\"in\": (\"summer\",), \"chance\": 3, \"days\": (1, 2), \"as\": \"winter\"}."
msgstr "должен быть {\"in\": (\"summer\",), \"chance\": 3, \"days\": (1, 2), \"as\": \"winter\"}."

#: season.py
#, python-format
msgid "%(keys)s is not a part of a spell. The parts are %(parts)s."
msgid_plural "%(keys)s are not parts of a spell. The parts are %(parts)s."
msgstr[0] "%(keys)s — не часть каприза. Его части: %(parts)s."
msgstr[1] "%(keys)s — не части каприза. Его части: %(parts)s."
msgstr[2] "%(keys)s — не части каприза. Его части: %(parts)s."

#: season.py
msgid "\"in\" names the seasons it can start in, like (\"summer\",)."
msgstr "в \"in\" указывают сезоны, в которые каприз может начаться, например (\"summer\",)."

#: season.py
#, python-format
msgid "\"in\" names %(names)s, which is not a season. The seasons are %(seasons)s."
msgid_plural "\"in\" names %(names)s, which are not seasons. The seasons are %(seasons)s."
msgstr[0] "в \"in\" указано %(names)s — это не сезон. Сезоны: %(seasons)s."
msgstr[1] "в \"in\" указаны %(names)s — это не сезоны. Сезоны: %(seasons)s."
msgstr[2] "в \"in\" указаны %(names)s — это не сезоны. Сезоны: %(seasons)s."

#: season.py
#, python-format
msgid "%s is off in your calendar, so it never starts."
msgid_plural "%s are off in your calendar, so it never starts."
msgstr[0] "%s — этот сезон выключен в вашем календаре, так что каприз никогда не начнётся."
msgstr[1] "%s — эти сезоны выключены в вашем календаре, так что каприз никогда не начнётся."
msgstr[2] "%s — эти сезоны выключены в вашем календаре, так что каприз никогда не начнётся."

#: season.py
msgid "\"chance\" is the percent chance it starts on each day of those seasons, more than 0 and up to 100, like 3."
msgstr "\"chance\" — ежедневный шанс в процентах, что каприз начнётся в эти сезоны: больше 0 и не больше 100, например 3."

#: season.py
#, python-format
msgid "\"days\" is how long it runs, 1 to %d, or the fewest and the most, like (1, 2). A week or longer is a season of your own."
msgstr "\"days\" — сколько дней длится каприз: от 1 до %d или наименьшее и наибольшее число, например (1, 2). Неделя и дольше — это уже свой сезон."

#: season.py
#, python-format
msgid "\"as\" is the season it brings, one of %s, or None to leave the season as it is."
msgstr "\"as\" — сезон, который приносит каприз: один из %s, или None, чтобы сезон не менялся."

#: season.py
#, python-format
msgid "it brings %s, which is off in your calendar."
msgstr "он приносит сезон «%s», который выключен в вашем календаре."

#: season.py
#, python-format
msgid "it would bring %(season)s to %(season)s, which changes nothing."
msgstr "он принёс бы сезон «%(season)s» в сезон «%(season)s», а это ничего не меняет."

#: season.py
msgid "Polesia (the Zone's own dates)"
msgstr "Полесье (собственные даты Зоны)"

#. a season's usual name, then the player's own name for it
#: season.py
#, python-format
msgctxt "a season and its name"
msgid "%(season)s \"%(name)s\""
msgstr "%(season)s «%(name)s»"

#: season.py
#, python-format
msgid "Polesia (the Zone's own dates); named: %s"
msgstr "Полесье (собственные даты Зоны); свои названия: %s"

#: season.py
msgid "meteorological (month starts)"
msgstr "метеорологический (с начала месяцев)"

#. a season and the day it starts: "summer May 20"
#: season.py
#, python-format
msgctxt "a season and its first day"
msgid "%(season)s %(day)s"
msgstr "%(season)s с %(day)s"

#: season.py
#, python-format
msgid "your own: %(seasons)s; off: %(off)s"
msgstr "свой: %(seasons)s; выключены: %(off)s"

#: season.py
#, python-format
msgid "your own: %s"
msgstr "свой: %s"

#: season.py
msgid "the shipped one, for Polesia's dates"
msgstr "стандартный, для дат Полесья"

#: season.py
msgid "drawn for your dates and names"
msgstr "нарисован для ваших дат и названий"

#: season.py
msgid "to be drawn for your dates and names at the next play.bat"
msgstr "будет нарисован для ваших дат и названий при следующем запуске play.bat"

#: season.py
msgid "hidden - the game has no dial for your dates and names"
msgstr "скрыт — в игре нет циферблата для ваших дат и названий"

#: season.py
msgid "not written"
msgstr "не записан"

#: season.py
#, python-format
msgid "drawing one needs Pillow: %s"
msgstr "для рисования циферблата нужен Pillow: %s"

#: season.py
msgid "the mod's configs folder is missing"
msgstr "папка configs мода не найдена"

#: season.py
#, python-format
msgid "the dial could not be drawn (%s)"
msgstr "не удалось нарисовать циферблат (%s)"

#: season.py
#, python-format
msgid "%(file)s could not be written (%(error)s)"
msgstr "не удалось записать %(file)s (%(error)s)"

#: season.py
msgid "give its first and last day, like ((12, 24), (12, 26)), or a rule, like {\"weekdays\": (\"sat\", \"sun\")}."
msgstr "укажите первый и последний день, например ((12, 24), (12, 26)), или правило, например {\"weekdays\": (\"sat\", \"sun\")}."

#: season.py
#, python-format
msgid "%(keys)s is not a part of a rule. The parts are %(parts)s."
msgid_plural "%(keys)s are not parts of a rule. The parts are %(parts)s."
msgstr[0] "%(keys)s — не часть правила. Его части: %(parts)s."
msgstr[1] "%(keys)s — не части правила. Его части: %(parts)s."
msgstr[2] "%(keys)s — не части правила. Его части: %(parts)s."

#: season.py
#, python-format
msgid "\"weekdays\" must list days of the week as %s, like (\"sat\", \"sun\")."
msgstr "в \"weekdays\" нужно перечислить дни недели в виде %s, например (\"sat\", \"sun\")."

#: season.py
msgid "\"days\" must list days of the month, 1 to 31, or -1 for the last, like (1, 15, -1)."
msgstr "в \"days\" нужно перечислить дни месяца, от 1 до 31, или -1 для последнего, например (1, 15, -1)."

#: season.py
msgid "\"weeks\" must say which of those weekdays in the month count, 1 to 5 or -1 for the last, like (1,)."
msgstr "в \"weeks\" нужно указать, какие из этих дней недели в месяце считаются: от 1 до 5 или -1 для последнего, например (1,)."

#: season.py
msgid "\"weeks\" needs \"weekdays\" too (--weekdays on the command line), to say which day of the week it counts."
msgstr "для \"weeks\" нужен ещё и \"weekdays\" (--weekdays в командной строке), чтобы указать, какой день недели считать."

#: season.py
msgid "\"months\" must list months, 1 to 12, like (12, 1, 2)."
msgstr "в \"months\" нужно перечислить месяцы, от 1 до 12, например (12, 1, 2)."

#: season.py
msgid "\"within\" must be a first and last day, like ((12, 1), (2, 28))."
msgstr "в \"within\" нужно указать первый и последний день, например ((12, 1), (2, 28))."

#: season.py
msgid "never happens - no date matches every part of the rule."
msgstr "никогда не наступает — ни одна дата не подходит под все части правила."

