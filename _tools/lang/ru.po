#. keep each command as it is; translate what is said about it, and the rest
#: configure.py
msgid ""
"configure.bat opens the window. The same changes can be made with commands, run in the\n"
"GAMMA folder (use python in place of py if that is how your Python starts):\n"
"\n"
"  py _tools\\configure.py list                    the seasonal mods, events and calendar\n"
"  py _tools\\configure.py add \"<mod>\" --when winter \"deep winter\" [--above \"<mod>\"]\n"
"  py _tools\\configure.py remove \"<mod>\"\n"
"  py _tools\\configure.py event <name> <MM-DD> [<MM-DD>]\n"
"  py _tools\\configure.py event <name> --weekdays sat sun\n"
"  py _tools\\configure.py event <name> --days 1 15 last [--months dec jan]\n"
"  py _tools\\configure.py event <name> --weekdays mon --weeks first [--between 12-01 02-28]\n"
"  py _tools\\configure.py event <name> --remove\n"
"  py _tools\\configure.py season                  your own seasons\n"
"  py _tools\\configure.py season \"<name>\" <MM-DD> <MM-DD>    add or change one, a week or\n"
"                                                longer; it runs on top of the season it\n"
"                                                falls in\n"
"  py _tools\\configure.py season \"<name>\" --rename \"<new>\" | --remove\n"
"  py _tools\\configure.py spell                   your spells\n"
"  py _tools\\configure.py spell \"<name>\" --in summer --chance 3 [--days 1 2] [--as winter]\n"
"                                                a short stretch, 1 to 6 days, that starts by\n"
"                                                chance; --as is the season it brings\n"
"  py _tools\\configure.py spell \"<name>\" --rename \"<new>\" | --remove\n"
"  py _tools\\configure.py mcm                     other mods' MCM options that follow the\n"
"                                                season\n"
"  py _tools\\configure.py mcm --find <words>      MCM's options with those words in their\n"
"                                                names, and their values now\n"
"  py _tools\\configure.py mcm <page/option> --in winter \"deep winter\" --to true --else false\n"
"  py _tools\\configure.py mcm <page/option> --set \"deep winter=2\" winter=1.5 --else 1\n"
"  py _tools\\configure.py mcm <page/option> --remove\n"
"  py _tools\\configure.py calendar                when each season starts\n"
"  py _tools\\configure.py calendar summer=5-1 \"deep winter=11-15\" [--only]\n"
"  py _tools\\configure.py calendar --off \"late winter\" | --on \"late winter\"\n"
"  py _tools\\configure.py calendar --dates met | --reset\n"
"  py _tools\\configure.py name                    what the seasons are called\n"
"  py _tools\\configure.py name \"deep winter\" \"The Long Cold\" | name \"deep winter\" --reset\n"
"  py _tools\\configure.py place                   where the real weather comes from\n"
"  py _tools\\configure.py place \"Kyiv\" [--pick 2]  look a place up, and take the weather there\n"
"  py _tools\\configure.py place --at 50.45 30.52 [--name \"Home\"] | place --reset\n"
"  py _tools\\configure.py --advanced              the tabbed editor, not the guided setup\n"
"  py mods\\<the mod>\\_tools\\configure.py install  put the tools in the GAMMA folder, or\n"
"                                                update them there (configure.bat does it\n"
"                                                when opened from the mod's folder)\n"
"  py _tools\\configure.py preset                  the presets there are\n"
"  py _tools\\configure.py preset save \"<name>\" [--about \"...\"] [--parts calendar mods]\n"
"  py _tools\\configure.py preset load \"<name>\" [--parts calendar events mods textures]\n"
"  py _tools\\configure.py preset show \"<name>\"\n"
"\n"
"Mod names are as MO2's mod list shows them; a name with a space goes in quotes. --above\n"
"is the mod a seasonal mod wins over, worked out from the files they share when left out.\n"
"Every change is checked with season.py's rules before it is written, and the previous\n"
"file is kept as seasons_config.py.bak.\n"
msgstr ""
"configure.bat открывает окно. То же самое можно сделать командами, запуская их\n"
"в папке GAMMA (пишите python вместо py, если ваш Python запускается так):\n"
"\n"
"  py _tools\\configure.py list                    сезонные моды, события и календарь\n"
"  py _tools\\configure.py add \"<mod>\" --when winter \"deep winter\" [--above \"<mod>\"]\n"
"  py _tools\\configure.py remove \"<mod>\"\n"
"  py _tools\\configure.py event <name> <MM-DD> [<MM-DD>]\n"
"  py _tools\\configure.py event <name> --weekdays sat sun\n"
"  py _tools\\configure.py event <name> --days 1 15 last [--months dec jan]\n"
"  py _tools\\configure.py event <name> --weekdays mon --weeks first [--between 12-01 02-28]\n"
"  py _tools\\configure.py event <name> --remove\n"
"  py _tools\\configure.py season                  свои сезоны\n"
"  py _tools\\configure.py season \"<name>\" <MM-DD> <MM-DD>    добавить или изменить\n"
"                                                (от недели и дольше); он действует\n"
"                                                поверх сезона, в который попадает\n"
"  py _tools\\configure.py season \"<name>\" --rename \"<new>\" | --remove\n"
"  py _tools\\configure.py spell                   ваши капризы\n"
"  py _tools\\configure.py spell \"<name>\" --in summer --chance 3 [--days 1 2] [--as winter]\n"
"                                                короткий отрезок от 1 до 6 дней,\n"
"                                                наступающий случайно; --as — сезон,\n"
"                                                который он приносит\n"
"  py _tools\\configure.py spell \"<name>\" --rename \"<new>\" | --remove\n"
"  py _tools\\configure.py mcm                     настройки MCM других модов,\n"
"                                                которые меняются с сезоном\n"
"  py _tools\\configure.py mcm --find <words>      параметры MCM с этими словами\n"
"                                                в названии и их текущие значения\n"
"  py _tools\\configure.py mcm <page/option> --in winter \"deep winter\" --to true --else false\n"
"  py _tools\\configure.py mcm <page/option> --set \"deep winter=2\" winter=1.5 --else 1\n"
"  py _tools\\configure.py mcm <page/option> --remove\n"
"  py _tools\\configure.py calendar                когда начинается каждый сезон\n"
"  py _tools\\configure.py calendar summer=5-1 \"deep winter=11-15\" [--only]\n"
"  py _tools\\configure.py calendar --off \"late winter\" | --on \"late winter\"\n"
"  py _tools\\configure.py calendar --dates met | --reset\n"
"  py _tools\\configure.py name                    как называются сезоны\n"
"  py _tools\\configure.py name \"deep winter\" \"The Long Cold\" | name \"deep winter\" --reset\n"
"  py _tools\\configure.py place                   откуда берётся реальная погода\n"
"  py _tools\\configure.py place \"Kyiv\" [--pick 2]  найти место и брать погоду оттуда\n"
"  py _tools\\configure.py place --at 50.45 30.52 [--name \"Home\"] | place --reset\n"
"  py _tools\\configure.py --advanced              редактор с вкладками, а не\n"
"                                                пошаговая настройка\n"
"  py mods\\<the mod>\\_tools\\configure.py install  положить инструменты в папку GAMMA\n"
"                                                или обновить их там (так делает\n"
"                                                configure.bat из папки мода)\n"
"  py _tools\\configure.py preset                  какие есть пресеты\n"
"  py _tools\\configure.py preset save \"<name>\" [--about \"...\"] [--parts calendar mods]\n"
"  py _tools\\configure.py preset load \"<name>\" [--parts calendar events mods textures]\n"
"  py _tools\\configure.py preset show \"<name>\"\n"
"\n"
"Имена модов — как в списке модов MO2; имя с пробелом пишется в кавычках. --above —\n"
"мод, перекрываемый сезонным модом; если не указан, он определяется по файлам,\n"
"общим для обоих модов. Каждое изменение перед записью проверяется по правилам\n"
"season.py, а прежний файл сохраняется как seasons_config.py.bak.\n"

#: configure.py
msgid "Set up Seasons of the Zone. With no command, opens the window."
msgstr "Настройка Seasons of the Zone. Без команды открывает окно."

#: configure.py
msgid "open the tabbed editor rather than the guided setup"
msgstr "открыть редактор с вкладками вместо пошаговой настройки"

#: configure.py
msgid "show the seasonal mods, events and calendar"
msgstr "показать сезонные моды, события и календарь"

#: configure.py
msgid "make a mod seasonal, or change when it is on"
msgstr "сделать мод сезонным или изменить, когда он включён"

#: configure.py
msgid "the mod as MO2's mod list names it, in quotes if it has spaces"
msgstr "мод, как он назван в списке модов MO2; в кавычках, если есть пробелы"

#: configure.py
#, python-format
msgid "the seasons, events or weather it is on in, like %s"
msgstr "сезоны, события или погода, при которых он включён, например %s"

#: configure.py
msgid "the mod it wins over; worked out from shared files if left out"
msgstr "мод, который он перекрывает; если не указан, определяется по общим файлам"

#: configure.py
msgid "stop switching a mod by season"
msgstr "перестать переключать мод по сезонам"

#: configure.py
msgid "the seasonal mod to stop switching"
msgstr "сезонный мод, который больше не нужно переключать"

#: configure.py
msgid "add, change or remove an event"
msgstr "добавить, изменить или удалить событие"

#. English letters, a to z: an event's name takes no others
#: configure.py
#, python-format
msgid "lowercase letters, digits and underscores, like %s"
msgstr "строчные латинские буквы, цифры и подчёркивания, например %s"

#: configure.py
msgid "the first day, month-day, like 12-24"
msgstr "первый день, месяц-день, например 12-24"

#: configure.py
msgid "the last day, month-day; left out for one day"
msgstr "последний день, месяц-день; не нужен, если день один"

#: configure.py
#, python-format
msgid "days of the week: %s"
msgstr "дни недели: %s"

#: configure.py
#, python-format
msgid "days of the month: %s"
msgstr "числа месяца: %s"

#: configure.py
#, python-format
msgid "with --weekdays, which of them in the month: %s"
msgstr "с --weekdays — какие по счёту в месяце: %s"

#: configure.py
msgid "only in these months"
msgstr "только в эти месяцы"

#: configure.py
msgid "only between these dates, month-day"
msgstr "только между этими датами, месяц-день"

#: configure.py
msgid "delete the event"
msgstr "удалить событие"

#: configure.py
msgid "show, add, change or remove a season of your own"
msgstr "показать, добавить, изменить или удалить свой сезон"

#: configure.py
msgid "its name, in quotes if it has spaces"
msgstr "его название, в кавычках, если есть пробелы"

#: configure.py
msgid "the first day, month-day, like 08-01"
msgstr "первый день, месяц-день, например 08-01"

#: configure.py
msgid "the last day, month-day, at least a week on"
msgstr "последний день, месяц-день, не меньше чем через неделю"

#: configure.py
msgid "give it another name"
msgstr "дать ему другое название"

#: configure.py
msgid "delete it, and take it off the mods on in it"
msgstr "удалить его и убрать из модов, которые в нём включаются"

#: configure.py
msgid "show, add, change or remove a spell: a short stretch that starts by chance"
msgstr "показать, добавить, изменить или удалить каприз — короткий отрезок, который начинается случайно"

#: configure.py
msgid "the seasons it can start in, yours included"
msgstr "сезоны, в которые он может начаться, включая ваши собственные"

#: configure.py
msgid "the percent chance it starts on each of those days, like 3"
msgstr "шанс в процентах, с которым он начинается в каждый из этих дней, например 3"

#: configure.py
#, python-format
msgid "how long it runs: a number, or the fewest and the most, 1 to %d"
msgstr "сколько дней он длится: одно число или наименьшее и наибольшее, от 1 до %d"

#: configure.py
#, python-format
msgid "the season it brings, or %s to leave the season as it is"
msgstr "сезон, который он приносит, или %s, чтобы оставить сезон как есть"

#: configure.py
msgid "delete it, and take it off the mods on during it"
msgstr "удалить его и убрать из модов, которые включаются на его время"

#: configure.py
msgid "show, add, change or remove another mod's MCM option that follows the season"
msgstr "показать, добавить, изменить или удалить настройку MCM другого мода, которая меняется с сезоном"

#: configure.py
msgid "the option as MCM saves it, like cold_system/winter"
msgstr "настройка, как её сохраняет MCM, например cold_system/winter"

#: configure.py
msgid "list MCM's options with these words in their names"
msgstr "перечислить параметры MCM с этими словами в названии"

#: configure.py
msgid "the seasons, events, spells or weather that take the value --to gives"
msgstr "сезоны, события, капризы или погода, при которых действует значение из --to"

#: configure.py
msgid "the value in those"
msgstr "значение при них"

#: configure.py
msgid "a value for each name, like \"deep winter=2\""
msgstr "значение для каждого названия, например \"deep winter=2\""

#: configure.py
msgid "the value the rest of the year"
msgstr "значение в остальное время года"

#: configure.py
msgid "stop setting it; MCM keeps the value it has then"
msgstr "перестать её задавать; в MCM останется текущее значение"

#: configure.py
msgid "show or change when each season starts"
msgstr "показать или изменить, когда начинается каждый сезон"

#: configure.py
msgid "move a season's start, turning it on if it was off"
msgstr "перенести начало сезона и включить его, если он был выключен"

#: configure.py
msgid "the seasons named are the only ones on"
msgstr "включены только названные сезоны"

#: configure.py
msgid "turn seasons off"
msgstr "выключить сезоны"

#: configure.py
msgid "turn seasons back on, at Polesia's date"
msgstr "снова включить сезоны, с датами из календаря Полесья"

#: configure.py
msgid "start from Polesia's dates or the meteorological ones (month starts), all six seasons on"
msgstr "взять за основу даты Полесья или метеорологические (с начала месяцев), все шесть сезонов включены"

#: configure.py
msgid "back to Polesia's dates"
msgstr "вернуться к датам Полесья"

#: configure.py
msgid "show MCM's dice, or switch them on or off: at each launch, a chance of another season"
msgstr "показать кости MCM или включить и выключить их: при каждом запуске — шанс другого сезона"

#: configure.py
msgid "the chance in 100 at each launch, 1 to 100; at 100 every launch rolls"
msgstr "шанс из 100 при каждом запуске, от 1 до 100; при 100 другой сезон при каждом запуске"

#: configure.py
msgid "show or change what the seasons are called"
msgstr "показать или изменить названия сезонов"

#: configure.py
#, python-format
msgid "a season, like %(one)s or %(other)s"
msgstr "сезон, например %(one)s или %(other)s"

#: configure.py
msgid "the name to show in the game, in quotes"
msgstr "название, которое покажет игра, в кавычках"

#: configure.py
msgid "back to its usual name"
msgstr "вернуть обычное название"

#: configure.py
msgid "show or change where the real weather comes from"
msgstr "показать или изменить, откуда берётся реальная погода"

#: configure.py
msgid "a place to look up on open-meteo.com, like Kyiv or \"New York\""
msgstr "место для поиска на open-meteo.com, например Kyiv или \"New York\""

#: configure.py
msgid "which of the places found, when there are several"
msgstr "какое из найденных мест взять, если их несколько"

#: configure.py
msgid "the place's coordinates in degrees, north and east positive"
msgstr "координаты места в градусах; север и восток положительные"

#: configure.py
msgid "with --at, what to call the place"
msgstr "с --at — как назвать место"

#: configure.py
msgid "back to Chornobyl"
msgstr "вернуться к Чернобылю"

#: configure.py
msgid "copy the tools from the mod's folder into the GAMMA folder, or update them there; configure.bat does this when opened from the mod's folder"
msgstr "скопировать инструменты из папки мода в папку GAMMA или обновить их там; configure.bat делает это сам, если открыт из папки мода"

#: configure.py
msgid "in the console, without asking"
msgstr "в консоли, без вопросов"

#: configure.py
msgid "save your setup under a name, or load one"
msgstr "сохранить вашу настройку под именем или загрузить сохранённую"

#: configure.py
#, python-format
msgid "%s (the default)"
msgstr "%s (по умолчанию)"

#: configure.py
msgid "the preset's name, in quotes if it has spaces"
msgstr "название пресета, в кавычках, если есть пробелы"

#: configure.py
msgid "a line saying what the preset is"
msgstr "строка о том, что это за пресет"

#: configure.py
msgid "which parts to save or load: by default, a save keeps the parts that have something in them, and a load takes every part the preset holds"
msgstr "какие части сохранять или загружать: по умолчанию сохраняются части, в которых что-то есть, а загружаются все части, что есть в пресете"

#: configure.py
msgid "save over a preset of that name, or load over your own setup"
msgstr "сохранить поверх пресета с таким именем или загрузить поверх вашей настройки"

