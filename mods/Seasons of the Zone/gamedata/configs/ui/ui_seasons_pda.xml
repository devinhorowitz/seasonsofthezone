<w>
<!--
    Seasons of the Zone - the calendar page.

    Laid out on the same grid as ui_seasons_forecast.xml, because the two sit beside each
    other in the launcher and a player should not have to learn the page twice: a chamfered
    frame with the corners left open, a rule under the header block, and a vertical split
    with the year on the left and the dial on the right.

    Dates and names only. Anything running on the GAME clock - the weather plan, the next
    emission - lives on the forecast page, because those are not calendar questions. Nothing
    about the MOD belongs here either: which seasonal mods are staged is a question about an
    install rather than about the Zone, and MCM's per-season pages already answer it. The one
    exception is the line at the foot naming the mod, its version and its author, so that a
    screenshot says which Seasons it shows. The player's own seasons, events, periods and
    spells are on it by the names they gave them.

    Textureless except for two things this mod ships and therefore cannot be missing: the
    year dial (ui_seasons_dial_NN, 384x384) and the season accent bar
    (ui_season_hdr_<season>, 256x16). The shared PDA frame textures other tab-adding mods
    borrow are declared in NO texture_descr in a stock install, which is why opening those
    pages logs "Can't find texture". The flat window's frame is the one exception: the PDA's
    own body, which the base game declares (ui_actor_pda.xml) because pda_16.xml draws it.

    Colors follow the Anomaly PDA convention: amber 238,196,112 for headings, light gray
    for body, dim gray for things that are off. Fonts are letterica, as everywhere else.
-->
    <!-- the flat window only (the app key): the 2D PDA's frame behind the page, and the
         face's name where the PDA prints a section's - pda_16.xml's background_static and
         caption_static, at the same offsets -->
    <flat_bezel x="-10" y="-34" width="819" height="768" stretch="1">
        <texture>ui_inGame2_pda_texture</texture>
    </flat_bezel>
    <flat_caption x="29" y="28" width="748" height="17">
        <text font="letterica16" align="l" r="170" g="170" b="170"/>
    </flat_caption>

    <background x="28" y="106" width="764" height="603" stretch="1"/>

    <!-- the season the Zone runs, then the accent bar in that season's color -->
    <header x="52" y="120" width="440" height="28">
        <text font="letterica18" r="238" g="196" b="112" align="l" vert_align="c" complex_mode="1"/>
    </header>

    <bar x="52" y="152" width="452" height="8" stretch="1"/>

    <subheader x="52" y="164" width="452" height="18">
        <text font="letterica16" r="170" g="170" b="170" align="l" vert_align="c" complex_mode="1"/>
    </subheader>

    <!-- what has the season: a pin, the dice or a spell, beside what the calendar reads;
         else the calendar's next turn. A whole line, as some of these run long. -->
    <turning x="52" y="180" width="452" height="16">
        <text font="letterica16" r="255" g="255" b="255" align="l" vert_align="c" complex_mode="1"/>
    </turning>

    <!-- The year, as a year looks: twelve month rows of day cells tinted by season, with
         today lit, the days the Zone marks underlined, and the player's own seasons and
         events drawn as a line above their days. This page's equivalent of the forecast's
         chart - the thing that answers "where are we" without being read.

         Cells are tinted copies of <px> parented to this element. A month is drawn as one
         block per season rather than one block per day, and the day divisions are 30
         hairlines over the whole grid: the same picture for a twelfth of the widgets. -->
    <grid x="52" y="212" width="452" height="230"/>

    <grid_cap_l x="52" y="446" width="150" height="16">
        <text font="letterica16" r="150" g="156" b="150" align="l" vert_align="c" complex_mode="1"/>
    </grid_cap_l>
    <grid_cap_r x="206" y="446" width="298" height="16">
        <text font="letterica16" r="150" g="156" b="150" align="r" vert_align="c" complex_mode="1"/>
    </grid_cap_r>

    <!-- the month names down the left of the grid, and the day scale across its top. Both
         are cloned and repositioned in script, exactly as the forecast does with its
         hours. -->
    <grid_month x="0" y="0" width="32" height="16">
        <text font="letterica16" r="170" g="170" b="170" align="r" vert_align="c" complex_mode="1"/>
    </grid_month>

    <axis_x x="0" y="0" width="54" height="14">
        <text font="letterica16" r="150" g="156" b="150" align="c" vert_align="c" complex_mode="1"/>
    </axis_x>

    <!-- the year dial; square, so the width is corrected for aspect from script, which
         puts it in the middle of the column at 16:9 -->
    <dial x="575" y="160" width="212" height="212" stretch="1"/>

    <dial_caption x="546" y="378" width="216" height="18">
        <text font="letterica16" r="170" g="170" b="170" align="c" vert_align="c" complex_mode="1"/>
    </dial_caption>

    <!-- one white block, tinted per cell. X-Ray has no fill-rect. -->
    <px x="0" y="0" width="8" height="8" stretch="1">
        <texture>sotz_px</texture>
    </px>

    <!-- No scroll view. Everything fits, and a page you have to scroll to read the date
         off is a document rather than a device. -->

    <!-- the back button; its texture is set from script, as MAC does for its tiles -->
    <back x="730" y="636" width="34" height="34" stretch="1"/>

    <!-- The switch between the app's two faces, The Year and Forecast. The same place on
         both pages, so it holds still while the page under it changes. Four-state plates
         from sotz_btn, each with its label laid over it, as the units button does. -->
    <toggle_year x="556" y="126" width="64" height="24" stretch="1"/>
    <toggle_fc   x="622" y="126" width="64" height="24" stretch="1"/>
    <toggle_year_label x="556" y="126" width="64" height="24">
        <text font="letterica16" r="200" g="200" b="200" align="c" vert_align="c" complex_mode="1"/>
    </toggle_year_label>
    <toggle_fc_label x="622" y="126" width="64" height="24">
        <text font="letterica16" r="200" g="200" b="200" align="c" vert_align="c" complex_mode="1"/>
    </toggle_fc_label>

    <!-- The foot of the right column, beside Back, the same on both pages: Silence, which is
         MCM's "PDA notifications" seen here too (lit, with an amber label, while the messages
         are off), and under it the mod's name, version and author, so a screenshot of either
         page says which Seasons it shows. The plate takes its texture from script. -->
    <silence x="556" y="641" width="64" height="24" stretch="1"/>
    <silence_label x="556" y="641" width="64" height="24">
        <text font="letterica16" r="200" g="200" b="200" align="c" vert_align="c" complex_mode="1"/>
    </silence_label>
    <credit x="556" y="676" width="212" height="16">
        <text font="letterica16" r="128" g="136" b="128" align="l" vert_align="c" complex_mode="1"/>
    </credit>

    <!-- Rows and headings are allocated from these once and repositioned. Color carries
         the emphasis a font change would normally carry, because a widget cannot be
         restyled after it is built. -->
    <row_head x="0" y="0" width="460" height="24">
        <text font="letterica18" r="238" g="196" b="112" align="l" vert_align="c" complex_mode="1"/>
    </row_head>

    <row_line x="0" y="0" width="460" height="17">
        <text font="letterica16" r="200" g="200" b="200" align="l" vert_align="c" complex_mode="1"/>
    </row_line>
</w>
