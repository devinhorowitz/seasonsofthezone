<w>
<!--
    Seasons of the Zone - the forecast page.

    Laid out to match ui_seasons_pda.xml element for element, because the two pages sit
    next to each other in the Mod App Creator launcher and should read as one mod: same
    margins, same amber headings, same row heights. Only the right-hand image differs -
    the barometer instead of the year dial.

    Textureless except for two things this mod ships and therefore cannot be missing: the
    barometer (ui_seasons_forecast, 384x384) and the season accent bar
    (ui_season_hdr_<season>, 256x16). The shared PDA frame textures other tab-adding mods
    borrow are declared in NO texture_descr in a stock install, which is why those pages
    log "Can't find texture".
-->
    <background x="28" y="106" width="764" height="603" stretch="1"/>

    <header x="48" y="120" width="470" height="28">
        <text font="letterica18" r="238" g="196" b="112" align="l" vert_align="c" complex_mode="1"/>
    </header>

    <bar x="48" y="150" width="470" height="8" stretch="1"/>

    <subheader x="48" y="160" width="470" height="18">
        <text font="letterica16" r="170" g="170" b="170" align="l" vert_align="c" complex_mode="1"/>
    </subheader>

    <!-- Where the numbers came from. Observed and modelled are different claims.
         The dot to its left pulses only when the reading is a live one. -->
    <live_dot x="48" y="181" width="7" height="7" stretch="1">
        <texture>sotz_px</texture>
    </live_dot>
    <src x="62" y="176" width="440" height="16">
        <text font="letterica16" r="128" g="136" b="128" align="l" vert_align="c" complex_mode="1"/>
    </src>

    <!-- Celsius / Fahrenheit. Writes the MCM option rather than keeping its own copy. -->
    <units x="700" y="118" width="58" height="24" stretch="1"/>
    <units_label x="700" y="118" width="58" height="24">
        <text font="letterica16" r="238" g="196" b="112" align="c" vert_align="c" complex_mode="1"/>
    </units_label>

    <!-- The ecologists get a panel of their own, with their own banner: what it says is
         being withheld, not merely dim. Border drawn from tinted px blocks in script. -->
    <!-- The shield only. The full ui_inGame2_ecolog region is a banner - emblem on the
         left, empty name plate on the right - and using it whole put a black box on the
         page. sotz_eco_mark is that emblem cropped out of the same file. -->
    <eco_logo x="554" y="370" width="42" height="42" stretch="1">
        <texture>sotz_eco_mark</texture>
    </eco_logo>
    <eco_class x="606" y="378" width="160" height="24">
        <text font="letterica18" r="238" g="196" b="112" align="l" vert_align="c" complex_mode="1"/>
    </eco_class>
    <eco_l1 x="554" y="424" width="212" height="18">
        <text font="letterica16" r="200" g="200" b="200" align="l" vert_align="c" complex_mode="1"/>
    </eco_l1>
    <eco_l2 x="554" y="444" width="212" height="18">
        <text font="letterica16" r="200" g="200" b="200" align="l" vert_align="c" complex_mode="1"/>
    </eco_l2>
    <eco_l3 x="554" y="464" width="212" height="18">
        <text font="letterica16" r="140" g="140" b="140" align="l" vert_align="c" complex_mode="1"/>
    </eco_l3>

    <!-- shown only when the day dips below zero -->
    <frost x="430" y="190" width="34" height="34" stretch="1">
        <texture>sotz_wx_frost</texture>
    </frost>

    <!-- The sky, now and next. Square textures, so the width is corrected for aspect
         from script exactly as the dial and the barometer are. -->
    <wx_now   x="48"  y="198" width="56" height="56" stretch="1"/>
    <wx_arrow x="118" y="212" width="34" height="34" stretch="1"/>
    <wx_next  x="166" y="198" width="56" height="56" stretch="1"/>

    <wx_now_label x="34" y="258" width="86" height="18">
        <text font="letterica16" r="255" g="255" b="255" align="c" vert_align="c" complex_mode="1"/>
    </wx_now_label>
    <wx_next_label x="140" y="258" width="112" height="18">
        <text font="letterica16" r="190" g="190" b="190" align="c" vert_align="c" complex_mode="1"/>
    </wx_next_label>

    <!-- the temperature, beside the sky rather than buried in a row -->
    <now x="278" y="204" width="146" height="44">
        <text font="letterica18" r="255" g="255" b="255" align="l" vert_align="c" complex_mode="1"/>
    </now>

    <!-- the barometer; one of six images, picked by the weather. Square, width
         corrected for aspect from script. -->
    <gauge  x="566" y="150" width="184" height="184" stretch="1"/>
    <!-- One hand. A set hand pointing at the coming weather was tried and cut: at this
         size two white needles overlap into a single thick smear rather than reading as
         a gap, and the glyphs above already say what is coming. -->
    <needle x="566" y="150" width="184" height="184" stretch="1"/>

    <gauge_caption x="548" y="336" width="220" height="18">
        <text font="letterica16" r="170" g="170" b="170" align="c" vert_align="c" complex_mode="1"/>
    </gauge_caption>

    <!-- the day chart lives here: weather ribbon, hour marks, temperature curve. Bars
         are tinted copies of <px> parented to this. -->
    <!-- The densest thing on the page, so it gets the room. The ribbon and the curve
         share one x axis: 24 game hours across 462px. -->
    <chart x="48" y="290" width="462" height="206"/>

    <chart_cap_l x="48" y="500" width="200" height="16">
        <text font="letterica16" r="150" g="150" b="150" align="l" vert_align="c" complex_mode="1"/>
    </chart_cap_l>
    <chart_cap_r x="310" y="500" width="200" height="16">
        <text font="letterica16" r="150" g="150" b="150" align="r" vert_align="c" complex_mode="1"/>
    </chart_cap_r>

    <!-- Which system each stratum comes from. The ribbon is Atmospherics', the curve
         is Chornobyl's, and they share an axis because that is the whole idea. -->
    <strat_sky x="516" y="298" width="48" height="16">
        <text font="letterica16" r="150" g="160" b="170" align="l" vert_align="c" complex_mode="1"/>
    </strat_sky>
    <strat_air x="516" y="398" width="48" height="16">
        <text font="letterica16" r="196" g="170" b="120" align="l" vert_align="c" complex_mode="1"/>
    </strat_air>

    <!-- chart scales: three temperatures up the left gutter, five hours along the
         bottom. Cloned and repositioned in script like every other row on this page. -->
    <axis_y x="0" y="0" width="34" height="14">
        <text font="letterica16" r="150" g="156" b="150" align="r" vert_align="c" complex_mode="1"/>
    </axis_y>
    <axis_x x="0" y="0" width="54" height="14">
        <text font="letterica16" r="150" g="156" b="150" align="c" vert_align="c" complex_mode="1"/>
    </axis_x>

    <!-- one white block, tinted per bar. X-Ray has no fill-rect. -->
    <px x="0" y="0" width="8" height="8" stretch="1">
        <texture>sotz_px</texture>
    </px>

    <!-- No scroll view. Everything fits, and a page you have to scroll to read the
         weather off is a document rather than a device. Rows are allocated from
         row_head / row_line once and repositioned; colour carries the emphasis, because
         a widget cannot change its font after it is built. -->

    <!-- the back button; its texture is set from script, as MAC does for its tiles -->
    <back x="740" y="652" width="34" height="34" stretch="1"/>

    <!-- rows are cloned from these at runtime. row_holder carries the columns: one text
         widget per column at a fixed x, because letterica is proportional and padded
         strings do not line up. -->
    <row_holder x="0" y="0" width="470" height="18"/>

    <row_head x="0" y="0" width="460" height="26">
        <text font="letterica18" r="238" g="196" b="112" align="l" vert_align="c" complex_mode="1"/>
    </row_head>

    <row_line x="0" y="0" width="460" height="18">
        <text font="letterica16" r="200" g="200" b="200" align="l" vert_align="c" complex_mode="1"/>
    </row_line>

    <row_now x="0" y="0" width="460" height="18">
        <text font="letterica16" r="255" g="255" b="255" align="l" vert_align="c" complex_mode="1"/>
    </row_now>

    <row_dim x="0" y="0" width="460" height="18">
        <text font="letterica16" r="140" g="140" b="140" align="l" vert_align="c" complex_mode="1"/>
    </row_dim>

    <row_gap x="0" y="0" width="460" height="12"/>
</w>
