-- Seasons of the Zone - make eptSeasons a real PDA section.
--
-- Mod App Creator routes a click to our page itself: mac_handle_tabs() monkeypatches
-- pda.set_active_subdialog and returns app_data.func() for a matching tab. But it gets
-- there through ActorMenu.get_pda_menu():SetActiveSubdialog(tab), and the engine only
-- accepts a section that exists as a button in ui/pda*.xml. That is why MAC parks
-- eptTaskboard, eptInteractive and the rest at x=1000, width 0 - registered, invisible.
--
-- This adds eptSeasons the same way, by runtime injection rather than by shipping our
-- own pda_16.xml. Editing MAC's copy would mean maintaining a fork of a file three other
-- mods also care about; injecting touches nobody's file and works whichever copy wins.
--
-- Parked off-screen on purpose: the app is reached from the MAC launcher or the app key,
-- so the sections only have to exist, not show. A visible button added HERE, in the xml,
-- would crowd the bar and clip once it is full; on modded exes CUITabControl:AddTab is the
-- way to show a real tab, sized like its neighbors and scrolling on overflow. See
-- sotz_pda.script.
--
-- The tab bar and nothing else: the files ui/pda.xml and ui/pda_16.xml, and in them the
-- <tab> that holds the PDA's own sections (eptTasks and the rest). An earlier match on any
-- ui/pda*.xml reached every other PDA page as well - pda_relations_16.xml has a <tab> of its
-- own, a plain container - and any mod's page that is named pda_something.
--
-- The bar is a file several mods ship whole: MAC's has its Launcher, and another mod's that
-- adds tabs of its own may not. Only one copy wins, and the other's tabs are gone. With MAC
-- installed and a bar without the Launcher, this parks one too, so MAC's own launcher key
-- and this app's Back button still reach it. What the bar was found to hold is kept for
-- MCM's Main page, which tells the player (tab_bar).

local BAR_FILES = {["ui\\pda.xml"] = true, ["ui\\pda_16.xml"] = true}
local LAUNCHER = "eptLauncher"

-- what the tab bar held the last time the game read it, or nil before it has been read
local BAR = nil

local function has_mac()
    local ok, yes = pcall(function() return mac_mcm and mac_mcm.add_app and true end)
    return ok and yes == true
end

-- the <tab> with the PDA's own sections in it, and the ids of its buttons
local function find_bar(xml_obj)
    for _, el in ipairs(xml_obj:query("tab") or {}) do
        local ids = {}
        local sections = false
        for _, child in ipairs(el.kids or {}) do
            local id = child.name == "button" and child.attribs and child.attribs.id
            if id then
                ids[id] = true
                if id:find("^ept") then sections = true end
            end
        end
        if sections then return el, ids end
    end
    return nil
end

local function park(xml_obj, tab_el, id, label)
    xml_obj:insertFromXMLString(string.format([[
        <button x="1000" y="0" width="0" height="0" id="%s" frame_mode="0">
            <text align="c" vert_align="c" x="0" y="0" font="letterica16">%s</text>
        </button>
    ]], id, label), tab_el)
end

local function inject(xml_file_name, xml_obj)
    local tab_el, have = find_bar(xml_obj)
    if not tab_el then return end

    local WANT = {
        {id = "eptSeasons",  label = "pda_btn_seasons"},
        {id = "eptForecast", label = "pda_btn_forecast"},
    }
    -- already there? a second copy would give the engine a duplicate id
    for _, w in ipairs(WANT) do
        if not have[w.id] then park(xml_obj, tab_el, w.id, w.label) end
    end

    local launcher, parked = have[LAUNCHER] == true, false
    if not launcher and has_mac() then
        park(xml_obj, tab_el, LAUNCHER, "pda_btn_launcher")
        parked = true
        printf("%s", "[seasons-pda] " .. tostring(xml_file_name)
            .. " has no Launcher tab; parked one for Mod App Creator")
    end
    BAR = {file = xml_file_name, launcher = launcher, parked_launcher = parked}
end

-- What the PDA's tab bar held when the game last read it: {file, launcher, parked_launcher},
-- with launcher true when the bar itself carries MAC's Launcher tab. nil before the bar has
-- been read, at the main menu, or without DXML.
function tab_bar()
    return BAR
end

-- whether a file DXML hands over is the tab bar's
function is_bar_file(xml_file_name)
    local name = tostring(xml_file_name or ""):lower():gsub("/", "\\")
    return BAR_FILES[name] == true
end

function on_game_start()
    -- on_xml_read comes from DXML, which Modded Exes loads at startup. Without it (plain
    -- Anomaly, or the exes without their gamedata) there is nothing to register with, and
    -- asking anyway logs a stack trace on every start. The app still opens with its key and
    -- from MAC; the PDA's tab bar just goes blank while a face is open in the PDA.
    if not rawget(_G, "dxml_core") then
        printf("%s", "[seasons-pda] DXML not found, so the PDA sections are not added")
        return
    end
    RegisterScriptCallback("on_xml_read", function(xml_file_name, xml_obj)
        if not is_bar_file(xml_file_name) then return end
        local ok, err = pcall(inject, xml_file_name, xml_obj)
        if not ok then
            printf("%s", "[seasons-pda] xml inject failed: " .. tostring(err))
        end
    end)
end
