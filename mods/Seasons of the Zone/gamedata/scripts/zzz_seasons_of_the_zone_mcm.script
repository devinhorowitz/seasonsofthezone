-- Seasons of the Zone - MCM pages
--
-- Pages under one entry: Main (the calendar and the global settings) and one per
-- season the calendar has on. A season page holds that season's color grade preset, a
-- read-out of its resolved values, and a checkbox for each seasonal mod active in it.
-- Options are stored as seasons_zone/<page>/<id>.
--
-- String keys (from ui_mcm.script, not its tutorial):
--     page title    the node's `text` field: ui_mcm_seasons_zone_page_<page>
--     option label  ui_mcm_<hint>; opt() sets hint = seasons_zone_<id>, so keys do not
--                   depend on which page an option is on
--     list item     seasons_zone_<page>_<id>_lst_<value>, or a literal with no_str
-- A wrong key renders as itself on screen. A desc row renders game.translate_string(text),
-- which returns its input when nothing matches, so a computed sentence renders verbatim.
-- So a fixed row passes its string id, and a row with a value in it arrives from the main
-- script already filled in, through sotz_text; neither is ever English here.

-- Register_Image does not apply width_factor: a square request renders as an ellipse.
-- Widths are corrected by (4:3) / screen aspect, 0.75 at 16:9.
local function aspect()
    local f = 0.75
    local okd, dw, dh = pcall(function() return device().width, device().height end)
    if okd and dw and dh and dh > 0 then
        f = (1024 / 768) / (dw / dh)
    end
    return f
end

-- A captioned option keeps its string key regardless of page.
local function opt(t)
    if t.type == "check" or t.type == "list" or t.type == "track" then
        t.hint = t.hint or ("seasons_zone_" .. t.id)
    end
    return t
end

local function desc(out, id, text, bright)
    out[#out + 1] = {id = id, type = "desc", text = text,
                     clr = bright and {255, 255, 255, 255} or {255, 165, 165, 165}}
end

local function has_season(seasons_str, s)
    for tok in tostring(seasons_str):gmatch("[^,%s]+") do
        if tok == s then return true end
    end
    return false
end

-- What the PDA app needs, and whether it is here. Gray is fine, red is broken.
--
-- The red is the one the PDA pages alarm in, rather than MCM's own 225,0,0, so it means the
-- same thing on both screens.
local STATUS_OK  = {255, 165, 165, 165}
local STATUS_BAD = {255, 238, 96, 72}

local WEATHER_TEXT = {
    plan  = "ui_mcm_seasons_zone_status_plan",
    stock = "ui_mcm_seasons_zone_status_stock",
    none  = "ui_mcm_seasons_zone_status_none",
}

local function dependency_rows(out)
    local function row(id, text, bad)
        out[#out + 1] = {id = id, type = "desc", text = text,
                         clr = bad and STATUS_BAD or STATUS_OK}
    end

    -- The same test the registration uses, so this line and the launcher tile cannot
    -- disagree about whether MAC is here.
    local has_mac = (mac_mcm and mac_mcm.add_app) and true or false
    if has_mac then
        row("status_mac", "ui_mcm_seasons_zone_status_mac", false)
    else
        row("status_mac", "ui_mcm_seasons_zone_status_no_mac", true)
    end

    -- weather_source() never builds a manager from the main menu, which is where MCM is
    -- most often opened; see its comment in zzz_seasons_of_the_zone.
    local ok, src = pcall(function() return zzz_seasons_of_the_zone.weather_source() end)
    src = (ok and WEATHER_TEXT[src]) and src or "none"
    row("status_weather", WEATHER_TEXT[src], src == "none")
end

-- Today's date, and a line when a pinned season disagrees with the calendar.
local function calendar_rows(out)
    local ok, rows = pcall(function() return zzz_seasons_of_the_zone.calendar_rows() end)
    if not (ok and rows) then
        out[#out + 1] = {id = "desc_cal_err", type = "desc",
                         text = "ui_mcm_seasons_zone_desc_cal_unavailable"}
        return
    end
    for i, r in ipairs(rows) do
        desc(out, "desc_cal_" .. i, r.text, r.current)
    end
end

-- Every season, in page order
local ALL_SEASONS = {"spring", "summer", "autumn", "winter", "winter_snow", "late_winter"}

-- The seasons the calendar has on (configure.bat can turn some off), in page order.
-- All six if the main script cannot say.
local function seasons_on()
    local ok, on = pcall(function() return zzz_seasons_of_the_zone.enabled_seasons() end)
    if ok and type(on) == "table" and #on > 0 then return on end
    return ALL_SEASONS
end

-- A season's name as MCM shows it: the player's own when configure.bat set one, else
-- `id`, the string that holds its usual name. MCM runs both through translate_string,
-- which hands back a name it has no string for unchanged.
local function shown(s, id)
    local ok, name = pcall(function() return zzz_seasons_of_the_zone.season_name(s) end)
    return (ok and name) or id
end

-- The dropdown of presets, shared by every season page and the neutral picker.
local function preset_choices()
    local okp, c = pcall(function() return zzz_seasons_of_the_zone.preset_choices() end)
    return (okp and c) or {{"builtin", "seasons_zone_preset_lst_builtin"}}
end

-- Main page: the calendar, the global settings, the launch-time master switches.
local function page_main()
    local gr = {}
    local function add(t) gr[#gr + 1] = opt(t) end

    add({id = "desc_top", type = "desc", text = "ui_mcm_seasons_zone_desc_top"})
    -- Above everything else: a missing launcher means the player never sees either page,
    -- so it cannot sit below the fold under options they will not reach for.
    dependency_rows(gr)
    add({id = "line_cal1", type = "line"})
    calendar_rows(gr)
    local ok, tex = pcall(function() return zzz_seasons_of_the_zone.dial_texture() end)
    if ok and tex then
        local H = 268
        local W = math.floor(H * aspect() + 0.5)
        local x = math.floor((547 - W) / 2 - 27 + 0.5)   -- centered in the ~547-wide panel
        add({id = "dial", type = "image", link = tex,
             size = {W, H}, pos = {x > 0 and x or 0, 0}, stretch = true})
    end
    add({id = "line_cal2", type = "line"})

    add({id = "enabled", type = "check", val = 1, def = true})
    -- only the seasons the calendar has on can be pinned. no_str: each label is a
    -- string id or a name, not a suffix, so a season the player renamed shows that name.
    local modes = {{"auto", "seasons_zone_main_mode_lst_auto"}}
    for _, s in ipairs(seasons_on()) do
        modes[#modes + 1] = {s, shown(s, "seasons_zone_main_mode_lst_" .. s)}
    end
    add({id = "mode", type = "list", val = 0, def = "auto", no_str = true, content = modes})
    add({id = "blend_days", type = "track", val = 2, min = 0, max = 30, step = 1, def = 14})
    add({id = "intensity", type = "track", val = 2, min = 0.0, max = 1.0, step = 0.05, def = 1.0})
    -- neutral is the intensity-0 baseline, not a season, so its preset lives here
    add({id = "preset_neutral", type = "list", val = 0, def = "builtin",
         no_str = true, content = preset_choices()})

    add({id = "line1", type = "line"})
    add({id = "do_grade", type = "check", val = 1, def = true})
    add({id = "do_flora", type = "check", val = 1, def = true})
    add({id = "do_fog",   type = "check", val = 1, def = true})
    add({id = "do_wind",  type = "check", val = 1, def = true})
    add({id = "do_wet",   type = "check", val = 1, def = true})

    add({id = "line2", type = "line"})
    -- what play.bat switches at launch; each seasonal mod's checkbox is on a season page
    add({id = "stage_textures", type = "check", val = 1, def = true})
    add({id = "stage_sound", type = "check", val = 1, def = true})

    add({id = "line_rem", type = "line"})
    -- Days of remembrance: April 26 and December 14. Each is a day laid over
    -- whatever season is running; none of these touch the season layers.
    add({id = "rem_weather", type = "check", val = 1, def = true})
    add({id = "rem_messages", type = "check", val = 1, def = true})
    -- the four mainline release dates: PDA messages, a storm and a crop of artefacts,
    -- each with its own switch
    add({id = "rem_anniversary", type = "check", val = 1, def = true})
    add({id = "rem_ann_weather", type = "check", val = 1, def = true})
    add({id = "rem_ann_artefacts", type = "check", val = 1, def = true})

    -- The forecast page has a button that writes this same option, so the two can
    -- never drift apart.
    -- MCM labels each entry "seasons_zone_main_units_lst_" .. its second field, so that
    -- field is a suffix, not a string id; a full id there showed as the raw key.
    add({id = "units", type = "list", val = 0, def = "celsius", content = {
        {"celsius", "celsius"},
        {"fahrenheit", "fahrenheit"},
    }})

    add({id = "line_fc", type = "line"})
    -- The emission forecast on the PDA page, and what it costs in ecologist goodwill.
    -- Goodwill runs -1000 to +1000; below the first threshold the page shows the number
    -- rather than hiding the row, so the player can see what they are working towards.
    add({id = "forecast", type = "check", val = 1, def = true})
    add({id = "forecast_coarse", type = "track", val = 2, min = 0, max = 1000, step = 50,
         def = 200})
    add({id = "forecast_exact", type = "track", val = 2, min = 0, max = 1000, step = 50,
         def = 700})
    -- the weather half of the page: a forecaster's calls unless this asks for the plan
    add({id = "wx_exact", type = "check", val = 1, def = false})

    add({id = "line3", type = "line"})
    add({id = "notify", type = "check", val = 1, def = true})
    add({id = "pda_greeting", type = "check", val = 1, def = true})
    add({id = "pda_delay", type = "track", val = 2, min = 3, max = 60, step = 1, def = 12})
    return gr
end

-- A season page: a colored bar, the color grade preset dropdown, the resolved read-out,
-- and the seasonal mods active in this season, each with its own checkbox for this season.
--
-- The list comes from season_mods.ltx, which play.bat writes. It ships as a stub with
-- staged_for = none and no mods, so until the first play.bat start an empty list says
-- nothing about the config, and the page asks for that start instead.
local function page_season(s, choices, info)
    local gr = {}
    local function add(t) gr[#gr + 1] = opt(t) end

    local bar_w = math.floor(520 * aspect() + 0.5)
    gr[#gr + 1] = {id = "hdr", type = "image", link = "ui_season_hdr_" .. s,
                   size = {bar_w, 10}, pos = {0, 0}, stretch = true}

    add({id = "preset", type = "list", val = 0, def = "builtin",
         no_str = true, content = choices, hint = "seasons_zone_preset"})

    add({id = "line_ro", type = "line"})
    local okr, rows = pcall(function() return zzz_seasons_of_the_zone.season_readout(s) end)
    if okr and rows then
        for i, line in ipairs(rows) do desc(gr, "ro_" .. i, line, false) end
    end

    add({id = "line_mods", type = "line"})
    local mine = {}
    if info and info.mods then
        for _, m in ipairs(info.mods) do
            if has_season(m.seasons, s) then mine[#mine + 1] = m end
        end
    end
    if #mine == 0 then
        -- no file at all is as unknown as the stub
        if not info or info.staged_for == "none" then
            desc(gr, "desc_nomods", "ui_mcm_seasons_zone_mods_unstaged", false)
        else
            desc(gr, "desc_nomods", "ui_mcm_seasons_zone_mods_none", false)
        end
    else
        desc(gr, "desc_mods", "ui_mcm_seasons_zone_mods_listed", false)
        for _, m in ipairs(mine) do
            add({id = "mod_" .. m.key, type = "check", val = 1, def = true,
                 hint = "seasons_zone_mod_" .. m.key})
        end
    end
    return gr
end

function on_mcm_load()
    local choices = preset_choices()
    local okm, info = pcall(function() return zzz_seasons_of_the_zone.mod_list() end)
    if not okm then info = nil end

    local pages = {
        {id = "main", sh = true, text = "ui_mcm_seasons_zone_page_main", gr = page_main()},
    }
    for _, s in ipairs(seasons_on()) do
        pages[#pages + 1] = {id = s, sh = true, text = shown(s, "ui_mcm_seasons_zone_page_" .. s),
            gr = page_season(s, choices, info)}
    end

    op = {id = "seasons_zone", sh = false, gr = pages}
    return op
end
