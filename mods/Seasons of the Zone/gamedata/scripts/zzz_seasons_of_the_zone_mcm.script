-- Seasons of the Zone - MCM pages
--
-- Six pages under one entry: Main (the calendar and the global settings) and one per
-- season (Spring, Summer, Autumn, Winter, Deep winter). A season page holds that season's
-- color-grade preset, a read-out of its resolved values, and the ticks for the texture
-- mods active in it. Options are stored as seasons_zone/<page>/<id>.
--
-- String keys (from ui_mcm.script, not its tutorial):
--     page title    the node's `text` field: ui_mcm_seasons_zone_page_<page>
--     option label  ui_mcm_<hint>; opt() sets hint = seasons_zone_<id>, so keys do not
--                   depend on which page an option is on
--     list item     seasons_zone_<page>_<id>_lst_<value>, or a literal with no_str
-- A wrong key renders as itself on screen. A desc row renders game.translate_string(text),
-- which returns its input when nothing matches, so a computed sentence renders verbatim.

-- Register_Image does not apply width_factor: a square request renders as an ellipse.
-- Widths are corrected by (4:3) / screen aspect, 0.75 at 16:9.
local function aspect()
    local f = 0.75
    local okd, dw, dh = pcall(function() return device().width, device().height end)
    if okd and dw and dh and dh > 0 then
        f = (1024 / 768) / (dw / dh)
    end
    return f
end

-- A captioned option keeps its string key regardless of page.
local function opt(t)
    if t.type == "check" or t.type == "list" or t.type == "track" then
        t.hint = t.hint or ("seasons_zone_" .. t.id)
    end
    return t
end

local function desc(out, id, text, bright)
    out[#out + 1] = {id = id, type = "desc", text = text,
                     clr = bright and {255, 255, 255, 255} or {255, 165, 165, 165}}
end

local function has_season(seasons_str, s)
    for tok in tostring(seasons_str):gmatch("[^,%s]+") do
        if tok == s then return true end
    end
    return false
end

-- Today's date, and a line when a pinned season disagrees with the calendar.
local function calendar_rows(out)
    local ok, rows = pcall(function() return zzz_seasons_of_the_zone.calendar_rows() end)
    if not (ok and rows) then
        out[#out + 1] = {id = "desc_cal_err", type = "desc",
                         text = "ui_mcm_seasons_zone_desc_cal_unavailable"}
        return
    end
    for i, r in ipairs(rows) do
        desc(out, "desc_cal_" .. i, r.text, r.current)
    end
end

-- The dropdown of presets, shared by every season page and the neutral picker.
local function preset_choices()
    local okp, c = pcall(function() return zzz_seasons_of_the_zone.preset_choices() end)
    return (okp and c) or {{"builtin", "Built-in"}}
end

-- Main page: the calendar, the global settings, the launch-time master switches.
local function page_main()
    local gr = {}
    local function add(t) gr[#gr + 1] = opt(t) end

    add({id = "desc_top", type = "desc", text = "ui_mcm_seasons_zone_desc_top"})
    add({id = "line_cal1", type = "line"})
    calendar_rows(gr)
    local ok, tex = pcall(function() return zzz_seasons_of_the_zone.dial_texture() end)
    if ok and tex then
        local H = 268
        local W = math.floor(H * aspect() + 0.5)
        local x = math.floor((547 - W) / 2 - 27 + 0.5)   -- centered in the ~547-wide panel
        add({id = "dial", type = "image", link = tex,
             size = {W, H}, pos = {x > 0 and x or 0, 0}, stretch = true})
    end
    add({id = "line_cal2", type = "line"})

    add({id = "enabled", type = "check", val = 1, def = true})
    add({id = "mode", type = "list", val = 0, def = "auto", content = {
        {"auto", "auto"}, {"spring", "spring"}, {"summer", "summer"},
        {"autumn", "autumn"}, {"winter", "winter"}, {"winter_snow", "winter_snow"},
    }})
    add({id = "blend_days", type = "track", val = 2, min = 0, max = 30, step = 1, def = 14})
    add({id = "intensity", type = "track", val = 2, min = 0.0, max = 1.0, step = 0.05, def = 1.0})
    -- neutral is the intensity-0 baseline, not a season, so its preset lives here
    add({id = "preset_neutral", type = "list", val = 0, def = "builtin",
         no_str = true, content = preset_choices()})

    add({id = "line1", type = "line"})
    add({id = "do_grade", type = "check", val = 1, def = true})
    add({id = "do_flora", type = "check", val = 1, def = true})
    add({id = "do_fog",   type = "check", val = 1, def = true})
    add({id = "do_wind",  type = "check", val = 1, def = true})
    add({id = "do_wet",   type = "check", val = 1, def = true})

    add({id = "line2", type = "line"})
    -- launch-time master switches; the per-season mod ticks are on the season pages
    add({id = "stage_textures", type = "check", val = 1, def = true})
    add({id = "stage_sound", type = "check", val = 1, def = true})

    add({id = "line_rem", type = "line"})
    -- Days of remembrance: April 26 and December 14. Each is a day laid over
    -- whatever season is running; none of these touch the season layers.
    add({id = "rem_weather", type = "check", val = 1, def = true})
    add({id = "rem_messages", type = "check", val = 1, def = true})
    -- the four mainline release dates; a line on the PDA and nothing else
    add({id = "rem_anniversary", type = "check", val = 1, def = true})
    add({id = "rem_ann_weather", type = "check", val = 1, def = true})
    add({id = "rem_ann_artefacts", type = "check", val = 1, def = true})

    add({id = "line3", type = "line"})
    add({id = "notify", type = "check", val = 1, def = true})
    add({id = "pda_greeting", type = "check", val = 1, def = true})
    add({id = "pda_delay", type = "track", val = 2, min = 3, max = 60, step = 1, def = 12})
    return gr
end

-- A season page: a colored bar, the preset dropdown, the resolved read-out, and the
-- texture mods active in this season (each with its own tick for this season).
local function page_season(s, choices, info)
    local gr = {}
    local function add(t) gr[#gr + 1] = opt(t) end

    local bar_w = math.floor(520 * aspect() + 0.5)
    gr[#gr + 1] = {id = "hdr", type = "image", link = "ui_season_hdr_" .. s,
                   size = {bar_w, 10}, pos = {0, 0}, stretch = true}

    add({id = "preset", type = "list", val = 0, def = "builtin",
         no_str = true, content = choices, hint = "seasons_zone_preset"})

    add({id = "line_ro", type = "line"})
    local okr, rows = pcall(function() return zzz_seasons_of_the_zone.season_readout(s) end)
    if okr and rows then
        for i, line in ipairs(rows) do desc(gr, "ro_" .. i, line, false) end
    end

    add({id = "line_mods", type = "line"})
    local mine = {}
    if info and info.mods then
        for _, m in ipairs(info.mods) do
            if has_season(m.seasons, s) then mine[#mine + 1] = m end
        end
    end
    if #mine == 0 then
        desc(gr, "desc_nomods", "No texture mods are set for this season.", false)
    else
        desc(gr, "desc_mods", "Texture mods for this season - untick to leave one out here:", false)
        for _, m in ipairs(mine) do
            add({id = "mod_" .. m.key, type = "check", val = 1, def = true,
                 hint = "seasons_zone_mod_" .. m.key})
        end
    end
    return gr
end

function on_mcm_load()
    local choices = preset_choices()
    local okm, info = pcall(function() return zzz_seasons_of_the_zone.mod_list() end)
    if not okm then info = nil end

    local seasons = {}
    for _, s in ipairs({"spring", "summer", "autumn", "winter", "winter_snow"}) do
        seasons[#seasons + 1] = {id = s, sh = true,
            text = "ui_mcm_seasons_zone_page_" .. s, gr = page_season(s, choices, info)}
    end

    op = {id = "seasons_zone", sh = false, gr = {
        {id = "main", sh = true, text = "ui_mcm_seasons_zone_page_main", gr = page_main()},
        seasons[1], seasons[2], seasons[3], seasons[4], seasons[5],
    }}
    return op
end
