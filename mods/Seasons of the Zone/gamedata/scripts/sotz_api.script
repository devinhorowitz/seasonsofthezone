-- Seasons of the Zone - the public read API.
--
-- Everything else in this mod is internal and may be rearranged. THIS file is the
-- contract: a small, cheap, side-effect-free surface that other mods can read to put the
-- Zone's schedule on a wrist device, a HUD, a custom PDA page, or anything else, without
-- opening ours.
--
-- X-Ray gives every .script file its own table, exposed to other files under the FILE's
-- name. So a consumer calls:
--
--     local t = sotz_api.temperature()
--     local b = sotz_api.blowout()
--
-- never the bare function name. (The Wearable Devices PDA Messages mod documents the same
-- rule the hard way in zz_wd_pda_redirect.script.)
--
-- Contract:
--   * Every function is a pure read. Nothing here changes game state.
--   * Nothing throws. A missing manager, a missing mod, a save loaded before the world is
--     up - all return nil or a marked "unknown", never an error.
--   * Everything is cached for CACHE_MS, so a device may call these every frame.
--   * VERSION only goes up, and only when a field changes meaning. New fields are added
--     without a bump, so check `>=`, not `==`.

VERSION = 1

local CACHE_MS = 2000
local cache = {}

-- time_global() is real milliseconds since launch, which is what a frame-rate cache
-- wants; game time would stretch and compress with the time factor.
local function cached(key, build)
    local now = 0
    local ok, t = pcall(time_global)
    if ok and type(t) == "number" then now = t end

    local hit = cache[key]
    if hit and (now - hit.at) < CACHE_MS then return hit.val end

    local good, val = pcall(build)
    if not good then val = nil end
    cache[key] = {at = now, val = val}
    return val
end

--- Drop everything cached, so the next read is fresh.
-- The page calls this after writing the units option: without it the repaint returns the
-- value that was just replaced, and the button looks like it did nothing.
function flush()
    cache = {}
end

-- =========================================================================================
-- Temperature
-- =========================================================================================
--
-- There is no ambient temperature anywhere in Anomaly or GAMMA - every "thermal" in the
-- install is a thermal anomaly or a thermal scope. So this is a MODEL, and it says so:
-- every reading carries source = "model". It is not a sensor reading dressed up as one.
--
-- What it models is the real Zone. The daily high and low come from climate normals for
-- the Polesia region around Chornobyl, interpolated between months so nothing jumps on
-- the 1st - or for the place picked in configure.bat, whose own normals fetch_weather.py
-- leaves in season_weather.ltx. The mod already runs its calendar on real dates, so the
-- real month is the right input.
--
-- The curve between those two is driven by the GAME clock, not the real one. The day is
-- accelerated, so a fixed number would be wrong twice over - it would ignore the night,
-- and it would move at the wrong speed. Minimum sits just before dawn and maximum in the
-- middle of the afternoon, and the rise is steeper than the fall, which is how a real day
-- actually behaves.
--
-- Highs and lows are published alongside the current value on purpose. A consumer that
-- wants a band, a gauge or a "feels like" has the endpoints; one that wants a number has
-- `now`. Nothing has to re-derive the model to draw something different.

-- mean daily high / low in Celsius, by month, for the Chornobyl area. Approximate
-- normals, not a live reading - see source = "model".
local NORMALS = {
    {-2, -8}, {-1, -8}, {5, -3}, {14, 3},  {20, 9},  {23, 13},
    {25, 14}, {24, 13}, {18, 9}, {12, 4},  {4, -1},  {-1, -6},
}

-- Named bands, in Celsius. Temperature drives nothing in Anomaly - there is no ambient
-- temperature in the engine at all - which is exactly what makes it a good hook: a mod
-- can take these and decide what they mean. Ice on the puddles below freezing, melt on a
-- freeze-thaw day, stamina in the heat, appetite in the cold.
local BANDS = {
    {-99, 0,  "freezing"},
    {0,   8,  "cold"},
    {8,   18, "mild"},
    {18,  26, "warm"},
    {26,  99, "hot"},
}

local function band_for(c)
    for i = 1, #BANDS do
        if c < BANDS[i][2] then return BANDS[i][3] end
    end
    return "hot"
end

local T_MIN_HOUR = 5.0        -- coldest, just before dawn
local T_MAX_HOUR = 15.0       -- warmest, mid afternoon

-- What the in-game sky does to the day. The real Zone decides what kind of day it is;
-- Atmospherics decides what this hour of it feels like. Cloud holds heat in at night and
-- keeps it out by day, so it squeezes the swing toward the mean; rain and storms drag the
-- whole day down on top of that, which is the variance a player actually feels when the
-- weather turns on them.
local WEATHER_T = {
    clear  = {swing = 1.00, offset =  0.0},
    partly = {swing = 0.88, offset = -0.3},
    cloudy = {swing = 0.65, offset = -1.0},
    foggy  = {swing = 0.55, offset = -1.5},
    rain   = {swing = 0.55, offset = -2.5},
    storm  = {swing = 0.50, offset = -3.5},
}

-- --- the real Zone ----------------------------------------------------------------------
--
-- _tools/fetch_weather.py leaves today's observed high and low in season_weather.ltx,
-- fetched from open-meteo for Chornobyl. Only the ENDPOINTS are taken: the curve between
-- them stays modeled, because the game's day runs six times real time and the sky above
-- the player belongs to Atmospherics rather than to Ukraine.
--
-- The file is read through ini_file, which is the engine's own parser and therefore
-- section-aware - [weather] and [weather_next] carry the same key names, and a flat read
-- would quietly hand back tomorrow's numbers as today's.
--
-- A reading more than a day old is ignored. Stale observations are worse than none: they
-- look authoritative and describe a day that has been and gone.
local OBS_MAX_AGE_DAYS = 1

-- Days between two calendar dates, via os.time rather than by subtracting packed
-- YYYYMMDD integers. The packed form makes 31 August and 1 September look 70 apart, so
-- a reading fetched last night would be thrown away every month end - the fallback is
-- safe, but real weather would quietly stop working once a month and nothing would say
-- why. Noon avoids any daylight-saving edge.
local function day_diff(y, m, d)
    local ok, n = pcall(function()
        local a = os.time({year = y, month = m, day = d, hour = 12})
        local now = os.date("*t")
        local b = os.time({year = now.year, month = now.month, day = now.day, hour = 12})
        return (b - a) / 86400
    end)
    if ok and type(n) == "number" then return n end
    return nil
end

local function parse_ymd(s)
    local y, m, d = tostring(s or ""):match("^(%d+)-(%d+)-(%d+)$")
    if not y then return nil end
    return tonumber(y), tonumber(m), tonumber(d)
end

-- {high, low, cycle, date, freezing} from the fetched file, or nil.
-- A place's name as fetch_weather.py writes it, "New_York": the engine's reader drops the
-- spaces in a value, so the file has an underscore for each.
local function spaced(v)
    if v == nil then return nil end
    return (tostring(v):gsub("_", " "))
end

local function observed()
    local ok, out = pcall(function()
        local ini = ini_file("season_weather.ltx")
        if not (ini and ini:section_exist("weather")) then return nil end
        local hi = ini:r_float_ex("weather", "high")
        local lo = ini:r_float_ex("weather", "low")
        if not (hi and lo) then return nil end

        local y, m, d = parse_ymd(ini:r_string_ex("weather", "date"))
        if y then
            local age = day_diff(y, m, d)
            if age == nil then return nil end
            if age > OBS_MAX_AGE_DAYS or age < -OBS_MAX_AGE_DAYS then return nil end
        end

        return {
            high  = hi,
            low   = lo,
            cycle = ini:r_string_ex("weather", "cycle"),
            date  = ini:r_string_ex("weather", "date"),
            place = spaced(ini:r_string_ex("weather", "place")),
        }
    end)
    if ok then return out end
    return nil
end

-- A place of the player's own: its name and monthly normals, from the [place] and
-- [normals] sections fetch_weather.py writes, m1 to m12 each "high, low". nil for
-- Chornobyl, whose normals are the table above, and for anything short of twelve months.
local function place_normals()
    local ok, out = pcall(function()
        local ini = ini_file("season_weather.ltx")
        if not (ini and ini:section_exist("normals")) then return nil end
        local t = {}
        for m = 1, 12 do
            local v = ini:r_string_ex("normals", "m" .. m)
            local hi, lo = tostring(v or ""):match("^%s*(%-?[%d%.]+)%s*,%s*(%-?[%d%.]+)%s*$")
            hi, lo = tonumber(hi), tonumber(lo)
            if not (hi and lo) or lo > hi then return nil end
            t[m] = {hi, lo}
        end
        t.place = ini:section_exist("place") and spaced(ini:r_string_ex("place", "name"))
                  or nil
        return t
    end)
    if ok then return out end
    return nil
end

local function month_normals(table_)
    local normals = table_ or NORMALS
    local now = os.date("*t")
    local m = now.month
    local days = tonumber(os.date("%d")) or 15
    -- slide toward the neighboring month across the month, so 31 Jan is nearly February
    local span = 30.0
    local f = (days - 15) / span
    local other = m
    if f >= 0 then other = (m % 12) + 1 else other = ((m - 2) % 12) + 1; f = -f end
    f = math.min(f, 1.0)

    local a, b = normals[m], normals[other]
    if not (a and b) then return 10, 0 end
    return a[1] + (b[1] - a[1]) * f, a[2] + (b[2] - a[2]) * f
end

-- 0 at the daily minimum, 1 at the daily maximum. Asymmetric: the ten hours of warming
-- are compressed against fourteen of cooling.
local function diurnal(hour)
    local rise = T_MAX_HOUR - T_MIN_HOUR
    local fall = 24.0 - rise
    local h = hour % 24
    if h >= T_MIN_HOUR and h < T_MAX_HOUR then
        return 0.5 - 0.5 * math.cos(math.pi * (h - T_MIN_HOUR) / rise)
    end
    local x = ((h - T_MAX_HOUR) % 24) / fall
    return 0.5 + 0.5 * math.cos(math.pi * x)
end

local function game_hour()
    local ok, h, m = pcall(function()
        return level.get_time_hours(), level.get_time_minutes()
    end)
    if ok and type(h) == "number" then return h + (tonumber(m) or 0) / 60.0 end
    return 12.0
end

-- The current weather cycle, straight from Atmospherics. nil when it is not running.
local function cycle_now()
    local ok, c = pcall(function()
        if not (level_weathers and level_weathers.get_weather_manager) then return nil end
        local wm = level_weathers.get_weather_manager()
        return wm and wm.cycle
    end)
    if ok then return c end
    return nil
end

-- Celsius or Fahrenheit, from the MCM option the page's button also writes. One stored
-- value, so a page preference can never shadow a menu preference.
local function want_f()
    local ok, v = pcall(function()
        return ui_mcm and ui_mcm.get and ui_mcm.get("seasons_zone/main/units")
    end)
    return ok and (v == "fahrenheit" or v == 1) or false
end

local function to_f(c)
    return c * 9.0 / 5.0 + 32.0
end

--- Modeled air temperature.
-- @return {low, high, now, hour, rising, cycle, unit = "C", source = "model"}
--         low/high are today's endpoints AFTER the weather adjustment, so a consumer can
--         draw a band without knowing anything about the model. `rising` is true while
--         the curve is climbing, which is what a device needs to draw an arrow.
function temperature()
    return cached("temperature", function()
        -- The base: the real Zone's reading when there is one, climate normals for the
        -- region when there is not.
        local obs = observed()
        local own = not obs and place_normals() or nil
        local base_high, base_low
        if obs then
            base_high, base_low = obs.high, obs.low
        else
            base_high, base_low = month_normals(own)
        end

        -- Then the in-game sky moves it. This is the blend: an observation says what kind
        -- of day it is, Atmospherics says what standing in it costs you. Without this the
        -- temperature was real but inert - unchanged by the storm you are stood in.
        local mean = (base_high + base_low) / 2.0
        local w = WEATHER_T[tostring(cycle_now() or "")] or WEATHER_T.partly
        local high = mean + (base_high - mean) * w.swing + w.offset
        local low  = mean - (mean - base_low)  * w.swing + w.offset

        local h = game_hour()
        local f = diurnal(h)
        local hh = h % 24
        local rising = (hh >= T_MIN_HOUR and hh < T_MAX_HOUR)

        -- the next 24 hours of the curve, one sample an hour starting now, so a page
        -- can plot the day without re-deriving the model and drifting from `now`
        local curve = {}
        for i = 0, 23 do
            curve[#curve + 1] = low + (high - low) * diurnal(h + i)
        end

        local now_c = low + (high - low) * f

        -- Every flag is decided in Celsius BEFORE any conversion: zero is a property of
        -- water, not of the unit the player happens to be reading.
        local is_freezing, is_frost = now_c <= 0.0, low <= 0.0
        -- A freeze-thaw day: it went below zero and it will come back above. That pair,
        -- not the freeze alone, is what a melt effect actually wants to key off.
        local is_thaw = is_frost and high > 0.0
        local band_now = band_for(now_c)

        -- what the station alone would have said at this hour, for the gap below
        local base_now_c = base_low + (base_high - base_low) * f
        local base_low_out, base_high_out = base_low, base_high

        local unit = "C"
        if want_f() then
            unit = "F"
            low, high, now_c = to_f(low), to_f(high), to_f(now_c)
            base_low_out, base_high_out = to_f(base_low_out), to_f(base_high_out)
            base_now_c = to_f(base_now_c)
            for i = 1, #curve do curve[i] = to_f(curve[i]) end
        end

        return {
            low    = math.floor(low + 0.5),
            high   = math.floor(high + 0.5),
            now    = math.floor(now_c + 0.5),
            hour   = h,
            rising = rising,
            curve  = curve,
            cycle  = cycle_now(),
            unit   = unit,
            -- the station's own numbers, before the in-game sky moved them. Published so
            -- a consumer can show the base, the adjusted value, or the gap between them,
            -- and never has to guess which one it is holding.
            base_low  = math.floor(base_low_out + 0.5),
            base_high = math.floor(base_high_out + 0.5),
            sky_shift = math.floor((now_c - base_now_c) + 0.5),
            -- "observed" means the endpoints came from the real Chornobyl; the shape
            -- between them is modeled either way, and no consumer should read this as
            -- an in-game sensor.
            source = obs and "observed" or "model",
            -- where the reading is from, or, modeled, whose climate the model is: nil for
            -- Chornobyl's built-in normals
            place  = obs and obs.place or (own and own.place) or nil,
            date   = obs and obs.date or nil,
            real_cycle = obs and obs.cycle or nil,
            -- the two hooks worth hanging a mod off
            band     = band_now,              -- freezing / cold / mild / warm / hot
            freezing = is_freezing,           -- it is below zero right now
            frost    = is_frost,              -- the day dips below zero at some point
            thaw     = is_thaw,               -- it froze and will rise above zero again
        }
    end)
end

--- Tomorrow, as the real Zone expects it.
-- @return {date, high, low, cycle, frost} or nil when there is no fetched file.
--
-- Observations only - there is no modeled fallback here on purpose. A modeled "today"
-- is a reasonable stand-in for a reading, because the shape of a day in this region is
-- genuinely predictable. A modeled "tomorrow" would be the same curve with a different
-- label, which is not a forecast of anything.
function tomorrow()
    return cached("tomorrow", function()
        local ok, out = pcall(function()
            local ini = ini_file("season_weather.ltx")
            if not (ini and ini:section_exist("weather_next")) then return nil end
            local hi = ini:r_float_ex("weather_next", "high")
            local lo = ini:r_float_ex("weather_next", "low")
            if not (hi and lo) then return nil end
            -- a file from an earlier day holds that day's tomorrow: not ours
            local y, m, d = parse_ymd(ini:r_string_ex("weather_next", "date"))
            local ago = y and day_diff(y, m, d)
            if not ago or math.floor(ago + 0.5) ~= -1 then return nil end
            local frost = lo <= 0.0          -- decided in Celsius, as above
            local unit = "C"
            if want_f() then
                unit, hi, lo = "F", to_f(hi), to_f(lo)
            end
            return {
                date  = ini:r_string_ex("weather_next", "date"),
                high  = math.floor(hi + 0.5),
                low   = math.floor(lo + 0.5),
                cycle = ini:r_string_ex("weather_next", "cycle"),
                unit  = unit,
                frost = frost,
            }
        end)
        if ok then return out end
        return nil
    end)
end

-- =========================================================================================
-- Weather
-- =========================================================================================

--- What it is doing now and what it does next.
-- @return {now, next = {cycle, at, away_min}, plan = {…}, forecast = {…}, odds = {…}}
--         or nil without a weather manager.
--         `next` and `plan` are not predictions: Atmospherics plans the next 24 game hours
--         in WeatherManager.day_plan and this reads that plan, so `at` is when it will
--         actually change. Repeats of the current cycle are not changes and are skipped.
--         `forecast` is the same plan as the PDA page calls it by default: rounded times,
--         about one call in ten wrong, and `chance` (percent) on each. Use it to show
--         the player what their PDA shows; use `plan` to act on the weather.
--         `odds` is stock only: {cycle, chance (0-1)} for each sky the next change can
--         bring, exact, since the stock scheduler draws it at random from that list.
function weather()
    return cached("weather", function()
        local page = zzz_seasons_of_the_zone.forecast_page()
        if not (page and page.weather) then return nil end
        local w = page.weather
        return {
            now  = w.now,
            next = w.segments and w.segments[1] and {
                cycle    = w.segments[1].cycle,
                at       = w.segments[1].at,
                away_min = w.segments[1].away,
            } or nil,
            plan = w.segments,
            -- "plan": Atmospherics' day planner, and `plan` is every change ahead.
            -- "stock": base Anomaly, which is what GAMMA ships. It knows when the sky
            --          turns but picks what it turns into at random at that moment, so
            --          `next` is nil and `window` = {lo, hi} game minutes says when.
            -- An empty plan with source "plan" is a settled day. With "stock" it is not.
            source = w.source,
            window = w.window,
            forecast = w.forecast,
            odds = w.odds,
        }
    end)
end

-- =========================================================================================
-- Blowout
-- =========================================================================================

-- Where each LIMITED bracket sits on a 0-1 gauge. Must track the bracket text in
-- zzz_seasons_of_the_zone.forecast_page(); a key that stops matching does not fail, it
-- quietly returns the fallback.
local BRACKET_AT = {
    ["WITHIN 2 HOURS"] = 0.06,
    ["2 to 8 hours"]   = 0.20,
    ["8 to 16 hours"]  = 0.50,
    ["ALL CLEAR"]      = 0.85,
}

--- Time to the next emission and psi storm, at the resolution the player has earned.
-- @return {tier, standing, need, need_exact,
--          emission = {seconds|band}, psi = {seconds|band}}
--
--         tier is "locked", "coarse" or "exact".
--           locked - the ecologists do not share. `seconds` and `band` are both nil, and a
--                    consumer MUST NOT infer anything from that; showing a blank is the
--                    point.
--           coarse - `band` is "ALL CLEAR", "8 to 16 hours", "2 to 8 hours" or
--                    "WITHIN 2 HOURS". A bracket, deliberately; never the hour.
--           exact  - `seconds` is game seconds to the event.
--
--         `fraction` is present on every unlocked tier: 0 at the event, 1 a full period
--         away. That is the field to drive a gauge, a bar or a pulse rate from - it needs
--         no unit conversion and it stays correct when the frequency option moves.
--         wd_sensor_pulse.get_delay(1 - fraction, min, max) is a blowout sensor.
function blowout()
    return cached("blowout", function()
        local page = zzz_seasons_of_the_zone.forecast_page()
        if not (page and page.forecast) then return nil end
        local f = page.forecast

        local function part(seconds, band, key, fallback, alert)
            local out = {seconds = seconds, band = band, alert = alert and true or false}
            if seconds then
                local ok, hours = pcall(function() return ui_options.get(key) end)
                if not (ok and type(hours) == "number" and hours > 0) then hours = fallback end
                out.fraction = math.min(1.0, seconds / (hours * 3600))
            elseif band then
                -- The coarse tier deliberately has no number, but a gauge still needs
                -- somewhere to sit, so each bracket maps to its own midpoint.
                --
                -- These keys have to track the brackets in forecast_page(). When the
                -- bands were renamed this table was left behind, and every coarse
                -- reading silently fell through to 0.70 - a needle pinned near "quiet"
                -- while the panel beside it read WITHIN 2 HOURS.
                out.fraction = BRACKET_AT[tostring(band)] or 0.70
            end
            return out
        end

        return {
            tier       = f.tier,
            standing   = f.standing,
            need       = f.need,
            need_exact = f.need_exact,
            -- `alert` is the field a wearable device wants: one boolean, already gated
            -- by tier, true when an emission is close enough to act on. Re-deriving it
            -- from `seconds` would drift out of step with the page the moment either
            -- threshold moved.
            emission   = part(page.surge, page.surge_band,
                              "alife/event/emission_frequency", 24, page.surge_alert),
            psi        = part(page.psi, page.psi_band,
                              "alife/event/psi_storm_frequency", 48, page.psi_alert),
        }
    end)
end

-- =========================================================================================
-- Calendar
-- =========================================================================================

--- Where the year stands, and whether today is one of the days the Zone marks.
-- @return {season, label, today, next = {label, days}, marked = {kind, key}}
function calendar()
    return cached("calendar", function()
        local page = zzz_seasons_of_the_zone.calendar_page()
        if not page then return nil end
        return {
            season = page.season,
            label  = page.label,
            today  = page.today,
            next   = page.next,
            marked = page.marked,
        }
    end)
end
