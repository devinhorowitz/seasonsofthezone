-- Seasons of the Zone
--
-- Sets the engine's light, foliage, fog, wind and wetness values from the real-world
-- date, mapped to the seasons of Polesia. Reads the date with os.date(), the values from
-- configs/seasons_of_the_zone.ltx, and drives the console directly.
--
-- Textures cannot follow: the engine loads them at level load and keeps them for the
-- session. _tools/season.py handles those before launch.
--
-- SSS's own scripts push their MCM values at game start and on every option change, so
-- applying once would be overwritten. This re-checks the engine every few seconds and
-- re-asserts only what drifted.
--
-- The engine rejects a whole console command if any component is out of range, and the
-- only trace is one "~ Invalid syntax in call to ..." log line; the old value stays. So
-- every value is clamped before sending, read back after, and a refusal (the value did
-- not move) is told from drift (something else changed it). A refused value is given up
-- on after a few tries instead of being retried forever.

local CFG        = "seasons_of_the_zone.ltx"
local PREFIX     = "seasons_zone/"
local CHECK_MS   = 5000      -- how often to re-assert drifted uniforms
local DATE_MS    = 600000    -- how often to re-read the calendar (long sessions, midnight)
local GIVE_UP    = 5         -- consecutive refusals before we stop retrying a uniform

-- Season starts for Polesia: the dates the landscape changes, not the equinoxes.
-- Month/day, converted per year so leap years stay exact. Winter comes in three parts:
-- snow starts falling in November, settles from December, and thaws through March into
-- mud before anything turns green. In date order; the last one wraps the year end.
local BOUNDS = {
    {m = 3,  d = 5,  season = "late_winter"},  -- 41d,  thaw: patchy snow, mud, bare trees
    {m = 4,  d = 15, season = "spring"},       -- 35d,  green-up
    {m = 5,  d = 20, season = "summer"},       -- 118d, full foliage
    {m = 9,  d = 15, season = "autumn"},       -- 47d,  the turn, peaking in October
    {m = 11, d = 1,  season = "winter"},       -- 30d,  first snowfall, bare ground
    {m = 12, d = 1,  season = "winter_snow"},  -- 94d,  cover (wraps the year end)
}
-- A player's own calendar (configure.bat) replaces these; see read_calendar() below.

-- The six seasons in the order MCM lists them
local SEASON_KEYS = {"spring", "summer", "autumn", "winter", "winter_snow", "late_winter"}

-- Engine ranges, from the SSS MCM sliders. A value outside these is clamped and logged.
local RANGES = {
    saturation = {0.0, 2.0}, gamma = {0.0, 2.0}, exposure = {0.0, 2.0},
    spec_grass = {0.0, 1.0}, spec_grass_wet = {0.0, 1.0},
    spec_trees = {0.0, 1.0}, spec_trees_wet = {0.0, 1.0},
    sss_int = {0.0, 10.0}, sss_color = {0.0, 1.0},
    fog_height = {0.0, 20.0}, fog_density = {0.0, 5.0},
    fog_suncolor = {0.0, 1.0}, fog_scattering = {0.0, 1.0},
    wind_grass_speed = {0.1, 13.0}, wind_grass_turbulence = {0.1, 3.0},
    wind_grass_push = {0.1, 3.0}, wind_grass_wave = {0.1, 1.0},
    wind_trees_speed = {0.1, 13.0}, wind_trees_trunk = {0.1, 0.3},
    wind_trees_bend = {0.1, 2.0}, wind_min_speed = {0.0, 1.0},
    wet_buildup = {0.1, 20.0}, wet_dry = {0.1, 20.0},
}

-- keys  : config keys to interpolate, in component order
-- pad   : trailing zeros the command needs but we do not drive
-- check : how many leading components to verify on readback
-- layer : which MCM toggle owns it
local UNIFORMS = {
    {name = "r__color_grading",      layer = "grade", keys = {"grade_r", "grade_g", "grade_b"}},
    {name = "r__saturation",         layer = "grade", keys = {"saturation"}},
    {name = "r__gamma",              layer = "grade", keys = {"gamma"}},
    {name = "r__exposure",           layer = "grade", keys = {"exposure"}},
    {name = "r2_sun_lumscale",       layer = "grade", keys = {"sun_lumscale"}},
    {name = "r2_sun_lumscale_hemi",  layer = "grade", keys = {"sun_lumscale_hemi"}},
    {name = "r2_sun_lumscale_amb",   layer = "grade", keys = {"sun_lumscale_amb"}},
    {name = "r2_tonemap_adaptation", layer = "grade", keys = {"tonemap_adaptation"}},
    {name = "r2_tonemap_lowlum",     layer = "grade", keys = {"tonemap_lowlum"}},
    {name = "r2_tonemap_middlegray", layer = "grade", keys = {"tonemap_middlegray"}},
    {name = "ssfx_hud_hemi",         layer = "grade", keys = {"hud_hemi"}},
    {name = "r2_sunshafts_value",    layer = "grade", keys = {"sunshafts_value"}},

    {name = "ssfx_florafixes_1", layer = "flora",
     keys = {"spec_grass", "spec_grass_wet", "spec_trees", "spec_trees_wet"}},
    {name = "ssfx_florafixes_2", layer = "flora", keys = {"sss_int", "sss_color"}, pad = 2},

    -- Held at zero: it is a hue rotation, not a tint, and turns foliage red and blue.
    {name = "ssfx_floravariation", layer = "flora", const = {0, 0, 0, 0}},

    {name = "ssfx_fog", layer = "fog",
     keys = {"fog_height", "fog_density", "fog_suncolor"}, pad = 1},
    {name = "ssfx_fog_scattering", layer = "fog", keys = {"fog_scattering"}},

    {name = "ssfx_wind_grass", layer = "wind",
     keys = {"wind_grass_speed", "wind_grass_turbulence", "wind_grass_push", "wind_grass_wave"}},
    {name = "ssfx_wind_trees", layer = "wind",
     keys = {"wind_trees_speed", "wind_trees_trunk", "wind_trees_bend", "wind_min_speed"}},

    -- how fast surfaces take on water and how fast they dry
    {name = "ssfx_wetness_multiplier", layer = "wet",
     keys = {"wet_buildup", "wet_dry"}, pad = 1},
}

-- Dynamic Tonemap Extended sets these five on a timer. Fighting it would be a visible
-- pulse, so while its module is loaded they are left to it.
local DTE_OWNS = {
    r2_tonemap_adaptation = true, r2_tonemap_lowlum = true, r2_tonemap_middlegray = true,
    r2_sun_lumscale_amb = true, r2_sun_lumscale_hemi = true,
}
local dte_said   = false

local P          = nil   -- P[season][key] = number, loaded from the ltx
local want       = nil   -- resolved command list for the current blend
-- What apply() last resolved, {mode, season}, for the MCM panel: ui_mcm.get() cannot
-- be called while the panel is being built.
local live       = nil
local reasserts  = {}
local fails      = {}
local dead       = {}
local next_check = 0
local next_date  = 0
local last_label = nil

local function say(msg)
    printf("%s", "[seasons] " .. msg)
end

-- names of the player's own, from configure.bat; filled from season_calendar.ltx below
local NAMES = {}

-- A season's name inside a sentence, "deep winter": the player's own, or the string
-- table's. Config keys are not for the player.
local function name_of(s)
    return NAMES[s] or sotz_text.text("st_sotz_season_" .. tostring(s) .. "_mid")
end

-- The player's own name for a season, or nil: MCM titles a page with it, and falls back
-- to its own string for the usual name.
function season_name(s)
    return NAMES[s]
end

-- The same name as it starts a sentence or a line, "Deep winter". A name of the player's
-- own has the one form, so its first letter is raised.
local function cap(s)
    local v = NAMES[s]
    if v then return sotz_text.cap_first(v) end
    return sotz_text.text("st_sotz_season_" .. tostring(s))
end

-- "September 25, 2026". os.date("%B") depends on the Windows locale and renders as
-- garbage in the game's font outside English and Cyrillic locales, so the month's name
-- and where it goes are the string table's.
local function today_text()
    local t = zone_today()
    return sotz_text.date(t.month, t.day, t.year)
end

-- Options live on three MCM pages; the stored path is seasons_zone/<page>/<id>.
-- Options live on pages: the global settings on "main", each season's preset and mod
-- checkboxes on its own page. mcm() reads a main-page option; season_preset() a season's.
local function mcm_path(path, default)
    if ui_mcm and ui_mcm.get then
        local ok, v = pcall(ui_mcm.get, path)
        if ok and v ~= nil then return v end
    end
    return default
end

-- Goodwill buying forecast resolution, with the ecologists unless MCM picks another
-- faction. Goodwill is 1000 at friendly and starts near zero, so 200 is a few jobs done
-- for them and 700 is a real investment. Both are MCM tracks; these are only the defaults.
local FORECAST_COARSE = 200
local FORECAST_EXACT  = 700

-- The factions with a network to read, in the order "best of the three" breaks a tie.
local FORECAST_FACTIONS = {"ecolog", "csky", "isg"}

local function mcm(key, default)
    return mcm_path(PREFIX .. "main/" .. key, default)
end

local function goodwill(faction)
    local ok, v = pcall(function()
        return relation_registry.community_goodwill(faction, db.actor:id())
    end)
    if ok and type(v) == "number" then return v end
    return nil
end

-- The standing that buys the forecast, and the faction it is with: the one MCM picks, or
-- with "best" whichever of the three thinks most of the player. nil when it can't be read.
function forecast_standing()
    local pick = tostring(mcm("forecast_faction", "ecolog"))
    if pick ~= "best" then
        for _, f in ipairs(FORECAST_FACTIONS) do
            if f == pick then return goodwill(f), f end
        end
        return goodwill("ecolog"), "ecolog"
    end
    local best, from
    for _, f in ipairs(FORECAST_FACTIONS) do
        local v = goodwill(f)
        if v and (best == nil or v > best) then best, from = v, f end
    end
    return best, from or "ecolog"
end

-- The preset chosen for a season; neutral's lives on the main page.
local function season_preset(s)
    if s == "neutral" then return mcm_path(PREFIX .. "main/preset_neutral", "builtin") end
    return mcm_path(PREFIX .. s .. "/preset", "builtin")
end

-- A saved MCM value WITHOUT ui_mcm.get, which asserts during on_mcm_load (where the
-- read-out is built). vtype 0 = string.
local function cfg_raw(path, default)
    if axr_main and axr_main.config then
        local ok, v = pcall(function()
            return axr_main.config:r_value("mcm", path, 0, default)
        end)
        if ok and v ~= nil then return v end
    end
    return default
end

-- --- the day the seasons run on --------------------------------------------------------
--
-- The real date, as always; or, with MCM's Calendar set to the game's clock, the Zone's
-- own: the in-game date, run faster by "Zone days per game day" from the day the game
-- starts. The game writes that date to appdata\seasons_clock.txt as it saves and loads,
-- which play.bat reads to switch the season's mods, and which stands in for the in-game
-- date at the main menu, where there is none to read.
local CLOCK_FILE = "seasons_clock.txt"

-- An MCM value, from ui_mcm while it answers and from the saved options while it can't,
-- during on_mcm_load
local function main_option(key, default)
    local v = mcm_path(PREFIX .. "main/" .. key, nil)
    if v == nil then v = cfg_raw(PREFIX .. "main/" .. key, default) end
    return v
end

function clock_mode()
    return tostring(main_option("clock", "real")) == "game" and "game" or "real"
end

function clock_speed()
    local v = math.floor(tonumber(main_option("clock_speed", 1)) or 1)
    return math.max(1, math.min(30, v))
end

-- The in-game date and time, or nil where there is none: at the main menu, and while a
-- level loads. get_game_time() without a level is unsafe, which is MCM's own guard too.
local function game_date()
    local ok, here = pcall(function() return level.present() and db.actor ~= nil end)
    if not (ok and here) then return nil end
    local ok2, Y, M, D, h, mi = pcall(function()
        local y, mo, d, hh, mm, s, ms = 0, 0, 0, 0, 0, 0, 0
        return game.get_game_time():get(y, mo, d, hh, mm, s, ms)
    end)
    if ok2 and type(Y) == "number" and Y > 0 then return Y, M, D, h or 0, mi or 0 end
    return nil
end

-- The day the game starts, from alife.ltx: October 26, 2018 in GAMMA, the 25th in Anomaly.
local function game_start()
    local ok, v = pcall(function() return system_ini():r_string_ex("alife", "start_date") end)
    local d, m, y = tostring(ok and v or ""):match("(%d+)%.(%d+)%.(%d+)")
    if d then return tonumber(y), tonumber(m), tonumber(d) end
    return 2018, 10, 26
end

-- Game minutes from midnight on the day the game began to the in-game Y-M-D h:mi. The
-- days are counted noon to noon, which no daylight-saving hour can tip.
local function game_minutes(Y, M, D, h, mi)
    local sy, sm, sd = game_start()
    local t0 = os.time({year = sy, month = sm, day = sd, hour = 12})
    local t = os.time({year = Y, month = M, day = D, hour = 12})
    return math.floor((t - t0) / 86400 + 0.5) * 1440 + h * 60 + mi
end

-- The Zone's date for an in-game date: the same at speed 1, else the start date plus the
-- game days since its midnight times the speed.
local function zone_from_game(Y, M, D, h, mi, speed)
    if speed <= 1 then return Y, M, D end
    local sy, sm, sd = game_start()
    local days = math.floor(math.max(0, game_minutes(Y, M, D, h, mi)) * speed / 1440)
    local t = os.date("*t", os.time({year = sy, month = sm, day = sd, hour = 12}) + days * 86400)
    return t.year, t.month, t.day
end

local function clock_path()
    local ok, p = pcall(function() return getFS():update_path("$app_data_root$", CLOCK_FILE) end)
    return ok and p or nil
end

-- The Zone's date the game last wrote, for the main menu
local function read_clock()
    local p = clock_path()
    if not p then return nil end
    local ok, text = pcall(function()
        local f = io.open(p, "r")
        if not f then return nil end
        local s = f:read("*a")
        f:close()
        return s
    end)
    local y, m, d = tostring(ok and text or ""):match("zone%s*=%s*(%d%d%d%d)%-(%d%d)%-(%d%d)")
    if y then return tonumber(y), tonumber(m), tonumber(d) end
    return nil
end

-- The day the seasons run on, as os.date("*t") gives a day, with its day of the year in
-- yday, "YYYY-MM-DD" in iso and the clock it came from in clock: "real" or "game".
function zone_today()
    if clock_mode() == "game" then
        local Y, M, D, h, mi = game_date()
        local zy, zm, zd
        if Y then
            zy, zm, zd = zone_from_game(Y, M, D, h, mi, clock_speed())
        else
            zy, zm, zd = read_clock()
        end
        if zy then
            local t = os.date("*t", os.time({year = zy, month = zm, day = zd, hour = 12}))
            t.iso = string.format("%04d-%02d-%02d", zy, zm, zd)
            t.clock = "game"
            return t
        end
    end
    local t = os.date("*t")
    t.yday = tonumber(os.date("%j"))
    t.iso = os.date("%Y-%m-%d")
    t.clock = "real"
    return t
end

-- Game minutes until the day the seasons run on ends: real midnight at the game's time
-- factor, or the Zone's day turning.
function day_left_game_minutes()
    if clock_mode() == "game" then
        local Y, M, D, h, mi = game_date()
        if Y then
            local span = 1440 / clock_speed()
            return span - (math.max(0, game_minutes(Y, M, D, h, mi)) % span)
        end
    end
    local tf = 6
    pcall(function() tf = level.get_time_factor() end)
    local t = os.date("*t")
    return ((23 - t.hour) * 3600 + (59 - t.min) * 60 + (60 - t.sec)) * tf / 60
end

-- What play.bat reads: the Zone's date, written as the game saves and loads. Only with
-- the game's clock on, and never a save edit: the file sits beside the saves.
function write_clock()
    if clock_mode() ~= "game" then return false end
    local Y, M, D, h, mi = game_date()
    if not Y then return false end
    local speed = clock_speed()
    local zy, zm, zd = zone_from_game(Y, M, D, h, mi, speed)
    local p = clock_path()
    if not p then return false end
    local ok = pcall(function()
        local f = io.open(p, "w")
        if not f then error("can't write " .. p) end
        f:write("; Seasons of the Zone: the Zone's date when the game last saved or loaded.\n"
                .. "; play.bat reads it to switch the season's mods. Delete it at will.\n"
                .. string.format("zone = %04d-%02d-%02d\ngame = %04d-%02d-%02d %02d:%02d\n"
                                 .. "speed = %d\n", zy, zm, zd, Y, M, D, h, mi, speed))
        f:close()
    end)
    return ok
end

local function q(name)
    local ok, v = pcall(function() return get_console():get_string(name) end)
    return (ok and v) and tostring(v) or nil
end

local function nums(s)
    local t = {}
    for n in tostring(s or ""):gmatch("%-?%d+%.?%d*") do t[#t + 1] = tonumber(n) end
    return t
end

-- compare only the leading `count` components: the engine echoes 6 decimals and pads
local function matches(got, target, count)
    local a, b = nums(got), nums(target)
    if #a == 0 or #b == 0 then return false end
    for i = 1, math.min(count, #b) do
        if not a[i] or math.abs(a[i] - b[i]) > 0.0005 then return false end
    end
    return true
end

local function lerp(a, b, k) return a + (b - a) * k end

local function clamp(key, v)
    local r = RANGES[key]
    if not r then return v, false end
    if v < r[1] then return r[1], true end
    if v > r[2] then return r[2], true end
    return v, false
end

-- exact day-of-year for a month/day in a given year, leap years included
local function doy_of(m, d, year)
    return tonumber(os.date("%j", os.time({year = year, month = m, day = d, hour = 12})))
end

local function circ(delta, len)
    if delta >  len * 0.5 then delta = delta - len end
    if delta < -len * 0.5 then delta = delta + len end
    return delta
end

-- --- the player's calendar -----------------------------------------------------------
--
-- configure.bat can move the season starts and turn seasons off. play.bat, and saving in
-- the tool, write the result to season_calendar.ltx, with a dial drawn for those dates
-- when one could be drawn. With no file, custom = false, or anything that does not read
-- cleanly, the Polesia dates above stay.
local DIAL = "default"      -- "custom": redrawn for the player's dates; "none": no dial
local DIAL_YEAR = 2026      -- the year the dials are drawn for: no Feb 29
local MONTH_LEN = {31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31}
local MIN_SEASON_DAYS = 14  -- as season.py holds it: shorter has no dial position of its own
local NAME_CHARS = 20       -- the longest name season.py lets through

-- {key = value} from one section of the file, [calendar] unless `want` names another,
-- keys lower-cased; nil with no file. Read here rather than through ini_file(), because
-- the engine asserts on a malformed section line, and a typo in this one file must not
-- stop the game loading.
local function calendar_file(want)
    want = want or "calendar"
    local fs = getFS()
    if not fs:exist("$game_config$", "season_calendar.ltx") then return nil end
    local f = io.open(fs:update_path("$game_config$", "season_calendar.ltx"), "r")
    if not f then return nil end
    local src = f:read("*a") or ""
    f:close()
    local kv, section = {}, nil
    for raw in src:gmatch("[^\r\n]+") do
        local line = raw:gsub(";.*$", ""):match("^%s*(.-)%s*$")
        local sec = line:match("^%[%s*([%w_]+)%s*%]$")
        if sec then
            section = sec:lower()
        elseif section == want then
            local k, v = line:match("^([%w_]+)%s*=%s*(.-)$")
            if k then kv[k:lower()] = v end
        end
    end
    return kv
end

-- The starts in date order and the dial to use, or nil for Polesia's. Held to the same
-- rules season.py writes it by, since the file can be edited by hand.
local function read_calendar()
    local kv = calendar_file()
    if not kv then return nil end
    local custom = (kv.custom or ""):lower()
    if custom ~= "true" then
        if custom ~= "false" then
            say("!season_calendar.ltx: custom = " .. tostring(kv.custom) .. " is neither "
                .. "true nor false - keeping the Polesia calendar")
        end
        return nil
    end
    local known = {custom = true, dial = true, dial_sig = true}
    local out, seen = {}, {}
    for _, s in ipairs(SEASON_KEYS) do
        known[s] = true
        if kv[s] then
            local t = nums(kv[s])
            local m, d = t[1], t[2]
            if not (#t == 2 and m == math.floor(m) and d == math.floor(d) and MONTH_LEN[m]
                    and d >= 1 and d <= MONTH_LEN[m]) or seen[m * 100 + d] then
                say("!season_calendar.ltx: " .. s .. " has no usable start date - "
                    .. "keeping the Polesia calendar")
                return nil
            end
            seen[m * 100 + d] = true
            out[#out + 1] = {m = m, d = d, season = s}
        end
    end
    -- the player's own names; the file is cp1251, a byte a letter
    local names = {}
    for _, s in ipairs(SEASON_KEYS) do
        known["name_" .. s] = true
        local v = kv["name_" .. s]
        if v and v ~= "" then
            if #v > NAME_CHARS then
                say("!season_calendar.ltx: the name for " .. s .. " is longer than "
                    .. NAME_CHARS .. " letters - using the usual one")
            else
                names[s] = v
            end
        end
    end
    for k in pairs(kv) do
        if not known[k] then say("!season_calendar.ltx: ignoring '" .. k .. "'") end
    end
    if #out == 0 then
        say("!season_calendar.ltx: no season is on - keeping the Polesia calendar")
        return nil
    end
    table.sort(out, function(a, b) return a.m * 100 + a.d < b.m * 100 + b.d end)
    for i, b in ipairs(out) do
        local nxt = out[i % #out + 1]
        local len = (doy_of(nxt.m, nxt.d, DIAL_YEAR) - doy_of(b.m, b.d, DIAL_YEAR)) % 365
        if #out > 1 and len < MIN_SEASON_DAYS then
            say("!season_calendar.ltx: " .. b.season .. " would last " .. len .. " days - "
                .. "keeping the Polesia calendar")
            return nil
        end
    end
    local dial = (kv.dial or ""):lower() == "custom" and "custom" or "none"
    if dial == "custom" and not getFS():exist("$game_textures$",
                                               string.format("ui_seasons_dial_c%02d.dds", 0)) then
        say("!season_calendar.ltx: the dial drawn for it is missing - run play.bat to draw it")
        dial = "none"
    end
    return out, dial, names
end

-- at load, and never fatal: a file that cannot be read leaves Polesia's calendar running
local ok_cal, cal_bounds, cal_dial, cal_names = pcall(read_calendar)
if not ok_cal then
    say("!season_calendar.ltx could not be read (" .. tostring(cal_bounds)
        .. ") - keeping the Polesia calendar")
elseif cal_bounds then
    BOUNDS, DIAL, NAMES = cal_bounds, cal_dial, cal_names
end

local function is_on(s)
    for _, b in ipairs(BOUNDS) do
        if b.season == s then return true end
    end
    return false
end

-- The seasons that are on, in the order MCM lists them
function enabled_seasons()
    local out = {}
    for _, s in ipairs(SEASON_KEYS) do
        if is_on(s) then out[#out + 1] = s end
    end
    return out
end

-- The MCM pin, or "auto". A pin on a season the calendar has since turned off has no
-- dates to stand on, so it counts as automatic; MCM's list shows it as automatic too.
local function pinned()
    local mode = mcm("mode", "auto")
    if mode ~= "auto" and not is_on(mode) then return "auto" end
    return mode
end

-- The spell play.bat found for the day it staged, when the spell brings a season:
-- {season, name, first, last}, the days as "YYYY-MM-DD". nil when there is none.
local function read_spell()
    local kv = calendar_file("spell")
    if not kv or not kv.season then return nil end
    local s, first, last = kv.season:lower(), kv.first or "", kv.last or ""
    -- a real day, "YYYY-MM-DD": the message and MCM put its month and day on screen
    local function day(v)
        local y, m, d = v:match("^(%d%d%d%d)%-(%d%d)%-(%d%d)$")
        m, d = tonumber(m), tonumber(d)
        return y and MONTH_LEN[m] and d >= 1 and d <= MONTH_LEN[m] + (m == 2 and 1 or 0)
    end
    if not is_on(s) or not day(first) or not day(last) or last < first
            or (kv.name or "") == "" then
        say("!season_calendar.ltx: the spell in it can't be used - the calendar decides")
        return nil
    end
    return {season = s, name = kv.name, first = first, last = last}
end

local ok_spell, SPELL = pcall(read_spell)
if not ok_spell then
    say("!season_calendar.ltx: its spell could not be read (" .. tostring(SPELL)
        .. ") - the calendar decides")
    SPELL = nil
end

-- The spell, while today is one of its days. A session that runs past its last day, or a
-- launch on a later day without play.bat, is back on the calendar.
local function spell_today()
    if not SPELL then return nil end
    local today = zone_today().iso
    if today >= SPELL.first and today <= SPELL.last then return SPELL end
    return nil
end

-- What MCM's dice rolled for this launch, when play.bat rolled one: {season, draw,
-- chance, day}. nil when it rolled none. It holds until the next launch through play.bat,
-- which rolls again or clears it, as it does the staged mods; a launch without play.bat
-- keeps both. A roll the file gets wrong is left out, with a line in the log.
local ROLL = (function()
    local ok, kv = pcall(calendar_file, "roll")
    if not ok then
        say("!season_calendar.ltx: its roll could not be read (" .. tostring(kv)
            .. ") - the calendar decides")
        return nil
    end
    if not kv or not kv.season then return nil end
    local s, draw, chance = kv.season:lower(), tonumber(kv.draw), tonumber(kv.chance)
    if not is_on(s) or not draw or not chance then
        say("!season_calendar.ltx: the roll in it can't be used - the calendar decides")
        return nil
    end
    return {season = s, draw = draw, chance = chance, day = kv.day or ""}
end)()

-- The roll that holds now: an MCM pin wins over it, as it does over a spell.
local function rolled()
    if ROLL and pinned() == "auto" then return ROLL end
    return nil
end

-- The season the game runs when it isn't the calendar's: the MCM pin, else what the dice
-- rolled, else a spell's. "auto" when it is the calendar's. Every layer asks this;
-- pinned() and rolled() are for saying so.
local function season_mode()
    local mode = pinned()
    if mode ~= "auto" then return mode end
    if ROLL then return ROLL.season end
    local sp = spell_today()
    return sp and sp.season or "auto"
end

-- --- the player's own: seasons, events, periods and spells ------------------------------
--
-- configure.bat makes them and play.bat hands them over in season_calendar.ltx, in [own],
-- [events], [periods] and [spells], numbered, a part to a line: "1_name = Hunter's moon".
-- They switch mods, which play.bat does at launch; here they are for the PDA's page, for
-- MCM's page of their messages, and for the messages. Which are on is worked out from the
-- date, the Zone's when the calendar runs on the game's clock, so a page opened after the
-- Zone's date has moved on shows the day it is. Spells are drawn by play.bat and never
-- here: [today] names those on the day it staged, beside the kinds of weather it found.

-- {[i] = {part = value}} from a section of numbered parts, in number order, as far as the
-- numbers run unbroken
local function numbered(section)
    local ok, kv = pcall(calendar_file, section)
    if not (ok and kv) then return {} end
    local rows = {}
    for k, v in pairs(kv) do
        local i, part = k:match("^(%d+)_([%w_]+)$")
        if i then
            i = tonumber(i)
            rows[i] = rows[i] or {}
            rows[i][part] = v
        end
    end
    local out = {}
    while rows[#out + 1] do out[#out + 1] = rows[#out + 1] end
    return out
end

-- "08-01" as {8, 1}; nil for anything else
local function md_of(v)
    local m, d = tostring(v or ""):match("^%s*(%d%d?)%-(%d%d?)%s*$")
    m, d = tonumber(m), tonumber(d)
    if m and MONTH_LEN[m] and d >= 1 and d <= MONTH_LEN[m] + ((m == 2) and 1 or 0) then
        return {m, d}
    end
    return nil
end

-- "sat, sun" as {"sat", "sun"}
local function list_of(v)
    local out = {}
    for x in tostring(v or ""):gmatch("[^,]+") do
        x = x:match("^%s*(.-)%s*$")
        if x ~= "" then out[#out + 1] = x end
    end
    return out
end

-- whole numbers from lo to hi, -hi to -lo too with `negative`; nil if any is not
local function ints_of(v, lo, hi, negative)
    local out = {}
    for _, x in ipairs(list_of(v)) do
        local n = tonumber(x)
        if not (n and n == math.floor(n) and ((n >= lo and n <= hi)
                or (negative and n <= -lo and n >= -hi))) then
            return nil
        end
        out[#out + 1] = n
    end
    return (#out > 0) and out or nil
end

local WEEKDAY_OK = {mon = true, tue = true, wed = true, thu = true, fri = true, sat = true,
                    sun = true}

local function read_yours()
    local out = {own = {}, events = {}, periods = {}, spells = {}}
    for _, r in ipairs(numbered("own")) do
        local a, b = md_of(r.from), md_of(r.to)
        if r.name and r.key and a and b then
            out.own[#out.own + 1] = {kind = "own", name = r.name, key = r.key,
                                     show = r.show or r.name, from = a, to = b}
        else
            say("!season_calendar.ltx: the season of your own " .. tostring(r.name)
                .. " can't be used - the PDA leaves it off")
        end
    end
    for _, r in ipairs(numbered("events")) do
        local ev = {kind = "event", name = r.name, key = r.key, show = r.show or r.name}
        local ok = (r.name and r.key) and true or false
        if r.from or r.to then
            ev.from, ev.to = md_of(r.from), md_of(r.to)
            ok = ok and ev.from ~= nil and ev.to ~= nil
        else
            local rule = {}
            if r.weekdays then
                rule.weekdays = {}
                for _, w in ipairs(list_of(r.weekdays)) do
                    if WEEKDAY_OK[w] then rule.weekdays[w] = true else ok = false end
                end
            end
            if r.days then
                rule.days = ints_of(r.days, 1, 31, true)
                ok = ok and rule.days ~= nil
            end
            if r.weeks then
                rule.weeks = ints_of(r.weeks, 1, 5, true)
                ok = ok and rule.weeks ~= nil
            end
            if r.months then
                local ms = ints_of(r.months, 1, 12)
                ok = ok and ms ~= nil
                rule.months = {}
                for _, m in ipairs(ms or {}) do rule.months[m] = true end
            end
            if r.within then
                local w = list_of(r.within)
                local a, b = md_of(w[1]), md_of(w[2])
                ok = ok and a ~= nil and b ~= nil
                rule.within = {a, b}
            end
            ok = ok and next(rule) ~= nil
            ev.rule = rule
        end
        if ok then
            out.events[#out.events + 1] = ev
        else
            say("!season_calendar.ltx: the event " .. tostring(r.name)
                .. " can't be used - the PDA leaves it off")
        end
    end
    for _, r in ipairs(numbered("periods")) do
        local a = md_of(r.from)
        if r.name and r.key and a then
            out.periods[#out.periods + 1] = {kind = "period", name = r.name, key = r.key,
                                             show = r.show or r.name, from = a}
        else
            say("!season_calendar.ltx: the period " .. tostring(r.name)
                .. " can't be used - the PDA leaves it off")
        end
    end
    for _, r in ipairs(numbered("spells")) do
        local d = list_of(r.days)
        local chance, lo, hi = tonumber(r.chance), tonumber(d[1]), tonumber(d[2] or d[1])
        local as = r.as and r.as:lower() or nil
        if r.name and r.key and chance and lo and hi and (not as or is_on(as)) then
            out.spells[#out.spells + 1] = {kind = "spell", name = r.name, key = r.key,
                                           show = r.show or r.name, chance = chance,
                                           days = {lo, hi}, as = as, ["in"] = list_of(r["in"])}
        else
            say("!season_calendar.ltx: the spell " .. tostring(r.name)
                .. " can't be used - the PDA leaves it off")
        end
    end
    return out
end

local ok_yours, YOURS = pcall(read_yours)
if not ok_yours then
    say("!season_calendar.ltx: your own seasons and events could not be read ("
        .. tostring(YOURS) .. ") - the PDA leaves them off")
    YOURS = {own = {}, events = {}, periods = {}, spells = {}}
end

-- What play.bat found on the day it staged: {day = "YYYY-MM-DD", weather = {kinds},
-- spells = {{name, key, first, last, as}}}; nil when it found nothing to say.
local function read_today()
    local ok, kv = pcall(calendar_file, "today")
    if not (ok and kv and kv.day) then return nil end
    local out = {day = kv.day, weather = list_of(kv.weather), spells = {}}
    for _, r in ipairs(numbered("today")) do
        if r.spell and r.first and r.last then
            out.spells[#out.spells + 1] = {kind = "spell", name = r.spell, key = r.key or "",
                                           first = r.first, last = r.last,
                                           as = r.as and r.as:lower() or nil}
        end
    end
    return out
end

local ok_today, STAGED_DAY = pcall(read_today)
if not ok_today then STAGED_DAY = nil end

-- Is month m, day d inside the window a..b, both {month, day} and both in it? A window
-- whose start is after its end wraps the year end, as season.py's do.
local function in_window(m, d, a, b)
    local x, lo, hi = m * 100 + d, a[1] * 100 + a[2], b[1] * 100 + b[2]
    if lo <= hi then return lo <= x and x <= hi end
    return x >= lo or x <= hi
end

local DAY_NAMES = {"sun", "mon", "tue", "wed", "thu", "fri", "sat"}   -- os.date's wday 1..7

local function month_days(y, m)
    if m == 2 and (y % 4 == 0 and (y % 100 ~= 0 or y % 400 == 0)) then return 29 end
    return MONTH_LEN[m]
end

-- Is the day t, as os.date("*t") gives one, in an event's rule? The day has to be
-- everything the rule names, as season.py's event_on() has it.
local function rule_on(t, r)
    if r.within and not in_window(t.month, t.day, r.within[1], r.within[2]) then
        return false
    end
    if r.months and not r.months[t.month] then return false end
    if r.weekdays and not r.weekdays[DAY_NAMES[t.wday]] then return false end
    local last = month_days(t.year, t.month)
    if r.days then
        local hit = false
        for _, x in ipairs(r.days) do
            if t.day == ((x > 0) and x or (last + 1 + x)) then hit = true end
        end
        if not hit then return false end
    end
    if r.weeks then
        local nth, from_end = math.floor((t.day - 1) / 7) + 1, -(math.floor((last - t.day) / 7) + 1)
        local hit = false
        for _, w in ipairs(r.weeks) do
            if w == nth or w == from_end then hit = true end
        end
        if not hit then return false end
    end
    return true
end

-- Whether an MCM switch on the page of the player's own has the PDA tell them about one
local function announces(key)
    return mcm_path(PREFIX .. "yours/ann_" .. tostring(key), true) and true or false
end

-- The player's own as MCM lists them: {kind, name, key, show}, seasons of their own first,
-- then events, periods and spells. MCM builds its page from this.
function your_items()
    local out = {}
    for _, kind in ipairs({"own", "events", "periods", "spells"}) do
        for _, it in ipairs(YOURS[kind]) do
            out[#out + 1] = {kind = it.kind, name = it.name, key = it.key, show = it.show}
        end
    end
    return out
end

-- --- color grade presets ------------------------------------------------------------
--
-- A cfg_load preset is a text file of console commands in appdata/. Atmospherics ships
-- Atmos_Cold/Neutral/Warm there; this mod ships Seasons_* (copied in by play.bat, and
-- read from its own folder until then). A season can take its grade from one of them,
-- chosen on the MCM page. Only the grade keys change.
local PRESET_MAP = {
    r__color_grading      = {"grade_r", "grade_g", "grade_b"},
    r__saturation         = {"saturation"},
    r__gamma              = {"gamma"},
    r__exposure           = {"exposure"},
    r2_sun_lumscale       = {"sun_lumscale"},
    r2_sun_lumscale_hemi  = {"sun_lumscale_hemi"},
    r2_sun_lumscale_amb   = {"sun_lumscale_amb"},
    r2_tonemap_adaptation = {"tonemap_adaptation"},
    r2_tonemap_lowlum     = {"tonemap_lowlum"},
    r2_tonemap_middlegray = {"tonemap_middlegray"},
    ssfx_hud_hemi         = {"hud_hemi"},
    r2_sunshafts_value    = {"sunshafts_value"},
}
local PRESET_SEASONS = {"spring", "summer", "autumn", "winter", "winter_snow",
                        "late_winter", "neutral"}
local SHIPPED = {"Seasons_Spring", "Seasons_Summer", "Seasons_Autumn", "Seasons_Winter",
                 "Seasons_DeepWinter", "Seasons_LateWinter", "Seasons_Neutral"}
-- The engine's file table is lowercase, so names come back as "atmos_cold". Shown as
-- "Atmos Cold"; the mod's own by season, from the string table.
local SHIPPED_LABEL = {
    seasons_spring     = "seasons_zone_preset_lst_seasons_spring",
    seasons_summer     = "seasons_zone_preset_lst_seasons_summer",
    seasons_autumn     = "seasons_zone_preset_lst_seasons_autumn",
    seasons_winter     = "seasons_zone_preset_lst_seasons_winter",
    seasons_deepwinter = "seasons_zone_preset_lst_seasons_deepwinter",
    seasons_latewinter = "seasons_zone_preset_lst_seasons_latewinter",
    seasons_neutral    = "seasons_zone_preset_lst_seasons_neutral",
}

local function pretty(stem)
    local s = SHIPPED_LABEL[stem]
    if s then return sotz_text.text(s) end
    local words = {}
    for w in stem:gmatch("[^_]+") do
        words[#words + 1] = w:sub(1, 1):upper() .. w:sub(2)
    end
    return table.concat(words, " ")
end

-- {key = number} for the grade commands in a preset file, or nil if it has none
local function read_preset(path)
    local f = io.open(path, "r")
    if not f then return nil end
    local out, any = {}, false
    for line in f:lines() do
        local cmd, rest = line:match("^%s*([%w_]+)%s+(.-)%s*$")
        local keys = cmd and PRESET_MAP[cmd]
        if keys then
            local vals = nums(rest)
            for i, k in ipairs(keys) do
                if vals[i] then out[k] = vals[i]; any = true end
            end
        end
    end
    f:close()
    return any and out or nil
end

-- {stem = path} for every preset on offer, keyed lowercase. appdata/ first; the mod's own
-- copies only when not already there.
local function preset_paths()
    local paths = {}
    local ok, err = pcall(function()
        local fs = getFS()
        local flist = fs:file_list_open_ex("$app_data_root$",
                                           bit_or(FS.FS_ListFiles, FS.FS_RootOnly), "*.ltx")
        for i = 0, flist:Size() - 1 do
            local name = flist:GetAt(i):NameFull()
            local stem = name:lower():match("^(.+)%.ltx$")
            if stem and stem ~= "user" then
                local path = fs:update_path("$app_data_root$", name)
                if read_preset(path) then paths[stem] = path end
            end
        end
    end)
    if not ok then say("!could not list presets in appdata: " .. tostring(err)) end

    -- Listing $app_data_root$ costs the engine its registry for the savedgames
    -- folder underneath it, and CALifeUpdateManager::load then fatals with "Cannot
    -- find the specified saved game" on a save that is plainly on disk. MCM calls
    -- on_mcm_load at startup, so this runs on every load, not only when the menu is
    -- opened. Listing the leaf puts the registry back.
    pcall(function()
        getFS():file_list_open_ex("$game_saves$",
                                  bit_or(FS.FS_ListFiles, FS.FS_RootOnly), "*.scop")
    end)
    for _, name in ipairs(SHIPPED) do
        if not paths[name:lower()] then
            local path = getFS():update_path("$game_config$", "seasons_presets\\" .. name .. ".ltx")
            if read_preset(path) then paths[name:lower()] = path end
        end
    end
    return paths
end

-- The MCM dropdown: {{value, label}, ...}. Built-in, then the mod's own presets in season
-- order, then everything else alphabetically.
function preset_choices()
    local paths = preset_paths()
    local out, seen = {{"builtin", sotz_text.text("seasons_zone_preset_lst_builtin")}}, {}
    for _, name in ipairs(SHIPPED) do
        local stem = name:lower()
        if paths[stem] then
            out[#out + 1] = {stem, pretty(stem)}
            seen[stem] = true
        end
    end
    local rest = {}
    for stem in pairs(paths) do
        if not seen[stem] then rest[#rest + 1] = stem end
    end
    table.sort(rest)
    for _, stem in ipairs(rest) do
        out[#out + 1] = {stem, pretty(stem)}
    end
    return out
end

-- A per-season read-out for the MCM page: the grade after the chosen preset, plus fog,
-- wind and wetness from the table. Built during on_mcm_load, so it uses cfg_raw, not
-- ui_mcm.get. Reflects the SAVED preset (updates when you reopen after Apply).
function season_readout(s)
    local ini = ini_file(CFG)
    if not (ini and ini:section_exist(s)) then return {} end
    local g = {}
    for _, u in ipairs(UNIFORMS) do
        for _, k in ipairs(u.keys or {}) do g[k] = ini:r_float_ex(s, k) end
    end
    -- named as the dropdown names it, not by the file's stem
    local src = sotz_text.text("ui_mcm_seasons_zone_ro_builtin")
    local sel = (s == "neutral") and cfg_raw(PREFIX .. "main/preset_neutral", "builtin")
                                  or  cfg_raw(PREFIX .. s .. "/preset", "builtin")
    if sel and tostring(sel):lower() ~= "builtin" then
        local paths = preset_paths()
        local key = tostring(sel):lower()
        local vals = paths[key] and read_preset(paths[key])
        if vals then
            for k, v in pairs(vals) do g[k] = v end
            src = pretty(key)
        end
    end
    local function f(x) return x and string.format("%.4g", x) or "-" end
    -- The labels are the string table's and the spacing between the columns is this
    -- page's, since a string table does not keep a run of spaces.
    local t = sotz_text.text
    return {
        t("ui_mcm_seasons_zone_ro_grade") .. "   " .. f(g.grade_r) .. "  " .. f(g.grade_g)
            .. "  " .. f(g.grade_b) .. "      "
            .. t("ui_mcm_seasons_zone_ro_from", {preset = src}),
        t("ui_mcm_seasons_zone_ro_saturation") .. " " .. f(g.saturation)
            .. "    " .. t("ui_mcm_seasons_zone_ro_gamma") .. " " .. f(g.gamma)
            .. "    " .. t("ui_mcm_seasons_zone_ro_exposure") .. " " .. f(g.exposure),
        t("ui_mcm_seasons_zone_ro_sun") .. " " .. f(g.sun_lumscale)
            .. "    " .. t("ui_mcm_seasons_zone_ro_sky") .. " " .. f(g.sun_lumscale_hemi)
            .. " / " .. f(g.sun_lumscale_amb)
            .. "    " .. t("ui_mcm_seasons_zone_ro_sunshafts") .. " " .. f(g.sunshafts_value),
        t("ui_mcm_seasons_zone_ro_tonemap") .. " " .. f(g.tonemap_adaptation)
            .. " / " .. f(g.tonemap_lowlum) .. " / " .. f(g.tonemap_middlegray)
            .. "    " .. t("ui_mcm_seasons_zone_ro_hud") .. " " .. f(g.hud_hemi),
        t("ui_mcm_seasons_zone_ro_fog") .. " " .. f(g.fog_height)
            .. " / " .. f(g.fog_density) .. " / " .. f(g.fog_suncolor)
            .. "      " .. t("ui_mcm_seasons_zone_ro_wetness") .. " " .. f(g.wet_buildup)
            .. " / " .. f(g.wet_dry),
        t("ui_mcm_seasons_zone_ro_wind_grass") .. " " .. f(g.wind_grass_speed)
            .. "    " .. t("ui_mcm_seasons_zone_ro_trees") .. " " .. f(g.wind_trees_speed),
    }
end

-- Replace each season's grade keys with its chosen preset, if one is chosen.
local function overlay_presets(tbl)
    local paths
    for _, s in ipairs(PRESET_SEASONS) do
        local sel = season_preset(s)
        if sel and sel ~= "builtin" and tbl[s] then
            paths = paths or preset_paths()
            sel = tostring(sel):lower()
            local vals = paths[sel] and read_preset(paths[sel])
            if vals then
                for k, v in pairs(vals) do tbl[s][k] = v end
                say("grade for " .. s .. " from preset " .. sel)
            else
                say("!preset " .. sel .. " chosen for " .. s .. " not found - using the table")
            end
        end
    end
end

local function load_table()
    local ini = ini_file(CFG)
    if not ini then return nil end
    local out = {}
    for _, s in ipairs({"spring", "summer", "autumn", "winter",
                        "winter_snow", "late_winter", "neutral"}) do
        if not ini:section_exist(s) then
            say("!config section [" .. s .. "] missing from " .. CFG)
            return nil
        end
        out[s] = {}
        for _, u in ipairs(UNIFORMS) do
            for _, k in ipairs(u.keys or {}) do
                local v = ini:r_float_ex(s, k)
                if v == nil then
                    say("!config [" .. s .. "] is missing '" .. k .. "'")
                    return nil
                end
                out[s][k] = v
            end
        end
    end
    overlay_presets(out)
    return out
end

-- Which seasons are we between, and how far across? Returns from, to, k (0..1).
-- Away from a boundary from == to and k == 1, so callers need no special case.
--
-- Each half of a window is at most half the season on that side. A calendar of the
-- player's own can have a 14-day season, and a 30-day window around each of its ends
-- would overlap: the first boundary listed won, the blend jumped by half a season in a
-- day, and on a season's first day the weight could sit with the one two back.
local function resolve(blend_days)
    local now  = zone_today()
    local year = now.year
    local doy  = now.yday
    local len  = doy_of(12, 31, year)

    if blend_days > 0 then
        local n = #BOUNDS
        for i, b in ipairs(BOUNDS) do
            local prev, nxt = BOUNDS[(i - 2) % n + 1], BOUNDS[i % n + 1]
            local at = doy_of(b.m, b.d, year)
            local before = (at - doy_of(prev.m, prev.d, year)) % len
            local after  = (doy_of(nxt.m, nxt.d, year) - at) % len
            if n == 1 then before, after = len, len end
            local half = math.min(blend_days * 0.5, before * 0.5, after * 0.5)
            local d = circ(doy - at, len)
            if half > 0 and d >= -half and d <= half then
                return prev.season, b.season, (d + half) / (2 * half)
            end
        end
    end

    local cur = BOUNDS[#BOUNDS].season          -- before the first boundary = winter
    for _, b in ipairs(BOUNDS) do
        if doy >= doy_of(b.m, b.d, year) then cur = b.season end
    end
    return cur, cur, 1.0
end

local function fmt(v)
    return string.format("%.4f", v)
end

-- How wintry it is now, 0..1, for the snowfall patch. Blended across the boundaries
-- like everything else, and cached: it is called every frame.
local snow_cached, snow_cache_until = 0.0, 0

function snow_factor()
    local tg = time_global()
    if tg < snow_cache_until then return snow_cached end
    snow_cache_until = tg + 5000

    -- snow in all three winters, hardest once the ground is covered; the thaw still
    -- gets showers of it
    local SNOW_WEIGHT = {winter = 0.60, winter_snow = 1.00, late_winter = 0.40}

    local v = 0.0
    if mcm("enabled", true) then
        local mode = season_mode()
        if mode ~= "auto" then
            v = SNOW_WEIGHT[mode] or 0.0
        else
            local from, to, k = resolve(mcm("blend_days", 14))
            local a = SNOW_WEIGHT[from] or 0.0
            local b = SNOW_WEIGHT[to] or 0.0
            v = a + (b - a) * k
        end
    end
    snow_cached = v
    return v
end


-- The current blend as a weight per season, summing to 1, for other seasonal effects
-- (seeds in spring, leaves in autumn). Cached: called every frame.
local mix_cached, mix_until = nil, 0

function season_mix()
    local tg = time_global()
    if mix_cached and tg < mix_until then return mix_cached end
    mix_until = tg + 5000

    local m = {spring = 0, summer = 0, autumn = 0, winter = 0, winter_snow = 0,
               late_winter = 0}
    if mcm("enabled", true) then
        local mode = season_mode()
        if mode ~= "auto" and m[mode] then
            m[mode] = 1.0
        else
            local from, to, k = resolve(mcm("blend_days", 14))
            if from == to then
                m[to] = 1.0
            else
                m[from] = 1.0 - k
                m[to]   = k
            end
        end
    end
    mix_cached = m
    return m
end

-- Pre-rendered dials, ~11 days apart, drawn for DIAL_YEAR's dates by
-- _tools/build_season_dial.py. The date itself is live text above the dial.
DIAL_POSITIONS = 32

-- which season a day-of-year falls in, ignoring blending
local function season_at(doy, year)
    local cur = BOUNDS[#BOUNDS].season          -- before the first boundary
    for _, b in ipairs(BOUNDS) do
        if doy >= doy_of(b.m, b.d, year) then cur = b.season end
    end
    return cur
end

-- The season the world runs now, for sotz_api.season(): an MCM pin's, the dice's or a
-- spell's when there is one, else the calendar's; with the calendar's own, whether a pin or
-- a roll holds, the spell running, and the names to show.
function season_now()
    local now = zone_today()
    local cal = season_at(now.yday, now.year)
    local mode = season_mode()
    local key = (mode ~= "auto") and mode or cal
    local pin = pinned() ~= "auto"
    local roll = rolled()
    local sp = (not pin and not roll) and spell_today() or nil
    return {key = key, calendar = cal, pinned = pin, rolled = roll ~= nil, label = name_of(key),
            title = cap(key),
            spell = sp and {name = sp.name, first = sp.first, last = sp.last} or nil}
end

-- The nearest dial whose own date is in today's season. Each dial has its season's arc
-- highlighted, so the nearest by date alone can light the wrong arc near a boundary.
-- Positions are worked out for the year they were drawn for, not this one: in a leap
-- year they would move a day and could land on the wrong side of a boundary. nil when a
-- calendar of the player's own has no dial drawn for it.
function dial_texture()
    if DIAL == "none" then return nil end
    local now  = zone_today()
    local year, doy = now.year, now.yday
    local yl   = doy_of(12, 31, DIAL_YEAR)
    local want = season_at(doy, year)

    local best, best_d
    for i = 0, DIAL_POSITIONS - 1 do
        local day = math.floor(i * yl / DIAL_POSITIONS + 0.5) + 1
        if season_at(day, DIAL_YEAR) == want then
            local d = math.abs(day - doy)
            if d > yl / 2 then d = yl - d end   -- wrap the year end
            if not best_d or d < best_d then best, best_d = i, d end
        end
    end
    return string.format(DIAL == "custom" and "ui_seasons_dial_c%02d.dds"
                         or shipped_dial() .. "%02d.dds", best or 0)
end

-- The shipped set in the game's language: the text table names it (st_sotz_dial_set),
-- and English's is shown for a language that names none, or names one not there. A
-- calendar of the player's own has the set play.bat drew for it, in the game's language.
local dial_sets = {}
function shipped_dial()
    local set = game.translate_string("st_sotz_dial_set")
    if dial_sets[set] == nil then
        dial_sets[set] = set:match("^ui_seasons_dial_%w+_$") ~= nil
            and getFS():exist("$game_textures$", set .. "00.dds") and true or false
    end
    return dial_sets[set] and set or "ui_seasons_dial_"
end


-- Rows for the MCM panel: today's date, and a line when a pin or a spell has the season
-- differ from the calendar's. Touches no game state, so it is safe at the main menu.
function calendar_rows()
    local now  = zone_today()
    local year, doy = now.year, now.yday

    local cur = BOUNDS[#BOUNDS].season          -- before the first boundary = winter
    for _, b in ipairs(BOUNDS) do
        if doy >= doy_of(b.m, b.d, year) then cur = b.season end
    end

    local today = today_text()

    local rows = {}

    -- `live` is what apply() last pushed, so this cannot disagree with the world. It is
    -- nil until the mod has run once.
    rows[#rows + 1] = {text = sotz_text.text(now.clock == "game"
                                                 and "ui_mcm_seasons_zone_today_game"
                                                 or "ui_mcm_seasons_zone_today", {date = today}),
                       current = false}

    if live and live.spell and live.season ~= cur then
        local y, m, d = live.spell.last:match("^(%d+)%-(%d+)%-(%d+)$")
        rows[#rows + 1] = {
            text = sotz_text.text("ui_mcm_seasons_zone_spell", {
                name = live.spell.name, ends = sotz_text.date_short(tonumber(m), tonumber(d)),
                spell = name_of(live.season), Spell = cap(live.season),
                season = name_of(cur), Season = cap(cur)}),
            current = true,
        }
    elseif live and live.roll and live.season ~= cur then
        rows[#rows + 1] = {
            text = sotz_text.text("ui_mcm_seasons_zone_rolled", {
                rolled = name_of(live.season), Rolled = cap(live.season),
                season = name_of(cur), Season = cap(cur)}),
            current = true,
        }
    elseif live and live.mode ~= "auto" and live.season ~= cur then
        rows[#rows + 1] = {
            text = sotz_text.text("ui_mcm_seasons_zone_pinned", {
                pinned = name_of(live.season), Pinned = cap(live.season),
                season = name_of(cur), Season = cap(cur)}),
            current = true,
        }
    end

    return rows
end

-- Resolve every uniform to a concrete command for the current blend.
local function build(from, to, k, intensity, layers)
    local out, clamped = {}, {}
    local dte = (dynamic_tonemap ~= nil)
    if dte and not dte_said then
        dte_said = true
        say("Dynamic Tonemap Extended is loaded - leaving tonemap adaptation/lowlum/"
            .. "middlegray and sun lumscale amb/hemi to it (5 of 12 grade uniforms)")
    end
    for _, u in ipairs(UNIFORMS) do
        if layers[u.layer] and not (dte and DTE_OWNS[u.name]) then
            local parts, n
            if u.const then
                parts, n = {}, #u.const
                for _, c in ipairs(u.const) do parts[#parts + 1] = fmt(c) end
            else
                parts, n = {}, #u.keys
                for _, key in ipairs(u.keys) do
                    -- blend the two seasons, then toward neutral by intensity
                    local v = lerp(P[from][key], P[to][key], k)
                    v = lerp(P.neutral[key], v, intensity)
                    local c, hit = clamp(key, v)
                    if hit then clamped[#clamped + 1] = key end
                    parts[#parts + 1] = fmt(c)
                end
                for _ = 1, (u.pad or 0) do parts[#parts + 1] = "0" end
            end

            local val, cmd
            if #parts > 1 then
                val = "(" .. table.concat(parts, ",") .. ")"
                cmd = u.name .. " " .. val
            else
                val = parts[1]
                cmd = u.name .. " " .. val
            end
            out[#out + 1] = {name = u.name, val = val, cmd = cmd, n = n}
        end
    end
    if #clamped > 0 then
        say("!clamped out-of-range config value(s): " .. table.concat(clamped, ", ")
            .. " - the engine would have discarded the whole command")
    end
    return out
end

-- Re-assert what drifted. Drift (something overwrote a value) is corrected forever; a
-- refusal (the value did not move) is given up on.
local function enforce()
    if not want then return end
    local c = get_console()
    for _, u in ipairs(want) do
        if not dead[u.name] then
            local got = q(u.name)
            if not matches(got, u.val, u.n) then
                c:execute(u.cmd)
                reasserts[u.name] = (reasserts[u.name] or 0) + 1
                if matches(q(u.name), u.val, u.n) then
                    fails[u.name] = 0
                else
                    fails[u.name] = (fails[u.name] or 0) + 1
                    if fails[u.name] >= GIVE_UP then
                        dead[u.name] = true
                        if q(u.name) == nil then
                            -- no readback: the command does not exist in this engine
                            say("!" .. u.name .. " is not a console command in this engine"
                                .. " build - GAMMA's Modded Exes (DX11) are required for it."
                                .. " Not retrying it this session.")
                        else
                            say("!" .. u.name .. " REFUSED by the engine " .. GIVE_UP
                                .. "x running - " .. u.val .. " is out of range. Search this log"
                                .. " for: Invalid syntax in call to " .. u.name
                                .. " . Not retrying it this session.")
                        end
                    end
                end
            end
        end
    end
end

local function apply(announce)
    if not P then return end
    local enabled = mcm("enabled", true)
    if not enabled then
        if want then
            -- Restore the grade to neutral before letting go; nothing else sets those
            -- values. The other layers are SSS's own and it re-pushes them itself.
            local c = get_console()
            for _, u in ipairs(build("neutral", "neutral", 1.0, 1.0, {grade = true})) do
                c:execute(u.cmd)
            end
            say("disabled in MCM - grade restored to neutral, releasing control")
        end
        want = nil
        live = nil          -- not driving anything, so claim no season on the panel
        return
    end

    local layers = {
        grade = mcm("do_grade", true), flora = mcm("do_flora", true),
        fog   = mcm("do_fog",   true), wind  = mcm("do_wind",  true),
        wet   = mcm("do_wet",   true),
    }
    local intensity = mcm("intensity", 1.0)
    local mode      = season_mode()

    local from, to, k
    if mode == "auto" then
        from, to, k = resolve(mcm("blend_days", 14))
    else
        from, to, k = mode, mode, 1.0
    end

    -- the spell, when it is a spell and not the pin or the dice that set the season
    local roll = rolled()
    local spell = nil
    if pinned() == "auto" and not roll then spell = spell_today() end
    live = {mode = mode, season = to, spell = spell, roll = roll}

    want = build(from, to, k, intensity, layers)
    local c = get_console()
    for _, u in ipairs(want) do c:execute(u.cmd) end

    local label
    if from == to then
        label = to
    else
        label = string.format("%s->%s %d%%", from, to, math.floor(k * 100 + 0.5))
    end
    if intensity < 1.0 then
        label = label .. string.format(" @%d%%", math.floor(intensity * 100 + 0.5))
    end

    if announce or label ~= last_label then
        local off = {}
        for _, n in ipairs({"grade", "flora", "fog", "wind", "wet"}) do
            if not layers[n] then off[#off + 1] = n end
        end
        say(label .. " applied (" .. #want .. " uniforms"
            .. (#off > 0 and ", off: " .. table.concat(off, ",") or "") .. ")")
        if announce then
            for _, u in ipairs(want) do
                local got = q(u.name)
                say(string.format("  %-24s -> %-44s %s", u.name, tostring(got),
                    matches(got, u.val, u.n) and "OK" or ("WANT " .. u.val)))
            end
        end
        if last_label and label ~= last_label and mcm("notify", true)
           and actor_menu and actor_menu.set_msg then
            -- `label` is the log string, built from config keys; not for the player
            local said
            if from == to then
                said = sotz_text.text("st_sotz_msg_settled",
                                      {season = name_of(to), Season = cap(to)})
            else
                said = sotz_text.text("st_sotz_msg_giving_way",
                                      {from = name_of(from), From = cap(from),
                                       to = name_of(to), To = cap(to)})
            end
            actor_menu.set_msg(1, said, 5)
        end
    end
    last_label = label
end

-- Days until the next season starts, and which one. A boundary on today wraps to a full
-- year, so the first day of autumn reports winter, not autumn.
local function days_to_next()
    local now  = zone_today()
    local year, doy = now.year, now.yday
    local len  = doy_of(12, 31, year)
    local best, name
    for _, b in ipairs(BOUNDS) do
        local d = doy_of(b.m, b.d, year) - doy
        -- already past this year: the rest of this year, then that date next year. Adding
        -- this year's length instead was a day out whenever only one of the two is a leap year
        if d <= 0 then d = (len - doy) + doy_of(b.m, b.d, year + 1) end
        if not best or d < best then best, name = d, b.season end
    end
    return best, name
end

-- The PDA message. Delayed: sent at actor_on_first_update it lands under the loading
-- screen.
local function pda_announce()
    if not (db.actor and news_manager and news_manager.send_tip) then
        say("news_manager unavailable - skipping PDA announcement")
        return
    end
    local date = today_text()

    -- one whole sentence for each thing the report can say, so a translation can put the
    -- season, the date and the count wherever its language wants them
    local mode = pinned()
    local roll = rolled()
    local sp = nil
    if mode == "auto" and not roll then sp = spell_today() end
    local msg
    if mode ~= "auto" then
        -- pinned: no date, which would only contradict the season
        msg = sotz_text.text("st_sotz_news_pinned",
                             {season = name_of(mode), Season = cap(mode)})
    elseif roll then
        -- rolled: no date either, and the season the calendar would have had
        local now = zone_today()
        local cal = season_at(now.yday, now.year)
        msg = sotz_text.text("st_sotz_news_rolled", {
            season = name_of(roll.season), Season = cap(roll.season),
            calendar = name_of(cal), Calendar = cap(cal)})
    elseif sp then
        local y, m, d = sp.last:match("^(%d+)%-(%d+)%-(%d+)$")
        msg = sotz_text.text("st_sotz_news_spell", {
            season = name_of(sp.season), Season = cap(sp.season), name = sp.name,
            ends = sotz_text.date(tonumber(m), tonumber(d), tonumber(y))})
    else
        local from, to, k = resolve(mcm("blend_days", 14))
        if from == to then
            local d, nxt = days_to_next()
            local v = {season = name_of(to), Season = cap(to), date = date,
                       next = name_of(nxt), Next = cap(nxt)}
            if nxt == to then
                -- a calendar with one season on: it never gives way
                msg = sotz_text.text("st_sotz_news_one_season", v)
            elseif mcm("dice", false) then
                -- the dice roll again at the next launch, so the next season is no promise
                msg = sotz_text.text("st_sotz_news_dice_again", v)
            elseif d == 1 then
                msg = sotz_text.text("st_sotz_news_next_tomorrow", v)
            else
                msg = sotz_text.plural("st_sotz_news_next_in_days", d, v)
            end
        else
            local v = {season = name_of(to), Season = cap(to), date = date,
                       from = name_of(from), From = cap(from),
                       to = name_of(to), To = cap(to)}
            if k < 0.35 then
                msg = sotz_text.text("st_sotz_news_beginning", v)
            elseif k < 0.65 then
                msg = sotz_text.text("st_sotz_news_giving_way", v)
            else
                msg = sotz_text.text("st_sotz_news_taken_hold", v)
            end
        end
    end
    news_manager.send_tip(db.actor, msg, nil, nil, 14000)
    say("PDA: " .. msg)
end

-- --- days of remembrance -----------------------------------------------------------------
--
-- Two fixed dates the Zone marks by going still. Both are real observances:
--
--     April 26      International Chernobyl Disaster Remembrance Day (UN, 2016)
--     December 14   Liquidators' Day (Ukraine, 2006)
--
-- They are DAYS, not seasons. Each sits on top of whatever season is running and changes
-- nothing about it - April 26 is still spring, December 14 is still deep winter. Nothing
-- here touches the season table, the blend, or the staged mods.
--
-- Deliberately no reward, no drop, no map marker. The day is carried by the sky going
-- quiet and the PDA carrying the day.
--
-- The day is the one the seasons run on (zone_today): the real date, or the Zone's own
-- when MCM puts the calendar on the game's clock. Nothing here is tied to an in-game
-- hour.

local REM_MS  = 5000          -- how often the day is re-checked; cheap either way
local next_rem = 0
local rem_said = false        -- the opening is once per session, not once per tick

-- Two kinds of day, deliberately not treated alike.
--
--   memorial     a real observance for a real disaster. The sky is held clear and the
--                PDA carries the day's transmissions.
--   anniversary  the release date of a mainline game. The Zone gets loud: a storm, a
--                crop of artefacts and the PDA's transmissions, each with its own MCM
--                switch. Giving a game's birthday the same still sky as the 26th of April
--                would flatten the difference between them.
--
-- `since` is the year the game's story is set in, not its release year: the count is
-- in-game years (game_year below), so it stays correct instead of going stale.
-- `opens` is a pool for the opening line, sent shortly after you load in. `lines` is a pool drawn from at random
-- intervals after that, shuffled so nothing repeats until the pool is exhausted.
--
-- A pool names who says each of its lines. The words are the string table's, as
-- st_sotz_rem_<key>_<pool>_<n>, and go out as "Owl: ..." through st_sotz_rem_says. A line
-- named in `years` counts the years elapsed since `since`, a form for each count, so the
-- count is computed rather than written down and cannot go stale.
local REMEMBRANCE = {
    -- memorial
    [426]  = {kind = "memorial", key = "chernobyl",
              opens = {"owl", "owl", "sidorovich"},
              lines = {"owl", "sidorovich", "nimble", "forester", "beard", "barman",
                       "forester", "owl", "guide", "barman", "nimble", "sidorovich",
                       "sakharov", "beard", "forester"}},
    -- memorial
    [1214] = {kind = "memorial", key = "liquidators",
              opens = {"sakharov", "forester", "owl"},
              lines = {"sakharov", "barman", "beard", "owl", "forester", "nimble", "owl",
                       "guide", "beard", "forester", "barman", "sakharov", "nimble",
                       "sidorovich", "sidorovich"}},
    -- anniversary
    [320]  = {kind = "anniversary", key = "soc", since = 2012,
              years = {opens_1 = true, opens_3 = true},
              opens = {"sidorovich", "barman", "forester"},
              lines = {"sidorovich", "barman", "nimble", "barman", "sakharov", "beard",
                       "nimble", "sakharov", "sidorovich", "nimble", "forester", "guide",
                       "owl", "owl", "barman"}},
    -- anniversary
    [822]  = {kind = "anniversary", key = "cs", since = 2011,
              years = {opens_1 = true, opens_2 = true},
              opens = {"sakharov", "guide", "sakharov"},
              lines = {"sakharov", "barman", "barman", "guide", "sakharov", "nimble",
                       "barman", "owl", "sidorovich", "beard", "sakharov", "beard",
                       "forester", "owl", "guide"}},
    -- anniversary
    [1002] = {kind = "anniversary", key = "cop", since = 2012,
              years = {opens_1 = true, opens_2 = true},
              opens = {"owl", "beard", "owl"},
              lines = {"beard", "owl", "forester", "owl", "guide", "beard", "nimble",
                       "guide", "beard", "owl", "sakharov", "sidorovich", "barman",
                       "beard", "owl"}},
    -- anniversary
    [1120] = {kind = "anniversary", key = "hoc",
              opens = {"forester", "guide", "sidorovich"},
              lines = {"guide", "sidorovich", "sakharov", "forester", "barman", "nimble",
                       "sidorovich", "barman", "forester", "beard", "sakharov", "nimble",
                       "owl", "barman", "beard"}},
}

local function remembrance_today()
    local t = zone_today()
    return REMEMBRANCE[t.month * 100 + t.day]
end

-- Hold the weather on a named cycle.
--
-- A memorial holds "clear"; an anniversary holds "storm". The two kinds of day pull
-- in opposite directions on purpose - one goes still, the other goes loud.
--
-- This goes through the weather manager itself - the accessor surge_manager.script
-- already uses - rather than writing console values, so it does not fight the weather
-- system. It re-asserts on a tick instead of setting it once, and only writes when
-- something has drifted, so a clear day costs nothing.
--
-- The base game's manager draws its cycle at the next game hour, and a forced change
-- makes that draw immediate, so setting the cycle is enough there. Atmospherics' planner
-- draws only when a segment of its day plan comes due, and that segment brings its own
-- cycle: setting wm.cycle alone never reached the sky. So there the plan is held - every
-- segment due before the day ends takes this cycle, which also keeps the Forecast page's
-- plan true - and the sky is drawn now, blended, with the planner's own call.
local function hold_cycle(name)
    if not (level_weathers and level_weathers.get_weather_manager) then
        return "Atmospherics not present"
    end
    local ok, err = pcall(function()
        local wm = level_weathers.get_weather_manager()
        if not wm then error("no weather manager") end
        local planner = type(wm.day_plan) == "table"
            and type(wm.abs_schedule_minute) == "function"
        if planner then
            local last = wm:abs_schedule_minute() + day_left_game_minutes()
            for i = (wm.day_plan_index or 1), #wm.day_plan do
                local seg = wm.day_plan[i]
                if seg and seg.minute and seg.minute <= last then seg.cycle = name end
            end
        end
        if wm.cycle == name then return end
        if not (wm.presets and wm.presets[name]) then error("no " .. name .. " cycle") end
        wm.cycle = name
        if random_key_table then
            wm.preset = random_key_table(wm.presets[name])
        end
        if planner and type(wm.select_weather) == "function" then
            wm:select_weather(false)
        elseif type(wm.forced_weather_change) == "function" then
            wm:forced_weather_change()
        end
    end)
    return ok and "ok" or tostring(err)
end

-- An anniversary seeds an extra crop of artefacts on each level you visit that day.
--
-- This calls Dynamic Anomalies Overhaul's own public entry point - the same one
-- grok_artefacts_random_spawner already calls behind a chance roll - rather than
-- touching its spawn-chance setting, which is a local and unreachable anyway. That
-- also means there is nothing to restore: a crash mid-day cannot leave a rate
-- turned up for good.
--
-- NOTE: these artefacts go into the alife and persist in the save, exactly as the
-- ordinary random spawner's do. Once per level per session, latched, so walking in
-- and out of a level does not keep seeding it.
-- Keyed "YYYY-MM-DD|level" and saved with the game, so the promise in the docs - one
-- crop per level per DAY - survives a reload. A plain in-memory table reset on every
-- load, and repeated loads are normal here.
arte_done = {}                 -- module-scope: save_state/load_state reach it

-- The factions that have already told the player their network is open, by community id.
-- Persisted, because standing drifts either side of a threshold and an announcement that
-- repeats every time it crosses back is worse than one that never came. One per faction,
-- so picking another faction in MCM brings its own word once.
eco_told = {}
local ARTE_PASSES = 5          -- see the note in anniversary_artefacts

-- Count every artefact the simulation knows about. alife():iterate_objects, never a
-- 0..65534 sweep - that is the pattern that had to be removed from Homestead for the
-- hitches it caused. Returns nil if the engine will not cooperate.
local function count_artefacts()
    local n = 0
    local ok = pcall(function()
        alife():iterate_objects(function(se)
            if se and IsArtefact(nil, se:clsid()) then n = n + 1 end
        end)
    end)
    return ok and n or nil
end

local function anniversary_artefacts()
    if not (drx_da_main and drx_da_main.spawn_artefacts_on_level) then
        return "Dynamic Anomalies Overhaul not present"
    end
    local okl, lvl = pcall(function() return level.name() end)
    if not (okl and lvl) then return "no level" end

    local key = zone_today().iso .. "|" .. lvl
    if arte_done[key] then return nil end
    -- DAO sets a level up in its own actor_on_update, which runs after ours, so on the
    -- first update on a level it has not seen yet its table for the level is missing and
    -- spawn_artefacts_on_level indexes nil. Wait for it: this runs every REM_MS, and the
    -- day is only latched once DAO has the level.
    local da = drx_da_main.updated_anomaly_levels
    if not (type(da) == "table" and da[lvl] and da[lvl].anomaly_types_by_smart) then
        return nil
    end
    arte_done[key] = true

    -- One call is a ~15% dice roll per eligible smart, so it yields 0-1 artefacts -
    -- measured at 28 -> 29 once and 28 -> 28 twice on Garbage. The chance itself lives
    -- in a file local inside DAO and cannot be reached, so repeating the call is the
    -- only lever. Five passes gives a light 0-5, which is the intended dose for a day
    -- that comes around once a year.
    local before = count_artefacts()
    for _ = 1, ARTE_PASSES do
        local ok, err = pcall(drx_da_main.spawn_artefacts_on_level)
        if not ok then return tostring(err) end
    end
    local after = count_artefacts()

    if before and after then
        return string.format("seeded %s on %s over %s passes (artefacts %s -> %s)",
                             tostring(after - before), lvl, tostring(ARTE_PASSES),
                             tostring(before), tostring(after))
    end
    return "seeded artefacts on " .. lvl .. " (count unavailable)"
end

-- The opening transmission lands shortly after you load in; the pool is drawn from at
-- intervals somewhere between these two, so two days running never sound the same.
local REM_OPEN_MS = 25000
local REM_GAP_MIN = 8 * 60000
local REM_GAP_MAX = 20 * 60000

local rem_bag  = nil          -- shuffled indices remaining in today's pool
local rem_next = 0            -- time_global of the next transmission

-- The in-game year, not the real one. Anomaly starts on 26.10.2018 and its calendar
-- advances with play, so a line about how long ago something happened has to be measured
-- from where the player actually is. Returns nil if the engine will not give it up.
local function game_year()
    local ok, y = pcall(function() return game.get_game_time():get() end)
    if ok and type(y) == "number" and y > 1900 and y < 4000 then return y end
    return nil
end

-- One transmission as the PDA shows it, "Owl: ...", and who says it. nil for a line that
-- counts years when there is nothing to count from.
local function rem_line(day, pool, i)
    local who = day[pool] and day[pool][i]
    if not who then return nil end
    local id = "st_sotz_rem_" .. day.key .. "_" .. pool .. "_" .. i
    local line
    if day.years and day.years[pool .. "_" .. i] then
        if not day.since then return nil end      -- a count with nothing to count from
        local y = game_year()
        if not y then return nil end              -- caller picks a line without a count
        line = sotz_text.plural(id, y - day.since)
    else
        line = sotz_text.text(id)
    end
    return sotz_text.text("st_sotz_rem_says",
                          {who = sotz_text.text("st_sotz_speaker_" .. who), line = line}), who
end

-- Speaker -> the key added by mod_news_tips_icons_sotz.ltx, which puts the face beside
-- the name each transmission starts with.
local SPEAKER_ICON = {
    barman     = "sotz_barman",
    sidorovich = "sotz_sidorovich",
    owl        = "sotz_owl",
    beard      = "sotz_beard",
    sakharov   = "sotz_sakharov",
    forester   = "sotz_forester",
    nimble     = "sotz_nimble",
    guide      = "sotz_guide",
}

local function rem_send(day, pool, i)
    if not (db.actor and news_manager and news_manager.send_tip) then return end
    local msg, who = rem_line(day, pool, i)
    if not msg then return false end              -- unusable; the caller tries another
    news_manager.send_tip(db.actor, msg, nil, SPEAKER_ICON[who], 14000)
    say("remembrance PDA: " .. msg)
    return true
end

-- A shuffle bag rather than a plain random pick: with five lines and a straight roll you
-- would hear the same one twice in a row often enough to notice, which reads as a bug.
local function rem_refill(day)
    rem_bag = {}
    for i = 1, #(day.lines or {}) do
        rem_bag[i] = i
    end
    for i = #rem_bag, 2, -1 do
        local j = math.random(i)
        rem_bag[i], rem_bag[j] = rem_bag[j], rem_bag[i]
    end
end

local function remembrance_announce(day)
    local tg = time_global()
    if not rem_said then
        rem_said = true
        rem_next = tg + REM_OPEN_MS
        return                       -- the opening waits out the load, it does not race it
    end
    if tg < rem_next then return end

    if rem_bag == nil then           -- first fire after the opening delay: send `open`
        -- If the in-game year is unavailable, every opening carrying a count is
        -- unusable; fall back to one that does not need it rather than printing "$n".
        local ops = day.opens or {}
        local start = math.random(#ops)
        for k = 0, #ops - 1 do
            if rem_send(day, "opens", (start + k - 1) % #ops + 1) then break end
        end
        rem_refill(day)
    else
        if #rem_bag == 0 then rem_refill(day) end
        local idx = table.remove(rem_bag)
        local pool = day.lines or {}
        if idx and pool[idx] then rem_send(day, "lines", idx) end
    end
    rem_next = tg + math.random(REM_GAP_MIN, REM_GAP_MAX)
end

local rem_logged = false

local function remembrance_tick()
    local day = remembrance_today()
    if not day then return end

    if not rem_logged then
        rem_logged = true
        say("remembrance day active: " .. day.key .. " (" .. tostring(day.kind) .. ")")
    end

    -- A memorial holds the sky clear; an anniversary pushes a storm and seeds artefacts.
    local memorial = (day.kind == "memorial")

    if mcm(memorial and "rem_messages" or "rem_anniversary", true) then
        remembrance_announce(day)
    end
    if memorial then
        if mcm("rem_weather", true) then
            local r = hold_cycle("clear")
            if r ~= "ok" and r ~= nil then say("remembrance weather: " .. r) end
        end
    else
        if mcm("rem_ann_weather", true) then
            local r = hold_cycle("storm")
            if r ~= "ok" and r ~= nil then say("anniversary weather: " .. r) end
        end
        if mcm("rem_ann_artefacts", true) then
            local r = anniversary_artefacts()
            if r then say("anniversary: " .. r) end
        end
    end
end


-- Crossing the first threshold is worth hearing about. Without this the feature unlocks
-- in a menu the player was not looking at, which is the same as it not unlocking at all
-- until they happen to check.
--
-- Each faction's own voice: Sakharov for the ecologists, whom the player already knows and
-- whose portrait the remembrance transmissions use; Lebedev for Clear Sky; Major Hernandez
-- for UNISG. Once per faction per save: eco_told persists.
local ACCESS_NEWS = {
    ecolog = {"st_sotz_news_eco_access",  "sotz_sakharov"},
    csky   = {"st_sotz_news_csky_access", "sotz_lebedev"},
    isg    = {"st_sotz_news_isg_access",  "sotz_hernandez"},
}

function eco_access_tick()
    if not mcm("forecast", true) then return end
    local st, faction = forecast_standing()
    if not st or eco_told[faction] then return end
    if st < mcm("forecast_coarse", FORECAST_COARSE) then return end

    eco_told[faction] = true
    local news = ACCESS_NEWS[faction] or ACCESS_NEWS.ecolog
    pcall(function()
        -- the LIMITED tier: a bracket like "2 to 8 hours" on the Forecast page
        news_manager.send_tip(db.actor, sotz_text.text(news[1]), nil, news[2], 16000)
    end)
    say(faction .. " forecast access granted at standing " .. tostring(st))
end

-- --- weather odds that follow the season ------------------------------------------------
--
-- Optional, MCM's wx_season. Atmospherics 2.69's planner rolls its day plan from a weight
-- for each sky, level_weathers.weather_weights, which its own MCM sets. The season tips
-- those weights, blended across a turn like the light, after Polesia's climate: summer's
-- clear days and thunderstorms, autumn's rain and fog, the winters' overcast, the thaw's
-- fog. Atmospherics fills the table from its MCM again whenever an option changes, so a
-- value that isn't the one set here is the player's own, and the new base to tip. The base
-- game's weather has no weights, so there this does nothing.
local WX_TILT = {
    spring      = {clear = 0.9, partly = 1.2, cloudy = 1.0, rain = 1.3, storm = 0.8, foggy = 1.1},
    summer      = {clear = 1.3, partly = 1.2, cloudy = 0.8, rain = 0.8, storm = 1.4, foggy = 0.6},
    autumn      = {clear = 0.7, partly = 0.9, cloudy = 1.3, rain = 1.4, storm = 0.8, foggy = 1.4},
    winter      = {clear = 0.8, partly = 0.9, cloudy = 1.5, rain = 1.1, storm = 0.4, foggy = 1.3},
    winter_snow = {clear = 1.1, partly = 1.0, cloudy = 1.4, rain = 0.8, storm = 0.2, foggy = 1.1},
    late_winter = {clear = 0.8, partly = 0.9, cloudy = 1.3, rain = 1.2, storm = 0.5, foggy = 1.5},
}
local wx_base, wx_set = nil, nil          -- the player's weights, and the ones set here

function weather_tilt_tick()
    local ww = level_weathers and level_weathers.weather_weights
    if type(ww) ~= "table" then return end
    if wx_set then
        for c, v in pairs(ww) do
            if v ~= wx_set[c] then wx_base, wx_set = nil, nil; break end
        end
    end
    if not mcm("wx_season", false) then
        if wx_base then                        -- the player's own back
            for c, v in pairs(wx_base) do ww[c] = v end
        end
        wx_base, wx_set = nil, nil
        return
    end
    if not wx_base then
        wx_base = {}
        for c, v in pairs(ww) do wx_base[c] = v end
    end
    local ok, mix = pcall(season_mix)
    if not (ok and type(mix) == "table") then return end
    wx_set = {}
    for c, base in pairs(wx_base) do
        local f, total = 0, 0
        for s, w in pairs(mix) do
            local t = WX_TILT[s]
            f = f + w * ((t and t[c]) or 1)
            total = total + w
        end
        ww[c] = base * ((total > 0) and f / total or 1)
        wx_set[c] = ww[c]
    end
end

local turn_failed = false          -- said once, not every five seconds

local function actor_on_update()
    if not P then return end
    local tg = time_global()
    -- before the calendar branch below, which returns early on its own tick
    if tg >= next_rem then
        next_rem = tg + REM_MS
        remembrance_tick()
        eco_access_tick()
        weather_tilt_tick()
        local okt, why = pcall(turn_tick)
        if not okt and not turn_failed then
            turn_failed = true
            say("!turn messages failed: " .. tostring(why))
        end
    end
    if tg >= next_date then
        next_date = tg + DATE_MS
        apply(false)                 -- re-resolve the calendar; no-ops if nothing moved
        return
    end
    if not want then return end
    if tg < next_check then return end
    next_check = tg + CHECK_MS
    enforce()
end

-- Season-scoped mods. _tools/season.py writes season_mods.ltx before launch; the MCM
-- page shows one switch per mod; MCM saves the choice to axr_options.ltx, which
-- season.py reads at the next launch. Nothing here can change the current session.
local MODS_CFG = "season_mods.ltx"

function mod_list()
    local ini = ini_file(MODS_CFG)
    if not (ini and ini:section_exist("mods")) then return nil end
    local out = {
        staged_for     = ini:r_string_ex("mods", "staged_for") or "unknown",
        stage_textures = (ini:r_string_ex("mods", "stage_textures") or "on") ~= "off",
        -- the ambient layer: whether it is gating, whether the source mod is even here,
        -- and how many channel removals the staged season carries
        stage_sound    = (ini:r_string_ex("mods", "stage_sound") or "on") ~= "off",
        sound_have     = ini:r_string_ex("mods", "sound_available") == "true",
        sound_cuts     = ini:r_float_ex("mods", "sound_cuts") or 0,
        mods           = {},
    }
    for key in string.gmatch(ini:r_string_ex("mods", "list") or "", "[^,%s]+") do
        if ini:section_exist(key) then
            out.mods[#out.mods + 1] = {
                key     = key,
                name    = ini:r_string_ex(key, "name") or key,
                seasons = ini:r_string_ex(key, "seasons") or "",
                -- the first season the mod serves; the list arrives in calendar order
                group   = ini:r_string_ex(key, "group") or "",
                -- r_string_ex strips internal whitespace, so season.py writes "Deep_winter"
                label   = (ini:r_string_ex(key, "group_label") or ""):gsub("_", " "),
                span    = ini:r_string_ex(key, "span") or "",
                mb      = ini:r_float_ex(key, "mb") or 0,
                enabled = ini:r_string_ex(key, "enabled") == "true",
                wanted  = ini:r_string_ex(key, "wanted") == "true",
            }
        end
    end
    return out
end

local function on_option_change()
    -- SSS re-pushes its own MCM values here; land after them
    CreateTimeEvent("seasons_zone", "reapply", 0.5, function()
        dead, fails = {}, {}         -- MCM changed: give a refused uniform a fresh chance
        P = load_table() or P        -- a preset choice may have changed
        apply(true)
        return true
    end)
end

local function actor_on_first_update()
    P = load_table()
    if not P then
        say("!" .. CFG .. " could not be read - mod is INACTIVE this session")
        return
    end
    apply(true)
    -- the loaded game's day, for the next play.bat, when the calendar runs on its clock
    if write_clock() then say("the Zone's date is " .. zone_today().iso) end

    -- The staged textures and the running season can disagree (a pinned season, or a
    -- launch without staging). Say so. season.py stages by the date, so that is what they
    -- are compared with: in the days before a turn the blend is already moving towards the
    -- next season, and comparing with that warned before every turn. A period of the
    -- player's own is staged under its own name, which no season here matches.
    local staged = ini_file("season_staged.ltx")
    if staged and staged:section_exist("staged") then
        local s = staged:r_string_ex("staged", "season")
        local on = (staged:r_string_ex("staged", "staging") or "on") ~= "off"
        local mode = season_mode()
        local running = (mode ~= "auto") and mode
                        or season_at(zone_today().yday, zone_today().year)
        local a_season = false
        for _, k in ipairs(SEASON_KEYS) do
            if k == s then a_season = true end
        end
        -- with the texture layer off they are meant to disagree
        if on and a_season and s ~= running then
            say("!TEXTURES ARE STAGED FOR " .. string.upper(s) .. " but the season running is "
                .. string.upper(running) .. " - terrain will not match the light.")
            say(" exit, and start the game with play.bat to line them up")
        end
    end

    local greeted, delay = mcm("pda_greeting", true), mcm("pda_delay", 12)
    if greeted then
        CreateTimeEvent("seasons_zone", "pda_greeting", delay, function()
            pda_announce()
            return true
        end)
    end
    -- then the player's own that are on, each where MCM's page of them has its switch on
    local oky, why = pcall(announce_yours, delay + (greeted and 5 or 0), greeted)
    if not oky then say("!your own's PDA messages failed: " .. tostring(why)) end
end

-- The artefact latch rides in the save. Only today's keys are kept, so the table does
-- not grow for the life of a playthrough.
function save_state(m_data)
    local today, keep = zone_today().iso, {}
    for k, v in pairs(arte_done) do
        if v and k:sub(1, #today) == today then keep[k] = true end
    end
    m_data.sotz_arte_done = keep
    m_data.sotz_eco_told = eco_told
    write_clock()                         -- the saved game's day, for the next play.bat
end

function load_state(m_data)
    arte_done = m_data.sotz_arte_done or {}
    local told = m_data.sotz_eco_told
    if told == true then
        eco_told = {ecolog = true}            -- a save from before the faction could be picked
    elseif type(told) == "table" then
        eco_told = told
    else
        eco_told = {}
    end
end

-- --- data for the PDA page ---------------------------------------------------------------
--
-- calendar_rows() above returns finished sentences for an MCM desc list. A page needs the
-- pieces apart - date, length, days away - so it can lay them out and mark today's. This
-- is that, and nothing else reads it.

-- "Sep 15", in the order and the month's form the string table gives
local function md(m, d)
    return sotz_text.date_short(m, d)
end

-- Days from today to (m, d), looking forward and wrapping the year end.
local function days_until(m, d)
    local now  = zone_today()
    local year = now.year
    local doy  = now.yday
    local tgt  = doy_of(m, d, year)
    if tgt >= doy then return tgt - doy end
    return (doy_of(12, 31, year) - doy) + doy_of(m, d, year + 1)
end

-- --- what is on, and what is coming --------------------------------------------------------
--
-- The page's Now and Coming up, the overlines on its grid, the spells it lists, and the
-- messages: the Zone's marked days, and the player's own seasons, events, periods and
-- spells, each worked out from the day the seasons run on.

-- The days from t on, as os.date("*t") gives a day, each with its "YYYY-MM-DD" in iso:
-- ahead(0) is t, ahead(n) the day n days later, each worked out once. Noon to noon, so no
-- daylight-saving hour can tip one.
local function lookahead(t)
    local base, days = os.time({year = t.year, month = t.month, day = t.day, hour = 12}), {}
    return function(n)
        local d = days[n]
        if not d then
            d = os.date("*t", base + n * 86400)
            d.iso = string.format("%04d-%02d-%02d", d.year, d.month, d.day)
            days[n] = d
        end
        return d
    end
end

-- The base periods in date order: the seasons that are on, and the player's own periods,
-- which share the year with them. Each runs from its start until the next one's.
local function base_starts()
    local out = {}
    for _, b in ipairs(BOUNDS) do out[#out + 1] = {m = b.m, d = b.d, season = b.season} end
    for _, p in ipairs(YOURS.periods) do
        out[#out + 1] = {m = p.from[1], d = p.from[2], period = p}
    end
    table.sort(out, function(a, b) return a.m * 100 + a.d < b.m * 100 + b.d end)
    return out
end

-- the base period the day t is in, from base_starts()
local function base_on(t, starts)
    local cur, x = starts[#starts], t.month * 100 + t.day
    for _, s in ipairs(starts) do
        if x >= s.m * 100 + s.d then cur = s end
    end
    return cur
end

-- Is one of the player's own on the day t?
local function item_on(it, t, starts)
    if it.kind == "own" then return in_window(t.month, t.day, it.from, it.to) end
    if it.kind == "event" then
        if it.from then return in_window(t.month, t.day, it.from, it.to) end
        return rule_on(t, it.rule)
    end
    if it.kind == "period" then return base_on(t, starts).period == it end
    if it.kind == "spell" then return it.first <= t.iso and t.iso <= it.last end
    return false
end

-- How many days after today one that is on today runs on: 0 when today is its last. A
-- year at most, which a rule on every day reaches.
local function runs_on(it, ahead, starts)
    local n = 0
    while n < 366 and item_on(it, ahead(n + 1), starts) do n = n + 1 end
    return n
end

-- How many days off the next day it comes on is, after today; nil when not within a year
local function comes_in(it, ahead, starts)
    for n = 1, 366 do
        if item_on(it, ahead(n), starts) then return n end
    end
    return nil
end

-- The next turn of the calendar after the day t: (days off, season). A turn on t itself is
-- a year off, so the first day of autumn reports winter, not autumn; with one season on,
-- the season is the one running.
local function turn_after(t)
    local len, best, name = doy_of(12, 31, t.year), nil, nil
    for _, b in ipairs(BOUNDS) do
        local d = doy_of(b.m, b.d, t.year) - t.yday
        if d <= 0 then d = (len - t.yday) + doy_of(b.m, b.d, t.year + 1) end
        if not best or d < best then best, name = d, b.season end
    end
    return best, name
end

-- What one of the Zone's marked days does, by MCM's switches for its kind: the string ids
-- of what is on, in order. Empty with every switch off, and the day is then not marked.
local function day_does(kind)
    if kind == "memorial" then
        local sky, voices = mcm("rem_weather", true), mcm("rem_messages", true)
        if sky and voices then return {"st_sotz_day_memorial"} end
        local out = {}
        if sky then out[#out + 1] = "st_sotz_day_clear" end
        if voices then out[#out + 1] = "st_sotz_day_voices" end
        return out
    end
    local storm, arte = mcm("rem_ann_weather", true), mcm("rem_ann_artefacts", true)
    local voices = mcm("rem_anniversary", true)
    if storm and arte then return {"st_sotz_day_anniversary"} end
    local out = {}
    if storm then out[#out + 1] = "st_sotz_day_storm" end
    if arte then out[#out + 1] = "st_sotz_day_artefacts" end
    if voices then out[#out + 1] = "st_sotz_day_voices" end
    return out
end

-- each sentence a whole string of its own, so a translation keeps them whole
local function does_text(ids)
    local out = {}
    for _, id in ipairs(ids) do out[#out + 1] = sotz_text.text(id) end
    return table.concat(out, " ")
end

-- the Coming up list's order on one day: the turn, the Zone's day, then the player's own
local KIND_ORDER = {turn = 1, marked = 2, own = 3, period = 4, event = 5}

-- The spells play.bat found on, as items, while their days last
-- A spell configure.bat has taken out since is left off, unless it is the one whose
-- season the game still follows from [spell] until the next launch.
local function spells_on_now()
    local out = {}
    for _, s in ipairs(STAGED_DAY and STAGED_DAY.spells or {}) do
        local show = (SPELL and SPELL.name == s.name) and s.name or nil
        for _, y in ipairs(YOURS.spells) do
            if y.name == s.name then show = y.show end
        end
        if show then
            out[#out + 1] = {kind = "spell", name = s.name, key = s.key, show = show,
                             first = s.first, last = s.last, as = s.as}
        end
    end
    return out
end

--- What is on and what is coming, from the day t (today, the Zone's, unless given):
--   now     {kind, key, name, show, when, what, alert, n}: the Zone's marked day, the
--           player's own seasons, events and periods, the spells and kinds of weather
--           play.bat found; n the days it runs on after today
--   coming  {kind, key, show, date, away, when, what}: the calendar's next turn, the next
--           day of each marked day and each of the player's own, soonest first
--   marks   {from, to, active}: day-of-year spans this year of the player's own seasons,
--           dated events and periods, and of the spells on, for the grid's overlines
--   tints   {from, to, season}: the days of a spell that brings its season, while it does
--   spells  {show, chance, on}: the spells that can start today, by the base period and
--           the player's own seasons on; spells_in the name of that base period
function your_days(t)
    t = t or zone_today()
    if not t.iso then
        t.iso = string.format("%04d-%02d-%02d", t.year, t.month, t.day)
    end
    local ahead, starts = lookahead(t), base_starts()
    local year, ylen = t.year, doy_of(12, 31, t.year)
    local out = {now = {}, coming = {}, marks = {}, tints = {}, spells = {}}
    local fixed = (pinned() ~= "auto") or (rolled() ~= nil)
    local dice = mcm("dice", false) and true or false

    local function until_text(n)
        if n == 0 then return sotz_text.text("st_sotz_year_today") end
        local last = ahead(n)
        return sotz_text.text("st_sotz_year_until", {date = md(last.month, last.day)})
    end
    local function away_text(n)
        if n == 1 then return sotz_text.text("st_sotz_year_tomorrow") end
        return sotz_text.plural("st_sotz_year_in_days", n)
    end
    local function doy(md_)
        return doy_of(md_[1], math.min(md_[2], month_days(year, md_[1])), year)
    end
    local function span(a, b, active)
        local x, y = doy(a), doy(b)
        if x <= y then
            out.marks[#out.marks + 1] = {from = x, to = y, active = active}
        else
            out.marks[#out.marks + 1] = {from = x, to = ylen, active = active}
            out.marks[#out.marks + 1] = {from = 1, to = y, active = active}
        end
    end

    -- the Zone's marked days: today's in Now, the rest in Coming up
    for key, day in pairs(REMEMBRANCE) do
        local m, d = math.floor(key / 100), key % 100
        local does = day_does(day.kind)
        if #does > 0 then
            if m == t.month and d == t.day then
                out.now[#out.now + 1] = {kind = "marked", key = day.key, show = md(m, d),
                                         when = until_text(0), what = does_text(does),
                                         alert = true, n = 0}
            else
                local n = doy_of(m, d, year) - t.yday
                if n <= 0 then n = (ylen - t.yday) + doy_of(m, d, year + 1) end
                out.coming[#out.coming + 1] = {kind = "marked", key = day.key, date = md(m, d),
                                               away = n, when = away_text(n),
                                               what = does_text(does)}
            end
        end
    end

    -- the player's own seasons, events and periods
    local base = base_on(t, starts)
    local own_now = {}
    for _, group in ipairs({"own", "events", "periods"}) do
        for _, it in ipairs(YOURS[group]) do
            local on = item_on(it, t, starts)
            if on then
                if it.kind == "own" then own_now[it.name] = true end
                local n = runs_on(it, ahead, starts)
                out.now[#out.now + 1] = {
                    kind = it.kind, key = it.key, name = it.name, show = it.show, n = n,
                    last = ahead(n), when = until_text(n),
                    what = sotz_text.text("st_sotz_year_kind_" .. it.kind)}
            else
                local n = comes_in(it, ahead, starts)
                if n then
                    local at = ahead(n)
                    out.coming[#out.coming + 1] = {
                        kind = it.kind, key = it.key, show = it.show,
                        date = md(at.month, at.day), away = n, when = away_text(n),
                        what = (it.kind == "event") and it.show
                               or sotz_text.text("st_sotz_year_begins", {name = it.show})}
                end
            end
            -- a window on the grid: seasons of the player's own, dated events, periods
            if it.kind == "own" or (it.kind == "event" and it.from) then
                span(it.from, it.to, on)
            elseif it.kind == "period" then
                local nxt
                for i, s in ipairs(starts) do
                    if s.period == it then nxt = starts[i % #starts + 1] end
                end
                if nxt and nxt.period ~= it then
                    local stop = os.date("*t", os.time({year = year, month = nxt.m,
                                                        day = nxt.d, hour = 12}) - 86400)
                    span(it.from, {stop.month, stop.day}, on)
                end
            end
        end
    end

    -- the spells play.bat found, while their days last
    local in_force, found = spell_today(), spells_on_now()
    local spell_now = {}
    for _, sp in ipairs(found) do
        if item_on(sp, t, starts) then
            spell_now[sp.name] = true
            local n = runs_on(sp, ahead, starts)
            local brings = sp.as and in_force and in_force.name == sp.name and not fixed
            out.now[#out.now + 1] = {
                kind = "spell", key = sp.key, name = sp.name, show = sp.show, n = n,
                last = ahead(n), when = until_text(n), brings = brings and sp.as or nil,
                what = brings and sotz_text.text("st_sotz_year_spell_brings",
                                                 {season = name_of(sp.as)})
                       or sotz_text.text("st_sotz_year_kind_spell")}
            -- its days on the grid, this year's of them
            local fy, fm, fd = sp.first:match("^(%d+)%-(%d+)%-(%d+)$")
            local ly, lm, ld = sp.last:match("^(%d+)%-(%d+)%-(%d+)$")
            fy, ly = tonumber(fy), tonumber(ly)
            if fy and ly and fy <= year and ly >= year then
                local a = (fy < year) and 1 or doy_of(tonumber(fm), tonumber(fd), year)
                local b = (ly > year) and ylen or doy_of(tonumber(lm), tonumber(ld), year)
                out.marks[#out.marks + 1] = {from = a, to = b, active = true}
                if brings then
                    out.tints[#out.tints + 1] = {from = a, to = b, season = sp.as}
                end
            end
        end
    end

    -- the kinds of weather play.bat found, on the day it found them
    if STAGED_DAY and STAGED_DAY.day == t.iso then
        for _, k in ipairs(STAGED_DAY.weather) do
            if k == "freezing" or k == "thaw" or k == "heat" then
                out.now[#out.now + 1] = {kind = "weather", key = k, n = 0,
                                         show = sotz_text.text("st_sotz_year_weather_" .. k),
                                         when = until_text(0),
                                         what = sotz_text.text("st_sotz_year_weather_"
                                                               .. k .. "_what")}
            end
        end
    end

    -- the calendar's next turn; with the season fixed, or the dice about to roll again,
    -- the turn is the calendar's and not a promise
    local n, nxt = turn_after(t)
    if nxt and nxt ~= season_at(t.yday, t.year) then
        local at = ahead(n)
        out.coming[#out.coming + 1] = {
            kind = "turn", key = nxt, date = md(at.month, at.day), away = n, when = away_text(n),
            what = (fixed or dice) and sotz_text.text("st_sotz_year_turn_calendar",
                                                      {Season = cap(nxt), season = name_of(nxt)})
                   or cap(nxt)}
    end
    table.sort(out.coming, function(a, b)
        if a.away ~= b.away then return a.away < b.away end
        return (KIND_ORDER[a.kind] or 9) < (KIND_ORDER[b.kind] or 9)
    end)

    -- the spells that can start today: in the base period, or a season of the player's own
    -- on today
    local base_name = base.period and base.period.name or base.season
    for _, sp in ipairs(YOURS.spells) do
        local can = false
        for _, w in ipairs(sp["in"]) do
            if w == base_name or own_now[w] then can = true end
        end
        if can then
            out.spells[#out.spells + 1] = {show = sp.show, chance = sp.chance,
                                           on = spell_now[sp.name] or false}
        end
    end
    out.spells_in = base.period and base.period.show or name_of(base.season)
    return out
end

function calendar_page()
    local now  = zone_today()
    local year = now.year
    local doy  = now.yday
    local cur  = season_at(doy, year)

    local out = {
        today   = today_text(),
        season  = cur,
        -- for the year ribbon: where today sits, and how long the year is. Both are
        -- cheap here and awkward on the page, which has no calendar of its own.
        doy      = doy,
        year_len = doy_of(12, 31, year),
        -- a season's name inside a sentence, and as it starts one or heads a line
        label   = name_of(cur),
        title   = cap(cur),
        dial    = dial_texture(),
        seasons = {},
        days    = {},
        extra   = {},
    }

    -- each season that is on, with length and range
    local yl = doy_of(12, 31, year)
    for i, b in ipairs(BOUNDS) do
        local nxt = BOUNDS[i % #BOUNDS + 1]
        local a, z = doy_of(b.m, b.d, year), doy_of(nxt.m, nxt.d, year)
        local len = z - a
        if len <= 0 then len = len + yl end         -- the one that wraps the year end
        out.seasons[#out.seasons + 1] = {
            doy_from = a,               -- day of year it begins, for the ribbon
            span     = len,
            key     = b.season,
            label   = name_of(b.season),
            title   = cap(b.season),
            from    = md(b.m, b.d),
            to      = md(nxt.m, nxt.d),
            days    = len,
            current = (b.season == cur),
            starts_in = days_until(b.m, b.d),
        }
    end
    -- listed from spring, like the MCM pages, or from the first season on after it;
    -- BOUNDS stays in date order because the lookups need it
    local first = enabled_seasons()[1]
    for _ = 1, #out.seasons do
        if out.seasons[1].key == first then break end
        table.insert(out.seasons, table.remove(out.seasons, 1))
    end

    -- the six fixed days, each marked while MCM's switches leave it doing something
    for key, day in pairs(REMEMBRANCE) do
        local m, d = math.floor(key / 100), key % 100
        local does = day_does(day.kind)
        out.days[#out.days + 1] = {
            doy    = doy_of(m, d, year),   -- where it falls, for the ribbon's ticks
            key    = day.key,
            kind   = day.kind,
            date   = md(m, d),
            month  = m,
            day    = d,
            away   = days_until(m, d),
            today  = (m == now.month and d == now.day),
            lines  = (day.opens and #day.opens or 0) + (day.lines and #day.lines or 0),
            on     = #does > 0,
            does   = does_text(does),
        }
    end
    table.sort(out.days, function(a, b) return a.away < b.away end)

    -- the turning: which season is next and how far off - whichever has the smallest
    -- non-zero starts_in.
    for _, s in ipairs(out.seasons) do
        if not s.current and s.starts_in > 0 then
            if not out.next or s.starts_in < out.next.days then
                out.next = {label = s.label, title = s.title, days = s.starts_in,
                            key = s.key}
            end
        end
    end

    -- is one of the six marked days today? marked_day says so by the date, for the API;
    -- the page alarms on `marked`, while MCM's switches leave the day doing something
    for _, day in ipairs(out.days) do
        if day.today then
            out.marked_day = day
            if day.on then out.marked = day end
        end
    end

    -- The season the world runs, which a pin, the dice or a spell can make another than
    -- the calendar's: the page heads with it and says why. `dice` is whether MCM's dice are
    -- on, which make the calendar's next turn no promise.
    local sn = season_now()
    out.running = {key = sn.key, label = sn.label, title = sn.title, pinned = sn.pinned,
                   rolled = sn.rolled, spell = sn.spell}
    out.dice = mcm("dice", false) and true or false

    -- the accent bar for the season running; one of this mod's own 256x16 strips
    out.bar = "ui_season_hdr_" .. tostring(sn.key)

    -- what is on beyond the season, what is coming, and the player's own on the grid
    local ok_y, yd = pcall(your_days, now)
    if not ok_y then
        say("!your_days failed: " .. tostring(yd))
        yd = {now = {}, coming = {}, marks = {}, tints = {}, spells = {}}
    end
    out.now, out.coming, out.marks, out.tints = yd.now, yd.coming, yd.marks, yd.tints
    out.spells, out.spells_in = yd.spells, yd.spells_in
    -- the base periods of the player's own beside the seasons, for the page's year list
    out.periods = {}
    local on = {}
    for _, row in ipairs(out.now) do
        if row.kind == "period" then on[row.key] = true end
    end
    for _, p in ipairs(YOURS.periods) do
        out.periods[#out.periods + 1] = {show = p.show, from = md(p.from[1], p.from[2]),
                                         doy_from = doy_of(p.from[1], p.from[2], year),
                                         key = p.key, on = on[p.key] or false}
    end


    -- anything the player added in seasons_config.py reaches the game only as staged
    -- mods, so the page reports what was staged rather than guessing at the config
    local ok, ml = pcall(mod_list)
    if ok and ml then
        out.staged_for = ml.staged_for
        out.extra = ml.mods or {}
    end

    return out
end

-- --- PDA messages for the player's own, and for a turn while playing -------------------------
--
-- At the start, after the season's greeting, a message for each of the player's own
-- seasons, events, periods and spells that is on, where MCM's page of them has its switch
-- on. While playing, the day the seasons run on can move on - always on the game's clock,
-- and past midnight on the real one - and then a message as a turn draws near, another as
-- it comes, and one for each of the player's own as it begins. A season fixed by a pin, the
-- dice or a spell has no turn to tell of.

local sent_n = 0

-- Send PDA messages one after another, `gap` seconds apart from `delay` on, through
-- CreateTimeEvent as the greeting is, so none lands under the loading screen.
local function send_later(msgs, delay, gap)
    for i, msg in ipairs(msgs) do
        sent_n = sent_n + 1
        CreateTimeEvent("seasons_zone", "pda_msg_" .. sent_n, delay + gap * (i - 1), function()
            if db.actor and news_manager and news_manager.send_tip then
                news_manager.send_tip(db.actor, msg, nil, nil, 12000)
                say("PDA: " .. msg)
            end
            return true
        end)
    end
end

-- One of the player's own in a message: on now, or `begins` as it comes on while playing
local function your_message(row, begins)
    local v = {name = row.show, Name = sotz_text.cap_first(row.show)}
    if row.n == 0 or not row.last then
        return sotz_text.text(begins and "st_sotz_news_yours_begins_today"
                              or "st_sotz_news_yours_today", v)
    end
    v.ends = sotz_text.date(row.last.month, row.last.day, row.last.year)
    return sotz_text.text(begins and "st_sotz_news_yours_begins_until"
                          or "st_sotz_news_yours_until", v)
end

local MINE = {own = true, event = true, period = true, spell = true}

--- The start's messages for the player's own, from `delay` seconds on. `greeted` says the
-- season's greeting goes out, which names a spell that brings its season already.
function announce_yours(delay, greeted)
    local yd = your_days()
    local in_force = (pinned() == "auto" and not rolled()) and spell_today() or nil
    local msgs = {}
    for _, row in ipairs(yd.now) do
        local said = greeted and in_force and row.kind == "spell" and row.name == in_force.name
        if MINE[row.kind] and not said and announces(row.key) then
            msgs[#msgs + 1] = your_message(row, false)
        end
    end
    send_later(msgs, delay, 5)
    return msgs
end

-- What turn_tick() saw the last time the day moved: nil until it first looks, which is
-- after the greeting has said how things stand
local turn_seen = nil

-- the textures play.bat staged, and whether it stages them: the ground a turn can't move
local function staged_ground()
    local staged = ini_file("season_staged.ltx")
    if staged and staged:section_exist("staged") then
        return staged:r_string_ex("staged", "season"),
               (staged:r_string_ex("staged", "staging") or "on") ~= "off"
    end
    return nil, false
end

--- Look at the day the seasons run on, and send what moving to it brought: a turn drawing
-- near or come, and the player's own beginning. Returns the messages.
function turn_tick()
    local t = zone_today()
    if turn_seen and turn_seen.iso == t.iso then return nil end
    local cal = season_at(t.yday, t.year)
    local n, nxt = turn_after(t)
    local lead = math.max(1, math.floor((tonumber(mcm("blend_days", 14)) or 14) / 2))
    local near = nil
    if nxt and nxt ~= cal and n <= lead then
        near = nxt .. "@" .. os.date("%Y-%m-%d", os.time({year = t.year, month = t.month,
                                                           day = t.day, hour = 12}) + n * 86400)
    end
    local yd = your_days(t)
    local on = {}
    for _, row in ipairs(yd.now) do
        if MINE[row.kind] then on[row.kind .. ":" .. tostring(row.key)] = true end
    end
    local prev = turn_seen
    turn_seen = {iso = t.iso, season = cal, near = near, on = on}
    if not prev then return nil end

    local msgs = {}
    if mcm("pda_turns", true) and season_mode() == "auto" then
        local v = {season = name_of(cal), Season = cap(cal)}
        if cal ~= prev.season then
            local ground, staging = staged_ground()
            msgs[#msgs + 1] = sotz_text.text((staging and ground ~= cal)
                                             and "st_sotz_news_turned_ground"
                                             or "st_sotz_news_turned", v)
        elseif near and near ~= prev.near then
            local w = {season = name_of(nxt), Season = cap(nxt)}
            msgs[#msgs + 1] = (n == 1) and sotz_text.text("st_sotz_news_near_tomorrow", w)
                              or sotz_text.plural("st_sotz_news_near_in_days", n, w)
        end
    end
    for _, row in ipairs(yd.now) do
        if MINE[row.kind] and not prev.on[row.kind .. ":" .. tostring(row.key)]
           and announces(row.key) then
            msgs[#msgs + 1] = your_message(row, true)
        end
    end
    send_later(msgs, 1, 5)
    return msgs
end


-- --- data for the forecast page ----------------------------------------------------------
--
-- Split from calendar_page on purpose. The calendar answers questions about DATES and runs
-- on real time; everything here runs on the game clock and answers "what is about to
-- happen". They were one page for a while and that read badly: nobody opens a calendar to
-- find out whether it is going to rain this afternoon.

-- Which weather this install can read. "plan" is Atmospherics' day planner, which knows
-- every change for the next 24 game hours. "stock" is base Anomaly's manager, which knows
-- the sky now and when it will turn, but rolls what comes next with math.random at the
-- moment of change - so there is nothing further to read. "none" is no manager at all.
--
-- GAMMA ships "stock". Neither of its two Atmospherics mods includes level_weathers.script;
-- the planner comes only with a newer Atmospherics installed separately.
--
-- In a level the live manager is authoritative, so it is read. At the main menu the script
-- must not even be touched. MCM calls this while it builds its pages, and Atmospherics
-- 2.69's level_weathers reads MCM at file scope, so loading it then fails ("Failed to load
-- script level_weathers") and the page said no weather manager was found. Base's
-- get_weather_manager() would also BUILD a manager, the side effect this mod refuses for
-- the surge manager. So at the menu the file is read instead: the planner is the copy
-- that defines record_day_history, and a copy that is not a loose file is the base game's.
local function weather_source_on_disk()
    local fs = getFS()
    if not fs:exist("$game_scripts$", "level_weathers.script") then return "none" end
    local f = io.open(fs:update_path("$game_scripts$", "level_weathers.script"), "r")
    if not f then return "stock" end
    local src = f:read("*a") or ""
    f:close()
    return src:find("function record_day_history", 1, true) and "plan" or "stock"
end

function weather_source()
    if not (db and db.actor) then
        local ok, src = pcall(weather_source_on_disk)
        return ok and src or "stock"
    end
    if not level_weathers then return "none" end
    if level_weathers.get_weather_manager then
        local ok, wm = pcall(level_weathers.get_weather_manager)
        if ok and wm then
            return (wm.day_plan and wm.abs_schedule_minute) and "plan" or "stock"
        end
        return "none"
    end
    if level_weathers.record_day_history then return "plan" end
    return "none"
end

-- --- a forecast, not a timetable ---------------------------------------------------------
--
-- Atmospherics' plan is exact, and a forecast that is never wrong is a timetable. So the
-- page gets a forecaster's calls instead: each planned change is given a rounded time and
-- a sky, both off by an error that shrinks as the change gets closer, and a percentage
-- that is how often a call made that far ahead comes true. MCM's "Exact weather forecast"
-- shows the plan itself.
--
-- A call is a pure function of the change it describes, so reopening the PDA shows the
-- same forecast, and it is only revised because the change got closer. The arithmetic
-- avoids bit operations so LuaJIT and the Lua the tests run give the same numbers.

-- where a wrong call lands: the next sky over, never the far end
local NEIGHBOURS = {
    clear  = {"partly"},
    partly = {"clear", "cloudy"},
    cloudy = {"partly", "foggy", "rain"},
    foggy  = {"cloudy", "partly"},
    rain   = {"cloudy", "storm"},
    storm  = {"rain"},
}

local PM = 2147483647                   -- Park-Miller's modulus, 2^31 - 1

-- n numbers in (0, 1), fixed by the change's minute and sky
local function draws(minute, cycle, n)
    local h = 7
    local s = tostring(cycle)
    for i = 1, #s do h = (h * 31 + s:byte(i)) % PM end
    local x = (math.floor(minute) * 104729 + h * 7919) % (PM - 1) + 1
    local out = {}
    for i = 1, n + 3 do
        x = (x * 16807) % PM
        if i > 3 then out[i - 3] = x / PM end      -- the first few track the seed too closely
    end
    return out
end

-- 98% right an hour out, 82% a day out: about one call in ten wrong across a day
local function accuracy(lead)
    local a = 0.98 - 0.16 * lead / 1440
    if a < 0.82 then a = 0.82 elseif a > 0.98 then a = 0.98 end
    return a
end

-- shown to the nearest 5, and never 100: a forecast is never certain
local function chance(lead)
    local p = math.floor(accuracy(lead) * 20 + 0.5) * 5
    if p > 95 then p = 95 end
    return p
end

-- One planned change as a forecaster would call it. prev is the sky before it; a call has
-- to differ from it, because "rain, then rain" is not a change.
local function call(minute, cycle, now, prev)
    local lead = minute - now
    local u = draws(minute, cycle, 4)
    local said = cycle
    if u[1] < 1 - accuracy(lead) then
        local opts = {}
        for _, c in ipairs(NEIGHBOURS[cycle] or {}) do
            if c ~= prev then opts[#opts + 1] = c end
        end
        if #opts > 0 then said = opts[math.floor(u[2] * #opts) + 1] end
    end
    -- the time is off by up to 2.5 sigma, sigma 8% of the lead: about two hours a day out
    local z = math.sqrt(-2 * math.log(u[3])) * math.cos(2 * math.pi * u[4])
    if z > 2.5 then z = 2.5 elseif z < -2.5 then z = -2.5 end
    local step = (lead > 180 and 30) or (lead > 60 and 15) or 5
    local t = math.floor((minute + z * 0.08 * lead) / step + 0.5) * step
    return said, t, chance(lead), step
end

-- The plan reaches 24 game hours ahead, and so does the forecast. A call its own error
-- pushes past that is dropped rather than shown a day and a half out.
local HORIZON = 1440

-- The page's forecast for a plan: segments as calls, in the same shape plus `chance`.
local function forecast_calls(now_cycle, segments, now, clock)
    local out, prev, last = {}, now_cycle, now
    for _, seg in ipairs(segments) do
        local minute = now + seg.away
        local said, t, p, step = call(minute, seg.cycle, now, prev)
        if said ~= prev then
            -- two calls can cross when their errors point at each other; keep them in order
            if t <= last then t = last + step end
            if t - now > HORIZON then break end
            out[#out + 1] = {at = clock(t), cycle = said, away = t - now, chance = p}
            prev, last = said, t
        end
    end
    return out
end

-- Base Anomaly draws the next sky with math.random from a list it builds at the moment of
-- change, and that list is already fixed: every sky but the current one, less those used
-- up (a sky may come twice before the list resets, once if its occurrence option is 2).
-- So these odds are exact. Mirrors level_weathers' get_next_weather_cycle and, for an
-- empty list, get_random_weather.
local function stock_odds(wm)
    local ok, cycles = pcall(function()
        return utils_data.collect_section(ini_file("environment\\dynamic_weather_graphs.ltx"),
                                          "weather_cycles")
    end)
    if not (ok and type(cycles) == "table" and #cycles > 0) then return nil end
    local storage = wm.weather_storage
    if type(storage) ~= "table" then return nil end
    local used = {}
    for i = 1, #storage do used[storage[i]] = (used[storage[i]] or 0) + 1 end
    local function occurrence(c)
        local okv, v = pcall(function()
            return ui_options.get("video/weather/" .. c .. "_occurrence")
        end)
        return (okv and tonumber(v)) or 3
    end
    local avail = {}
    for _, c in ipairs(cycles) do
        if c ~= wm.cycle then
            local v, n = occurrence(c), used[c] or 0
            if (v > 2.5 and n < 2) or (v > 1.5 and n < 1) then avail[#avail + 1] = c end
        end
    end
    if #avail == 0 then
        for _, c in ipairs(cycles) do
            if occurrence(c) > 1 then avail[#avail + 1] = c end
        end
        if #avail == 0 then
            for _, c in ipairs(cycles) do avail[#avail + 1] = c end
        end
    end
    local out = {}
    for _, c in ipairs(avail) do out[#out + 1] = {cycle = c, chance = 1 / #avail} end
    return out
end

function forecast_page()
    local out = {today = today_text()}

    -- the same accent strip the calendar page wears, so the two read as one mod rather
    -- than two addons that happen to be installed together: the season running, which a
    -- pin, the dice or a spell can make another than the calendar's
    pcall(function()
        local cur = season_at(zone_today().yday, zone_today().year)
        out.season = cur
        out.bar    = "ui_season_hdr_" .. tostring(season_now().key)
    end)

    -- --- what the ecologists will tell you ------------------------------------------------
    --
    -- Anomaly tasks carry no completion deadlines - 621 base tasks and every installed
    -- task mod were checked, and not one has a time limit - so there is nothing there to
    -- put on a calendar. Emissions ARE scheduled, but they do not belong on one either:
    -- emission_frequency 24 makes _delta a random 12-24 GAME hours, and time_factor 6
    -- turns that into one every 2-4 real hours. Six to twelve per real calendar day. The
    -- answer to "is there an emission in the next few days" is always yes, several times,
    -- which is no answer at all.
    --
    -- The live reading is worth having; the question is how much of it you have earned.
    -- The ecologists are the faction that measures this, so the resolution is bought with
    -- standing among them rather than with a detector - or with Clear Sky or UNISG, who run
    -- instruments of their own, when MCM says so (forecast_standing).

    -- Both managers compute the next event as _delta minus the time since the last, which
    -- is what CSurgeManager:new_surge_time and its psi-storm twin do internally. Read the
    -- module's own singleton rather than calling get_surge_manager(), because the getter
    -- CONSTRUCTS the manager when none exists and CSurgeManager:__init allocates a dozen
    -- sound_object handles. This only ever reads a manager the game already made.
    -- Returns seconds and a reason, because "nil" was covering four different states and
    -- the page could not tell them apart:
    --
    --   no-mgr    nothing has built the manager yet
    --   no-flds   it exists but _delta or the timestamp is not set
    --   due       the wait has already elapsed - an emission is imminent, which is the
    --             most useful thing the page can say and was being reported as nothing
    --   ok        a real countdown
    -- An X-Ray class instance is USERDATA, not a table. Every version of this check
    -- tested for "table" and therefore threw away a manager the game had handed over
    -- perfectly intact - which is why the forecast read "no reading" for hours while the
    -- surge manager was sitting there answering every call put to it.
    local function is_obj(v)
        local ty = type(v)
        return ty == "table" or ty == "userdata"
    end

    local function seconds_until(mgr, since)
        if not is_obj(mgr) then return nil, "no-mgr" end
        -- field access on userdata goes through __index, so it can raise
        local ok_f, delta, stamp = pcall(function() return mgr._delta, mgr[since] end)
        if not ok_f then return nil, "fields-threw" end
        if type(delta) ~= "number" or not stamp then return nil, "no-flds" end
        mgr = {_delta = delta, [since] = stamp}
        local ok, left = pcall(function()
            return math.floor(mgr._delta - game.get_game_time():diffSec(mgr[since]))
        end)
        if not (ok and type(left) == "number") then return nil, "err" end
        if left <= 0 then return 0, "due" end
        return left, "ok"
    end

    -- The period the frequency option implies, in game seconds. Both managers roll
    -- _delta in [freq/2, freq] hours, so freq hours is the longest wait there can be.
    local function period(key, fallback)
        local ok, v = pcall(function() return ui_options.get(key) end)
        if not (ok and type(v) == "number" and v > 0) then v = fallback end
        return v * 3600
    end

    -- A band is a FRACTION of the period, never an hour count, so it keeps its meaning
    -- whoever moves the frequency slider: at the stock 24 "building" is a few hours, at
    -- 168 it is most of a day. This is the whole point of the coarse tier - it tells you
    -- to get indoors without telling you exactly when, which is what the ecologists would
    -- actually say over a radio.
    -- What a relayed warning is actually worth. The ecologists are reading their own
    -- instruments and passing a bulletin down a bunker relay; a bracket is honest about
    -- that in a way a single number would not be, and eight hours of slop still tells a
    -- stalker whether to start walking back.
    --
    -- Fixed hours rather than a fraction of the period: "two to eight hours" means the
    -- same thing whatever the frequency slider says, whereas a fraction silently became
    -- a different warning when someone moved it.
    --
    -- The words are the API's, which sotz_api and the devices that read it key on, so
    -- they stay English whatever the language. The string id beside each is what the
    -- page shows.
    local function bracket(left)
        if not left then return nil end
        local h = left / 3600.0
        if h <= 2  then return "WITHIN 2 HOURS", "st_sotz_fc_band_within_2" end
        if h <= 8  then return "2 to 8 hours",   "st_sotz_fc_band_2_to_8"   end
        if h <= 16 then return "8 to 16 hours",  "st_sotz_fc_band_8_to_16"  end
        return "ALL CLEAR", "st_sotz_fc_band_all_clear"
    end

    -- Under two hours is the point where this stops being a forecast and becomes a
    -- warning. Both tiers raise it: a LIMITED "WITHIN 2 HOURS" means the same thing to
    -- the player as a CLEARED "1 hour".
    local ALERT_SECONDS = 2 * 3600

    if mcm("forecast", true) then
        local st, faction = forecast_standing()
        local need = mcm("forecast_coarse", FORECAST_COARSE)
        local full = mcm("forecast_exact",  FORECAST_EXACT)
        local tier = "locked"
        if st then
            if st >= full then tier = "exact" elseif st >= need then tier = "coarse" end
        end
        out.forecast = {tier = tier, standing = st, need = need, need_exact = full,
                        faction = faction}

        -- Read ALWAYS, expose by tier. Computing only when the tier allowed it meant a
        -- locked page and an unreachable surge manager produced identical nils, so there
        -- was no way to tell "withheld" from "broken" without standing over the screen.
        -- Reach the manager by the module global first, and fall back to the public
        -- getter.
        --
        -- The getter was avoided originally because it CONSTRUCTS on a miss and
        -- CSurgeManager:__init allocates a dozen sound_object handles. That caution was
        -- misplaced: surge_manager.main_loop runs on AddUniqueCall and calls
        -- get_surge_manager():update() every second once the actor has had its first
        -- update, so by the time a PDA can be open the manager already exists and the
        -- getter is a plain read. Avoiding it only meant reading a global that was
        -- coming back nil and reporting no forecast at all.
        local function reach(mod, global_name, getter_name)
            if type(mod) ~= "table" then
                return nil, "no-mod(" .. type(mod) .. ")"
            end
            local g = rawget(mod, global_name)
            if is_obj(g) then return g, "global" end

            -- Do not type-check the getter, just call it. Anything callable will do,
            -- and pcall reports whatever goes wrong - which is both more robust and
            -- harness-agnostic: lupa hands Python callables to Lua as userdata rather
            -- than function, so a type test rejected a getter that worked perfectly.
            local fn = rawget(mod, getter_name)
            if fn == nil then
                -- say what the module DOES hold, so a wrong table shows itself
                local keys, n = {}, 0
                for k in pairs(mod) do
                    n = n + 1
                    if n <= 6 then keys[#keys + 1] = tostring(k) end
                end
                return nil, string.format("no-getter(n=%d %s)", n,
                                          table.concat(keys, ","))
            end

            local ok, made = pcall(fn)
            if ok and is_obj(made) then return made, "getter" end
            if not ok then
                return nil, "getter-threw(" .. tostring(made):sub(1, 60) .. ")"
            end
            return nil, "getter-gave(" .. type(made) .. ")"
        end

        local sm, s_how = reach(surge_manager, "SurgeManager", "get_surge_manager")
        local pm, p_how = reach(psi_storm_manager, "PsiStormManager",
                                "get_psi_storm_manager")

        local s, s_why = seconds_until(sm, "last_surge_time")
        local p, p_why = seconds_until(pm, "last_psi_storm_time")
        s_why = s_how .. ":" .. s_why
        p_why = p_how .. ":" .. p_why
        -- why each one reads the way it does. Engine state rather than timing, so it is
        -- not something the gate is keeping from anyone.
        out.mgr_surge = s_why
        out.mgr_psi   = p_why

        if tier == "exact" then
            out.surge, out.psi = s, p
        elseif tier == "coarse" then
            out.surge_band, out.surge_band_id = bracket(s)
            out.psi_band,   out.psi_band_id   = bracket(p)
        end

        -- The flag only exists for a tier that is allowed to know. At locked it stays
        -- false, because a strobe would leak the one thing being withheld.
        if tier ~= "locked" then
            out.surge_alert = (s ~= nil and s <= ALERT_SECONDS)
            out.psi_alert   = (p ~= nil and p <= ALERT_SECONDS)
        else
            out.surge_alert, out.psi_alert = false, false
        end
    end

    -- --- the weather plan ------------------------------------------------------------------
    -- Atmospherics does not guess the weather, it PLANS it: WeatherManager:roll_day_plan
    -- extends self.day_plan to DAY_PLAN_WINDOW_MINUTES - 24 game hours - ahead, as a list
    -- of {minute, cycle}. `segments` is that schedule, read straight off; `forecast` is
    -- the same schedule as a forecaster would call it (see forecast_calls).
    --
    -- Ungated, unlike the emission tiers. Weather is something a stalker reads by looking
    -- up, the ecologists have no special claim on it, and it gives the page something to
    -- say at zero standing rather than a single locked row.
    --
    -- weather_manager is a FILE-LOCAL in level_weathers, so unlike the surge managers it
    -- can only be reached through its getter. That is safe here: Atmospherics constructs
    -- it itself to drive the weather, so it exists long before a PDA is open, and this
    -- mod already calls the same getter in hold_cycle().
    local function clock(abs_minute)
        local m = abs_minute % 1440
        return string.format("%02d:%02d", math.floor(m / 60), m % 60)
    end

    out.weather_source = weather_source()

    -- Stock weather. The sky now, and the window it turns in: base re-rolls the change
    -- time each hour between two thirds of the period and all of it, so the change lands
    -- somewhere in that window and nowhere else. What it turns TO is drawn at random at
    -- the moment of change, so no next sky is given, only the odds of each.
    if out.weather_source == "stock" then
        pcall(function()
            local wm = level_weathers.get_weather_manager()
            if not (wm and wm.cycle) then return end
            local w = {now = wm.cycle, segments = {}, source = "stock"}
            local okp, len = pcall(function()
                return ui_options.get("video/weather/" .. tostring(wm.cycle) .. "_period")
            end)
            len = (okp and tonumber(len)) or 6
            local oke, elapsed = pcall(function()
                return game.get_game_time():diffSec(wm.last_period_change_date)
            end)
            if oke and type(elapsed) == "number" then
                local lo = math.ceil(len * 2 / 3) * 3600 - elapsed
                local hi = len * 3600 - elapsed
                -- minutes, like a planned segment's `away`, so one formatter serves both
                w.window = {lo = math.max(0, math.floor(lo / 60)),
                            hi = math.max(0, math.floor(hi / 60))}
            end
            local oko, odds = pcall(stock_odds, wm)
            if oko then w.odds = odds end
            out.weather = w
        end)
        return out
    end

    pcall(function()
        if not (level_weathers and level_weathers.get_weather_manager) then return end
        local wm = level_weathers.get_weather_manager()
        if not (wm and wm.day_plan and wm.abs_schedule_minute) then return end

        local now = wm:abs_schedule_minute()
        local w   = {now = wm.cycle, segments = {}, source = "plan"}
        local last = wm.cycle
        for i = (wm.day_plan_index or 1), #wm.day_plan do
            local seg = wm.day_plan[i]
            -- the plan repeats a cycle to extend a spell; only the CHANGES are forecast
            if seg and seg.minute and seg.minute > now and seg.cycle ~= last then
                w.segments[#w.segments + 1] = {
                    at = clock(seg.minute), cycle = seg.cycle, away = seg.minute - now,
                }
                last = seg.cycle
                if #w.segments >= 6 then break end
            end
        end
        -- segments stay the plan itself; the page shows the calls unless MCM asks for exact
        w.exact = mcm("wx_exact", false) and true or false
        local okf, calls = pcall(forecast_calls, w.now, w.segments, now, clock)
        if okf then w.forecast = calls end
        out.weather = w
    end)

    return out
end

function on_game_start()
    RegisterScriptCallback("save_state", save_state)
    RegisterScriptCallback("load_state", load_state)
    RegisterScriptCallback("actor_on_first_update", actor_on_first_update)
    RegisterScriptCallback("actor_on_update", actor_on_update)
    RegisterScriptCallback("on_option_change", on_option_change)
    say(string.format("armed - re-assert %ds, calendar re-check %dmin",
        CHECK_MS / 1000, DATE_MS / 60000))
end
