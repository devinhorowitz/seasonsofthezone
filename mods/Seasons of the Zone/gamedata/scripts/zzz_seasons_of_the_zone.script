-- Seasons of the Zone
--
-- Ties the Zone's light, foliage, fog and wind to the REAL-WORLD date, mapped onto the
-- actual phenological seasons of Polesia - the region the Zone sits in. Boot the game in
-- late October and the Zone is in autumn because Chornobyl is in autumn.
--
-- Self-contained: no external tooling, no generated state. It reads the date with
-- os.date(), reads its parameters from configs/seasons_of_the_zone.ltx, and drives the
-- engine directly. Everything is tunable from MCM or that one config file.
--
-- WHAT IT CANNOT DO
--   Terrain and grass TEXTURES bind at level load from MO2's virtual file system and are
--   frozen for the session. No runtime API rebinds them - the only reload_textures() in
--   the install calls ChangeLevel(). Seasonal textures therefore still require swapping
--   mod files and relaunching, which a shipped mod cannot do to itself. This drives every
--   NON-texture layer, which is most of the visible difference.
--
-- WHY IT RE-ASSERTS INSTEAD OF APPLYING ONCE
--   SSS's own ssfx_fog / ssfx_florafixes / ssfx_wind scripts push their MCM values at
--   game start and again on every option change. Applying once races them. This re-checks
--   the engine periodically and re-asserts only what has actually drifted, which also
--   survives the player opening MCM mid-session.
--
-- THE FAILURE MODE THIS CODE IS BUILT AROUND
--   X-Ray REJECTS A WHOLE console command when ANY single component is out of range. It
--   does NOT clamp. The only trace is one line - "~ Invalid syntax in call to 'ssfx_fog'"
--   - and the old value stays, so a readback returns a plausible number and nothing looks
--   broken. A previous version of this system shipped fog height 28.0 against an engine
--   max of 20.0 and silently did nothing for weeks. Hence: clamp on the way out, read
--   back after every set, and distinguish "something overwrote us" from "the engine
--   refused us" instead of retrying a rejected command forever.

local CFG        = "seasons_of_the_zone.ltx"
local PREFIX     = "seasons_zone/"
local CHECK_MS   = 5000      -- how often to re-assert drifted uniforms
local DATE_MS    = 600000    -- how often to re-read the calendar (long sessions, midnight)
local GIVE_UP    = 5         -- consecutive refusals before we stop retrying a uniform

-- Phenological season starts for Polesia / northern Ukraine. Deliberately lopsided and
-- NOT the astronomical equinox/solstice dates. Stored as month/day and converted per-year
-- so leap years stay exact.
--
-- WINTER IS SPLIT IN TWO, because in Polesia those are genuinely different worlds:
--   winter        1 Nov - 30 Nov   30d  first snowfall, ground not yet covered
--   winter_snow   1 Dec -  4 Mar   94d  snow lies on the ground
-- Treating that as one 110-day "winter" meant either snow two months too early or bare
-- ground through February.
--
-- DATES ARE RESEARCHED, NOT GUESSED (see the 2026-09-18 changelog for sources):
--   "November marks the beginning of snowfall" and cover "accumulates in December and
--   remains to early March" for Kyiv/northern Ukraine. Kyiv averages ~80 days of snow
--   cover a year (~100 in colder decades); Chernobyl sits ~130 km further north, hence 94.
--   Spring starts as the cover goes, so it owns the wet thaw BEFORE green-up - the Polish
--   growing season (52N, same continental transition) now begins 12 March.
--   Autumn is anchored on birch leaf colouring/fall, 19 September in Poland 2007-2021;
--   October is peak "golden autumn" in Ukraine - zhovten, the month named for yellow.
local BOUNDS = {
    {m = 3,  d = 5,  season = "spring"},       -- 76d,  thaw then green-up
    {m = 5,  d = 20, season = "summer"},       -- 118d, full foliage
    {m = 9,  d = 15, season = "autumn"},       -- 47d,  the turn, peaking in October
    {m = 11, d = 1,  season = "winter"},       -- 30d,  first snowfall, bare ground
    {m = 12, d = 1,  season = "winter_snow"},  -- 94d,  cover (wraps the year end)
}

-- Engine-enforced bounds. Anything sent outside these is discarded WHOLESALE, so we clamp
-- first and say so. Sourced from the SSS MCM sliders and confirmed against the engine's
-- own "~ Valid arguments: vector4 in range [...]" line, which it prints on every refusal.
local RANGES = {
    saturation = {0.0, 2.0}, gamma = {0.0, 2.0}, exposure = {0.0, 2.0},
    spec_grass = {0.0, 1.0}, spec_grass_wet = {0.0, 1.0},
    spec_trees = {0.0, 1.0}, spec_trees_wet = {0.0, 1.0},
    sss_int = {0.0, 10.0}, sss_color = {0.0, 1.0},
    fog_height = {0.0, 20.0}, fog_density = {0.0, 5.0},
    fog_suncolor = {0.0, 1.0}, fog_scattering = {0.0, 1.0},
    wind_grass_speed = {0.1, 13.0}, wind_grass_turbulence = {0.1, 3.0},
    wind_grass_push = {0.1, 3.0}, wind_grass_wave = {0.1, 1.0},
    wind_trees_speed = {0.1, 13.0}, wind_trees_trunk = {0.1, 0.3},
    wind_trees_bend = {0.1, 2.0}, wind_min_speed = {0.0, 1.0},
    wet_buildup = {0.1, 20.0}, wet_dry = {0.1, 20.0},
}

-- keys  : config keys to interpolate, in component order
-- pad   : trailing zeros the command needs but we do not drive
-- check : how many leading components to verify on readback
-- layer : which MCM toggle owns it
local UNIFORMS = {
    {name = "r__color_grading",      layer = "grade", keys = {"grade_r", "grade_g", "grade_b"}},
    {name = "r__saturation",         layer = "grade", keys = {"saturation"}},
    {name = "r__gamma",              layer = "grade", keys = {"gamma"}},
    {name = "r__exposure",           layer = "grade", keys = {"exposure"}},
    {name = "r2_sun_lumscale",       layer = "grade", keys = {"sun_lumscale"}},
    {name = "r2_sun_lumscale_hemi",  layer = "grade", keys = {"sun_lumscale_hemi"}},
    {name = "r2_sun_lumscale_amb",   layer = "grade", keys = {"sun_lumscale_amb"}},
    {name = "r2_tonemap_adaptation", layer = "grade", keys = {"tonemap_adaptation"}},
    {name = "r2_tonemap_lowlum",     layer = "grade", keys = {"tonemap_lowlum"}},
    {name = "r2_tonemap_middlegray", layer = "grade", keys = {"tonemap_middlegray"}},
    {name = "ssfx_hud_hemi",         layer = "grade", keys = {"hud_hemi"}},
    {name = "r2_sunshafts_value",    layer = "grade", keys = {"sunshafts_value"}},

    {name = "ssfx_florafixes_1", layer = "flora",
     keys = {"spec_grass", "spec_grass_wet", "spec_trees", "spec_trees_wet"}},
    {name = "ssfx_florafixes_2", layer = "flora", keys = {"sss_int", "sss_color"}, pad = 2},

    -- Pinned at zero on purpose, NOT a seasonal tint. The shader does
    --     color_variation(t) = sin(t + float3(0, 0.33, 0.66) * 6.28) * 0.5
    -- three sine waves a third of a cycle apart = a HUE ROTATION in all directions, not a
    -- shift toward amber. Driving it at 0.30 turned foliage red and dark blue. It is a
    -- per-instance decorrelation knob. Held at the shipped default so nothing else moves it.
    {name = "ssfx_floravariation", layer = "flora", const = {0, 0, 0, 0}},

    {name = "ssfx_fog", layer = "fog",
     keys = {"fog_height", "fog_density", "fog_suncolor"}, pad = 1},
    {name = "ssfx_fog_scattering", layer = "fog", keys = {"fog_scattering"}},

    {name = "ssfx_wind_grass", layer = "wind",
     keys = {"wind_grass_speed", "wind_grass_turbulence", "wind_grass_push", "wind_grass_wave"}},
    {name = "ssfx_wind_trees", layer = "wind",
     keys = {"wind_trees_speed", "wind_trees_trunk", "wind_trees_bend", "wind_min_speed"}},

    -- How fast surfaces take on water and how fast they give it up. The thaw is what
    -- makes a Polesian spring wet, so spring builds fast and dries at 0.18; summer dries
    -- at 1.20, i.e. wet only while it is actually raining.
    --
    -- This is the ONLY runtime lever on wetness. Puddle geometry is compile-time
    -- #defines in settings_screenspace_PUDDLES.h with no console equivalent - which is
    -- why INVERNO ships a modified header instead of a setting.
    {name = "ssfx_wetness_multiplier", layer = "wet",
     keys = {"wet_buildup", "wet_dry"}, pad = 1},
}

-- Dynamic Tonemap Extended (a stock-GAMMA opt-in, off by default) drives these five on a
-- timer of 60/time_factor seconds. Two writers on one console value is a visible pulse -
-- it pushes, we re-assert, it pushes - and no modlist position can fix a fight between
-- scripts. So while its module is loaded these five are its, and the log says so once.
-- Referencing the global is safe: Anomaly resolves an unknown script name to nil.
local DTE_OWNS = {
    r2_tonemap_adaptation = true, r2_tonemap_lowlum = true, r2_tonemap_middlegray = true,
    r2_sun_lumscale_amb = true, r2_sun_lumscale_hemi = true,
}
local dte_said   = false

local P          = nil   -- P[season][key] = number, loaded from the ltx
local want       = nil   -- resolved command list for the current blend
-- What apply() last resolved: {mode, season}. The MCM panel needs this and cannot work it
-- out for itself - ui_mcm.get() asserts when called from on_mcm_load (ui_mcm.script:705),
-- so the panel has no way to read the pin at the moment it is being built. Caching what
-- apply() resolved sidesteps that, and unlike reading the stored setting back it cannot go
-- stale: this is set by the code that actually pushed the season to the engine.
local live       = nil
local reasserts  = {}
local fails      = {}
local dead       = {}
local next_check = 0
local next_date  = 0
local last_label = nil

local function say(msg)
    printf("%s", "[seasons] " .. msg)
end

-- Config keys are not prose. "winter_snow" must never reach the player: it leaked into
-- the PDA feed as "Winter giving way to winter_snow".
local DISPLAY = {winter_snow = "deep winter"}

local function name_of(s)
    return DISPLAY[s] or tostring(s)
end

local function cap(s)
    local v = name_of(s)
    return v:sub(1, 1):upper() .. v:sub(2)
end

-- Fixed English month names. os.date("%B") is locale-dependent and hands back the OS
-- codepage's bytes, which the game's cp1251 font renders as garbage on any Windows that
-- is neither English nor Cyrillic. Every other string on the panel is English; so is this.
local MONTHS = {"January", "February", "March", "April", "May", "June", "July",
                "August", "September", "October", "November", "December"}

local function today_text()
    local t = os.date("*t")
    return string.format("%d %s %d", t.day, MONTHS[t.month] or tostring(t.month), t.year)
end

local function mcm(key, default)
    if ui_mcm and ui_mcm.get then
        local ok, v = pcall(ui_mcm.get, PREFIX .. key)
        if ok and v ~= nil then return v end
    end
    return default
end

local function q(name)
    local ok, v = pcall(function() return get_console():get_string(name) end)
    return (ok and v) and tostring(v) or nil
end

local function nums(s)
    local t = {}
    for n in tostring(s or ""):gmatch("%-?%d+%.?%d*") do t[#t + 1] = tonumber(n) end
    return t
end

-- compare only the leading `count` components: the engine echoes 6 decimals and pads
local function matches(got, target, count)
    local a, b = nums(got), nums(target)
    if #a == 0 or #b == 0 then return false end
    for i = 1, math.min(count, #b) do
        if not a[i] or math.abs(a[i] - b[i]) > 0.0005 then return false end
    end
    return true
end

local function lerp(a, b, k) return a + (b - a) * k end

local function clamp(key, v)
    local r = RANGES[key]
    if not r then return v, false end
    if v < r[1] then return r[1], true end
    if v > r[2] then return r[2], true end
    return v, false
end

-- exact day-of-year for a month/day in a given year, leap years included
local function doy_of(m, d, year)
    return tonumber(os.date("%j", os.time({year = year, month = m, day = d, hour = 12})))
end

local function circ(delta, len)
    if delta >  len * 0.5 then delta = delta - len end
    if delta < -len * 0.5 then delta = delta + len end
    return delta
end

local function load_table()
    local ini = ini_file(CFG)
    if not ini then return nil end
    local out = {}
    for _, s in ipairs({"spring", "summer", "autumn", "winter",
                        "winter_snow", "neutral"}) do
        if not ini:section_exist(s) then
            say("!config section [" .. s .. "] missing from " .. CFG)
            return nil
        end
        out[s] = {}
        for _, u in ipairs(UNIFORMS) do
            for _, k in ipairs(u.keys or {}) do
                local v = ini:r_float_ex(s, k)
                if v == nil then
                    say("!config [" .. s .. "] is missing '" .. k .. "'")
                    return nil
                end
                out[s][k] = v
            end
        end
    end
    return out
end

-- Which seasons are we between, and how far across? Returns from, to, k (0..1).
-- Away from a boundary from == to and k == 1, so callers need no special case.
local function resolve(blend_days)
    local now  = os.date("*t")
    local year = now.year
    local doy  = tonumber(os.date("%j"))
    local len  = doy_of(12, 31, year)

    if blend_days > 0 then
        for i, b in ipairs(BOUNDS) do
            local d = circ(doy - doy_of(b.m, b.d, year), len)
            if d >= -blend_days * 0.5 and d <= blend_days * 0.5 then
                local prev = BOUNDS[(i - 2) % #BOUNDS + 1].season
                return prev, b.season, (d + blend_days * 0.5) / blend_days
            end
        end
    end

    local cur = BOUNDS[#BOUNDS].season          -- before the first boundary = winter
    for _, b in ipairs(BOUNDS) do
        if doy >= doy_of(b.m, b.d, year) then cur = b.season end
    end
    return cur, cur, 1.0
end

local function fmt(v)
    return string.format("%.4f", v)
end

-- How wintry the Zone is right now, 0..1.
--
-- Snowfall rides on this rather than on a date test, so snow fades IN across the turn
-- into winter and OUT again, instead of switching on at midnight on 25 November. It also
-- honours the MCM enable switch and a pinned season.
--
-- CACHED: yawm_snowfall.script calls this from actor_on_update, i.e. every frame, and
-- resolve() does os.date/os.time work that has no business running at that rate.
local snow_cached, snow_cache_until = 0.0, 0

function snow_factor()
    local tg = time_global()
    if tg < snow_cache_until then return snow_cached end
    snow_cache_until = tg + 5000

    -- Snow falls in BOTH winter seasons, harder once the ground is covered. Lerping the
    -- weights through the same from/to/k the rest of the mod uses means every transition
    -- (autumn->winter, winter->winter_snow, winter_snow->spring) eases automatically.
    local SNOW_WEIGHT = {winter = 0.60, winter_snow = 1.00}

    local v = 0.0
    if mcm("enabled", true) then
        local mode = mcm("mode", "auto")
        if mode ~= "auto" then
            v = SNOW_WEIGHT[mode] or 0.0
        else
            local from, to, k = resolve(mcm("blend_days", 14))
            local a = SNOW_WEIGHT[from] or 0.0
            local b = SNOW_WEIGHT[to] or 0.0
            v = a + (b - a) * k
        end
    end
    snow_cached = v
    return v
end


-- The current blend as a weight per season, summing to 1.
--
-- snow_factor() answers "how wintry is it"; this answers "how much of each season is in
-- play", which is what any OTHER seasonal effect needs. Drifting seeds belong to spring,
-- falling leaves to autumn, and a consumer can ask for the blend of whichever seasons it
-- cares about without this file knowing anything about particles.
--
-- CACHED for the same reason snow_factor() is: the snowfall script calls it every frame.
local mix_cached, mix_until = nil, 0

function season_mix()
    local tg = time_global()
    if mix_cached and tg < mix_until then return mix_cached end
    mix_until = tg + 5000

    local m = {spring = 0, summer = 0, autumn = 0, winter = 0, winter_snow = 0}
    if mcm("enabled", true) then
        local mode = mcm("mode", "auto")
        if mode ~= "auto" and m[mode] then
            m[mode] = 1.0
        else
            local from, to, k = resolve(mcm("blend_days", 14))
            if from == to then
                m[to] = 1.0
            else
                m[from] = 1.0 - k
                m[to]   = k
            end
        end
    end
    mix_cached = m
    return m
end

-- Which pre-rendered dial matches today.
--
-- 16 positions around the year, ~23 days apart. That granularity is only possible
-- because the EXACT date is NOT baked into the texture - it is drawn as live text in the
-- row above. Baking the date would need one texture per day.
DIAL_POSITIONS = 32

-- which season a day-of-year falls in, ignoring blending
local function season_at(doy, year)
    local cur = BOUNDS[#BOUNDS].season          -- before the first boundary
    for _, b in ipairs(BOUNDS) do
        if doy >= doy_of(b.m, b.d, year) then cur = b.season end
    end
    return cur
end

-- Pick the dial whose OWN date falls in the same season as today, nearest to today.
--
-- Choosing purely by day-of-year is wrong near a boundary: each texture bakes in which
-- arc is highlighted, so a dial rendered a few days the other side of a boundary lights
-- the wrong season. That is exactly what happened on 18 September - the nearest position
-- had been rendered for 9 September, still summer under the researched dates, so the
-- panel highlighted SUMMER while the world was in autumn. Winter is only 30 days, which
-- is shorter than the old 23-day sampling step, so it could have been skipped entirely.
function dial_texture()
    local year = os.date("*t").year
    local doy  = tonumber(os.date("%j"))
    local yl   = doy_of(12, 31, year)
    local want = season_at(doy, year)

    local best, best_d
    for i = 0, DIAL_POSITIONS - 1 do
        local day = math.floor(i * yl / DIAL_POSITIONS + 0.5) + 1
        if season_at(day, year) == want then
            local d = math.abs(day - doy)
            if d > yl / 2 then d = yl - d end   -- wrap the year end
            if not best_d or d < best_d then best, best_d = i, d end
        end
    end
    return string.format("ui_seasons_dial_%02d.dds", best or 0)
end


-- The season calendar, as rows for the MCM panel.
--
-- Touches no game state and no MCM cache, so it is safe to build the settings menu from -
-- including at the main menu, before any save is loaded. Each row is {text, current},
-- and the caller decides how to mark the current one.
function calendar_rows()
    local year = os.date("*t").year
    local doy  = tonumber(os.date("%j"))

    local cur = BOUNDS[#BOUNDS].season          -- before the first boundary = winter
    for _, b in ipairs(BOUNDS) do
        if doy >= doy_of(b.m, b.d, year) then cur = b.season end
    end

    local today = today_text()

    local rows = {}

    -- ONE header row stating the date, and - only when they disagree - one saying so.
    --
    -- The dial tracks the DATE, so with a season pinned its centre reads one season while
    -- the world runs another. That is honest but it puts the largest element on the page
    -- in contradiction with what you are standing in, so name the difference.
    --
    -- An earlier version of this line read the setting back through axr_main.config,
    -- because ui_mcm.get() cannot be called from on_mcm_load() (ui_mcm.script:705), and
    -- that read went stale: the panel announced "Pinned to Winter_snow" while the dropdown
    -- three rows below read "Automatic (real date)" and the game was, correctly, on
    -- automatic. This instead reports what apply() actually resolved and pushed to the
    -- engine, so it cannot disagree with the world. It stays silent until the mod has run
    -- once - opened from the main menu there is no running season to report - and silent
    -- when the pin agrees with the calendar, because then there is nothing to explain.
    rows[#rows + 1] = {text = "Today is " .. today .. ".", current = false}

    if live and live.mode ~= "auto" and live.season ~= cur then
        rows[#rows + 1] = {
            text = "Pinned to " .. name_of(live.season) .. " - the calendar reads "
                   .. name_of(cur) .. ".",
            current = true,
        }
    end

    return rows
end

-- Resolve every uniform to a concrete command for the current blend.
local function build(from, to, k, intensity, layers)
    local out, clamped = {}, {}
    local dte = (dynamic_tonemap ~= nil)
    if dte and not dte_said then
        dte_said = true
        say("Dynamic Tonemap Extended is loaded - leaving tonemap adaptation/lowlum/"
            .. "middlegray and sun lumscale amb/hemi to it (5 of 12 grade uniforms)")
    end
    for _, u in ipairs(UNIFORMS) do
        if layers[u.layer] and not (dte and DTE_OWNS[u.name]) then
            local parts, n
            if u.const then
                parts, n = {}, #u.const
                for _, c in ipairs(u.const) do parts[#parts + 1] = fmt(c) end
            else
                parts, n = {}, #u.keys
                for _, key in ipairs(u.keys) do
                    -- blend the two seasons, then blend that toward neutral by intensity.
                    -- Both endpoints are in range, so the result is too - clamp() only
                    -- ever fires on a hand-edited config value.
                    local v = lerp(P[from][key], P[to][key], k)
                    v = lerp(P.neutral[key], v, intensity)
                    local c, hit = clamp(key, v)
                    if hit then clamped[#clamped + 1] = key end
                    parts[#parts + 1] = fmt(c)
                end
                for _ = 1, (u.pad or 0) do parts[#parts + 1] = "0" end
            end

            local val, cmd
            if #parts > 1 then
                val = "(" .. table.concat(parts, ",") .. ")"
                cmd = u.name .. " " .. val
            else
                val = parts[1]
                cmd = u.name .. " " .. val
            end
            out[#out + 1] = {name = u.name, val = val, cmd = cmd, n = n}
        end
    end
    if #clamped > 0 then
        say("!clamped out-of-range config value(s): " .. table.concat(clamped, ", ")
            .. " - the engine would have discarded the whole command")
    end
    return out
end

-- Re-assert what drifted, and tell the two failure modes apart.
--   DRIFT   the set landed and something later overwrote it -> keep correcting, forever.
--   REFUSAL the set did not move the value -> the engine rejected it; retrying is futile.
local function enforce()
    if not want then return end
    local c = get_console()
    for _, u in ipairs(want) do
        if not dead[u.name] then
            local got = q(u.name)
            if not matches(got, u.val, u.n) then
                c:execute(u.cmd)
                reasserts[u.name] = (reasserts[u.name] or 0) + 1
                if matches(q(u.name), u.val, u.n) then
                    fails[u.name] = 0
                else
                    fails[u.name] = (fails[u.name] or 0) + 1
                    if fails[u.name] >= GIVE_UP then
                        dead[u.name] = true
                        if q(u.name) == nil then
                            -- No readback at all: the command does not exist in this
                            -- engine build. An older or non-modded exe, not a bad value.
                            say("!" .. u.name .. " is not a console command in this engine"
                                .. " build - GAMMA's Modded Exes (DX11) are required for it."
                                .. " Not retrying it this session.")
                        else
                            say("!" .. u.name .. " REFUSED by the engine " .. GIVE_UP
                                .. "x running - " .. u.val .. " is out of range. Search this log"
                                .. " for: Invalid syntax in call to " .. u.name
                                .. " . Not retrying it this session.")
                        end
                    end
                end
            end
        end
    end
end

local function apply(announce)
    if not P then return end
    local enabled = mcm("enabled", true)
    if not enabled then
        if want then
            -- Hand the GRADE back at neutral before letting go. Console values outlive
            -- this script, and nothing else in the install drives r__color_grading and
            -- its siblings, so releasing them mid-season would leave the Zone graded to
            -- that season until something else set them. Only the grade: fog, flora, wind
            -- and wetness are SSS's own, and it re-pushes the player's MCM values for
            -- them on this same option-change tick, half a second before this runs -
            -- restoring those too would overwrite what the player just set.
            local c = get_console()
            for _, u in ipairs(build("neutral", "neutral", 1.0, 1.0, {grade = true})) do
                c:execute(u.cmd)
            end
            say("disabled in MCM - grade restored to neutral, releasing control")
        end
        want = nil
        live = nil          -- not driving anything, so claim no season on the panel
        return
    end

    local layers = {
        grade = mcm("do_grade", true), flora = mcm("do_flora", true),
        fog   = mcm("do_fog",   true), wind  = mcm("do_wind",  true),
        wet   = mcm("do_wet",   true),
    }
    local intensity = mcm("intensity", 1.0)
    local mode      = mcm("mode", "auto")

    local from, to, k
    if mode == "auto" then
        from, to, k = resolve(mcm("blend_days", 14))
    else
        from, to, k = mode, mode, 1.0
    end

    live = {mode = mode, season = to}

    want = build(from, to, k, intensity, layers)
    local c = get_console()
    for _, u in ipairs(want) do c:execute(u.cmd) end

    local label
    if from == to then
        label = to
    else
        label = string.format("%s->%s %d%%", from, to, math.floor(k * 100 + 0.5))
    end
    if intensity < 1.0 then
        label = label .. string.format(" @%d%%", math.floor(intensity * 100 + 0.5))
    end

    if announce or label ~= last_label then
        local off = {}
        for _, n in ipairs({"grade", "flora", "fog", "wind", "wet"}) do
            if not layers[n] then off[#off + 1] = n end
        end
        say(label .. " applied (" .. #want .. " uniforms"
            .. (#off > 0 and ", off: " .. table.concat(off, ",") or "") .. ")")
        if announce then
            for _, u in ipairs(want) do
                local got = q(u.name)
                say(string.format("  %-24s -> %-44s %s", u.name, tostring(got),
                    matches(got, u.val, u.n) and "OK" or ("WANT " .. u.val)))
            end
        end
        if last_label and label ~= last_label and mcm("notify", true)
           and actor_menu and actor_menu.set_msg then
            -- `label` is the LOG string and is built from raw config keys
            -- ("winter_snow", "summer->autumn 71%"). It must never be shown to the
            -- player - pinning Deep Winter would have put "The season turns:
            -- winter_snow" on screen. Same leak as the PDA feed had.
            local said
            if from == to then
                said = cap(to) .. " has settled over the Zone."
            else
                said = string.format("%s giving way to %s.", cap(from), name_of(to))
            end
            actor_menu.set_msg(1, said, 5)
        end
    end
    last_label = label
end

-- How many days until the NEXT season starts, and which one.
-- A boundary landing on today gives d == 0, which wraps to a full year and so loses the
-- min - which is what we want: standing on the first day of autumn, the next season is
-- winter, not autumn again.
local function days_to_next()
    local year = os.date("*t").year
    local doy  = tonumber(os.date("%j"))
    local len  = doy_of(12, 31, year)
    local best, name
    for _, b in ipairs(BOUNDS) do
        local d = doy_of(b.m, b.d, year) - doy
        if d <= 0 then d = d + len end
        if not best or d < best then best, name = d, b.season end
    end
    return best, name
end

-- The Zone acknowledging the real calendar, delivered as PDA news once the player is
-- actually in the world. Deliberately delayed: fired at actor_on_first_update it lands
-- under the loading screen and is never seen.
local function pda_announce()
    if not (db.actor and news_manager and news_manager.send_tip) then
        say("news_manager unavailable - skipping PDA announcement")
        return
    end
    local date = today_text()

    local mode = mcm("mode", "auto")
    local msg
    if mode ~= "auto" then
        -- A PDA has no notion of the player having pinned a season in a menu.
        -- Just state it, and omit the date: with the calendar overridden the date
        -- is not what chose this, and printing it would only contradict the season.
        msg = string.format("%s in the Zone.", cap(mode))
    else
        local from, to, k = resolve(mcm("blend_days", 14))
        if from == to then
            local d, nxt = days_to_next()
            msg = string.format("%s in the Zone. %s. %s begins in %s days.",
                                cap(to), date, cap(nxt), tostring(d))
        else
            -- Qualitative, not a percentage. "71% through the turn" is a debug readout,
            -- not something a PDA would say, and it reads as nonsense in the message feed.
            local phase
            if k < 0.35 then
                phase = string.format("%s is beginning to show.", cap(to))
            elseif k < 0.65 then
                phase = string.format("%s giving way to %s.", cap(from), name_of(to))
            else
                phase = string.format("%s has taken hold.", cap(to))
            end
            msg = phase .. " " .. date .. "."
        end
    end
    news_manager.send_tip(db.actor, msg, nil, nil, 14000)
    say("PDA: " .. msg)
end

local function actor_on_update()
    if not P then return end
    local tg = time_global()
    if tg >= next_date then
        next_date = tg + DATE_MS
        apply(false)                 -- re-resolve the calendar; no-ops if nothing moved
        return
    end
    if not want then return end
    if tg < next_check then return end
    next_check = tg + CHECK_MS
    enforce()
end

-- --- season-scoped mods: the list, and the player's decisions about it --------------
--
-- _tools/season.py writes season_mods.ltx before the game starts, describing every
-- season-scoped mod that is actually installed. The MCM page turns that into one switch
-- per mod. The decisions go back the other way through MCM's own store: ui_mcm persists
-- to axr_options.ltx, plain text on disk, which season.py reads before the next launch.
--
-- None of it can change anything THIS session. Textures bind from the VFS at level load
-- and are frozen there; the only honest thing to do is say so on the page and act on the
-- next launch.
local MODS_CFG = "season_mods.ltx"

function mod_list()
    local ini = ini_file(MODS_CFG)
    if not (ini and ini:section_exist("mods")) then return nil end
    local out = {
        staged_for     = ini:r_string_ex("mods", "staged_for") or "unknown",
        stage_textures = (ini:r_string_ex("mods", "stage_textures") or "on") ~= "off",
        -- the ambient layer: whether it is gating, whether the source mod is even here,
        -- and how many channel removals the staged season carries
        stage_sound    = (ini:r_string_ex("mods", "stage_sound") or "on") ~= "off",
        sound_have     = ini:r_string_ex("mods", "sound_available") == "true",
        sound_cuts     = ini:r_float_ex("mods", "sound_cuts") or 0,
        mods           = {},
    }
    for key in string.gmatch(ini:r_string_ex("mods", "list") or "", "[^,%s]+") do
        if ini:section_exist(key) then
            out.mods[#out.mods + 1] = {
                key     = key,
                name    = ini:r_string_ex(key, "name") or key,
                seasons = ini:r_string_ex(key, "seasons") or "",
                -- group: the first season this mod serves. season.py has already sorted
                -- the list into calendar order, so the panel only has to notice when the
                -- group changes and drop a heading in.
                group   = ini:r_string_ex(key, "group") or "",
                -- underscores back to spaces: r_string_ex strips internal whitespace out
                -- of an ltx value, so season.py writes "Deep_winter" to survive the trip
                label   = (ini:r_string_ex(key, "group_label") or ""):gsub("_", " "),
                span    = ini:r_string_ex(key, "span") or "",
                mb      = ini:r_float_ex(key, "mb") or 0,
                enabled = ini:r_string_ex(key, "enabled") == "true",
                wanted  = ini:r_string_ex(key, "wanted") == "true",
            }
        end
    end
    return out
end

local function on_option_change()
    -- SSS re-pushes its own MCM values here; land after them
    CreateTimeEvent("seasons_zone", "reapply", 0.5, function()
        dead, fails = {}, {}         -- MCM changed: give a refused uniform a fresh chance
        apply(true)
        return true
    end)
end

local function actor_on_first_update()
    P = load_table()
    if not P then
        say("!" .. CFG .. " could not be read - mod is INACTIVE this session")
        return
    end
    apply(true)

    -- Textures cannot follow the calendar at runtime: X-Ray binds them from the VFS at
    -- launch and freezes them. So they are staged by _tools/season.py, and the two can
    -- disagree - a season pinned in MCM, or the game launched without staging. That used
    -- to be silent, and looked like a bug: winter light on autumn ground. Say it plainly.
    local staged = ini_file("season_staged.ltx")
    if staged and staged:section_exist("staged") then
        local s = staged:r_string_ex("staged", "season")
        local on = (staged:r_string_ex("staged", "staging") or "on") ~= "off"
        local from, to = resolve(mcm("blend_days", 14))
        local mode = mcm("mode", "auto")
        local running = (mode ~= "auto") and mode or to
        -- With the texture layer switched off the two are SUPPOSED to disagree; saying so
        -- every load would be nagging about a choice that was made on purpose. An
        -- unrecognised staging is not actionable either.
        if on and s and s ~= "unknown" and s ~= running then
            say("!TEXTURES ARE STAGED FOR " .. string.upper(s) .. " but the season running is "
                .. string.upper(running) .. " - terrain will not match the light.")
            say(" run  _tools/season.py apply  (or play.bat) and relaunch to line them up")
        end
    end

    if mcm("pda_greeting", true) then
        local delay = mcm("pda_delay", 12)
        CreateTimeEvent("seasons_zone", "pda_greeting", delay, function()
            pda_announce()
            return true
        end)
    end
end

function on_game_start()
    RegisterScriptCallback("actor_on_first_update", actor_on_first_update)
    RegisterScriptCallback("actor_on_update", actor_on_update)
    RegisterScriptCallback("on_option_change", on_option_change)
    say(string.format("armed - re-assert %ds, calendar re-check %dmin",
        CHECK_MS / 1000, DATE_MS / 60000))
end
