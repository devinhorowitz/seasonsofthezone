                  "Sidorovich: Hiring notice on the board with no destination written on it.",
                  "Barman: Old hands do not like how many people are coming in.",
                  "Forester: Something went through the treeline at speed. Left no prints.",
                  "Beard: A guide walked a route he has known for years and did not recognise it.",
                  "Sakharov: Anomaly two clicks east that nobody has a name for. One of them will name it.",
                  "Nimble: Detector at the bar reads something the others do not. Owner will not sell it.",
                  "Owl: Three expeditions went out this week. One has reported back.",
                  "Barman: The newcomers talk about the Zone like it is a job.",
                  "Beard: Two guides gave different answers for the same route today.",
              }},
}

local function remembrance_today()
    local t = os.date("*t")
    return REMEMBRANCE[t.month * 100 + t.day]
end

-- Hold the weather on a named cycle.
--
-- A memorial holds "clear"; an anniversary holds "storm". The two kinds of day pull
-- in opposite directions on purpose - one goes still, the other goes loud.
--
-- This goes through Atmospherics' own manager - the accessor surge_manager.script already
-- uses - rather than writing console values, so it does not fight the weather system. The
-- day plan reassigns self.cycle as segments advance, which is why this re-asserts on a
-- tick instead of setting it once; it only writes when the cycle has actually drifted, so
-- a clear day costs nothing.
local function hold_cycle(name)
    if not (level_weathers and level_weathers.get_weather_manager) then
        return "Atmospherics not present"
    end
    local ok, err = pcall(function()
        local wm = level_weathers.get_weather_manager()
        if not wm then error("no weather manager") end
        if wm.cycle == name then return end
        if not (wm.presets and wm.presets[name]) then error("no " .. name .. " cycle") end
        wm.cycle = name
        if random_key_table then
            wm.preset = random_key_table(wm.presets[name])
        end
        if type(wm.forced_weather_change) == "function" then
            wm:forced_weather_change()
        end
    end)
    return ok and "ok" or tostring(err)
end

-- An anniversary seeds an extra crop of artefacts on each level you visit that day.
--
-- This calls Dynamic Anomalies Overhaul's own public entry point - the same one
-- grok_artefacts_random_spawner already calls behind a chance roll - rather than
-- touching its spawn-chance setting, which is a local and unreachable anyway. That
-- also means there is nothing to restore: a crash mid-day cannot leave a rate
-- turned up for good.
--
-- NOTE: these artefacts go into the alife and persist in the save, exactly as the
-- ordinary random spawner's do. Once per level per session, latched, so walking in
-- and out of a level does not keep seeding it.
-- Keyed "YYYY-MM-DD|level" and saved with the game, so the promise in the docs - one
-- crop per level per DAY - survives a reload. A plain in-memory table reset on every
-- load, and repeated loads are normal here.
arte_done = {}                 -- module-scope: save_state/load_state reach it

-- Whether the ecologists have already told the player their network is open. Persisted,
-- because standing drifts either side of a threshold and an announcement that repeats
-- every time it crosses back is worse than one that never came.
eco_told = false
local ARTE_PASSES = 5          -- see the note in anniversary_artefacts

-- Count every artefact the simulation knows about. alife():iterate_objects, never a
-- 0..65534 sweep - that is the pattern that had to be removed from Homestead for the
-- hitches it caused. Returns nil if the engine will not co-operate.
local function count_artefacts()
    local n = 0
    local ok = pcall(function()
        alife():iterate_objects(function(se)
            if se and IsArtefact(nil, se:clsid()) then n = n + 1 end
        end)
    end)
    return ok and n or nil
end

local function anniversary_artefacts()
    if not (drx_da_main and drx_da_main.spawn_artefacts_on_level) then
        return "Dynamic Anomalies Overhaul not present"
    end
    local okl, lvl = pcall(function() return level.name() end)
    if not (okl and lvl) then return "no level" end

    local key = os.date("%Y-%m-%d") .. "|" .. lvl
    if arte_done[key] then return nil end
    arte_done[key] = true

    -- One call is a ~15% dice roll per eligible smart, so it yields 0-1 artefacts -
    -- measured at 28 -> 29 once and 28 -> 28 twice on Garbage. The chance itself lives
    -- in a file local inside DAO and cannot be reached, so repeating the call is the
    -- only lever. Five passes gives a light 0-5, which is the intended dose for a day
    -- that comes round once a year.
    local before = count_artefacts()
    for _ = 1, ARTE_PASSES do
        local ok, err = pcall(drx_da_main.spawn_artefacts_on_level)
        if not ok then return tostring(err) end
    end
    local after = count_artefacts()

    if before and after then
        return string.format("seeded %s on %s over %s passes (artefacts %s -> %s)",
                             tostring(after - before), lvl, tostring(ARTE_PASSES),
                             tostring(before), tostring(after))
    end
    return "seeded artefacts on " .. lvl .. " (count unavailable)"
end

-- The opening transmission lands shortly after you load in; the pool is drawn from at
-- intervals somewhere between these two, so two days running never sound the same.
local REM_OPEN_MS = 25000
local REM_GAP_MIN = 8 * 60000
local REM_GAP_MAX = 20 * 60000

local rem_bag  = nil          -- shuffled indices remaining in today's pool
local rem_next = 0            -- time_global of the next transmission

-- The in-game year, not the real one. Anomaly starts on 26.10.2018 and its calendar
-- advances with play, so a line about how long ago something happened has to be measured
-- from where the player actually is. Returns nil if the engine will not give it up.
local function game_year()
    local ok, y = pcall(function() return game.get_game_time():get() end)
    if ok and type(y) == "number" and y > 1900 and y < 4000 then return y end
    return nil
end

local function rem_format(day, s)
    if not s:find("%%d") then return s end
    if not day.since then return nil end          -- a count with nothing to count from
    local y = game_year()
    if not y then return nil end                  -- caller picks a line without a count
    local ok, out = pcall(string.format, s, y - day.since)
    return ok and out or nil
end

-- Speaker -> the key added by mod_news_tips_icons_sotz.ltx. Lines are written as
-- "Owl: ..." so the name is already in the text; this puts the face beside it.
local SPEAKER_ICON = {
    Barman     = "sotz_barman",
    Sidorovich = "sotz_sidorovich",
    Owl        = "sotz_owl",
    Beard      = "sotz_beard",
    Sakharov   = "sotz_sakharov",
    Forester   = "sotz_forester",
    Nimble     = "sotz_nimble",
    Guide      = "sotz_guide",
}

local function rem_send(day, s)
    if not (db.actor and news_manager and news_manager.send_tip) then return end
    local msg = rem_format(day, s)
    if not msg then return false end              -- unusable; the caller tries another
    -- the speaker is the word before the first colon
    local who = msg:match("^([%a]+):")
    local icon = who and SPEAKER_ICON[who] or nil
    news_manager.send_tip(db.actor, msg, nil, icon, 14000)
    say("remembrance PDA: " .. msg)
    return true
end

-- A shuffle bag rather than a plain random pick: with five lines and a straight roll you
-- would hear the same one twice in a row often enough to notice, which reads as a bug.
local function rem_refill(day)
    rem_bag = {}
    for i = 1, #(day.lines or {}) do
        rem_bag[i] = i
    end
    for i = #rem_bag, 2, -1 do
        local j = math.random(i)
        rem_bag[i], rem_bag[j] = rem_bag[j], rem_bag[i]
    end
end

local function remembrance_announce(day)
    local tg = time_global()
    if not rem_said then
        rem_said = true
        rem_next = tg + REM_OPEN_MS
        return                       -- the opening waits out the load, it does not race it
    end
    if tg < rem_next then return end

    if rem_bag == nil then           -- first fire after the opening delay: send `open`
        -- If the in-game year is unavailable, every opening carrying a count is
        -- unusable; fall back to one that does not need it rather than printing "%d".
        local ops = day.opens or {}
        local start = math.random(#ops)
        for k = 0, #ops - 1 do
            if rem_send(day, ops[(start + k - 1) % #ops + 1]) then break end
        end
        rem_refill(day)
    else
        if #rem_bag == 0 then rem_refill(day) end
        local idx = table.remove(rem_bag)
        local pool = day.lines or {}
        if idx and pool[idx] then rem_send(day, pool[idx]) end
    end
    rem_next = tg + math.random(REM_GAP_MIN, REM_GAP_MAX)
end

local rem_logged = false

local function remembrance_tick()
    local day = remembrance_today()
    if not day then return end

    if not rem_logged then
        rem_logged = true
        say("remembrance day active: " .. day.key .. " (" .. tostring(day.kind) .. ")")
    end

    -- An anniversary is a line and nothing else; only a memorial touches the world.
    local memorial = (day.kind == "memorial")

    if mcm(memorial and "rem_messages" or "rem_anniversary", true) then
        remembrance_announce(day)
    end
    if memorial then
        if mcm("rem_weather", true) then
            local r = hold_cycle("clear")
            if r ~= "ok" and r ~= nil then say("remembrance weather: " .. r) end
        end
    else
        if mcm("rem_ann_weather", true) then
            local r = hold_cycle("storm")
            if r ~= "ok" and r ~= nil then say("anniversary weather: " .. r) end
        end
        if mcm("rem_ann_artefacts", true) then
            local r = anniversary_artefacts()
            if r then say("anniversary: " .. r) end
        end
    end
end


-- Crossing the first ecologist threshold is worth hearing about. Without this the
-- feature unlocks in a menu the player was not looking at, which is the same as it not
-- unlocking at all until they happen to check.
--
-- Sakharov because he is the ecologist the player already knows and the mod already ships
-- his portrait for the remembrance transmissions. Once per save: eco_told persists.
function eco_access_tick()
    if eco_told then return end
    if not mcm("forecast", true) then return end

    local ok, st = pcall(function()
        return relation_registry.community_goodwill("ecolog", db.actor:id())
    end)
    if not (ok and type(st) == "number") then return end
    if st < mcm("forecast_coarse", FORECAST_COARSE) then return end

    eco_told = true
    pcall(function()
        news_manager.send_tip(db.actor,
            "Your standing has been noted. Bunker relays will carry emission warnings to "
            .. "your device from now on - direction only, no timings. Do not mistake that "
            .. "for safety.",
            nil, "sotz_sakharov", 16000)
    end)
    say("ecologist access granted at standing " .. tostring(st))
end

local function actor_on_update()
    if not P then return end
    local tg = time_global()
    -- before the calendar branch below, which returns early on its own tick
    if tg >= next_rem then
        next_rem = tg + REM_MS
        remembrance_tick()
        eco_access_tick()
    end
    if tg >= next_date then
        next_date = tg + DATE_MS
        apply(false)                 -- re-resolve the calendar; no-ops if nothing moved
        return
    end
    if not want then return end
    if tg < next_check then return end
    next_check = tg + CHECK_MS
    enforce()
end

-- Season-scoped mods. _tools/season.py writes season_mods.ltx before launch; the MCM
-- page shows one switch per mod; MCM saves the choice to axr_options.ltx, which
-- season.py reads at the next launch. Nothing here can change the current session.
local MODS_CFG = "season_mods.ltx"

function mod_list()
    local ini = ini_file(MODS_CFG)
    if not (ini and ini:section_exist("mods")) then return nil end
    local out = {
        staged_for     = ini:r_string_ex("mods", "staged_for") or "unknown",
        stage_textures = (ini:r_string_ex("mods", "stage_textures") or "on") ~= "off",
        -- the ambient layer: whether it is gating, whether the source mod is even here,
        -- and how many channel removals the staged season carries
        stage_sound    = (ini:r_string_ex("mods", "stage_sound") or "on") ~= "off",
        sound_have     = ini:r_string_ex("mods", "sound_available") == "true",
        sound_cuts     = ini:r_float_ex("mods", "sound_cuts") or 0,
        mods           = {},
    }
    for key in string.gmatch(ini:r_string_ex("mods", "list") or "", "[^,%s]+") do
        if ini:section_exist(key) then
            out.mods[#out.mods + 1] = {
                key     = key,
                name    = ini:r_string_ex(key, "name") or key,
                seasons = ini:r_string_ex(key, "seasons") or "",
                -- the first season the mod serves; the list arrives in calendar order
                group   = ini:r_string_ex(key, "group") or "",
                -- r_string_ex strips internal whitespace, so season.py writes "Deep_winter"
                label   = (ini:r_string_ex(key, "group_label") or ""):gsub("_", " "),
                span    = ini:r_string_ex(key, "span") or "",
                mb      = ini:r_float_ex(key, "mb") or 0,
                enabled = ini:r_string_ex(key, "enabled") == "true",
                wanted  = ini:r_string_ex(key, "wanted") == "true",
            }
        end
    end
    return out
end

local function on_option_change()
    -- SSS re-pushes its own MCM values here; land after them
    CreateTimeEvent("seasons_zone", "reapply", 0.5, function()
        dead, fails = {}, {}         -- MCM changed: give a refused uniform a fresh chance
        P = load_table() or P        -- a preset choice may have changed
        apply(true)
        return true
    end)
end

local function actor_on_first_update()
    P = load_table()
    if not P then
        say("!" .. CFG .. " could not be read - mod is INACTIVE this session")
        return
    end
    apply(true)

    -- The staged textures and the running season can disagree (a pinned season, or a
    -- launch without staging). Say so. season.py stages by the date, so that is what they
    -- are compared with: in the days before a turn the blend is already moving towards the
    -- next season, and comparing with that warned before every turn. A period of the
    -- player's own is staged under its own name, which no season here matches.
    local staged = ini_file("season_staged.ltx")
    if staged and staged:section_exist("staged") then
        local s = staged:r_string_ex("staged", "season")
        local on = (staged:r_string_ex("staged", "staging") or "on") ~= "off"
        local mode = pinned()
        local running = (mode ~= "auto") and mode
                        or season_at(tonumber(os.date("%j")), os.date("*t").year)
        local a_season = false
        for _, k in ipairs(SEASON_KEYS) do
            if k == s then a_season = true end
        end
        -- with the texture layer off they are meant to disagree
        if on and a_season and s ~= running then
            say("!TEXTURES ARE STAGED FOR " .. string.upper(s) .. " but the season running is "
                .. string.upper(running) .. " - terrain will not match the light.")
            say(" run  _tools/season.py apply  (or play.bat) and relaunch to line them up")
        end
    end

    if mcm("pda_greeting", true) then
        local delay = mcm("pda_delay", 12)
        CreateTimeEvent("seasons_zone", "pda_greeting", delay, function()
            pda_announce()
            return true
        end)
    end
end

-- The artefact latch rides in the save. Only today's keys are kept, so the table does
-- not grow for the life of a playthrough.
function save_state(m_data)
    local today, keep = os.date("%Y-%m-%d"), {}
    for k, v in pairs(arte_done) do
        if v and k:sub(1, #today) == today then keep[k] = true end
    end
    m_data.sotz_arte_done = keep
    m_data.sotz_eco_told = eco_told and true or false
end

function load_state(m_data)
    arte_done = m_data.sotz_arte_done or {}
    eco_told = m_data.sotz_eco_told and true or false
end

-- --- data for the PDA page ---------------------------------------------------------------
--
-- calendar_rows() above returns finished sentences for an MCM desc list. A page needs the
-- pieces apart - date, length, days away - so it can lay them out and mark today's. This
-- is that, and nothing else reads it.

local MONTH = {"Jan", "Feb", "Mar", "Apr", "May", "Jun",
               "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"}

local function md(m, d)
    return string.format("%s %d", MONTH[m] or "?", d)
end

-- Days from today to (m, d), looking forward and wrapping the year end.
local function days_until(m, d)
    local now  = os.date("*t")
    local year = now.year
    local doy  = tonumber(os.date("%j"))
    local tgt  = doy_of(m, d, year)
    if tgt >= doy then return tgt - doy end
    return (doy_of(12, 31, year) - doy) + doy_of(m, d, year + 1)
end

function calendar_page()
    local now  = os.date("*t")
    local year = now.year
    local doy  = tonumber(os.date("%j"))
    local cur  = season_at(doy, year)

    local out = {
        today   = today_text(),
        season  = cur,
        -- for the year ribbon: where today sits, and how long the year is. Both are
        -- cheap here and awkward on the page, which has no calendar of its own.
        doy      = doy,
        year_len = doy_of(12, 31, year),
        label   = name_of(cur),
        dial    = dial_texture(),
        seasons = {},
        days    = {},
        extra   = {},
    }

    -- each season that is on, with length and range
    local yl = doy_of(12, 31, year)
    for i, b in ipairs(BOUNDS) do
        local nxt = BOUNDS[i % #BOUNDS + 1]
        local a, z = doy_of(b.m, b.d, year), doy_of(nxt.m, nxt.d, year)
        local len = z - a
        if len <= 0 then len = len + yl end         -- the one that wraps the year end
        out.seasons[#out.seasons + 1] = {
            doy_from = a,               -- day of year it begins, for the ribbon
            span     = len,
            key     = b.season,
            label   = name_of(b.season),
            from    = md(b.m, b.d),
            to      = md(nxt.m, nxt.d),
            days    = len,
            current = (b.season == cur),
            starts_in = days_until(b.m, b.d),
        }
    end
    -- listed from spring, like the MCM pages, or from the first season on after it;
    -- BOUNDS stays in date order because the lookups need it
    local first = enabled_seasons()[1]
    for _ = 1, #out.seasons do
        if out.seasons[1].key == first then break end
        table.insert(out.seasons, table.remove(out.seasons, 1))
    end

    -- the six fixed days
    for key, day in pairs(REMEMBRANCE) do
        local m, d = math.floor(key / 100), key % 100
        out.days[#out.days + 1] = {
            doy    = doy_of(m, d, year),   -- where it falls, for the ribbon's ticks
            key    = day.key,
            kind   = day.kind,
            date   = md(m, d),
            month  = m,
            day    = d,
            away   = days_until(m, d),
            today  = (m == now.month and d == now.day),
            lines  = (day.opens and #day.opens or 0) + (day.lines and #day.lines or 0),
        }
    end
    table.sort(out.days, function(a, b) return a.away < b.away end)

    -- the turning: which season is next and how far off - whichever has the smallest
    -- non-zero starts_in.
    for _, s in ipairs(out.seasons) do
        if not s.current and s.starts_in > 0 then
            if not out.next or s.starts_in < out.next.days then
                out.next = {label = s.label, days = s.starts_in, key = s.key}
            end
        end
    end

    -- is one of the six marked days today? the page leads with it if so
    for _, day in ipairs(out.days) do
        if day.today then out.marked = day end
    end

    -- the accent bar for the current season; one of this mod's own 256x16 strips
    out.bar = "ui_season_hdr_" .. tostring(cur)


    -- anything the player added in seasons_config.py reaches the game only as staged
    -- mods, so the page reports what was staged rather than guessing at the config
    local ok, ml = pcall(mod_list)
    if ok and ml then
        out.staged_for = ml.staged_for
        out.extra = ml.mods or {}
    end

    return out
end


-- --- data for the forecast page ----------------------------------------------------------
--
-- Split from calendar_page on purpose. The calendar answers questions about DATES and runs
-- on real time; everything here runs on the game clock and answers "what is about to
-- happen". They were one page for a while and that read badly: nobody opens a calendar to
-- find out whether it is going to rain this afternoon.

-- Which weather this install can read. "plan" is Atmospherics' day planner, which knows
-- every change for the next 24 game hours. "stock" is base Anomaly's manager, which knows
-- the sky now and when it will turn, but rolls what comes next with math.random at the
-- moment of change - so there is nothing further to read. "none" is no manager at all.
--
-- GAMMA ships "stock". Neither of its two Atmospherics mods includes level_weathers.script;
-- the planner comes only with a newer Atmospherics installed separately.
--
-- In a level the live manager is authoritative, so it is read. At the main menu the script
-- must not even be touched. MCM calls this while it builds its pages, and Atmospherics
-- 2.69's level_weathers reads MCM at file scope, so loading it then fails ("Failed to load
-- script level_weathers") and the page said no weather manager was found. Base's
-- get_weather_manager() would also BUILD a manager, the side effect this mod refuses for
-- the surge manager. So at the menu the file is read instead: the planner is the copy
-- that defines record_day_history, and a copy that is not a loose file is the base game's.
local function weather_source_on_disk()
    local fs = getFS()
    if not fs:exist("$game_scripts$", "level_weathers.script") then return "none" end
    local f = io.open(fs:update_path("$game_scripts$", "level_weathers.script"), "r")
    if not f then return "stock" end
    local src = f:read("*a") or ""
    f:close()
    return src:find("function record_day_history", 1, true) and "plan" or "stock"
end

function weather_source()
    if not (db and db.actor) then
        local ok, src = pcall(weather_source_on_disk)
        return ok and src or "stock"
    end
    if not level_weathers then return "none" end
    if level_weathers.get_weather_manager then
        local ok, wm = pcall(level_weathers.get_weather_manager)
        if ok and wm then
            return (wm.day_plan and wm.abs_schedule_minute) and "plan" or "stock"
        end
        return "none"
    end
    if level_weathers.record_day_history then return "plan" end
    return "none"
end

-- --- a forecast, not a timetable ---------------------------------------------------------
--
-- Atmospherics' plan is exact, and a forecast that is never wrong is a timetable. So the
-- page gets a forecaster's calls instead: each planned change is given a rounded time and
-- a sky, both off by an error that shrinks as the change gets closer, and a percentage
-- that is how often a call made that far ahead comes true. MCM's "Exact weather forecast"
-- shows the plan itself.
--
-- A call is a pure function of the change it describes, so reopening the PDA shows the
-- same forecast, and it is only revised because the change got closer. The arithmetic
-- avoids bit operations so LuaJIT and the Lua the tests run give the same numbers.

-- where a wrong call lands: the next sky over, never the far end
local NEIGHBOURS = {
    clear  = {"partly"},
    partly = {"clear", "cloudy"},
    cloudy = {"partly", "foggy", "rain"},
    foggy  = {"cloudy", "partly"},
    rain   = {"cloudy", "storm"},
    storm  = {"rain"},
}

local PM = 2147483647                   -- Park-Miller's modulus, 2^31 - 1

-- n numbers in (0, 1), fixed by the change's minute and sky
local function draws(minute, cycle, n)
    local h = 7
    local s = tostring(cycle)
    for i = 1, #s do h = (h * 31 + s:byte(i)) % PM end
    local x = (math.floor(minute) * 104729 + h * 7919) % (PM - 1) + 1
    local out = {}
    for i = 1, n + 3 do
        x = (x * 16807) % PM
        if i > 3 then out[i - 3] = x / PM end      -- the first few track the seed too closely
    end
    return out
end

-- 98% right an hour out, 82% a day out: about one call in ten wrong across a day
local function accuracy(lead)
    local a = 0.98 - 0.16 * lead / 1440
    if a < 0.82 then a = 0.82 elseif a > 0.98 then a = 0.98 end
    return a
end

-- shown to the nearest 5, and never 100: a forecast is never certain
local function chance(lead)
    local p = math.floor(accuracy(lead) * 20 + 0.5) * 5
    if p > 95 then p = 95 end
    return p
end

-- One planned change as a forecaster would call it. prev is the sky before it; a call has
-- to differ from it, because "rain, then rain" is not a change.
local function call(minute, cycle, now, prev)
    local lead = minute - now
    local u = draws(minute, cycle, 4)
    local said = cycle
    if u[1] < 1 - accuracy(lead) then
        local opts = {}
        for _, c in ipairs(NEIGHBOURS[cycle] or {}) do
            if c ~= prev then opts[#opts + 1] = c end
        end
        if #opts > 0 then said = opts[math.floor(u[2] * #opts) + 1] end
    end
    -- the time is off by up to 2.5 sigma, sigma 8% of the lead: about two hours a day out
    local z = math.sqrt(-2 * math.log(u[3])) * math.cos(2 * math.pi * u[4])
    if z > 2.5 then z = 2.5 elseif z < -2.5 then z = -2.5 end
    local step = (lead > 180 and 30) or (lead > 60 and 15) or 5
    local t = math.floor((minute + z * 0.08 * lead) / step + 0.5) * step
    return said, t, chance(lead), step
end

-- The plan reaches 24 game hours ahead, and so does the forecast. A call its own error
-- pushes past that is dropped rather than shown a day and a half out.
local HORIZON = 1440

-- The page's forecast for a plan: segments as calls, in the same shape plus `chance`.
local function forecast_calls(now_cycle, segments, now, clock)
    local out, prev, last = {}, now_cycle, now
    for _, seg in ipairs(segments) do
        local minute = now + seg.away
        local said, t, p, step = call(minute, seg.cycle, now, prev)
        if said ~= prev then
            -- two calls can cross when their errors point at each other; keep them in order
            if t <= last then t = last + step end
            if t - now > HORIZON then break end
            out[#out + 1] = {at = clock(t), cycle = said, away = t - now, chance = p}
            prev, last = said, t
        end
    end
    return out
end

-- Base Anomaly draws the next sky with math.random from a list it builds at the moment of
-- change, and that list is already fixed: every sky but the current one, less those used
-- up (a sky may come twice before the list resets, once if its occurrence option is 2).
-- So these odds are exact. Mirrors level_weathers' get_next_weather_cycle and, for an
-- empty list, get_random_weather.
local function stock_odds(wm)
    local ok, cycles = pcall(function()
        return utils_data.collect_section(ini_file("environment\\dynamic_weather_graphs.ltx"),
                                          "weather_cycles")
    end)
    if not (ok and type(cycles) == "table" and #cycles > 0) then return nil end
    local storage = wm.weather_storage
    if type(storage) ~= "table" then return nil end
    local used = {}
    for i = 1, #storage do used[storage[i]] = (used[storage[i]] or 0) + 1 end
    local function occurrence(c)
        local okv, v = pcall(function()
            return ui_options.get("video/weather/" .. c .. "_occurrence")
        end)
        return (okv and tonumber(v)) or 3
    end
    local avail = {}
    for _, c in ipairs(cycles) do
        if c ~= wm.cycle then
            local v, n = occurrence(c), used[c] or 0
            if (v > 2.5 and n < 2) or (v > 1.5 and n < 1) then avail[#avail + 1] = c end
        end
    end
    if #avail == 0 then
        for _, c in ipairs(cycles) do
            if occurrence(c) > 1 then avail[#avail + 1] = c end
        end
        if #avail == 0 then
            for _, c in ipairs(cycles) do avail[#avail + 1] = c end
        end
    end
    local out = {}
    for _, c in ipairs(avail) do out[#out + 1] = {cycle = c, chance = 1 / #avail} end
    return out
end

function forecast_page()
    local out = {today = today_text()}

    -- the same accent strip the calendar page wears, so the two read as one mod rather
    -- than two addons that happen to be installed together
    pcall(function()
        local cur = season_at(tonumber(os.date("%j")), os.date("*t").year)
        out.season = cur
        out.bar    = "ui_season_hdr_" .. tostring(cur)
    end)

    -- --- what the ecologists will tell you ------------------------------------------------
    --
    -- Anomaly tasks carry no completion deadlines - 621 base tasks and every installed
    -- task mod were checked, and not one has a time limit - so there is nothing there to
    -- put on a calendar. Emissions ARE scheduled, but they do not belong on one either:
    -- emission_frequency 24 makes _delta a random 12-24 GAME hours, and time_factor 6
    -- turns that into one every 2-4 real hours. Six to twelve per real calendar day. The
    -- answer to "is there an emission in the next few days" is always yes, several times,
    -- which is no answer at all.
    --
    -- The live reading is worth having; the question is how much of it you have earned.
    -- The ecologists are the faction that actually measures this, so the resolution is
    -- bought with standing among them rather than with a detector. Below the first
    -- threshold the page says so and names the number, because a locked thing the player
    -- cannot see is not something they can play towards.
    local function standing()
        local ok, v = pcall(function()
            return relation_registry.community_goodwill("ecolog", db.actor:id())
        end)
        if ok and type(v) == "number" then return v end
        return nil
    end

    -- Both managers compute the next event as _delta minus the time since the last, which
    -- is what CSurgeManager:new_surge_time and its psi-storm twin do internally. Read the
    -- module's own singleton rather than calling get_surge_manager(), because the getter
    -- CONSTRUCTS the manager when none exists and CSurgeManager:__init allocates a dozen
    -- sound_object handles. This only ever reads a manager the game already made.
    -- Returns seconds and a reason, because "nil" was covering four different states and
    -- the page could not tell them apart:
    --
    --   no-mgr    nothing has built the manager yet
    --   no-flds   it exists but _delta or the timestamp is not set
    --   due       the wait has already elapsed - an emission is imminent, which is the
    --             most useful thing the page can say and was being reported as nothing
    --   ok        a real countdown
    -- An X-Ray class instance is USERDATA, not a table. Every version of this check
    -- tested for "table" and therefore threw away a manager the game had handed over
    -- perfectly intact - which is why the forecast read "no reading" for hours while the
    -- surge manager was sitting there answering every call put to it.
    local function is_obj(v)
        local ty = type(v)
        return ty == "table" or ty == "userdata"
    end

    local function seconds_until(mgr, since)
        if not is_obj(mgr) then return nil, "no-mgr" end
        -- field access on userdata goes through __index, so it can raise
        local ok_f, delta, stamp = pcall(function() return mgr._delta, mgr[since] end)
        if not ok_f then return nil, "fields-threw" end
        if type(delta) ~= "number" or not stamp then return nil, "no-flds" end
        mgr = {_delta = delta, [since] = stamp}
        local ok, left = pcall(function()
            return math.floor(mgr._delta - game.get_game_time():diffSec(mgr[since]))
        end)
        if not (ok and type(left) == "number") then return nil, "err" end
        if left <= 0 then return 0, "due" end
        return left, "ok"
    end

    -- The period the frequency option implies, in game seconds. Both managers roll
    -- _delta in [freq/2, freq] hours, so freq hours is the longest wait there can be.
    local function period(key, fallback)
        local ok, v = pcall(function() return ui_options.get(key) end)
        if not (ok and type(v) == "number" and v > 0) then v = fallback end
        return v * 3600
    end

    -- A band is a FRACTION of the period, never an hour count, so it keeps its meaning
    -- whoever moves the frequency slider: at the stock 24 "building" is a few hours, at
    -- 168 it is most of a day. This is the whole point of the coarse tier - it tells you
    -- to get indoors without telling you exactly when, which is what the ecologists would
    -- actually say over a radio.
    -- What a relayed warning is actually worth. The ecologists are reading their own
    -- instruments and passing a bulletin down a bunker relay; a bracket is honest about
    -- that in a way a single number would not be, and eight hours of slop still tells a
    -- stalker whether to start walking back.
    --
    -- Fixed hours rather than a fraction of the period: "two to eight hours" means the
    -- same thing whatever the frequency slider says, whereas a fraction silently became
    -- a different warning when someone moved it.
    local function bracket(left)
        if not left then return nil end
        local h = left / 3600.0
        if h <= 2  then return "WITHIN 2 HOURS" end
        if h <= 8  then return "2 to 8 hours"   end
        if h <= 16 then return "8 to 16 hours"  end
        return "ALL CLEAR"
    end

    -- Under two hours is the point where this stops being a forecast and becomes a
    -- warning. Both tiers raise it: a LIMITED "WITHIN 2 HOURS" means the same thing to
    -- the player as a CLEARED "1 hour".
    local ALERT_SECONDS = 2 * 3600

    if mcm("forecast", true) then
        local st   = standing()
        local need = mcm("forecast_coarse", FORECAST_COARSE)
        local full = mcm("forecast_exact",  FORECAST_EXACT)
        local tier = "locked"
        if st then
            if st >= full then tier = "exact" elseif st >= need then tier = "coarse" end
        end
        out.forecast = {tier = tier, standing = st, need = need, need_exact = full}

        -- Read ALWAYS, expose by tier. Computing only when the tier allowed it meant a
        -- locked page and an unreachable surge manager produced identical nils, so there
        -- was no way to tell "withheld" from "broken" without standing over the screen.
        -- Reach the manager by the module global first, and fall back to the public
        -- getter.
        --
        -- The getter was avoided originally because it CONSTRUCTS on a miss and
        -- CSurgeManager:__init allocates a dozen sound_object handles. That caution was
        -- misplaced: surge_manager.main_loop runs on AddUniqueCall and calls
        -- get_surge_manager():update() every second once the actor has had its first
        -- update, so by the time a PDA can be open the manager already exists and the
        -- getter is a plain read. Avoiding it only meant reading a global that was
        -- coming back nil and reporting no forecast at all.
        local function reach(mod, global_name, getter_name)
            if type(mod) ~= "table" then
                return nil, "no-mod(" .. type(mod) .. ")"
            end
            local g = rawget(mod, global_name)
            if is_obj(g) then return g, "global" end

            -- Do not type-check the getter, just call it. Anything callable will do,
            -- and pcall reports whatever goes wrong - which is both more robust and
            -- harness-agnostic: lupa hands Python callables to Lua as userdata rather
            -- than function, so a type test rejected a getter that worked perfectly.
            local fn = rawget(mod, getter_name)
            if fn == nil then
                -- say what the module DOES hold, so a wrong table shows itself
                local keys, n = {}, 0
                for k in pairs(mod) do
                    n = n + 1
                    if n <= 6 then keys[#keys + 1] = tostring(k) end
                end
                return nil, string.format("no-getter(n=%d %s)", n,
                                          table.concat(keys, ","))
            end

            local ok, made = pcall(fn)
            if ok and is_obj(made) then return made, "getter" end
            if not ok then
                return nil, "getter-threw(" .. tostring(made):sub(1, 60) .. ")"
            end
            return nil, "getter-gave(" .. type(made) .. ")"
        end

        local sm, s_how = reach(surge_manager, "SurgeManager", "get_surge_manager")
        local pm, p_how = reach(psi_storm_manager, "PsiStormManager",
                                "get_psi_storm_manager")

        local s, s_why = seconds_until(sm, "last_surge_time")
        local p, p_why = seconds_until(pm, "last_psi_storm_time")
        s_why = s_how .. ":" .. s_why
        p_why = p_how .. ":" .. p_why
        -- why each one reads the way it does. Engine state rather than timing, so it is
        -- not something the gate is keeping from anyone.
        out.mgr_surge = s_why
        out.mgr_psi   = p_why

        if tier == "exact" then
            out.surge, out.psi = s, p
        elseif tier == "coarse" then
            out.surge_band = bracket(s)
            out.psi_band   = bracket(p)
        end

        -- The flag only exists for a tier that is allowed to know. At locked it stays
        -- false, because a strobe would leak the one thing being withheld.
        if tier ~= "locked" then
            out.surge_alert = (s ~= nil and s <= ALERT_SECONDS)
            out.psi_alert   = (p ~= nil and p <= ALERT_SECONDS)
        else
            out.surge_alert, out.psi_alert = false, false
        end
    end

    -- --- the weather plan ------------------------------------------------------------------
    -- Atmospherics does not guess the weather, it PLANS it: WeatherManager:roll_day_plan
    -- extends self.day_plan to DAY_PLAN_WINDOW_MINUTES - 24 game hours - ahead, as a list
    -- of {minute, cycle}. `segments` is that schedule, read straight off; `forecast` is
    -- the same schedule as a forecaster would call it (see forecast_calls).
    --
    -- Ungated, unlike the emission tiers. Weather is something a stalker reads by looking
    -- up, the ecologists have no special claim on it, and it gives the page something to
    -- say at zero standing rather than a single locked row.
    --
    -- weather_manager is a FILE-LOCAL in level_weathers, so unlike the surge managers it
    -- can only be reached through its getter. That is safe here: Atmospherics constructs
    -- it itself to drive the weather, so it exists long before a PDA is open, and this
    -- mod already calls the same getter in hold_cycle().
    local function clock(abs_minute)
        local m = abs_minute % 1440
        return string.format("%02d:%02d", math.floor(m / 60), m % 60)
    end

    out.weather_source = weather_source()

    -- Stock weather. The sky now, and the window it turns in: base re-rolls the change
    -- time each hour between two thirds of the period and all of it, so the change lands
    -- somewhere in that window and nowhere else. What it turns TO is drawn at random at
    -- the moment of change, so no next sky is given, only the odds of each.
    if out.weather_source == "stock" then
        pcall(function()
            local wm = level_weathers.get_weather_manager()
            if not (wm and wm.cycle) then return end
            local w = {now = wm.cycle, segments = {}, source = "stock"}
            local okp, len = pcall(function()
                return ui_options.get("video/weather/" .. tostring(wm.cycle) .. "_period")
            end)
            len = (okp and tonumber(len)) or 6
            local oke, elapsed = pcall(function()
                return game.get_game_time():diffSec(wm.last_period_change_date)
            end)
            if oke and type(elapsed) == "number" then
                local lo = math.ceil(len * 2 / 3) * 3600 - elapsed
                local hi = len * 3600 - elapsed
                -- minutes, like a planned segment's `away`, so one formatter serves both
                w.window = {lo = math.max(0, math.floor(lo / 60)),
                            hi = math.max(0, math.floor(hi / 60))}
            end
            local oko, odds = pcall(stock_odds, wm)
            if oko then w.odds = odds end
            out.weather = w
        end)
        return out
    end

    pcall(function()
        if not (level_weathers and level_weathers.get_weather_manager) then return end
        local wm = level_weathers.get_weather_manager()
        if not (wm and wm.day_plan and wm.abs_schedule_minute) then return end

        local now = wm:abs_schedule_minute()
        local w   = {now = wm.cycle, segments = {}, source = "plan"}
        local last = wm.cycle
        for i = (wm.day_plan_index or 1), #wm.day_plan do
            local seg = wm.day_plan[i]
            -- the plan repeats a cycle to extend a spell; only the CHANGES are forecast
            if seg and seg.minute and seg.minute > now and seg.cycle ~= last then
                w.segments[#w.segments + 1] = {
                    at = clock(seg.minute), cycle = seg.cycle, away = seg.minute - now,
                }
                last = seg.cycle
                if #w.segments >= 6 then break end
            end
        end
        -- segments stay the plan itself; the page shows the calls unless MCM asks for exact
        w.exact = mcm("wx_exact", false) and true or false
        local okf, calls = pcall(forecast_calls, w.now, w.segments, now, clock)
        if okf then w.forecast = calls end
        out.weather = w
    end)

    return out
end

function on_game_start()
    RegisterScriptCallback("save_state", save_state)
    RegisterScriptCallback("load_state", load_state)
    RegisterScriptCallback("actor_on_first_update", actor_on_first_update)
    RegisterScriptCallback("actor_on_update", actor_on_update)
    RegisterScriptCallback("on_option_change", on_option_change)
    say(string.format("armed - re-assert %ds, calendar re-check %dmin",
        CHECK_MS / 1000, DATE_MS / 60000))
end
