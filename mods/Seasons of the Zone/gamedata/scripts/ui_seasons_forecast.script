-- Seasons of the Zone - the forecast page.
--
-- The calendar page answers questions about dates and runs on real time. This one runs on
-- the game clock and answers "what is about to happen": the weather Atmospherics has
-- already planned, and - if the ecologists rate you highly enough - the next emission.
--
-- It is also the extension point. Anything that is near-term world state rather than a
-- date belongs here, so adding a reading means adding a section to Fill() and a field to
-- zzz_seasons_of_the_zone.forecast_page(). Nothing else has to change.
--
-- Mod App Creator calls get_ui() and expects a CUIScriptWnd back. Registration lives in
-- z_seasons_pda_mac.script, so this file does not care whether MAC is installed.

local SINGLETON = nil

local function say(msg)
    printf("%s", "[seasons-forecast] " .. tostring(msg))
end

-- InitTexture does not apply width_factor, so a square asset renders as an ellipse
-- unless the width is corrected by (4:3) / screen aspect - 0.75 at 16:9.
local function aspect()
    local f = 0.75
    local ok, w, h = pcall(function() return device().width, device().height end)
    if ok and w and h and h > 0 then
        f = (1024 / 768) / (w / h)
    end
    return f
end

-- Loose .dds files with no texture_descr entry, so the engine resolves them by path and
-- wants the bare stem. Some names arrive with the extension and some without.
local function tex(name)
    name = tostring(name or "")
    if name == "" then return nil end
    return (name:gsub("%.dds$", ""))
end

-- Atmospherics' internal cycle names, as a stalker would say them.
local CYCLE = {
    clear   = "Clear",
    partly  = "Broken cloud",
    cloudy  = "Overcast",
    foggy   = "Fog",
    rain    = "Rain",
    storm   = "Storm",
}

local function cycle_name(c)
    c = tostring(c or "")
    return CYCLE[c] or (c:sub(1, 1):upper() .. c:sub(2))
end

-- The glyph for each Atmospherics cycle. Anything the engine hands back that is not in
-- here falls to cloudy rather than drawing nothing, because a blank square next to an
-- arrow reads as a bug.
local WX_GLYPH = {
    clear = "sotz_wx_clear", partly = "sotz_wx_partly", cloudy = "sotz_wx_cloudy",
    foggy = "sotz_wx_foggy", rain = "sotz_wx_rain",     storm  = "sotz_wx_storm",
}

local function wx_tex(cycle)
    return WX_GLYPH[tostring(cycle or "")] or WX_GLYPH.cloudy
end

-- Ribbon colours. Cold and dark for the weather that keeps you indoors, pale and warm
-- for the weather that does not, so the strip reads as a mood before it reads as data.
local CYCLE_RGB = {
    clear  = {226, 232, 220},
    partly = {198, 206, 190},
    cloudy = {150, 158, 150},
    foggy  = {132, 142, 140},
    rain   = {104, 126, 148},
    storm  = { 74,  94, 120},
}

-- The coarse tier's whole job is to warn without timing. These are what a reading relayed
-- over a radio would sound like, and none of them implies an hour.
local BAND = {
    imminent = "very soon",
    building = "building",
    quiet    = "nothing yet",
}

-- What the barometer needle is sitting in. "outside now" described where the reading
-- came from rather than what it said, which is the one thing a caption is for.
local GAUGE_BAND = {
    storm = "stormy", rain = "stormy",
    foggy = "unsettled", cloudy = "unsettled", partly = "unsettled",
    clear = "fair",
}

-- Emission countdowns arrive as GAME seconds, which is what the player reckons in - a
-- surge is "about four hours off", never "24 real minutes".
local function countdown(sec)
    if sec >= 7200 then return string.format("%d hours",  math.floor(sec / 3600 + 0.5)) end
    if sec >= 3600 then return "an hour" end
    if sec >=  120 then return string.format("%d minutes", math.floor(sec / 60)) end
    return "any moment"
end

-- The weather plan's lead times arrive as game MINUTES.
-- cp1251 byte 176 is the degree sign, which is how every shipped string table in this
-- install writes it - there is no UTF-8 degree anywhere in the game's text. Emitting the
-- byte from Lua sidesteps the question of what encoding this file happens to be saved in.
local DEG = "\176"

local function temp_str(v, unit)
    if v == nil then return "" end
    return string.format("%d%s%s", v, DEG, unit or "C")
end

local function lead(min)
    if min >= 120 then return string.format("in %d hours", math.floor(min / 60 + 0.5)) end
    if min >=  60 then return "in an hour" end
    return string.format("in %d min", math.max(1, math.floor(min)))
end

-- CScriptXmlInit:ParseFile does NOT raise when the xml cannot be used - it returns, and
-- every Init* afterwards quietly hands back nil. The first method call on one of those
-- nils is a hard engine FATAL, not a Lua error pcall can absorb, which is exactly how a
-- comment sitting above the root element took the whole game down once. So nothing below
-- dereferences a widget without checking first, and a broken page is a blank page.
local function put(w, text)
    if w then w:SetText(text or "") end
end

local function page()
    local ok, data = pcall(function() return zzz_seasons_of_the_zone.forecast_page() end)
    if ok and type(data) == "table" then return data end
    say("forecast_page() unavailable: " .. tostring(data))
    return nil
end

class "SeasonsForecast" (CUIScriptWnd)

function SeasonsForecast:__init() super()
    self:InitControls()
end

function SeasonsForecast:__finalize()
    SINGLETON = nil
end

function SeasonsForecast:InitControls()
    self:SetWndRect(Frect():set(0, 0, 1024, 768))

    local xml = CScriptXmlInit()
    xml:ParseFile("ui_seasons_forecast.xml")
    self.xml = xml

    xml:InitStatic("background", self)
    self.header    = xml:InitTextWnd("header", self)
    self.bar       = xml:InitStatic("bar", self)
    self.subheader = xml:InitTextWnd("subheader", self)
    self.now       = xml:InitTextWnd("now", self)

    self.needle = xml:InitStatic("needle", self)
    if self.needle then
        local h = self.needle:GetHeight()
        self.needle:SetWndSize(vector2():set(h * aspect(), h))
        self.needle_x, self.needle_y = 566, 150
    end

    self.gauge = xml:InitStatic("gauge", self)
    if self.gauge then
        -- GetHeight/GetWidth, not GetWndRect: the latter is not bound in this
        -- engine at all. It reads plausibly and it is what crashed the game.
        local h = self.gauge:GetHeight()
        self.gauge:SetWndSize(vector2():set(h * aspect(), h))
    else
        say("ui_seasons_forecast.xml gave up no elements - check its root")
    end
    self.gauge_caption = xml:InitTextWnd("gauge_caption", self)

    -- the sky, now and next. Square assets need the same aspect correction as the dial.
    self.wx_now        = xml:InitStatic("wx_now", self)
    self.wx_arrow      = xml:InitStatic("wx_arrow", self)
    self.wx_next       = xml:InitStatic("wx_next", self)
    self.wx_now_label  = xml:InitTextWnd("wx_now_label", self)
    self.wx_next_label = xml:InitTextWnd("wx_next_label", self)
    for _, s in ipairs({self.wx_now, self.wx_arrow, self.wx_next}) do
        local h = s:GetHeight()
        s:SetWndSize(vector2():set(h * aspect(), h))
    end
    -- the arrow never changes, so it is set once here; the two condition glyphs are set
    -- per redraw in Fill()
    if self.wx_arrow then
        pcall(function() self.wx_arrow:InitTexture("sotz_wx_arrow") end)
    end

    self.chart       = xml:InitStatic("chart", self)
    self.chart_cap_l = xml:InitTextWnd("chart_cap_l", self)
    self.chart_cap_r = xml:InitTextWnd("chart_cap_r", self)
    self:InitChart()
    self:InitAxes()

    self.src       = xml:InitTextWnd("src", self)
    self.frost    = xml:InitStatic("frost", self)
    self.live_dot = xml:InitStatic("live_dot", self)
    self.eco_logo = xml:InitStatic("eco_logo", self)
    self.eco_class = xml:InitTextWnd("eco_class", self)

    -- sotz_eco_mark is a SQUARE 112x112 crop of the shield, so it wants the plain
    -- aspect correction. The 383/179 ratio here was the banner it replaced, and left
    -- the emblem stretched to twice its width.
    if self.eco_logo then
        local h = self.eco_logo:GetHeight()
        self.eco_logo:SetWndSize(vector2():set(h * aspect(), h))
    end

    self.units = xml:Init3tButton("units", self)
    if self.units then
        -- sotz_btn, not sotz_px: Init3tButton needs four declared states and the bare
        -- white block satisfies none of them, so the button would draw nothing at all
        self.units:InitTexture("sotz_btn")
        self:Register(self.units, "units")
        self:AddCallback("units", ui_events.BUTTON_CLICKED, self.OnUnits, self)
    end
    self.units_label = xml:InitTextWnd("units_label", self)
    self.eco_l1 = xml:InitTextWnd("eco_l1", self)
    self.eco_l2 = xml:InitTextWnd("eco_l2", self)
    self.eco_l3 = xml:InitTextWnd("eco_l3", self)
    self:InitEcoFrame()
    self:InitRows()

    self.back = xml:Init3tButton("back", self)
    if self.back then
        self.back:InitTexture("sotz_app_back")
        self:Register(self.back, "back")
        self:AddCallback("back", ui_events.BUTTON_CLICKED, self.OnBack, self)
    end
end
-- Back to the launcher. MAC reaches its own tab the same way, and it binds a key for it
-- too, but a page you can only leave by keyboard reads as a dead end.
-- Writes the MCM option rather than keeping a copy, so the button and the menu are the
-- same setting seen twice. sotz_api caches for two seconds, so the page is repainted
-- after the write to avoid showing the old unit until the cache lapses.
function SeasonsForecast:OnUnits()
    local ok, err = pcall(function()
        -- ui_mcm.get on a list option does not reliably hand back the string the option
        -- was declared with - it may be the index - so both shapes are accepted. Testing
        -- only for "fahrenheit" made every click write "fahrenheit" again, which is why
        -- the button worked once and then stopped.
        local cur = ui_mcm.get("seasons_zone/main/units")
        local is_f = (cur == "fahrenheit") or (cur == 1) or (cur == "1")
        ui_mcm.set("seasons_zone/main/units", is_f and "celsius" or "fahrenheit")
    end)
    if not ok then say("units toggle failed: " .. tostring(err)) end
    -- the api caches for two seconds; without this the repaint shows the old unit
    pcall(function() sotz_api.flush() end)
    self:Reset()
end

function SeasonsForecast:OnBack()
    local ok, err = pcall(function()
        ActorMenu.get_pda_menu():SetActiveSubdialog("eptLauncher")
    end)
    if not ok then say("back to launcher failed: " .. tostring(err)) end
end



-- Two fixed columns, no scrolling. Colour carries the emphasis a font change would
-- normally carry, because a widget cannot be restyled after it is built - and three
-- parallel pools, one per style, would be three times the widgets for the same page.
local HEAD_RGB = {238, 196, 112}
local LINE_RGB = {200, 200, 200}
local NOW_RGB  = {255, 255, 255}
local DIM_RGB  = {140, 140, 140}

-- Each column starts where the thing above it ends rather than on a shared line: the
-- left one is under the chart, the right one under the barometer, which is 130px higher.
-- Sharing a top left a hole under the gauge the size of the gauge.
local COL_X    = {48, 554}       -- the right column lines up with the panel's text
local HEAD_Y   = {522, 560}
local ROW_Y0   = {546, 584}

-- the ecologist panel, which the right column now sits beneath
local ECO_X, ECO_Y, ECO_W, ECO_H = 540, 356, 232, 188
local ROW_H    = 19
local ROWS     = 14

function SeasonsForecast:InitRows()
    self.heads, self.rows = {}, {}
    for col = 1, 2 do
        self.heads[col] = self.xml:InitTextWnd("row_head", self)
        if self.heads[col] then
            self.heads[col]:SetWndPos(vector2():set(COL_X[col], HEAD_Y[col]))
            self.heads[col]:Show(false)
        end
        self.rows[col] = {}
        for i = 1, ROWS do
            local set = {}
            for f = 1, 3 do
                local w = self.xml:InitTextWnd("row_line", self)
                if w then
                    w:Show(false)
                    set[f] = w
                end
            end
            self.rows[col][i] = set
        end
    end
    self.used = {0, 0}
end

-- The panel border: four tinted blocks, built once. A frame is the cheapest way to say
-- "this is a separate instrument" on a page that is otherwise one flat surface.
function SeasonsForecast:InitEcoFrame()
    self.eco_frame = {}
    local edges = {
        {ECO_X, ECO_Y, ECO_W, 1},
        {ECO_X, ECO_Y + ECO_H, ECO_W, 1},
        {ECO_X, ECO_Y, 1, ECO_H},
        {ECO_X + ECO_W, ECO_Y, 1, ECO_H + 1},
    }
    for i = 1, #edges do
        local e = edges[i]
        local s = self.xml:InitStatic("px", self)
        if s then
            s:SetWndPos(vector2():set(e[1], e[2]))
            s:SetWndSize(vector2():set(e[3], e[4]))
            s:SetTextureColor(GetARGB(255, 96, 82, 52))
            s:Show(false)
            self.eco_frame[#self.eco_frame + 1] = s
        end
    end
end

function SeasonsForecast:ShowEcoFrame(on)
    for i = 1, #(self.eco_frame or {}) do
        if self.eco_frame[i] then self.eco_frame[i]:Show(on and true or false) end
    end
    if self.eco_logo then self.eco_logo:Show(on and true or false) end
end

function SeasonsForecast:Head(col, text)
    local h = self.heads and self.heads[col]
    if not h then return end
    h:SetText(text or "")
    h:Show(true)
end

-- fields is {{dx, text}, ...}, dx measured from the column's left edge
function SeasonsForecast:Put(col, fields, rgb)
    if not (self.rows and self.rows[col]) then return end
    local n = (self.used[col] or 0) + 1
    if n > ROWS then return end                 -- never grow; a full column just stops
    self.used[col] = n
    local set = self.rows[col][n]
    local y = ROW_Y0[col] + (n - 1) * ROW_H
    rgb = rgb or LINE_RGB
    for f = 1, 3 do
        local w = set and set[f]
        if w then
            local spec = fields[f]
            if spec then
                w:SetText(tostring(spec[2] or ""))
                w:SetWndPos(vector2():set(COL_X[col] + spec[1], y))
                w:SetTextColor(GetARGB(255, rgb[1], rgb[2], rgb[3]))
                w:Show(true)
            else
                w:Show(false)
            end
        end
    end
end

function SeasonsForecast:ClearRows()
    for col = 1, 2 do
        if self.heads and self.heads[col] then self.heads[col]:Show(false) end
        for i = 1, ROWS do
            local set = self.rows and self.rows[col] and self.rows[col][i]
            for f = 1, 3 do
                if set and set[f] then set[f]:Show(false) end
            end
        end
        self.used[col] = 0
    end
end

-- A solid rectangle. X-Ray has no fill-rect: a CUIStatic carrying a plain white block
-- and tinted with SetTextureColor is how every other mod in the install draws one.
--
-- The blocks are allocated ONCE and reused. get_ui() calls Reset() every time the page is
-- opened, so building fresh statics per redraw would pile up a new set on every visit and
-- never release them - a slow leak that only shows after an hour of play.
local BAR_POOL = 44          -- 9 ribbon bands + 24 curve columns + 4 rules, with slack

function SeasonsForecast:InitAxes()
    self.axis_y, self.axis_x = {}, {}
    for i = 1, 3 do
        local w = self.xml:InitTextWnd("axis_y", self)
        if w then w:Show(false) end
        self.axis_y[i] = w
    end
    for i = 1, 5 do
        local w = self.xml:InitTextWnd("axis_x", self)
        if w then w:Show(false) end
        self.axis_x[i] = w
    end
end

function SeasonsForecast:InitChart()
    self.bars, self.bar_n = {}, 0
    if not self.chart then return end
    for i = 1, BAR_POOL do
        local s = self.xml:InitStatic("px", self.chart)
        if not s then break end
        s:Show(false)
        self.bars[i] = s
    end
end

function SeasonsForecast:Bar(x, y, w, h, r, g, b, alpha)
    self.bar_n = (self.bar_n or 0) + 1
    local s = self.bars and self.bars[self.bar_n]
    if not s then return end                      -- pool exhausted: draw nothing, never grow
    if w < 1 then w = 1 end
    s:SetWndPos(vector2():set(x, y))
    s:SetWndSize(vector2():set(w, h))
    s:SetTextureColor(GetARGB(alpha or 255, r, g, b))
    s:Show(true)
end

-- 24 hours across 462px: the weather Atmospherics has planned as a ribbon, and the
-- modelled temperature under it on the same axis, so a glance answers both "when does it
-- turn" and "how cold does it get" without reading a single row.
-- The left gutter carries the temperature scale, so the plot starts after it. Without
-- this the bars ran to the panel edge and there was nowhere to put a value.
local AXIS_W    = 34
local CHART_W   = 462
local PLOT_W    = CHART_W - AXIS_W
local RIBBON_Y  = 4
local RIBBON_H  = 24
local CURVE_Y   = 40
local CURVE_H   = 148
local SPAN_MIN  = 1440          -- one game day
local CHART_X   = 48            -- must match <chart> in the xml
local CHART_Y   = 290

function SeasonsForecast:DrawChart(d, temp)
    if not self.chart then return end
    for i = 1, #(self.bars or {}) do
        if self.bars[i] then self.bars[i]:Show(false) end
    end
    self.bar_n = 0

    local w = d.weather
    local function px(minute)
        return AXIS_W + math.floor((math.min(minute, SPAN_MIN) / SPAN_MIN) * PLOT_W + 0.5)
    end

    -- --- the weather ribbon ---------------------------------------------------------
    -- Segment boundaries are the planned changes; the first band is whatever is outside
    -- right now. A plan that runs out before the day does simply leaves its last band
    -- running to the edge, which is what "settled" looks like.
    if w then
        local marks = {}
        local cur = w.now
        local at = 0
        for _, seg in ipairs(w.segments or {}) do
            if seg.away and seg.away > at then
                marks[#marks + 1] = {from = at, to = math.min(seg.away, SPAN_MIN), cycle = cur}
                at, cur = seg.away, seg.cycle
            end
            if at >= SPAN_MIN then break end
        end
        if at < SPAN_MIN then
            marks[#marks + 1] = {from = at, to = SPAN_MIN, cycle = cur}
        end
        for _, m in ipairs(marks) do
            local c = CYCLE_RGB[tostring(m.cycle)] or CYCLE_RGB.cloudy
            self:Bar(px(m.from), RIBBON_Y, px(m.to) - px(m.from), RIBBON_H,
                     c[1], c[2], c[3], 235)
        end
    end

    -- --- the temperature curve ------------------------------------------------------
    -- One column an hour. The model hands over the samples so this cannot drift from the
    -- number printed at the top of the page.
    local curve = temp and temp.curve
    if curve and #curve > 1 then
        local lo, hi = curve[1], curve[1]
        for i = 1, #curve do
            if curve[i] < lo then lo = curve[i] end
            if curve[i] > hi then hi = curve[i] end
        end
        local range = (hi - lo)
        if range < 1 then range = 1 end
        local cw = math.floor(PLOT_W / #curve)
        for i = 1, #curve do
            local f = (curve[i] - lo) / range
            local h = math.max(2, math.floor(f * CURVE_H))
            -- warmer reads warmer: amber at the top of the day, cold blue at the bottom
            local r = math.floor(120 + 118 * f)
            local g = math.floor(140 + 56 * f)
            local b = math.floor(158 - 46 * f)
            self:Bar(AXIS_W + (i - 1) * cw + 1, CURVE_Y + (CURVE_H - h), cw - 2, h,
                     r, g, b, 225)
        end

        -- three gridlines and their values: the bars meant nothing without them
        local unit = (temp and temp.unit) or "C"
        for i, at in ipairs({0.0, 0.5, 1.0}) do
            local y = CURVE_Y + math.floor((1.0 - at) * CURVE_H)
            self:Bar(AXIS_W, y, PLOT_W, 1, 70, 76, 70, 150)
            local w = self.axis_y and self.axis_y[i]
            if w then
                w:SetText(string.format("%d%s", math.floor(lo + (hi - lo) * at + 0.5),
                                        DEG))
                w:SetWndPos(vector2():set(CHART_X - 6, CHART_Y + y - 7))
                w:Show(true)
            end
        end
    else
        for i = 1, 3 do
            if self.axis_y and self.axis_y[i] then self.axis_y[i]:Show(false) end
        end
    end

    -- --- now, and the hours ---------------------------------------------------------
    -- a hairline every six hours, and a brighter one at the left edge for "now"
    for hh = 6, 18, 6 do
        self:Bar(px(hh * 60), RIBBON_Y, 1, CURVE_Y + CURVE_H - RIBBON_Y, 90, 96, 90, 200)
    end
    self:Bar(AXIS_W, RIBBON_Y - 3, 2, CURVE_Y + CURVE_H - RIBBON_Y + 6, 238, 196, 112, 255)

    -- the hour under each rule, counted from the game clock rather than from zero
    local now_h = (temp and temp.hour) or 0
    for i = 1, 5 do
        local w = self.axis_x and self.axis_x[i]
        if w then
            local ahead = (i - 1) * 6
            local clock = (math.floor(now_h) + ahead) % 24
            w:SetText(string.format("%02d:00", clock))
            -- centred on its rule, then clamped inside the plot: the 24-hour label used
            -- to hang half its width past the chart and into the SKY/AIR column
            local lx = CHART_X + px(ahead * 60) - 27
            local lo_x = CHART_X + AXIS_W - 6
            local hi_x = CHART_X + CHART_W - 48
            if lx < lo_x then lx = lo_x end
            if lx > hi_x then lx = hi_x end
            w:SetWndPos(vector2():set(lx, CHART_Y + CURVE_Y + CURVE_H + 4))
            w:Show(true)
        end
    end
end



function SeasonsForecast:Fill()
    self:ClearRows()
    if self.meter_back then self.meter_back:Show(false) end
    if self.meter_fill then self.meter_fill:Show(false) end

    local d = page()
    if not d then
        put(self.header, "Forecast")
        put(self.subheader, "Nothing is reading right now.")
        put(self.now, "")
        return
    end

    put(self.header, "Forecast")
    put(self.subheader, d.today or "")

    if d.bar and self.bar then
        local okb = pcall(function() self.bar:InitTexture(tex(d.bar)) end)
        if not okb then say("accent bar failed: " .. tostring(d.bar)) end
    end

    -- the headline: what it is doing outside, right now. Temperature comes through
    -- sotz_api so the page and any wearable device read the same number from the same
    -- model, rather than each deriving its own and disagreeing by a degree.
    local w = d.weather
    local temp = nil
    local okt, tv = pcall(function() return sotz_api.temperature() end)
    if okt then temp = tv end

    -- The face is one image for every cycle; only the needle moves, which is what lets
    -- it be nudged without the bands moving with it.
    if self.gauge then
        local okg = pcall(function() self.gauge:InitTexture("sotz_gauge_face") end)
        if not okg then say("gauge face failed") end
    end
    if self.needle then
        local cyc = (w and w.now) and tostring(w.now) or "cloudy"
        if not CYCLE_RGB[cyc] then cyc = "cloudy" end
        local okn = pcall(function() self.needle:InitTexture("sotz_needle_" .. cyc) end)
        if not okn then say("needle texture failed for " .. cyc) end
    end

    -- the sky is drawn below, so this line carries only what a picture cannot: the
    -- number, and which way it is going
    -- "rising" invites the question rising-what. Say what is happening to the air.
    -- the only place "now" is printed; the chart captions used to repeat it
    local head = ""
    if temp and temp.now then
        -- the band joins the headline now that the All day row is gone
        head = string.format("%s  %s, %s", temp_str(temp.now, temp.unit),
                             temp.band or "",
                             temp.rising and "getting warmer" or "getting colder")
    end
    put(self.units_label, DEG .. ((temp and temp.unit) or "C"))
    put(self.now, head)
    -- The face is labelled STORMY / RAIN / CHANGE / FAIR / DRY and the needle points at
    -- the word, so a caption underneath repeating it was a third way of saying storm -
    -- after the glyph and the needle.
    put(self.gauge_caption, (w and w.now) and "" or "no reading")

    -- --- the sky, now and next --------------------------------------------------------
    -- The arrow and the second glyph only appear when there IS a next: on a settled day
    -- an arrow pointing at a repeat of the same sky would be a lie.
    local nxt = w and w.segments and w.segments[1]
    if self.wx_now then
        pcall(function() self.wx_now:InitTexture(wx_tex(w and w.now)) end)
        self.wx_now:Show(w ~= nil)
    end
    put(self.wx_now_label, w and cycle_name(w.now) or "")

    if self.wx_arrow then self.wx_arrow:Show(nxt ~= nil) end
    if self.wx_next then
        if nxt then pcall(function() self.wx_next:InitTexture(wx_tex(nxt.cycle)) end) end
        self.wx_next:Show(nxt ~= nil)
    end
    put(self.wx_next_label, nxt
        and string.format("%s, %s", cycle_name(nxt.cycle), lead(nxt.away))
        or (w and "settled" or ""))

    -- --- where the numbers came from ----------------------------------------------------
    -- "14.5 / 7.8" read off the real Chornobyl and the same figures taken from a climate
    -- table are not the same claim, and a page that will not say which is asking to be
    -- trusted further than it has earned.
    -- Where the temperature comes from, and nothing else. Earlier versions of this line
    -- also tried to say that the weather half came from the game; that is not a claim
    -- the page needs to argue, and mentioning the sky here only made a reader wonder
    -- which of the two numbers in front of them was being sourced.
    if temp and temp.source == "observed" then
        put(self.src, string.format("Live from %s", temp.place or "Chornobyl"))
    elseif temp then
        put(self.src, "No station data - temperature modelled")
    else
        put(self.src, "")
    end

    -- the crystal marks a day that dips below zero at some point, which is not the same
    -- as it being below zero now - that is what temp.freezing says
    if self.frost then self.frost:Show(temp ~= nil and temp.frost == true) end

    self:DrawChart(d, temp)
    -- Nothing: the x-axis now carries the hours, and "now" beside a label that already
    -- reads the current hour was the page saying the same thing twice.
    put(self.chart_cap_l, "")
    put(self.chart_cap_r, "")

    -- --- the weather ----------------------------------------------------------------------
    -- Not a guess. Atmospherics plans the next 24 game hours in advance and this is that
    -- plan, so the times are the times it will actually change.
    -- The next change is already stated under the glyphs, so the list starts after it.
    self:Head(1, "Later today")
    -- the day's endpoints, not just the current number: the cycle is accelerated, so
    -- "8 C" on its own says nothing about whether the night is survivable
    if w and w.segments and #w.segments > 1 then
        for i = 2, #w.segments do
            local seg = w.segments[i]
            self:Put(1, {{0, seg.at}, {76, cycle_name(seg.cycle)},
                         {232, lead(seg.away)}})
        end
    elseif w and #(w.segments or {}) == 1 then
        self:Put(1, {{0, "Nothing further planned."}}, DIM_RGB)
    elseif w then
        self:Put(1, {{0, "Settled - no change planned."}}, DIM_RGB)
    else
        self:Put(1, {{0, "No weather plan. Atmospherics is not running."}}, DIM_RGB)
    end

    -- --- tomorrow --------------------------------------------------------------------
    -- Under the weather it continues, not beside the ecologists - it is a forecast, and
    -- sitting in their column made it look like something they had told you.
    --
    -- Observed only. There is no modelled tomorrow, because a modelled tomorrow is just
    -- today's curve wearing a different date.
    local tm = nil
    local okm, tv2 = pcall(function() return sotz_api.tomorrow() end)
    if okm then tm = tv2 end
    if tm then
        self:Put(1, {{0, ""}})
        self:Put(1, {{0, "Tomorrow"}}, HEAD_RGB)
        self:Put(1, {{0, cycle_name(tm.cycle)},
                     {76, string.format("%s to %s", temp_str(tm.low, tm.unit),
                                        temp_str(tm.high, tm.unit))},
                     {232, tm.frost and "frost overnight" or ""}}, NOW_RGB)
    end

    -- --- the ecologist forecast -------------------------------------------------------------
    -- Three states, and the locked one is drawn on purpose: a reward the player cannot
    -- see is not one they can work towards, so the row names the standing they have and
    -- the standing they need.
    -- --- the ecologists ---------------------------------------------------------------
    -- A clearance word rather than a heading: what the tier controls is how much of
    -- their network you are allowed to read, and CLASSIFIED says that in one word where
    -- a dim row said it in none.
    local fc = d.forecast
    self:ShowEcoFrame(fc ~= nil)
    -- the right column is the panel alone now, so its head slot is free again
    self:Head(2, "")
    if fc then
        local CLEARANCE = {locked = "CLASSIFIED", coarse = "LIMITED",
                           exact = "CLEARED"}
        put(self.eco_class, CLEARANCE[tostring(fc.tier)] or "CLASSIFIED")

        if fc.tier == "locked" then
            -- The emblem and the word are the whole state. The lines that used to sit
            -- here explained what the emblem implies, and printing "0 of 200" turned
            -- something you might one day be trusted with into a progress bar.
            put(self.eco_l1, "")
            put(self.eco_l2, "")
            put(self.eco_l3, "")
        else
            local e = fc.tier == "exact" and (d.surge and countdown(d.surge))
                                         or  (d.surge_band and BAND[d.surge_band])
            local p = fc.tier == "exact" and (d.psi   and countdown(d.psi))
                                         or  (d.psi_band   and BAND[d.psi_band])
            -- padded to the same column the rest of the page uses for a value
            put(self.eco_l1, string.format("Emission    %s", e or "no reading"))
            put(self.eco_l2, string.format("Psi storm    %s", p or "no reading"))
            -- At LIMITED the relays carry a direction and no timing, and the panel says
            -- as much rather than leaving the vagueness looking like a fault.
            put(self.eco_l3, fc.tier == "coarse" and "Relay warnings only, no timings"
                or "")
        end
    else
        put(self.eco_class, "")
        put(self.eco_l1, "")
        put(self.eco_l2, "")
        put(self.eco_l3, "")
    end

    -- --- the live marker ----------------------------------------------------------------
    self.is_live = (temp ~= nil and temp.source == "observed")
    if self.live_dot then self.live_dot:Show(temp ~= nil) end

    -- One line per open, naming what the page actually resolved. The ecologist tier and
    -- the two countdowns are the parts with no visible failure mode - a locked panel and
    -- an unreachable surge manager look identical from the outside - so this is the only
    -- way to tell "withheld" from "broken" without standing over the screen.
    say(string.format("tier=%s standing=%s need=%s/%s  surge=%s psi=%s  air=%s %s%s",
        tostring(fc and fc.tier or "none"),
        tostring(fc and fc.standing or "?"),
        tostring(fc and fc.need or "?"), tostring(fc and fc.need_exact or "?"),
        -- shown value, then whether a manager answered at all: "nil/no-mgr" is broken,
        -- "nil/mgr-ok" is simply withheld by the tier
        tostring(d.surge or d.surge_band or "nil") .. "/" .. tostring(d.mgr_surge),
        tostring(d.psi or d.psi_band or "nil") .. "/" .. tostring(d.mgr_psi),
        tostring(temp and temp.now or "?"),
        tostring(temp and temp.unit or "?"),
        (temp and temp.source == "observed") and " live" or " modelled"))
end

-- The one moving thing. A live reading breathes; a modelled one sits dark. Update runs
-- every frame, so this does the least it can: one colour write on a 7px block.
-- A real barometer never sits perfectly still. Every few seconds the needle gets a
-- short shiver - a pixel or two, damped out over a fraction of a second - which is the
-- cheapest honest way to say the reading is being taken rather than remembered. The face
-- underneath does not move, so it reads as the needle and not as the panel.
local TWITCH_EVERY = 4700        -- ms between shivers
local TWITCH_FOR   = 420         -- ms each one lasts

function SeasonsForecast:Twitch(ms)
    if not (self.needle and self.needle_x) then return end
    local t = ms % TWITCH_EVERY
    local dx, dy = 0, 0
    if t < TWITCH_FOR then
        -- a decaying wobble: fast at the start, still by the end
        local k = 1.0 - (t / TWITCH_FOR)
        local swing = math.sin(t / TWITCH_FOR * 18.0) * 1.0 * k * k
        dx = swing
        dy = swing * 0.35
    end
    self.needle:SetWndPos(vector2():set(self.needle_x + dx, self.needle_y + dy))
end

function SeasonsForecast:Update()
    CUIScriptWnd.Update(self)
    local okt, ms0 = pcall(time_global)
    if okt and type(ms0) == "number" then self:Twitch(ms0) end
    if not self.live_dot then return end
    if not self.is_live then
        self.live_dot:SetTextureColor(GetARGB(255, 70, 76, 70))
        return
    end
    local ok, ms = pcall(time_global)
    if not ok or type(ms) ~= "number" then return end
    -- a two-second breath, never fully out: a marker that blinks off reads as a fault
    local f = 0.55 + 0.45 * math.sin(ms / 2000.0 * 6.2832)
    self.live_dot:SetTextureColor(
        GetARGB(255, math.floor(90 + 148 * f), math.floor(150 + 60 * f),
                math.floor(96 + 24 * f)))
end

-- Progress toward the ecologists trusting you, as a bar rather than a number you have
-- to compare in your head. Goodwill runs to 1000, so a bare "0" says nothing about how
-- far 200 is.
-- Progress toward the ecologists trusting you, drawn under whatever row was written
-- last in the right column. Goodwill runs to 1000, so a bare "0" says nothing about how
-- far 200 actually is.
--

function SeasonsForecast:Reset()
    local ok, err = pcall(function() self:Fill() end)
    if not ok then say("Fill failed: " .. tostring(err)) end
end

function SeasonsForecast:OnKeyboard(dik, action)
    local res = CUIScriptWnd.OnKeyboard(self, dik, action)
    if res then return res end
    if action == ui_events.WINDOW_KEY_PRESSED and dik == DIK_keys.DIK_ESCAPE then
        -- escape used to be swallowed here, which left the page with no way out but the
        -- launcher key. It goes back now.
        self:OnBack()
        return true
    end
    return false
end

function get_ui()
    SINGLETON = SINGLETON or SeasonsForecast()
    SINGLETON:Reset()
    return SINGLETON
end
