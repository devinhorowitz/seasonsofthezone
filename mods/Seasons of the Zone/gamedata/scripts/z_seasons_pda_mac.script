-- Seasons of the Zone - the app's tile in Mod App Creator's launcher.
--
-- MAC moves extra PDA pages off the top tab bar and onto an app launcher, which is how this
-- app gets in without fighting every other tab-adding mod for bar space. It is the official
-- way in, and this file is the only place MAC is used: the app itself - both faces, and the
-- switch between them - lives in sotz_pda.script and does not depend on it.
--
-- One tile. The Year and Forecast used to be two, which doubled the clutter in a launcher
-- other mods share and made one app look like two. The tile opens The Year; the switch at
-- the top of each page does the rest.
--
-- If MAC is absent this file does nothing, and MCM's Main page says so in red: in the
-- official build the app is then built but unreachable. A standalone fork deletes this file
-- and supplies its own way in - see the note at the top of sotz_pda.script.
--
-- The icon is one of this mod's own ui_seasons_dial_NN.dds files, picked for today, so
-- the app icon shows the season it is. MAC calls InitTexture on it directly - a single
-- texture, not a four-state button - so no _e/_h/_t/_d set is needed and nothing has to
-- be shipped beyond what the dial already uses.

-- MAC builds each tile with Init3tButton + InitTexture, which is a FOUR-state button:
-- the engine appends _e / _h / _t / _d and looks those up as DECLARED texture ids. A
-- loose .dds satisfies none of them and the tile draws empty - which is what the first
-- build shipped. These ids come from configs/ui/textures_descr/ui_sotz_apps.xml.
--
-- The year tile is not the dial. The dial carries season names and day counts that read
-- at 200px on the page and are mud at the ~48px a tile gets, so the tile is a plain ring
-- with the live season lit. It changes five times a year rather than daily, which is
-- often enough to be informative and rare enough not to be noise.
local function year_icon()
    local ok, season = pcall(function()
        return zzz_seasons_of_the_zone.calendar_page().season
    end)
    if ok and type(season) == "string" and season ~= "" then
        return "sotz_app_year_" .. season
    end
    return "sotz_app_year_autumn"
end

function on_game_start()
    if not (mac_mcm and mac_mcm.add_app) then return end
    local ok, err = pcall(function()
        -- `name` is the tile's own label. The section titles the PDA prints top left
        -- stay "The Year" and "Forecast", which are what each face is.
        mac_mcm.add_app("app_seasons", {
            name    = "pda_app_seasons",
            texture = year_icon(),
            tab     = sotz_pda.VIEWS.year.tab,
            func    = ui_seasons_pda.get_ui,
        })
    end)
    if not ok then
        printf("%s", "[seasons-pda] MAC registration failed: " .. tostring(err))
    end
end
