-- Seasons of the Zone - the calendar page.
--
-- What the Zone runs and why, where the year stands, what is on today and what is coming:
-- the Zone's own marked days, and the player's own seasons, events, periods and spells
-- from configure.bat. Everything comes from zzz_seasons_of_the_zone.calendar_page();
-- nothing is computed twice.
--
-- The season at the top is the one the world runs, which a pin, the dice or a spell can
-- make another than the calendar's, and the line under the date says which of them has
-- it. What is on today glows - in the lists, and as the line over its days on the grid -
-- so a season or event of the player's own reads as one the PDA has taken up.
--
-- Dates and names, and nothing about the MOD. An earlier version listed the staged
-- seasonal mods by name, which put MO2 folder strings on a stalker's PDA - and there is
-- no reliable way to turn an author-chosen folder name into something the Zone would say.
-- MCM's per-season pages already list them, which is where a question about an install
-- belongs. Anything on the GAME clock - the weather plan, the next emission - lives on
-- the forecast page for the same reason: it is not a calendar question.
--
-- Laid out on the forecast page's grid, down to the frame constants: the two sit side by
-- side in the launcher and should read as one device seen twice. No scroll view - a page
-- you have to scroll to read the date off is a document, not a device.
--
-- Mod App Creator calls get_ui() and expects a CUIScriptWnd back. Registration lives in
-- z_seasons_pda_mac.script, so this file does not care whether MAC is installed.
--
-- The same page also opens flat, on the app key (sotz_pda.open_flat): a window of its own
-- in the 2D PDA's frame, which needs no PDA tab and no MAC. Escape, the key again or Back
-- closes it, and the switch trades it for Forecast's flat window.
--
-- House style: the page should read like a device, not a readout. Terse lines, the
-- Zone's own amber, no ornament. The one image is this mod's own - the year dial - so
-- nothing here can reference a texture that does not exist.
--
-- Every word on the page is a string id, st_sotz_* in st_seasons_of_the_zone.xml, read
-- through sotz_text; the dates and season names arrive from the data layer already in the
-- player's language, and the player's own names as they typed them.

local SINGLETON = nil
local FLAT = nil        -- the page in its own window, while it exists
-- The PDA's pages sit this far into the screen (pda_16.xml's <main>), and so does the flat
-- window, so its frame and page land where the 2D PDA's would.
local PDA_X, PDA_Y = 112, 34

local function say(msg)
    printf("%s", "[seasons-pda] " .. tostring(msg))
end

-- InitTexture does not apply width_factor, so a square asset renders as an ellipse
-- unless the width is corrected by (4:3) / screen aspect - 0.75 at 16:9. The MCM page
-- already does this for the same dial.
local function aspect()
    local f = 0.75
    local ok, w, h = pcall(function() return device().width, device().height end)
    if ok and w and h and h > 0 then
        f = (1024 / 768) / (w / h)
    end
    return f
end

-- These are loose .dds files under gamedata/textures with no texture_descr entry, so the
-- engine resolves them by path and wants the bare stem. dial_texture() returns the name
-- WITH .dds because that is what MCM's image option takes; the accent bar is built by
-- concatenation and has none. Normalize both here rather than depending on which.
local function tex(name)
    name = tostring(name or "")
    if name == "" then return nil end
    return (name:gsub("%.dds$", ""))
end

-- `s` cut to `n` letters, an ellipsis last, for a field narrower than a name can be. A
-- byte is a letter here: the game's text is windows-1251, whose ellipsis is 133.
local function fit(s, n)
    s = tostring(s or "")
    if #s <= n then return s end
    return s:sub(1, n - 1) .. "\133"
end

-- A spell's chance a day: a whole percent as one, a fraction to one place
local function odds(chance)
    local c = tonumber(chance) or 0
    local shown = (c == math.floor(c)) and string.format("%d", c) or string.format("%.1f", c)
    return sotz_text.text("st_sotz_year_odds", {chance = shown})
end

-- CScriptXmlInit:ParseFile does NOT raise when the xml cannot be used - it returns, and
-- every Init* afterwards quietly hands back nil. The first method call on one of those
-- nils is a hard engine FATAL, not a Lua error pcall can absorb, which is exactly how a
-- comment sitting above the root element took the whole game down once. So nothing below
-- dereferences a widget without checking first, and a broken page is a blank page.
local function put(w, text)
    if w then w:SetText(text or "") end
end

local function page()
    local ok, data = pcall(function() return zzz_seasons_of_the_zone.calendar_page() end)
    if ok and type(data) == "table" then return data end
    say("calendar_page() unavailable: " .. tostring(data))
    return nil
end

class "SeasonsPDA" (CUIScriptWnd)

function SeasonsPDA:__init(flat) super()
    self.flat = flat == true
    self:InitControls()
end

function SeasonsPDA:__finalize()
    if self.flat then
        FLAT = nil
    else
        SINGLETON = nil
    end
end

function SeasonsPDA:InitControls()
    local x, y = self.flat and PDA_X or 0, self.flat and PDA_Y or 0
    self:SetWndRect(Frect():set(x, y, x + 1024, y + 768))

    local xml = CScriptXmlInit()
    xml:ParseFile("ui_seasons_pda.xml")
    self.xml = xml

    -- flat: the 2D PDA's frame behind the page, and the face's name where the PDA prints a
    -- section's
    if self.flat then
        xml:InitStatic("flat_bezel", self)
        put(xml:InitTextWnd("flat_caption", self), sotz_text.text(sotz_pda.VIEWS.year.title))
    end
    xml:InitStatic("background", self)
    self.header    = xml:InitTextWnd("header", self)
    self.bar       = xml:InitStatic("bar", self)
    self.subheader = xml:InitTextWnd("subheader", self)
    self.turning   = xml:InitTextWnd("turning", self)

    self.dial = xml:InitStatic("dial", self)
    if self.dial then
        -- GetHeight/GetWidth, not GetWndRect: the latter is not bound in this
        -- engine at all. It reads plausibly and it is what crashed the game.
        local h = self.dial:GetHeight()
        self.dial:SetWndSize(vector2():set(h * aspect(), h))
    else
        say("ui_seasons_pda.xml gave up no elements - check its root")
    end
    self.dial_caption = xml:InitTextWnd("dial_caption", self)

    self.grid       = xml:InitStatic("grid", self)
    self.grid_cap_l = xml:InitTextWnd("grid_cap_l", self)
    self.grid_cap_r = xml:InitTextWnd("grid_cap_r", self)
    self:InitFrame()
    self:InitGrid()
    self:InitScales()
    self:InitRows()
    -- the switch to the app's other face; a fault in it costs the switch, not the page
    local okt, errt = pcall(function() self:InitToggle() end)
    if not okt then say("switch failed: " .. tostring(errt)) end
    -- Silence and the credit line, likewise
    local okf, errf = pcall(function() self:InitFooter() end)
    if not okf then say("footer failed: " .. tostring(errf)) end

    self.back = xml:Init3tButton("back", self)
    if self.back then
        self.back:InitTexture("sotz_app_back")
        self:Register(self.back, "back")
        self:AddCallback("back", ui_events.BUTTON_CLICKED, self.OnBack, self)
    end
end

-- The foot of the right column, beside Back, the same on both faces: Silence, and under it
-- the mod's name, version and author, so a screenshot of either page says which Seasons it is.
-- Silence is MCM's "PDA notifications" seen here too: it writes that option rather than
-- keeping a copy, as the units button on Forecast does.
function SeasonsPDA:InitFooter()
    local xml = self.xml
    self.silence = xml:Init3tButton("silence", self)
    -- the label after its plate, so it draws on top
    self.silence_label = xml:InitTextWnd("silence_label", self)
    self.credit = xml:InitTextWnd("credit", self)
    put(self.silence_label, sotz_text.text("st_sotz_silence"))
    put(self.credit, sotz_pda.credit())
    if self.silence then
        self.silence:InitTexture("sotz_btn")
        self:Register(self.silence, "silence")
        self:AddCallback("silence", ui_events.BUTTON_CLICKED, self.OnSilence, self)
    end
    self:PaintFooter()
end

function SeasonsPDA:OnSilence()
    sotz_pda.set_news(not sotz_pda.news_on())
    self:PaintFooter()
end

-- Lit, with an amber label, while the messages are silenced. Read afresh at every open, so a
-- change made in MCM shows the next time the page does.
function SeasonsPDA:PaintFooter()
    local quiet = not sotz_pda.news_on()
    -- two named calls rather than one chosen name: check_textures tells a four-state plate by
    -- the widget the call is made on
    if self.silence then
        if quiet then self.silence:InitTexture("sotz_btn_on") else self.silence:InitTexture("sotz_btn") end
    end
    if self.silence_label then
        self.silence_label:SetTextColor(quiet and GetARGB(255, 238, 196, 112)
                                              or GetARGB(255, 200, 200, 200))
    end
end

-- The switch between the app's two faces. This page's half is disabled, which shows the lit
-- plate, and has an amber label; clicking it does nothing. The other half opens the other
-- face through sotz_pda, which routes both sections with or without MAC.
function SeasonsPDA:InitToggle()
    local xml = self.xml
    self.toggle_year = xml:Init3tButton("toggle_year", self)
    self.toggle_fc   = xml:Init3tButton("toggle_fc", self)
    -- labels after their plates, so they draw on top
    self.toggle_year_label = xml:InitTextWnd("toggle_year_label", self)
    self.toggle_fc_label   = xml:InitTextWnd("toggle_fc_label", self)

    local V = sotz_pda.VIEWS
    put(self.toggle_year_label, sotz_text.text(V.year.title))
    put(self.toggle_fc_label, sotz_text.text(V.forecast.title))

    local here_btn, here_lbl = self.toggle_year, self.toggle_year_label
    local away_btn = self.toggle_fc
    -- named, not looped: check_textures can only tell a four-state plate from a plain one
    -- by the widget the call is made on, and that check is what caught the empty tiles
    if self.toggle_year then self.toggle_year:InitTexture("sotz_btn") end
    if self.toggle_fc   then self.toggle_fc:InitTexture("sotz_btn") end
    if here_btn then here_btn:Enable(false) end
    if here_lbl then here_lbl:SetTextColor(GetARGB(255, 238, 196, 112)) end
    if away_btn then
        self:Register(away_btn, "toggle_fc")
        self:AddCallback("toggle_fc", ui_events.BUTTON_CLICKED, self.OnToggle, self)
    end
end

-- in the PDA, the other face's section; flat, the other face's window in place of this one
function SeasonsPDA:OnToggle()
    if self.flat then
        sotz_pda.open_flat("forecast")
    else
        sotz_pda.open(sotz_pda.VIEWS.forecast.tab)
    end
end

-- Back to the launcher. MAC reaches its own tab the same way, and it binds a key for it
-- too, but a page you can only leave by keyboard reads as a dead end. Flat, out of the
-- window.
function SeasonsPDA:OnBack()
    if self.flat then
        self:Close()
        return
    end
    local ok, err = pcall(function()
        ActorMenu.get_pda_menu():SetActiveSubdialog("eptLauncher")
    end)
    if not ok then say("back to launcher failed: " .. tostring(err)) end
end

function SeasonsPDA:Close()
    if self:IsShown() then
        self:HideDialog()
    end
end


-- --- the frame ----------------------------------------------------------------------------
--
-- The PDA's own framing language, taken off the Statistics page: a chamfered outer frame
-- with the corners left open, and thin rules splitting the content into cells. The lines
-- sit close to the background on purpose - they are there to group things, not to be
-- looked at. Identical constants to the forecast page, because the two pages are the same
-- page with different contents.
--
-- Allocated once. The frame never moves, so rebuilding it per redraw would be a slow leak.
local RULE   = {74, 80, 74}
local RULE_A = 210

-- the content box, inset from the page background at 28,106 - 792,709
local FR_L, FR_T, FR_R, FR_B = 38, 112, 782, 700
local CHAMFER   = 14        -- how far each line stops short of a corner
local SPLIT_X   = 526       -- between the year column and the dial column
local FR_HEAD_Y = 202       -- under the title, accent bar, date and the line under it
local FR_DIAL_Y = 404       -- under the dial and its caption, right column only
local FR_GRID_Y = 470       -- under the grid and its captions, left column only

function SeasonsPDA:InitFrame()
    self.frame = {}
    local function line(x, y, w, h, a)
        local s = self.xml:InitStatic("px", self)
        if not s then return end
        s:SetWndPos(vector2():set(x, y))
        s:SetWndSize(vector2():set(w, h))
        s:SetTextureColor(GetARGB(a or RULE_A, RULE[1], RULE[2], RULE[3]))
        self.frame[#self.frame + 1] = s
    end

    -- outer frame, corners left open so it reads as the chamfer the game's own panels
    -- have rather than as a plain box
    line(FR_L + CHAMFER, FR_T, FR_R - FR_L - CHAMFER * 2, 1)
    line(FR_L + CHAMFER, FR_B, FR_R - FR_L - CHAMFER * 2, 1)
    line(FR_L, FR_T + CHAMFER, 1, FR_B - FR_T - CHAMFER * 2)
    line(FR_R, FR_T + CHAMFER, 1, FR_B - FR_T - CHAMFER * 2)

    -- The header rule covers the LEFT column only, as on the forecast page: the dial
    -- occupies the right column from well above this line.
    line(FR_L + CHAMFER, FR_HEAD_Y, SPLIT_X - FR_L - CHAMFER, 1)

    -- the split runs the whole height, so the dial column is one tall cell
    line(SPLIT_X, FR_T + CHAMFER, 1, FR_B - FR_T - CHAMFER * 2)

    -- and each column's own divider: the dial from its list, the grid from its list
    line(SPLIT_X + CHAMFER, FR_DIAL_Y, FR_R - SPLIT_X - CHAMFER * 2, 1)
    line(FR_L + CHAMFER, FR_GRID_Y, SPLIT_X - FR_L - CHAMFER * 2, 1)
end


-- --- rows ---------------------------------------------------------------------------------
--
-- Two fixed columns, no scrolling, two lists in each: Now and Coming up under the grid, the
-- year and its spells beside the dial. Color carries the emphasis a font change would
-- normally carry, because a widget cannot be restyled after it is built.
local HEAD_RGB = {238, 196, 112}
local LINE_RGB = {200, 200, 200}
local NOW_RGB  = {255, 255, 255}

-- Each column starts where the thing above it ends rather than on a shared line: the
-- left one is under the grid, the right one under the dial.
local COL_X  = {52, 556}
-- What is left of the frame after each column's left edge and its own padding. row_line
-- is declared at the LEFT column's width, so a right-hand field inherited a 460px rect
-- running half a screen past the page edge; every field is sized to its cell instead.
local COL_W  = {460, 212}
local FIELD_MIN = 44
local COL_Y0 = {480, 412}     -- the first heading in each column
local COL_Y1 = {692, 628}     -- and where it must stop; the back button owns that corner
local HEAD_H = 24
local ROW_H  = 17
-- a full Now and Coming up on the left; the year, its periods and the spells on the right
local ROWS   = {12, 12}
local HEADS  = 4
-- Now shows this many rows at most, the last of them "and 3 more" when there are more
local NOW_MOST = 4

-- Rows are placed against a moving cursor rather than a fixed first-row y, so a list can
-- change length without every constant below it moving too.
function SeasonsPDA:InitRows()
    self.heads = {}
    for i = 1, HEADS do
        local h = self.xml:InitTextWnd("row_head", self)
        if h then h:Show(false) end
        self.heads[i] = h
    end
    self.rows, self.used, self.cursor = {}, {}, {}
    for col = 1, 2 do
        self.rows[col] = {}
        for i = 1, ROWS[col] do
            local set = {}
            for f = 1, 3 do
                local w = self.xml:InitTextWnd("row_line", self)
                if w then
                    w:Show(false)
                    set[f] = w
                end
            end
            self.rows[col][i] = set
        end
        self.used[col] = 0
        self.cursor[col] = COL_Y0[col]
    end
    self.head_n = 0
end

function SeasonsPDA:Section(col, title)
    local y = self.cursor[col] or COL_Y0[col]
    self.head_n = (self.head_n or 0) + 1
    local h = self.heads and self.heads[self.head_n]
    if h and y + HEAD_H <= COL_Y1[col] then
        h:SetText(title or "")
        h:SetWndPos(vector2():set(COL_X[col], y))
        h:SetWndSize(vector2():set(COL_W[col], HEAD_H))
        h:SetTextColor(GetARGB(255, HEAD_RGB[1], HEAD_RGB[2], HEAD_RGB[3]))
        h:Show(true)
    end
    self.cursor[col] = y + HEAD_H
end

-- air between two lists in one column, so the second heading does not read as a row
function SeasonsPDA:Gap(col, px)
    self.cursor[col] = (self.cursor[col] or COL_Y0[col]) + px
end

-- Rows that fit under the cursor in a column, after a heading of `heads` headings
function SeasonsPDA:Room(col, heads)
    local y = (self.cursor[col] or COL_Y0[col]) + (heads or 0) * HEAD_H
    return math.max(0, math.floor((COL_Y1[col] - y) / ROW_H))
end

-- fields is {{dx, text}, ...}, dx measured from the column's left edge. letterica is a
-- PROPORTIONAL font: padding a string with string.format("%-12s") does NOT line anything
-- up. It looked fine in a monospaced editor and ragged on the PDA. Returns the widgets
-- the row was drawn in, or nil when the column is full.
function SeasonsPDA:Put(col, fields, rgb)
    if not (self.rows and self.rows[col]) then return nil end
    local n = (self.used[col] or 0) + 1
    local y = self.cursor[col] or COL_Y0[col]
    -- never grow, and never run past the cell: a full column simply stops
    if n > ROWS[col] or y + ROW_H > COL_Y1[col] then return nil end
    self.used[col] = n
    self.cursor[col] = y + ROW_H
    local set = self.rows[col][n]
    local drawn = {}
    rgb = rgb or LINE_RGB
    for f = 1, 3 do
        local w = set and set[f]
        if w then
            local spec = fields[f]
            if spec then
                w:SetText(tostring(spec[2] or ""))
                w:SetWndPos(vector2():set(COL_X[col] + spec[1], y))
                w:SetWndSize(vector2():set(
                    math.max(FIELD_MIN, COL_W[col] - spec[1]), ROW_H))
                w:SetTextColor(GetARGB(255, rgb[1], rgb[2], rgb[3]))
                w:Show(true)
                drawn[#drawn + 1] = w
            else
                w:Show(false)
            end
        end
    end
    return drawn
end

function SeasonsPDA:ClearRows()
    for i = 1, HEADS do
        if self.heads and self.heads[i] then self.heads[i]:Show(false) end
    end
    self.head_n = 0
    for col = 1, 2 do
        for i = 1, ROWS[col] do
            local set = self.rows and self.rows[col] and self.rows[col][i]
            for f = 1, 3 do
                if set and set[f] then set[f]:Show(false) end
            end
        end
        self.used[col] = 0
        self.cursor[col] = COL_Y0[col]
    end
end

-- What is on glows: a row's words, the line over its days on the grid, and that line's
-- halo. Kept on lists that Update() walks; Fill() starts them afresh.
function SeasonsPDA:Glow(widgets)
    self.glow = self.glow or {}
    for _, w in ipairs(widgets or {}) do self.glow[#self.glow + 1] = w end
end


-- --- the year grid ------------------------------------------------------------------------
--
-- Twelve month rows of day cells, tinted by season, today lit and the marked days
-- underlined. A year drawn the way a year looks, which a single strip never quite is: on
-- a strip "late October" is a position you have to measure, and on a grid it is a place.
-- The player's own seasons, dated events and periods are a line in the gap above their
-- days, the spells play.bat found too, and a spell that brings its season tints its days
-- that season's color: those days are that season now.
--
-- Drawn as one block per SEASON RUN rather than one block per day. Twelve months of 31
-- days would be 372 statics held for the life of the session; the same picture comes out
-- of about fifteen blocks plus thirty hairlines for the day divisions, because within one
-- month the days of one season are always contiguous.
--
-- X-Ray has no fill-rect: a CUIStatic carrying a plain white block and tinted with
-- SetTextureColor is how every other mod in the install draws one. The blocks are
-- allocated ONCE and reused, because get_ui() calls Reset() on every open and a fresh set
-- per redraw would pile up and never release.
local GRID_X, GRID_Y = 52, 212      -- must match <grid> in the xml
local GRID_W  = 452
local GUT     = 38                  -- the month-name column, left of the cells
local CELL_W  = 13                  -- 31 days at 13 is 403, inside 452 - 38
local CELL_H  = 14
local PITCH   = 18                  -- month to month, so the rows read as twelve bands
local ROW_Y0  = 18                  -- under the day scale, in grid-local y
-- ~15 runs + 30 day rules + 6 marked + today, and the player's own: a line and a halo
-- for each month a window touches
local BAR_POOL = 240
-- kept back from the player's own, so a crowded year still draws the marked days and today
local RESERVE = 8

-- The dial's own arc colors, so the grid and the dial are one picture of the year seen
-- twice rather than two that merely sit near each other. These are exactly what
-- _tools/build_season_dial.py season_colors() computes from the season grades, scaled by
-- SEASON_DIM: the dial draws thin arcs and can carry full brightness, while a third of
-- the grid at (234,235,234) would be the loudest thing on the page. One factor for all
-- six keeps the hues and their order intact.
--
-- test_calendar recomputes them from the generator and fails if the two ever drift, so
-- changing a season's grade is a one-line follow-up here rather than a silent lie.
local SEASON_DIM = 0.78
local SEASON_RGB = {
    spring      = {136, 183, 136},
    summer      = {173, 183, 126},
    autumn      = {183, 155,  95},
    winter      = {145, 161, 183},
    winter_snow = {182, 183, 182},
    late_winter = {183, 175, 150},
}

-- The one red in the mod - the same one the forecast page strobes an emission alert
-- in - because it is the only hue nowhere in the season palette and so the only one a
-- month cannot camouflage. Amber marks vanished into autumn and slate marks into deep
-- winter, which are exactly the months they most needed to be seen on.
local MARK_RGB   = {238, 96, 72}
local MARK_H     = 5                -- the underline; 4 read as an artefact of the cell
-- The cool half of the alarm pulse. Still red, so the thing never stops reading as red -
-- it just stops being bright, which is what makes a pulse a pulse rather than a blink.
local MARK_COOL  = {150, 60, 50}

-- The player's own: a line in the gap above the cells, not on them, so it reads over any
-- season's color. The Zone's amber, dimmed while it is not on; on, it glows.
local OVER_RGB   = {176, 146, 88}
local OVER_H     = 2
local HALO_H     = 4                -- the whole gap above the row, behind the line

local MONTH_LEN  = {31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31}
-- five day marks, like the forecast's five hours: more than this and they collide
local DAY_AT     = {1, 8, 15, 22, 29}

-- Leap years are read off the length the data layer reported rather than recomputed, so
-- the grid cannot disagree with the day number printed beneath it.
local function month_len(m, year_len)
    local leap = (year_len and year_len >= 366) and 1 or 0
    return MONTH_LEN[m] + ((m == 2) and leap or 0)
end

local function month_starts(year_len)
    local out, acc = {}, 1
    for m = 1, 12 do
        out[m] = acc
        acc = acc + month_len(m, year_len)
    end
    return out
end

-- Which season owns each day of the year. Built by walking each season's span rather than
-- by comparing boundaries, so the one that runs December into March needs no special case
-- at all - the modulo carries it around the year end.
local function season_map(d, year_len)
    local map = {}
    for _, s in ipairs(d.seasons or {}) do
        local a, n = tonumber(s.doy_from), tonumber(s.span)
        if a and n then
            for i = 0, n - 1 do
                map[((a + i - 1) % year_len) + 1] = s.key
            end
        end
    end
    return map
end

-- Today's month and day, from the day number the page already reports. The data layer
-- does not publish them and does not need to: the grid is built from the same month
-- table, so deriving them here cannot disagree with the cells they land on.
local function md_of(doy, starts, year_len)
    for m = 12, 1, -1 do
        if doy >= starts[m] and doy < starts[m] + month_len(m, year_len) then
            return m, doy - starts[m] + 1
        end
    end
    return nil, nil
end

-- {m, first day, last day} for each month a day-of-year span from..to touches
local function month_runs(from, to, starts, year_len)
    local out = {}
    for m = 1, 12 do
        local a, z = starts[m], starts[m] + month_len(m, year_len) - 1
        local lo, hi = math.max(from, a), math.min(to, z)
        if lo <= hi then out[#out + 1] = {m, lo - a + 1, hi - a + 1} end
    end
    return out
end

function SeasonsPDA:InitGrid()
    self.bars, self.bar_n = {}, 0
    if not self.grid then return end
    for i = 1, BAR_POOL do
        local s = self.xml:InitStatic("px", self.grid)
        if not s then break end
        s:Show(false)
        self.bars[i] = s
    end
end

function SeasonsPDA:InitScales()
    self.months, self.axis_x = {}, {}
    for i = 1, 12 do
        local w = self.xml:InitTextWnd("grid_month", self)
        if w then w:Show(false) end
        self.months[i] = w
    end
    for i = 1, #DAY_AT do
        local w = self.xml:InitTextWnd("axis_x", self)
        if w then w:Show(false) end
        self.axis_x[i] = w
    end
end

-- One block from the pool. `spare` keeps that many back for what has to be drawn after.
function SeasonsPDA:Bar(x, y, w, h, r, g, b, alpha, spare)
    if spare and (self.bar_n or 0) >= #(self.bars or {}) - spare then return nil end
    self.bar_n = (self.bar_n or 0) + 1
    local s = self.bars and self.bars[self.bar_n]
    if not s then return nil end               -- pool exhausted: draw nothing, never grow
    if w < 1 then w = 1 end
    s:SetWndPos(vector2():set(x, y))
    s:SetWndSize(vector2():set(w, h))
    s:SetTextureColor(GetARGB(alpha or 255, r, g, b))
    s:Show(true)
    return s
end

function SeasonsPDA:BlankGrid()
    self.today_bar = nil
    self.glow_bars, self.halos = {}, {}
    for i = 1, #(self.bars or {}) do
        if self.bars[i] then self.bars[i]:Show(false) end
    end
    for i = 1, #(self.months or {}) do
        if self.months[i] then self.months[i]:Show(false) end
    end
    for i = 1, #(self.axis_x or {}) do
        if self.axis_x[i] then self.axis_x[i]:Show(false) end
    end
    self.bar_n = 0
end

function SeasonsPDA:DrawGrid(d)
    self:BlankGrid()
    if not self.grid then return end

    local len = tonumber(d.year_len) or 365
    if len < 1 then len = 365 end
    local starts = month_starts(len)
    local owner  = season_map(d, len)
    local rows_h = 11 * PITCH + CELL_H

    local function cell_x(day) return GUT + (day - 1) * CELL_W end
    local function row_y(m)    return ROW_Y0 + (m - 1) * PITCH end

    -- --- the months -------------------------------------------------------------------
    for m = 1, 12 do
        local y, n = row_y(m), month_len(m, len)
        local run_from, run_key = 1, owner[starts[m]]
        local function flush(upto)
            local c = SEASON_RGB[tostring(run_key)] or {150, 150, 150}
            self:Bar(cell_x(run_from), y, (upto - run_from + 1) * CELL_W - 1, CELL_H,
                     c[1], c[2], c[3], 235)
        end
        for day = 2, n do
            local k = owner[starts[m] + day - 1]
            if k ~= run_key then
                flush(day - 1)
                run_from, run_key = day, k
            end
        end
        flush(n)

        local w = self.months and self.months[m]
        if w then
            w:SetText(sotz_text.month_short(m))
            w:SetWndPos(vector2():set(GRID_X, GRID_Y + y))
            w:Show(true)
        end
    end

    -- --- a spell's season, on its days -----------------------------------------------
    for _, t in ipairs(d.tints or {}) do
        local c = SEASON_RGB[tostring(t.season)]
        if c then
            for _, r in ipairs(month_runs(t.from, t.to, starts, len)) do
                self:Bar(cell_x(r[2]), row_y(r[1]), (r[3] - r[2] + 1) * CELL_W - 1, CELL_H,
                         c[1], c[2], c[3], 235, RESERVE)
            end
        end
    end

    -- --- the day divisions ------------------------------------------------------------
    -- One hairline per day boundary, over the whole grid. Drawing 372 separate cells
    -- would look identical and cost twelve times the widgets, so the gaps are drawn
    -- instead of the cells. Dark enough to read as a gap over a month, faint enough to
    -- be almost nothing over the days a short month does not have.
    for day = 1, 30 do
        self:Bar(cell_x(day + 1) - 1, ROW_Y0, 1, rows_h, 26, 28, 26, 220)
    end

    -- --- the player's own ---------------------------------------------------------------
    -- A line in the gap above each day of a season of their own, a dated event, a period
    -- or a spell on. One that is on today glows, over a halo filling the gap; the rest
    -- wait in a dimmer amber.
    for _, mk in ipairs(d.marks or {}) do
        for _, r in ipairs(month_runs(mk.from, mk.to, starts, len)) do
            local x, w = cell_x(r[2]), (r[3] - r[2] + 1) * CELL_W - 1
            local y = row_y(r[1])
            if mk.active then
                local h = self:Bar(x, y - HALO_H, w, HALO_H, HEAD_RGB[1], HEAD_RGB[2],
                                   HEAD_RGB[3], 60, RESERVE)
                if h then self.halos[#self.halos + 1] = h end
            end
            local line = self:Bar(x, y - 3, w, OVER_H, OVER_RGB[1], OVER_RGB[2], OVER_RGB[3],
                                  255, RESERVE)
            if line and mk.active then self.glow_bars[#self.glow_bars + 1] = line end
        end
    end

    -- --- the days the Zone marks ------------------------------------------------------
    -- Underlined rather than filled: the cell already carries its season, and a day that
    -- changes the weather has not stopped being a day in that season. The underline is
    -- also what keeps a marked day distinct from today, which fills - on a day that is
    -- both, one color with two meanings would have to pick one.
    --
    -- One red for every kind. The memorial-against-anniversary split the color used to
    -- carry is said in words in the lists, which have room to say it properly. A day MCM's
    -- switches leave doing nothing is not marked.
    for _, day in ipairs(d.days or {}) do
        local m, dd = tonumber(day.month), tonumber(day.day)
        if m and dd and day.on ~= false then
            self:Bar(cell_x(dd), row_y(m) + CELL_H - MARK_H, CELL_W - 1, MARK_H,
                     MARK_RGB[1], MARK_RGB[2], MARK_RGB[3], 255)
        end
    end

    -- --- today ------------------------------------------------------------------------
    -- Drawn last, so the day division through it is covered and it reads as one lit cell
    -- rather than two halves. Kept on the side so Update can breathe it: the only moving
    -- thing on the page, and the only one that earns it.
    local tm, td = md_of(tonumber(d.doy) or 0, starts, len)
    if tm and td then
        self.today_bar = self:Bar(cell_x(td), row_y(tm), CELL_W - 1, CELL_H,
                                  MARK_RGB[1], MARK_RGB[2], MARK_RGB[3], 255)
    end

    -- --- the day scale ----------------------------------------------------------------
    for i, day in ipairs(DAY_AT) do
        local w = self.axis_x and self.axis_x[i]
        if w then
            w:SetText(tostring(day))
            -- Centered on its column, the label being 54 wide and the cell 13, then
            -- clamped inside the grid. The forecast page needed the same clamp for the
            -- same reason: its 24-hour label used to hang half its width past the chart
            -- and into the next column.
            local lx = GRID_X + cell_x(day) + math.floor(CELL_W / 2) - 27
            local hi = GRID_X + GRID_W - 54
            if lx > hi then lx = hi end
            if lx < GRID_X then lx = GRID_X end
            w:SetWndPos(vector2():set(lx, GRID_Y))
            w:Show(true)
        end
    end
end


-- --- what has the season ------------------------------------------------------------------
--
-- The line under the date: a pin, the dice or a spell, each beside what the calendar
-- reads; with the dice on, that they roll again; else the calendar's next turn. Returns
-- the line, and whether the season is another than the calendar's, which glows.
local function status(d)
    local run = d.running or {}
    local v = {season = d.label, Season = d.title}
    if run.pinned then return sotz_text.text("st_sotz_year_by_pin", v), true end
    if run.rolled then return sotz_text.text("st_sotz_year_by_dice", v), true end
    if run.spell then
        local _, m, day = tostring(run.spell.last):match("^(%d+)%-(%d+)%-(%d+)$")
        v.name = run.spell.name
        v.ends = sotz_text.date_short(tonumber(m), tonumber(day))
        return sotz_text.text("st_sotz_year_by_spell", v), true
    end
    local nx = d.next
    if not nx then return "", false end
    if d.dice then return sotz_text.text("st_sotz_year_dice_again"), false end
    local w = {season = nx.label, Season = nx.title}
    if nx.days == 0 then return sotz_text.text("st_sotz_year_next_today", w), false end
    if nx.days == 1 then return sotz_text.text("st_sotz_year_next_tomorrow", w), false end
    return sotz_text.plural("st_sotz_year_next_in_days", nx.days, w), false
end

-- The seasons that are on and the player's own periods, in the order the year runs from
-- spring: each period after the season its start falls in
local function year_rows(d)
    local out, len = {}, tonumber(d.year_len) or 365
    for _, s in ipairs(d.seasons or {}) do
        out[#out + 1] = {season = s}
        local mine = {}
        for _, p in ipairs(d.periods or {}) do
            local off = ((tonumber(p.doy_from) or 0) - (tonumber(s.doy_from) or 0)) % len
            if off < (tonumber(s.span) or 0) then mine[#mine + 1] = {off = off, period = p} end
        end
        table.sort(mine, function(a, b) return a.off < b.off end)
        for _, x in ipairs(mine) do out[#out + 1] = {period = x.period} end
    end
    return out
end


function SeasonsPDA:Fill()
    self:ClearRows()
    self.glow, self.alert_set = {}, nil

    local d = page()
    if not d then
        put(self.header, sotz_text.text("st_sotz_year_title"))
        put(self.subheader, sotz_text.text("st_sotz_year_unreadable"))
        put(self.turning, "")
        put(self.grid_cap_l, "")
        put(self.grid_cap_r, "")
        -- and clear the grid, or the last good year stays on screen with today's cell
        -- still breathing over it: a stale reading that looks live
        self:BlankGrid()
        self.alert = false
        return
    end

    -- the season the Zone runs, in both its forms: `title` starts a line, `label` sits
    -- inside one
    local run = d.running or {key = d.season, label = d.label, title = d.title}
    put(self.header, sotz_text.text("st_sotz_year_header",
                                    {season = run.label, Season = run.title}))
    put(self.subheader, d.today)

    -- the season's own accent strip; ours, so it cannot be missing
    if d.bar and self.bar then
        local okb = pcall(function() self.bar:InitTexture(tex(d.bar)) end)
        if not okb then say("accent bar failed: " .. tostring(d.bar)) end
    end

    -- what has the season, and it glows when it is not the calendar. White first: the
    -- page is kept between openings, and a glow left on it from a pin since taken off
    -- would go on looking like one
    local line, other = status(d)
    put(self.turning, line)
    if self.turning then self.turning:SetTextColor(GetARGB(255, 255, 255, 255)) end
    if other and self.turning then self:Glow({self.turning}) end

    -- no dial is a calendar of the player's own that could not be drawn (no Pillow)
    if self.dial then
        self.dial:Show(d.dial ~= nil)
        if d.dial then
            local okd = pcall(function() self.dial:InitTexture(tex(d.dial)) end)
            if not okd then say("dial texture failed: " .. tostring(d.dial)) end
        end
    end

    -- the dial shows the calendar's year; the caption gives its current span
    put(self.dial_caption, "")
    for _, s in ipairs(d.seasons or {}) do
        if s.current then
            -- one season on is the whole year, which runs from its start back to it
            local span = (s.from == s.to) and sotz_text.text("st_sotz_year_all_year")
                         or sotz_text.text("st_sotz_year_span", {from = s.from, to = s.to})
            put(self.dial_caption, span)
        end
    end

    -- Whether today is one of the six. Recorded here rather than recomputed sixty times
    -- a second in Update, the same way the forecast records its alert lines.
    self.alert = (d.marked ~= nil)

    -- --- the grid -----------------------------------------------------------------------
    self:DrawGrid(d)
    -- The month names and the day scale carry the axes, so the captions only say what
    -- they cannot: where today falls as a number, and what the marks are.
    put(self.grid_cap_l, sotz_text.text("st_sotz_year_day_of",
                                        {day = tonumber(d.doy) or 0,
                                         days = tonumber(d.year_len) or 0}))
    put(self.grid_cap_r, sotz_text.text("st_sotz_year_key"))

    -- --- now, and coming up ----------------------------------------------------------
    -- Now is what is on today beyond the season, each until its last day, glowing; the
    -- Zone's own day alarms instead. Coming up is the next of each, soonest first: the
    -- calendar's turn, the marked days, the player's own.
    local now = d.now or {}
    if #now > 0 then
        self:Section(1, sotz_text.text("st_sotz_year_now"))
        local shown = (#now > NOW_MOST) and (NOW_MOST - 1) or #now
        for i = 1, shown do
            local row = now[i]
            local drawn = self:Put(1, {{0, fit(row.show, 16)}, {110, row.when},
                                       {210, fit(row.what, 40)}},
                                   row.alert and MARK_RGB or NOW_RGB)
            if row.alert then
                self.alert_set = drawn
            else
                self:Glow(drawn)
            end
        end
        if #now > shown then
            self:Put(1, {{0, sotz_text.plural("st_sotz_year_more", #now - shown)}},
                     LINE_RGB)
        end
        self:Gap(1, 6)
    end
    local coming = d.coming or {}
    if #coming > 0 then
        self:Section(1, sotz_text.text("st_sotz_year_coming"))
        for _, row in ipairs(coming) do
            if not self:Put(1, {{0, row.date}, {110, row.when}, {210, fit(row.what, 40)}},
                            LINE_RGB) then
                break
            end
        end
    end

    -- --- the year, beside the dial that draws it ----------------------------------------
    -- Start dates, not lengths. The dial directly above prints every season's length
    -- already - illegibly, at 212px, but it prints them - and the grid on the left shows
    -- each span at its true width. What neither can state exactly is the date a season
    -- turns, which is the thing a stalker would actually want off this page. The
    -- calendar's season is white; the season running, when it is another, glows, and so
    -- does a period of the player's own while it is on.
    self:Section(2, sotz_text.text("st_sotz_year_season_starts"))
    local running = run.key
    for _, r in ipairs(year_rows(d)) do
        if r.season then
            local s = r.season
            local since = sotz_text.text("st_sotz_year_from", {date = s.from})
            local glow = (s.key == running) and not s.current
            local drawn = self:Put(2, {{0, fit(s.title, 17)}, {118, since}},
                                   (s.current or glow) and NOW_RGB or LINE_RGB)
            if glow then self:Glow(drawn) end
        else
            local p = r.period
            local since = sotz_text.text("st_sotz_year_from", {date = p.from})
            local drawn = self:Put(2, {{0, fit(p.show, 17)}, {118, since}},
                                   p.on and NOW_RGB or LINE_RGB)
            if p.on then self:Glow(drawn) end
        end
    end

    -- the spells that can start today, with the chance of each a day; one on glows
    local spells = d.spells or {}
    if #spells > 0 then
        self:Gap(2, 6)
        self:Section(2, sotz_text.text("st_sotz_year_spells_in", {season = d.spells_in}))
        for _, sp in ipairs(spells) do
            local drawn = self:Put(2, {{0, fit(sp.show, 17)}, {118, odds(sp.chance)}},
                                   sp.on and NOW_RGB or LINE_RGB)
            if not drawn then break end
            if sp.on then self:Glow(drawn) end
        end
    end

    -- One line per open, naming what the page actually resolved. This page has the same
    -- invisible failure mode the forecast does: a grid that drew nothing and a page that
    -- was never opened look identical from the log, so three quiet sessions proved only
    -- that nothing had crashed. cells is the count DrawGrid placed, which is the one
    -- number that cannot be produced by a page that failed to build.
    say(string.format("season=%s running=%s day=%s/%s cells=%s rows=%s/%s now=%s glow=%s",
        tostring(d.season), tostring(run.key), tostring(d.doy), tostring(d.year_len),
        tostring(self.bar_n), tostring(self.used[1]), tostring(self.used[2]),
        tostring(#now), tostring(#(self.glow or {}))))
end

-- Three rhythms, and which one is running is itself the information.
--
-- An ordinary day BREATHES: 2.4 seconds, a slow nod that the page is live rather than a
-- picture of a year. Six days out of three hundred and sixty five the Zone actually does
-- something, and on those the cell ALARMS instead - the same 900ms square pulse the
-- forecast strobes an approaching emission in, in the same red.
--
-- And what is on today GLOWS: the player's own seasons, events, periods and spells, a
-- season another than the calendar's, in amber that swells to near white and back over
-- two seconds, with a halo behind each line on the grid. Smooth, where the alarm is
-- square, so the two never read as the same signal.
--
-- So the tell is the rhythm, not the color: you can see which kind of day it is from
-- across the room without reading a word, which is most of the reason for drawing a year
-- as a grid at all. A fade would have been wrong for the alarm for the same reason it was
-- wrong there - a fade reads as decoration, a pulse reads as an alarm.
--
-- One color write per frame on one cell, two on an event day, and one for each glowing
-- widget. Same budget as the forecast page's live dot, plus the handful that is on.
local PULSE_MS = 2400
local ALERT_MS = 900
local GLOW_MS  = 2000
local GLOW_LO  = {214, 166, 82}
local GLOW_HI  = {255, 238, 190}

function SeasonsPDA:Update()
    CUIScriptWnd.Update(self)
    local ok, ms = pcall(time_global)
    if not (ok and type(ms) == "number") then return end

    if (self.glow and #self.glow > 0) or (self.glow_bars and #self.glow_bars > 0) then
        local f = 0.5 + 0.5 * math.sin((ms % GLOW_MS) / GLOW_MS * 6.2831853)
        local r = math.floor(GLOW_LO[1] + (GLOW_HI[1] - GLOW_LO[1]) * f + 0.5)
        local g = math.floor(GLOW_LO[2] + (GLOW_HI[2] - GLOW_LO[2]) * f + 0.5)
        local b = math.floor(GLOW_LO[3] + (GLOW_HI[3] - GLOW_LO[3]) * f + 0.5)
        local argb = GetARGB(255, r, g, b)
        -- words take a text color, the grid's blocks a texture color
        for _, w in ipairs(self.glow or {}) do w:SetTextColor(argb) end
        for _, s in ipairs(self.glow_bars or {}) do s:SetTextureColor(argb) end
        local halo = GetARGB(math.floor(30 + 110 * f), HEAD_RGB[1], HEAD_RGB[2], HEAD_RGB[3])
        for _, h in ipairs(self.halos or {}) do h:SetTextureColor(halo) end
    end

    if self.alert then
        local hot = (ms % ALERT_MS) < (ALERT_MS * 0.55)
        local c = hot and MARK_RGB or MARK_COOL
        local argb = GetARGB(255, c[1], c[2], c[3])
        -- the row that names the day, and the cell it falls on, together
        for _, w in ipairs(self.alert_set or {}) do w:SetTextColor(argb) end
        if self.today_bar then self.today_bar:SetTextureColor(argb) end
        return
    end

    if not self.today_bar then return end
    -- 190 rather than 150 at the bottom of the breath: the old floor took the cell far
    -- enough down that it stopped reading as red at all for a third of every cycle,
    -- which is the opposite of what marking today is for.
    local f = 0.5 + 0.5 * math.sin((ms % PULSE_MS) / PULSE_MS * 6.2831853)
    self.today_bar:SetTextureColor(GetARGB(math.floor(190 + 65 * f),
                                           MARK_RGB[1], MARK_RGB[2], MARK_RGB[3]))
end

function SeasonsPDA:Reset()
    local ok, err = pcall(function() self:Fill() end)
    if not ok then say("Fill failed: " .. tostring(err)) end
    local okf, errf = pcall(function() self:PaintFooter() end)
    if not okf then say("footer failed: " .. tostring(errf)) end
end

function SeasonsPDA:OnKeyboard(dik, action)
    local res = CUIScriptWnd.OnKeyboard(self, dik, action)
    if res then return res end
    if action == ui_events.WINDOW_KEY_PRESSED
       and (dik == DIK_keys.DIK_ESCAPE or (self.flat and dik == sotz_pda.app_key())) then
        -- escape used to be swallowed here, which left the page with no way out but the
        -- launcher key. It goes back now; flat, it and the app key close the window.
        self:OnBack()
        return true
    end
    return false
end

function get_ui()
    SINGLETON = SINGLETON or SeasonsPDA()
    SINGLETON:Reset()
    return SINGLETON
end

-- The page in a window of its own, filled afresh each time it opens. sotz_pda.open_flat
-- calls this; it closes Forecast's window first.
function open_flat()
    FLAT = FLAT or SeasonsPDA(true)
    if not FLAT:IsShown() then
        FLAT:Reset()
        FLAT:ShowDialog(true)
    end
    return FLAT
end

function close_flat()
    if FLAT then FLAT:Close() end
end

-- the flat window, while it is open
function flat_window()
    return (FLAT and FLAT:IsShown()) and FLAT or nil
end
