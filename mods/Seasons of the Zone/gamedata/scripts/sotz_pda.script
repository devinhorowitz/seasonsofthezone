-- Seasons of the Zone - the PDA app.
--
-- One app with two faces: The Year, which answers questions about dates, and Forecast,
-- which answers "what is about to happen" on the game clock. Each lives in its own PDA
-- section, so the engine treats both as ordinary pages, and a switch at the top of each
-- page moves between them.
--
-- Three ways in, and nothing here depends on which the player took:
--
--   Mod App Creator's launcher. z_seasons_pda_mac.script puts one tile there, and is the
--   only place MAC is registered. It needs MAC, and MAC's Launcher in the PDA's tab bar.
--
--   A tab of its own in the PDA's tab bar, on Modded Exes (below). It takes the tile's place.
--
--   The app key (MCM, Main page). It opens either face in a window of its own, drawn in the
--   2D PDA's frame, and needs neither MAC nor any PDA tab. The tab bar is one file,
--   ui/pda_16.xml, which MAC ships whole and so do mods that add tabs of their own. Only one
--   copy wins, and the loser's tabs are gone: MAC's Launcher, or the other mod's. The key is
--   the way in that no such pair can take away. With the 3D PDA on it is also the sharper
--   view: a PDA page is drawn onto the screen in hand, this window straight to the screen.

-- The two faces, by the PDA section each lives in. `title` is the string id of what the
-- PDA prints top left for that section, of what the switch on each page says, and of the
-- caption over a face opened flat.
VIEWS = {
    year     = {tab = "eptSeasons",  title = "pda_btn_seasons"},
    forecast = {tab = "eptForecast", title = "pda_btn_forecast"},
}

-- MCM stores the app key here: the key's DIK code, or -1 while unbound, which is how it ships.
KEY_PATH = "seasons_zone/main/app_key"

-- MCM's "Seasons tab in the PDA" (Main page), off as it ships: the tab of its own in place of
-- the launcher tile. MCM offers it only where both could be (tab_supported, and MAC).
TAB_PATH = "seasons_zone/main/pda_tab"

-- MCM's "PDA notifications" (Main page), on as it ships. Every PDA message the mod sends goes
-- through zzz_seasons_of_the_zone's pda_tip, which reads it; the Silence button at the foot of
-- both pages writes it, so the button and the menu are one setting seen twice.
NEWS_PATH = "seasons_zone/main/pda_news"

-- The release and its author, on the line at the foot of both pages, so a screenshot of either
-- says which Seasons it shows. test_pda.py and build_release.py hold VERSION to season.py's.
VERSION = "2.11.1"
AUTHOR  = "Windwalker"

local function say(msg)
    printf("%s", "[seasons-pda] " .. tostring(msg))
end

-- the script that draws a face
local function page_module(view)
    if view == "forecast" then return ui_seasons_forecast end
    return ui_seasons_pda
end

local function page_for(section)
    if section == VIEWS.year.tab then return ui_seasons_pda.get_ui() end
    if section == VIEWS.forecast.tab then return ui_seasons_forecast.get_ui() end
    return nil
end

-- A face for the PDA to show. Every tab passes through the router, so a page that fails to
-- build must not take the PDA down with it: it is caught and logged, and the section comes
-- back empty.
local function safe_page(section)
    local ok, ui = pcall(page_for, section)
    if ok then return ui end
    say("page for " .. tostring(section) .. " failed: " .. tostring(ui))
    return nil
end

-- Go to one face in the PDA. The same call each page's Back button makes to reach MAC's
-- launcher, so it rides the engine's own section switch rather than opening a window.
function open(tab)
    local ok, err = pcall(function()
        ActorMenu.get_pda_menu():SetActiveSubdialog(tab)
    end)
    if not ok then say("could not open " .. tostring(tab) .. ": " .. tostring(err)) end
end

-- --- the app key: a face in a window of its own ---------------------------------------------

-- The app key's DIK code, or nil while it is unbound or MCM is missing. Read at each press,
-- so a change in MCM takes at once. `saved` reads the stored options and nothing else, for
-- MCM's own page: ui_mcm.get asserts while MCM is building it.
function app_key(saved)
    local k
    if not saved then
        local ok, v = pcall(function() return ui_mcm and ui_mcm.get(KEY_PATH) end)
        if ok then k = v end
    end
    if k == nil then
        local ok, v = pcall(function() return axr_main.config:r_value("mcm", KEY_PATH, 2, -1) end)
        if ok then k = v end
    end
    k = tonumber(k)
    return (k and k >= 0) and k or nil
end

-- Open one face flat and close the other, so the switch on a flat page trades one window
-- for the other and the key never stacks two. Only while the player is up and about: a
-- window over the death screen or a level being loaded has nothing to show. Returns the
-- window, or nil.
function open_flat(view)
    view = VIEWS[view] and view or "year"
    if not (db.actor and db.actor:alive()) then return nil end
    for name in pairs(VIEWS) do
        if name ~= view then
            local ok, err = pcall(function() page_module(name).close_flat() end)
            if not ok then say("could not close " .. name .. ": " .. tostring(err)) end
        end
    end
    local ok, w = pcall(function() return page_module(view).open_flat() end)
    if ok then return w end
    say("could not open " .. view .. " flat: " .. tostring(w))
    return nil
end

-- the face open flat ("year" or "forecast"), or nil
function flat_open()
    for name in pairs(VIEWS) do
        local ok, w = pcall(function() return page_module(name).flat_window() end)
        if ok and w then return name end
    end
    return nil
end

-- The key opens The Year a moment after the press, not on it. The engine hands a key to the
-- scripts before the UI (Level_input.cpp: on_key_press, then IR_UIOnKeyboardPress), so a
-- window opened during the press becomes the UI's receiver for that same press, and the app
-- key closes a flat face: it opened and closed in one frame, and nothing showed. While a
-- face is open the press is the face's to close it, so this leaves it alone.
local function on_key_press(key)
    local k = app_key()
    if not (k and key == k) or flat_open() then return end
    CreateTimeEvent("sotz_pda", "open_flat", 0, function()
        open_flat("year")
        return true
    end)
end

-- --- the foot of the page: Silence, and which Seasons this is -------------------------------

-- whether the mod's PDA messages are on: true unless the player turned them off
function news_on()
    local ok, v = pcall(function() return ui_mcm and ui_mcm.get(NEWS_PATH) end)
    return not (ok and v == false)
end

function set_news(on)
    local ok, err = pcall(function() ui_mcm.set(NEWS_PATH, on and true or false) end)
    if not ok then say("could not set PDA notifications: " .. tostring(err)) end
end

-- the line at the foot of both pages: the mod's name, VERSION and AUTHOR (st_sotz_credit)
function credit()
    return sotz_text.text("st_sotz_credit", {version = VERSION, author = AUTHOR})
end

-- --- the router --------------------------------------------------------------------------------
--
-- pda.set_active_subdialog turns a section id into a page, and a mod claims its sections by
-- wrapping it, as MAC does for its launcher. This claims the two sections above and passes
-- every other one down untouched.
--
-- Installed whatever else is present. With MAC, only one of the two faces is a launcher
-- tile, so MAC's own wrapper has never heard of the other and the switch would lead nowhere
-- without this. Either wrap order works: whichever wrapper is outer, the other is reached
-- through it.
--
-- Every PDA tab passes through here, so each face comes through safe_page.
--
-- Forwards every argument rather than just `section`. A wrapper with named parameters
-- silently truncates the day upstream adds one.
local WRAPPED = false

local function install_router()
    if WRAPPED then return end
    if not (pda and pda.set_active_subdialog) then return end
    local orig = pda.set_active_subdialog
    pda.set_active_subdialog = function(section, ...)
        if section == VIEWS.year.tab or section == VIEWS.forecast.tab then
            return safe_page(section)
        end
        return orig(section, ...)
    end
    WRAPPED = true
end

-- --- a tab of its own --------------------------------------------------------------------------
--
-- Modded Exes' tab registry (pda_dynamic_tabs, since 2026.7.31) adds a tab after the PDA's
-- others, in the bar's own look, and scrolls the bar once it overflows. The tab has a section
-- of its own, ept_dynamic_<n>, which the registry routes to The Year; Forecast stays in its
-- parked section, and its switch comes back to the tab's.
--
-- The tab is there when MCM asks for it, or when no tile can stand in for it: MAC missing, or
-- a tab bar without MAC's Launcher (modxml_seasons_pda.tab_bar). The tile is there while the
-- tab is not, so the launcher never shows a second way to the same page. Without the registry,
-- the tile.
--
-- A tab added during a load crashed the game (Arsenal's, 2026-10-11) and one added in play
-- worked, so the tab comes and goes only in play: a second after the first update, and once the
-- game runs again after MCM's options change.
local TAB_CAPTION = "pda_app_seasons"
local TAB = nil         -- the tab's section, while it is there

-- whether this engine can give the app a tab: Modded Exes' registry, and AddTab on the tab
-- control
function tab_supported()
    local ok, yes = pcall(function()
        return pda_dynamic_tabs ~= nil and type(pda_dynamic_tabs.register) == "function"
            and CUITabControl ~= nil and CUITabControl.AddTab ~= nil
    end)
    return ok and yes == true
end

-- Whether MCM asks for the tab. `saved` reads the stored options and nothing else, as
-- app_key's does, for MCM's own page.
function tab_asked(saved)
    local v
    if not saved then
        local ok, got = pcall(function() return ui_mcm and ui_mcm.get(TAB_PATH) end)
        if ok then v = got end
    end
    if v == nil then
        local ok, got = pcall(function() return axr_main.config:r_value("mcm", TAB_PATH, 1, false) end)
        if ok then v = got end
    end
    return v == true
end

-- whether a tile in MAC's launcher can be reached: MAC here, and its Launcher in the bar, or
-- the bar not read yet
local function tile_reachable()
    if not (mac_mcm and mac_mcm.add_app) then return false end
    local ok, bar = pcall(function() return modxml_seasons_pda.tab_bar() end)
    return not (ok and type(bar) == "table" and bar.launcher == false)
end

-- Whether the app has a tab of its own (above); `saved` as tab_asked's. The option last: MCM
-- defines it only where a tile could be, and ui_mcm.get logs an id no page defines.
function wants_tab(saved)
    return tab_supported() and (not tile_reachable() or tab_asked(saved))
end

-- the section The Year opens in: the tab's while it is there
function year_section()
    return TAB or VIEWS.year.tab
end

-- whether Back, in the PDA, leads to the app's tile in MAC's launcher: while the tile is there.
-- Flat, Back closes the window whatever this says.
function back_to_launcher()
    local ok, yes = pcall(function() return z_seasons_pda_mac.has_tile() end)
    return ok and yes == true
end

-- the section the PDA shows, or nil while the PDA cannot be read
local function pda_section()
    local ok, s = pcall(function()
        local menu = ActorMenu.get_pda_menu()
        return menu and menu:GetActiveSection()
    end)
    return ok and s or nil
end

-- The tab there or gone, as wants_tab() says, and the tile the other way round; a tab the
-- registry refuses leaves the tile. With the tab taken away while it was the PDA's last
-- section, the PDA would reopen on a section nothing answers, its tab bar hidden; it goes to
-- Tasks, the PDA's own first page, instead.
--
-- The registry rebuilds the live tab bar as a tab comes or goes, and the engine then selects
-- the bar's pushed tab again when it is one of the registry's (CUIPdaWnd::RebuildExtraTabs),
-- which takes the PDA to that tab's own page: Arsenal's Workbench, reached from Arsenal's
-- tab, gave way to its catalog as this tab came, and Forecast to The Year as Arsenal's did.
-- So any other section the PDA was on is put back.
local function sync_tab()
    local want = wants_tab() == true
    if want == (TAB ~= nil) then return end
    local was, gone = pda_section(), nil
    if want then
        local ok, id = pcall(pda_dynamic_tabs.register, TAB_CAPTION, function()
            return safe_page(VIEWS.year.tab)
        end)
        if ok and type(id) == "string" then
            TAB = id
            z_seasons_pda_mac.remove_tile()
        else
            say("no PDA tab of its own: " .. tostring(id))
            z_seasons_pda_mac.add_tile()
        end
    else
        gone = TAB
        TAB = nil
        local ok, err = pcall(pda_dynamic_tabs.unregister, gone)
        if not ok then say("the PDA tab could not be taken away: " .. tostring(err)) end
        z_seasons_pda_mac.add_tile()
    end
    local menu = ActorMenu.get_pda_menu()
    if not menu then return end
    local now = menu:GetActiveSection()
    if gone and now == gone then
        menu:SetActiveSubdialog("eptTasks")
    elseif was and was ~= "" and was ~= gone and now ~= was then
        menu:SetActiveSubdialog(was)
    end
end

-- sync_tab, `delay` seconds into play (time events run with the actor's updates); a second
-- call before it runs changes nothing
local function sync_soon(delay)
    CreateTimeEvent("sotz_pda", "sync_tab", delay, function()
        local ok, err = pcall(sync_tab)
        if not ok then say("the PDA tab: " .. tostring(err)) end
        return true
    end)
end

-- A face open flat is a window Lua made, shown with ShowDialog. A load (a quickload while it is
-- open) restarts the scripts and frees it while the engine still holds it, and the next frame
-- draws freed memory: the crash at AnomalyDX11AVX.exe+0x215C52, as Immersive Identification's
-- tag dialog did. So both faces close when the level goes.
local function close_faces()
    for name in pairs(VIEWS) do
        local ok, err = pcall(function() page_module(name).close_flat() end)
        if not ok then say("could not close " .. name .. ": " .. tostring(err)) end
    end
end

-- the router on on_game_load, the same moment MAC installs its own wrapper; the tab in play
-- only (above)
function on_game_start()
    RegisterScriptCallback("on_game_load", install_router)
    RegisterScriptCallback("actor_on_first_update", function() sync_soon(1) end)
    RegisterScriptCallback("on_option_change", function() sync_soon(0) end)
    RegisterScriptCallback("on_key_press", on_key_press)
    RegisterScriptCallback("actor_on_net_destroy", close_faces)
end
